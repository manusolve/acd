<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//inputProcessIncoming := 1;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[if \Stepper.isEmpty then]]>
</Line>
<Line Number="5">
<![CDATA[	;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[anyMeasure := measure or measured or measuredToCollect;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[if \Transfer.gripper.isClosed and not \Transfer.gripper.isClosedEmpty then]]>
</Line>
<Line Number="12">
<![CDATA[	transfer := 1;]]>
</Line>
<Line Number="13">
<![CDATA[elsif \Transfer.gripper.isOpen or \Transfer.gripper.isClosedEmpty then]]>
</Line>
<Line Number="14">
<![CDATA[	transfer := 0;]]>
</Line>
<Line Number="15">
<![CDATA[end_if;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[if \CutInFeed.isColletUnClamped then]]>
</Line>
<Line Number="18">
<![CDATA[	infeed := 0;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="22">
<![CDATA[	if \Heads.h[counter].isColletReleased then]]>
</Line>
<Line Number="23">
<![CDATA[		head[counter] := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	end_if;]]>
</Line>
<Line Number="25">
<![CDATA[end_for;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[anyHeads := 0;]]>
</Line>
<Line Number="28">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="29">
<![CDATA[	anyHeads := anyHeads or head[counter];]]>
</Line>
<Line Number="30">
<![CDATA[end_for;]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[anyHandoff := 0;]]>
</Line>
<Line Number="33">
<![CDATA[for counter := 0 to 2 do]]>
</Line>
<Line Number="34">
<![CDATA[	anyHandoff := anyHandoff or handOff[counter];]]>
</Line>
<Line Number="35">
<![CDATA[end_for;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
