<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Evaluate dual channel OSSD from door]]>
</Comment>
<Text>
<![CDATA[RIN(rin,AUTOMATIC,ch0,ch1,1,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(O1)XIO(waitingForClose)OTE(needReset);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(needReset)XIC(doorReset)OSF(resetButtonFEdge.MEM,resetButtonFEdge.Q);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(resetButtonFEdge.Q) ,XIC(waitingForClose) ]OTL(waitingForClose)TON(resetTimer,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(resetTimer.DN)OTU(waitingForClose);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Set output when door is closed; waiting for close and the safety circuit is complete (door must be locked)]]>
</Comment>
<Text>
<![CDATA[XIC(rin.O1)XIC(doorClosed)[XIC(waitingForClose) ,XIC(O1) ]OTU(waitingForClose)OTE(O1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
