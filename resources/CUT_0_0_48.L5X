</Line>
<Line Number="408">
<![CDATA[			for counter := 0 to 3 do]]>
</Line>
<Line Number="409">
<![CDATA[				runHead[counter].waitAtIndex := -1;]]>
</Line>
<Line Number="410">
<![CDATA[			end_for;]]>
</Line>
<Line Number="411">
<![CDATA[		end_if;]]>
</Line>
<Line Number="412">
<![CDATA[		]]>
</Line>
<Line Number="413">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="414">
<![CDATA[			if headEnabled[counter] then]]>
</Line>
<Line Number="415">
<![CDATA[				]]>
</Line>
<Line Number="416">
<![CDATA[				runHead[counter].positionThreshold := 1.0;]]>
</Line>
<Line Number="417">
<![CDATA[				]]>
</Line>
<Line Number="418">
<![CDATA[				runHead[counter].step := step;				// step for prog. mode]]>
</Line>
<Line Number="419">
<![CDATA[				runHead[counter].allClear := allWaiting;	// once all heads are waiting they]]>
</Line>
<Line Number="420">
<![CDATA[															// can be released ]]>
</Line>
<Line Number="421">
<![CDATA[			]]>
</Line>
<Line Number="422">
<![CDATA[				//error stop processing]]>
</Line>
<Line Number="423">
<![CDATA[				if runHead[counter].errorState > 0 then]]>
</Line>
<Line Number="424">
<![CDATA[					state := opErrorState;]]>
</Line>
<Line Number="425">
<![CDATA[					headWithError := counter;]]>
</Line>
<Line Number="426">
<![CDATA[					JSR(LogHeadError);]]>
</Line>
<Line Number="427">
<![CDATA[					// can take multiple from runHead for the error event]]>
</Line>
<Line Number="428">
<![CDATA[					// This is to do with logging improvement]]>
</Line>
<Line Number="429">
<![CDATA[					(*]]>
</Line>
<Line Number="430">
<![CDATA[					runHead[counter].errorCode					]]>
</Line>
<Line Number="431">
<![CDATA[					runHead[counter].errorState]]>
</Line>
<Line Number="432">
<![CDATA[					runHead[counter].errorIndex]]>
