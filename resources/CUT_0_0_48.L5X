</Line>
<Line Number="353">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="354">
<![CDATA[			end_if;]]>
</Line>
<Line Number="355">
<![CDATA[		end_if;]]>
</Line>
<Line Number="356">
<![CDATA[		]]>
</Line>
<Line Number="357">
<![CDATA[	// open gripper after move to home	]]>
</Line>
<Line Number="358">
<![CDATA[	300:]]>
</Line>
<Line Number="359">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="360">
<![CDATA[		if (gripper.isClosed and not gripper.isClosedEmpty)]]>
</Line>
<Line Number="361">
<![CDATA[		then]]>
</Line>
<Line Number="362">
<![CDATA[			message := 'part in gripper';]]>
</Line>
<Line Number="363">
<![CDATA[			errorState := state;	// it may not be an error; monitor this]]>
