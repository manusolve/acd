<Line Number="391">
<![CDATA[#region lower to pickup]]>
</Line>
<Line Number="392">
<![CDATA[	/// pick up start cycle]]>
</Line>
<Line Number="393">
<![CDATA[	400:]]>
</Line>
<Line Number="394">
<![CDATA[		state := 410;]]>
</Line>
<Line Number="395">
<![CDATA[		]]>
</Line>
<Line Number="396">
<![CDATA[		if not isHome then]]>
</Line>
<Line Number="397">
<![CDATA[			message := 'transfer home position not reached';]]>
</Line>
<Line Number="398">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="399">
<![CDATA[		end_if;]]>
</Line>
<Line Number="400">
<![CDATA[		]]>
</Line>
<Line Number="401">
<![CDATA[	]]>
</Line>
<Line Number="402">
<![CDATA[	410:]]>
</Line>
<Line Number="403">
<![CDATA[		// move down to conv.]]>
</Line>
<Line Number="404">
<![CDATA[		// theoretical pipe diameter is \Settings.cellProgram.inPart.dia ]]>
</Line>
<Line Number="405">
<![CDATA[		// actual dia is ]]>
</Line>
<Line Number="406">
<![CDATA[		]]>
</Line>
<Line Number="407">
<![CDATA[		// from tube diameter + adjustment for installation of beam]]>
</Line>
<Line Number="408">
<![CDATA[		newPosition := posPickupY - (\Settings.cellProgram.inPart.dia / 2); 	]]>
</Line>
<Line Number="409">
<![CDATA[				]]>
</Line>
<Line Number="410">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="411">
<![CDATA[			if not axis.move and not axis.jog then]]>
</Line>
<Line Number="412">
<![CDATA[				axis.move := 1;]]>
</Line>
<Line Number="413">
<![CDATA[				axis.position := newPosition;]]>
</Line>
<Line Number="414">
<![CDATA[				state := 420;]]>
</Line>
<Line Number="415">
<![CDATA[			else]]>
</Line>
<Line Number="416">
<![CDATA[				message := 'transfer down axis not ready or busy';]]>
</Line>
<Line Number="417">
<![CDATA[				errorState := state;]]>
</Line>
<Line Number="418">
<![CDATA[			end_if;]]>
</Line>
<Line Number="419">
<![CDATA[		end_if;]]>
</Line>
<Line Number="420">
<![CDATA[		]]>
</Line>
<Line Number="421">
<![CDATA[	420:]]>
</Line>
<Line Number="422">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="423">
<![CDATA[			state := 500;]]>
</Line>
<Line Number="424">
<![CDATA[			]]>
</Line>
<Line Number="425">
<![CDATA[			// command is move down only ]]>
</Line>
<Line Number="426">
<![CDATA[			// TODO: Check this]]>
</Line>
<Line Number="427">
<![CDATA[			if currentCmd = 30 then]]>
</Line>
<Line Number="428">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="429">
<![CDATA[			end_if;]]>
</Line>
<Line Number="430">
<![CDATA[			]]>
</Line>
<Line Number="431">
<![CDATA[			JSR(CheckForStop);]]>
</Line>
<Line Number="432">
<![CDATA[		end_if;]]>
