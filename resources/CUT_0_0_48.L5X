<Routines>
<Routine Name="CheckBinCount" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[isBinFull := (bins[binSelect].count >= \Settings.cellProgram.outBinQty);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[bins[binSelect].isFull := (bins[binSelect].count >= \Settings.cellProgram.outBinQty);]]>
</Line>
</STContent>
</Routine>
<Routine Name="LogBinSwap" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[\Event.source := 200; 			]]>
</Line>
<Line Number="2">
<![CDATA[\Event.message := 'Swapping output bin to ';]]>
</Line>
<Line Number="3">
<![CDATA[tempInt := binSelect + 1;]]>
</Line>
<Line Number="4">
<![CDATA[DTOS(tempInt, \Event.tempString);]]>
</Line>
<Line Number="5">
<![CDATA[CONCAT(\Event.message, \Event.tempString, \Event.message);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[EVENT(LogEvent);]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[mAxis(outAxis, OutputConv, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="3">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[if binSelect < 0 or binSelect > 1 then]]>
</Line>
<Line Number="9">
<![CDATA[	binSelect := 0;]]>
</Line>
<Line Number="10">
<![CDATA[end_if;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[// local copy for HMI use]]>
</Line>
<Line Number="13">
<![CDATA[fullCount := \Settings.cellProgram.outBinQty;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[// check all the bins and signals]]>
</Line>
<Line Number="16">
<![CDATA[for counter := 0 to 1 do]]>
</Line>
<Line Number="17">
<![CDATA[	// check for reset button]]>
</Line>
<Line Number="18">
<![CDATA[	if bins[counter].reset then]]>
</Line>
<Line Number="19">
<![CDATA[		bins[counter].count := 0;]]>
</Line>
<Line Number="20">
<![CDATA[		bins[counter].reset := 0;]]>
</Line>
<Line Number="21">
<![CDATA[		bins[counter].isFull := 0;]]>
</Line>
<Line Number="22">
<![CDATA[	end_if;]]>
</Line>
<Line Number="23">
<![CDATA[	]]>
</Line>
<Line Number="24">
<![CDATA[	if bins[counter].count >= fullCount then]]>
</Line>
<Line Number="25">
<![CDATA[		bins[counter].isFull := 1;]]>
</Line>
<Line Number="26">
<![CDATA[	else]]>
</Line>
<Line Number="27">
<![CDATA[		bins[counter].isFull := 0;]]>
</Line>
<Line Number="28">
<![CDATA[	end_if;]]>
</Line>
<Line Number="29">
<![CDATA[end_for;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[isBinsFull := bins[0].isFull and bins[1].isFull;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[case state of ]]>
</Line>
<Line Number="34">
<![CDATA[	0:]]>
</Line>
<Line Number="35">
<![CDATA[		// init]]>
</Line>
<Line Number="36">
<![CDATA[		outAxis.speed			:= 200;]]>
</Line>
<Line Number="37">
<![CDATA[		outAxis.jerkPercentage 	:= 80;]]>
</Line>
<Line Number="38">
<![CDATA[		outAxis.jogDirection 	:= 1;]]>
</Line>
<Line Number="39">
<![CDATA[		outAxis.accel 			:= 800;]]>
</Line>
<Line Number="40">
<![CDATA[		outAxis.decel := outAxis.decel;]]>
</Line>
<Line Number="41">
<![CDATA[		]]>
</Line>
<Line Number="42">
<![CDATA[		outAxis.jog := 0;]]>
</Line>
<Line Number="43">
<![CDATA[		state := 90;]]>
</Line>
<Line Number="44">
<![CDATA[	]]>
</Line>
<Line Number="45">
<![CDATA[	90:]]>
</Line>
<Line Number="46">
<![CDATA[		// entry]]>
</Line>
<Line Number="47">
<![CDATA[		if outAxis.ready then]]>
</Line>
<Line Number="48">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="49">
<![CDATA[			outAxis.jog := 1;]]>
</Line>
<Line Number="50">
<![CDATA[		end_If;]]>
</Line>
<Line Number="51">
<![CDATA[	]]>
</Line>
<Line Number="52">
<![CDATA[	// polling loop]]>
</Line>
<Line Number="53">
<![CDATA[	100:]]>
</Line>
<Line Number="54">
<![CDATA[		if outAxis.fault then]]>
</Line>
<Line Number="55">
<![CDATA[			outAxis.state := 0;]]>
</Line>
<Line Number="56">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="57">
<![CDATA[			state := 1000;]]>
</Line>
<Line Number="58">
<![CDATA[		end_if;]]>
</Line>
<Line Number="59">
<![CDATA[		]]>
</Line>
<Line Number="60">
<![CDATA[		// a new part is dropped]]>
</Line>
<Line Number="61">
<![CDATA[		if \ModeAuto.partCountTotal <> partCountLast then]]>
</Line>
<Line Number="62">
<![CDATA[			// the current bin is full]]>
</Line>
<Line Number="63">
<![CDATA[			if bins[binSelect].count >= fullCount then]]>
</Line>
<Line Number="64">
<![CDATA[				// change to other bin]]>
</Line>
<Line Number="65">
<![CDATA[				// if the other bin is full it would]]>
</Line>
<Line Number="66">
<![CDATA[				// have been registerd before this count]]>
</Line>
<Line Number="67">
<![CDATA[				binSelect := binSelect + 1;]]>
</Line>
<Line Number="68">
<![CDATA[				if binSelect > 1 then]]>
</Line>
<Line Number="69">
<![CDATA[					binSelect := 0;]]>
</Line>
<Line Number="70">
<![CDATA[				end_if;]]>
</Line>
<Line Number="71">
<![CDATA[			end_if;]]>
</Line>
<Line Number="72">
<![CDATA[			]]>
</Line>
<Line Number="73">
<![CDATA[			bins[binSelect].count := bins[binSelect].count + 1;]]>
</Line>
<Line Number="74">
<![CDATA[		end_if;]]>
</Line>
<Line Number="75">
<![CDATA[end_case;]]>
</Line>
<Line Number="76">
<![CDATA[]]>
</Line>
<Line Number="77">
<![CDATA[case switchState of]]>
</Line>
<Line Number="78">
<![CDATA[	0:]]>
</Line>
<Line Number="79">
<![CDATA[		//init]]>
</Line>
<Line Number="80">
<![CDATA[		switchState := 100;]]>
</Line>
<Line Number="81">
<![CDATA[	100:]]>
</Line>
<Line Number="82">
<![CDATA[		// wait]]>
</Line>
<Line Number="83">
<![CDATA[		if binSelect <> binSelectLast then]]>
</Line>
<Line Number="84">
<![CDATA[			switchState := 400;]]>
</Line>
<Line Number="85">
<![CDATA[		end_if;]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
<![CDATA[	// change bin]]>
</Line>
<Line Number="88">
<![CDATA[	400:]]>
</Line>
<Line Number="89">
<![CDATA[		TimerStart(tS, timer, 500);]]>
</Line>
<Line Number="90">
<![CDATA[		case binSelect of]]>
</Line>
<Line Number="91">
<![CDATA[			0:]]>
</Line>
<Line Number="92">
<![CDATA[				divert1 := 0;]]>
</Line>
<Line Number="93">
<![CDATA[				divert2 := 1;]]>
</Line>
<Line Number="94">
<![CDATA[			1:]]>
</Line>
<Line Number="95">
<![CDATA[				divert1 := 1;]]>
</Line>
<Line Number="96">
<![CDATA[				divert2 := 0;]]>
</Line>
<Line Number="97">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="98">
<![CDATA[		]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[		]]>
</Line>
<Line Number="101">
<![CDATA[		JSR(LogBinSwap);]]>
</Line>
<Line Number="102">
<![CDATA[		]]>
</Line>
<Line Number="103">
<![CDATA[		switchState := 420;]]>
</Line>
<Line Number="104">
<![CDATA[		]]>
</Line>
<Line Number="105">
<![CDATA[	420:]]>
</Line>
<Line Number="106">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="107">
<![CDATA[			divert1 := 0;]]>
</Line>
<Line Number="108">
<![CDATA[			divert2 := 0;]]>
</Line>
<Line Number="109">
<![CDATA[			switchState := 100;]]>
</Line>
<Line Number="110">
<![CDATA[		end_if;]]>
</Line>
<Line Number="111">
<![CDATA[		]]>
</Line>
<Line Number="112">
<![CDATA[	// error]]>
</Line>
<Line Number="113">
<![CDATA[	1000:]]>
</Line>
<Line Number="114">
<![CDATA[		]]>
</Line>
<Line Number="115">
<![CDATA[		;]]>
</Line>
<Line Number="116">
<![CDATA[		]]>
</Line>
<Line Number="117">
<![CDATA[end_case;]]>
</Line>
<Line Number="118">
<![CDATA[]]>
</Line>
<Line Number="119">
<![CDATA[]]>
</Line>
<Line Number="120">
<![CDATA[binSelectLast := binSelect;]]>
</Line>
<Line Number="121">
<![CDATA[]]>
</Line>
<Line Number="122">
<![CDATA[if state > 99 then]]>
</Line>
<Line Number="123">
<![CDATA[	partCountLast := \ModeAuto.partCount;]]>
</Line>
<Line Number="124">
<![CDATA[end_if;]]>
</Line>
<Line Number="125">
<![CDATA[]]>
</Line>
<Line Number="126">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="MainToggleFlap" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[/// old code that toggled the output flap to try to stop parts sticking]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[(*]]>
</Line>
<Line Number="4">
<![CDATA[mAxis(outAxis, OutputConv, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="8">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="9">
<![CDATA[end_if;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[//if divert1 then]]>
</Line>
<Line Number="12">
<![CDATA[	//divert2 := 0;]]>
</Line>
<Line Number="13">
<![CDATA[//end_if;]]>
</Line>
<Line Number="14">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="15">
<![CDATA[TONR(toggleEvent);]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[if binSelect < 1 or binSelect > 2 then]]>
</Line>
<Line Number="18">
<![CDATA[	binSelect := 1;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[case state of ]]>
</Line>
<Line Number="24">
<![CDATA[	0:]]>
</Line>
<Line Number="25">
<![CDATA[		// init]]>
</Line>
<Line Number="26">
<![CDATA[		outAxis.speed			:= 200;]]>
</Line>
<Line Number="27">
<![CDATA[		outAxis.jerkPercentage 	:= 80;]]>
</Line>
<Line Number="28">
<![CDATA[		outAxis.jogDirection 	:= 1;]]>
</Line>
<Line Number="29">
<![CDATA[		outAxis.accel 			:= 800;]]>
</Line>
<Line Number="30">
<![CDATA[		outAxis.decel := outAxis.decel;]]>
</Line>
<Line Number="31">
<![CDATA[		]]>
</Line>
<Line Number="32">
<![CDATA[		outAxis.jog := 0;]]>
</Line>
<Line Number="33">
<![CDATA[		state := 90;]]>
</Line>
<Line Number="34">
<![CDATA[	]]>
</Line>
<Line Number="35">
<![CDATA[	90:]]>
</Line>
<Line Number="36">
<![CDATA[		// entry		]]>
</Line>
<Line Number="37">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="38">
<![CDATA[	]]>
</Line>
<Line Number="39">
<![CDATA[	100:]]>
</Line>
<Line Number="40">
<![CDATA[		if \ModeAuto.state > 700 ]]>
</Line>
<Line Number="41">
<![CDATA[			or (cmd = 1)]]>
</Line>
<Line Number="42">
<![CDATA[		then]]>
</Line>
<Line Number="43">
<![CDATA[			if outAxis.ready then]]>
</Line>
<Line Number="44">
<![CDATA[				state := 190;]]>
</Line>
<Line Number="45">
<![CDATA[				outAxis.jog := 1;]]>
</Line>
<Line Number="46">
<![CDATA[			end_If;]]>
</Line>
<Line Number="47">
<![CDATA[		end_if;]]>
</Line>
<Line Number="48">
<![CDATA[		]]>
</Line>
<Line Number="49">
<![CDATA[	190:]]>
</Line>
<Line Number="50">
<![CDATA[		TimerStart(tS, toggleEvent, 5000);]]>
</Line>
<Line Number="51">
<![CDATA[		state := 200;]]>
</Line>
<Line Number="52">
<![CDATA[		]]>
</Line>
<Line Number="53">
<![CDATA[	200:]]>
</Line>
<Line Number="54">
<![CDATA[		]]>
</Line>
<Line Number="55">
<![CDATA[		//if \ModeAuto.state < 700 ]]>
</Line>
<Line Number="56">
<![CDATA[		//	or (cmd = 0)]]>
</Line>
<Line Number="57">
<![CDATA[		if cmd = 0 then]]>
</Line>
<Line Number="58">
<![CDATA[			outAxis.jog := 0;]]>
</Line>
<Line Number="59">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="60">
<![CDATA[		end_if;]]>
</Line>
<Line Number="61">
<![CDATA[		]]>
</Line>
<Line Number="62">
<![CDATA[		if outAxis.fault then]]>
</Line>
<Line Number="63">
<![CDATA[			outAxis.state := 0;]]>
</Line>
<Line Number="64">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="65">
<![CDATA[		end_if;]]>
</Line>
<Line Number="66">
<![CDATA[		]]>
</Line>
<Line Number="67">
<![CDATA[		if toggleOut then]]>
</Line>
<Line Number="68">
<![CDATA[			state := 300;]]>
</Line>
<Line Number="69">
<![CDATA[		end_if;]]>
</Line>
<Line Number="70">
<![CDATA[		]]>
</Line>
<Line Number="71">
<![CDATA[		case binSelect of]]>
</Line>
<Line Number="72">
<![CDATA[			1:]]>
</Line>
<Line Number="73">
<![CDATA[				if toggleEvent.DN then]]>
</Line>
<Line Number="74">
<![CDATA[					state := 300;]]>
</Line>
<Line Number="75">
<![CDATA[					mem := 0;]]>
</Line>
<Line Number="76">
<![CDATA[				end_if;]]>
</Line>
<Line Number="77">
<![CDATA[		end_case;]]>
</Line>
<Line Number="78">
<![CDATA[		]]>
</Line>
<Line Number="79">
<![CDATA[		if binSelect <> binSelectLast then]]>
</Line>
<Line Number="80">
<![CDATA[			state := 400;]]>
</Line>
<Line Number="81">
<![CDATA[		end_if;]]>
</Line>
<Line Number="82">
<![CDATA[		]]>
</Line>
<Line Number="83">
<![CDATA[	// cycle on bin 1]]>
</Line>
<Line Number="84">
<![CDATA[	300:]]>
</Line>
<Line Number="85">
<![CDATA[		if mem then]]>
</Line>
<Line Number="86">
<![CDATA[			divert1 := 1;]]>
</Line>
<Line Number="87">
<![CDATA[		else]]>
</Line>
<Line Number="88">
<![CDATA[			divert2 := 1;]]>
</Line>
<Line Number="89">
<![CDATA[		end_if;]]>
</Line>
<Line Number="90">
<![CDATA[		mem := not mem;]]>
</Line>
<Line Number="91">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="92">
<![CDATA[		TimerStart(tS, timer, 250);]]>
</Line>
<Line Number="93">
<![CDATA[	310:]]>
</Line>
<Line Number="94">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="95">
<![CDATA[			state := 320;]]>
</Line>
<Line Number="96">
<![CDATA[		end_if;]]>
</Line>
<Line Number="97">
<![CDATA[		]]>
</Line>
<Line Number="98">
<![CDATA[	320:]]>
</Line>
<Line Number="99">
<![CDATA[		divert1 := 0;]]>
</Line>
<Line Number="100">
<![CDATA[		divert2 := 0;]]>
</Line>
<Line Number="101">
<![CDATA[		]]>
</Line>
<Line Number="102">
<![CDATA[		if mem then]]>
</Line>
<Line Number="103">
<![CDATA[			state := 300;]]>
</Line>
<Line Number="104">
<![CDATA[		else]]>
</Line>
<Line Number="105">
<![CDATA[			state := 190;]]>
</Line>
<Line Number="106">
<![CDATA[		end_if;]]>
</Line>
<Line Number="107">
<![CDATA[	]]>
</Line>
<Line Number="108">
<![CDATA[	// change to bin ]]>
</Line>
<Line Number="109">
<![CDATA[	400:]]>
</Line>
<Line Number="110">
<![CDATA[		TimerStart(tS, timer, 250);]]>
</Line>
<Line Number="111">
<![CDATA[		case binSelect of]]>
</Line>
<Line Number="112">
<![CDATA[			1:]]>
</Line>
<Line Number="113">
<![CDATA[				divert1 := 1;]]>
</Line>
<Line Number="114">
<![CDATA[				divert2 := 0;]]>
</Line>
<Line Number="115">
<![CDATA[			2:]]>
</Line>
<Line Number="116">
<![CDATA[				divert1 := 0;]]>
</Line>
<Line Number="117">
<![CDATA[				divert2 := 1;]]>
</Line>
<Line Number="118">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="119">
<![CDATA[		state := 420;]]>
</Line>
<Line Number="120">
<![CDATA[		]]>
</Line>
<Line Number="121">
<![CDATA[	420:]]>
</Line>
<Line Number="122">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="123">
<![CDATA[			divert1 := 0;]]>
