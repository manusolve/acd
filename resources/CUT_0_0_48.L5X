</Line>
<Line Number="363">
<![CDATA[		// tell head 1 if it can clamp]]>
</Line>
<Line Number="364">
<![CDATA[		runHead[0].inputFeedReady := ]]>
</Line>
<Line Number="365">
<![CDATA[			\CutInFeed.isAwaitingHeadHandoff]]>
</Line>
<Line Number="366">
<![CDATA[			and not \CutInFeed.isFrontOffal;	//this is implied by awaitHandoff]]>
</Line>
<Line Number="367">
<![CDATA[]]>
</Line>
<Line Number="368">
<![CDATA[		// if it can unclamp]]>
