<![CDATA[			axis.position := posUpY; // get from clear height parameter]]>
</Line>
<Line Number="312">
<![CDATA[			state := 210;]]>
</Line>
<Line Number="313">
<![CDATA[		else]]>
</Line>
<Line Number="314">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="315">
<![CDATA[		end_if;]]>
</Line>
<Line Number="316">
<![CDATA[		]]>
</Line>
<Line Number="317">
<![CDATA[	210:]]>
</Line>
<Line Number="318">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="319">
<![CDATA[			state := 240;]]>
</Line>
<Line Number="320">
<![CDATA[			]]>
</Line>
<Line Number="321">
<![CDATA[			// check -- but if faulted then not in position so it is covered]]>
</Line>
<Line Number="322">
<![CDATA[			if Y0.ActualPosition < (posUpY - 2.5) then]]>
</Line>
<Line Number="323">
<![CDATA[				;]]>
</Line>
<Line Number="324">
<![CDATA[			end_if;]]>
</Line>
<Line Number="325">
<![CDATA[		end_if;]]>
</Line>
<Line Number="326">
<![CDATA[	]]>
</Line>
<Line Number="327">
<![CDATA[	240:]]>
</Line>
<Line Number="328">
<![CDATA[		// travCylToInput := 1;]]>
