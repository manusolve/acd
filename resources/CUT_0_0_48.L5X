<Line Number="339">
<![CDATA[]]>
</Line>
<Line Number="340">
<![CDATA[		if not \Axes.xIn.move then]]>
</Line>
<Line Number="341">
<![CDATA[			case currentCmd of]]>
</Line>
<Line Number="342">
<![CDATA[				2:	// auto mode, resume wait for cutinfeed]]>
</Line>
<Line Number="343">
<![CDATA[					// TODO: Here can we set a new command]]>
</Line>
<Line Number="344">
<![CDATA[					state := 620;	]]>
</Line>
<Line Number="345">
<![CDATA[				20:]]>
</Line>
<Line Number="346">
<![CDATA[					state := 100; 	// move to home only]]>
</Line>
<Line Number="347">
<![CDATA[				else]]>
