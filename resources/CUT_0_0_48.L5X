<DataValueMember Name="bumpAccel" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="waitAtIndex" DataType="DINT" Radix="Decimal" Value="-1"/>
<DataValueMember Name="timeOpDuration" DataType="DINT" Radix="Decimal" Value="505881"/>
<DataValueMember Name="bumpCounter" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="bumpDistance" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="bumpCount" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="cutDone" DataType="BOOL" Value="0"/>
</Structure>
</Element>
