<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// call the axis]]>
</Line>
<Line Number="2">
<![CDATA[mAxis(axis, InputConv, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="5">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[readyForCommand := (currentCmd = 0 and cmd = -1);]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[case state of]]>
</Line>
<Line Number="13">
<![CDATA[	0:]]>
</Line>
<Line Number="14">
<![CDATA[		// init]]>
</Line>
<Line Number="15">
<![CDATA[		currentCmd := -1;]]>
</Line>
<Line Number="16">
<![CDATA[		axis.jog := 0;]]>
</Line>
<Line Number="17">
<![CDATA[		axis.accel := 400.0;]]>
</Line>
<Line Number="18">
<![CDATA[		axis.decel := 1000.0; //800]]>
</Line>
<Line Number="19">
<![CDATA[		axis.jerkPercentage := 80.0;		]]>
</Line>
<Line Number="20">
<![CDATA[		pushSpeed := \Settings.inputProcessParam.inputPushSpeed;]]>
</Line>
<Line Number="21">
<![CDATA[		timer.Reset := 1;]]>
</Line>
<Line Number="22">
<![CDATA[		isEmpty := 0;]]>
</Line>
<Line Number="23">
<![CDATA[		]]>
</Line>
<Line Number="24">
<![CDATA[		message := 'wait for axis ready';]]>
</Line>
<Line Number="25">
<![CDATA[		state := 50;]]>
</Line>
<Line Number="26">
<![CDATA[	]]>
</Line>
<Line Number="27">
<![CDATA[	50:]]>
</Line>
<Line Number="28">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="29">
<![CDATA[			state := 90;]]>
</Line>
<Line Number="30">
<![CDATA[		end_if;]]>
</Line>
<Line Number="31">
<![CDATA[		]]>
</Line>
<Line Number="32">
<![CDATA[	90:]]>
</Line>
<Line Number="33">
<![CDATA[		message := 'stopped';]]>
</Line>
<Line Number="34">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="35">
<![CDATA[		]]>
</Line>
<Line Number="36">
<![CDATA[	100:]]>
</Line>
<Line Number="37">
<![CDATA[		// stopped]]>
</Line>
<Line Number="38">
<![CDATA[		currentCmd := 0;]]>
</Line>
<Line Number="39">
<![CDATA[		cmd := -1;]]>
</Line>
<Line Number="40">
<![CDATA[		state := 110;]]>
</Line>
<Line Number="41">
<![CDATA[	]]>
</Line>
<Line Number="42">
<![CDATA[	110:]]>
</Line>
<Line Number="43">
<![CDATA[		(*]]>
</Line>
<Line Number="44">
<![CDATA[			-1 	- Inactive]]>
</Line>
<Line Number="45">
<![CDATA[			0 	- Stopped]]>
</Line>
<Line Number="46">
<![CDATA[			1	- Running cont.]]>
</Line>
<Line Number="47">
<![CDATA[			2	- Feed 1 part]]>
</Line>
<Line Number="48">
<![CDATA[		*)]]>
</Line>
<Line Number="49">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="50">
<![CDATA[			0:	// stop]]>
</Line>
<Line Number="51">
<![CDATA[				;]]>
</Line>
<Line Number="52">
<![CDATA[			]]>
</Line>
<Line Number="53">
<![CDATA[			1:	// start run]]>
</Line>
<Line Number="54">
<![CDATA[				axis.speed := pushSpeed;]]>
</Line>
<Line Number="55">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="56">
<![CDATA[			]]>
</Line>
<Line Number="57">
<![CDATA[			2:	// run till part exit, then stop]]>
</Line>
<Line Number="58">
<![CDATA[				axis.speed := pushSpeed * 2;]]>
</Line>
<Line Number="59">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="60">
<![CDATA[			]]>
</Line>
<Line Number="61">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="62">
<![CDATA[		]]>
</Line>
<Line Number="63">
<![CDATA[		if state <> stateLast then]]>
</Line>
<Line Number="64">
<![CDATA[			currentCmd := cmd;]]>
</Line>
<Line Number="65">
<![CDATA[			cmd := -1;]]>
</Line>
<Line Number="66">
<![CDATA[		end_if;]]>
</Line>
<Line Number="67">
<![CDATA[		]]>
</Line>
<Line Number="68">
<![CDATA[	200:]]>
</Line>
<Line Number="69">
<![CDATA[		// starting]]>
</Line>
<Line Number="70">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="71">
<![CDATA[			//JSR(messageSpeed);]]>
</Line>
<Line Number="72">
<![CDATA[			message := 'running';]]>
</Line>
<Line Number="73">
<![CDATA[			axis.jog := 1;]]>
</Line>
<Line Number="74">
<![CDATA[			state := 250;]]>
</Line>
<Line Number="75">
<![CDATA[		end_if;]]>
</Line>
<Line Number="76">
<![CDATA[		]]>
</Line>
<Line Number="77">
<![CDATA[	250:]]>
</Line>
<Line Number="78">
<![CDATA[		// transition to start timer]]>
</Line>
<Line Number="79">
<![CDATA[		timer.Reset := 0;]]>
</Line>
<Line Number="80">
<![CDATA[		TimerStart(tS, timer, 10000); 				// 10 seconds]]>
</Line>
<Line Number="81">
<![CDATA[		state := 300;]]>
</Line>
<Line Number="82">
<![CDATA[		]]>
</Line>
<Line Number="83">
<![CDATA[	300:]]>
</Line>
<Line Number="84">
<![CDATA[		// running]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
<![CDATA[		// check for parts on the conveyor within a time frame]]>
</Line>
<Line Number="88">
<![CDATA[		if not partExitDetect and exitDetectLast then]]>
</Line>
<Line Number="89">
<![CDATA[			//timer.Reset := 0;]]>
</Line>
<Line Number="90">
<![CDATA[			//TimerStart(tS, timer, 10000); 				// 10 seconds]]>
</Line>
<Line Number="91">
<![CDATA[			state := 250;]]>
</Line>
<Line Number="92">
<![CDATA[		end_if;]]>
</Line>
<Line Number="93">
<![CDATA[		]]>
</Line>
<Line Number="94">
<![CDATA[		if partExitDetect then]]>
</Line>
<Line Number="95">
<![CDATA[			isEmpty := 0;]]>
</Line>
<Line Number="96">
<![CDATA[			timer.Reset := 1;]]>
</Line>
<Line Number="97">
<![CDATA[		end_if;]]>
</Line>
<Line Number="98">
<![CDATA[		]]>
</Line>
<Line Number="99">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="100">
<![CDATA[			isEmpty := 1;]]>
</Line>
<Line Number="101">
<![CDATA[		end_if;]]>
</Line>
<Line Number="102">
<![CDATA[		]]>
</Line>
<Line Number="103">
<![CDATA[		readyForCommand := 1;]]>
</Line>
<Line Number="104">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="105">
<![CDATA[			0:]]>
</Line>
<Line Number="106">
<![CDATA[				// just stop]]>
</Line>
<Line Number="107">
<![CDATA[				cmd := -1;]]>
</Line>
<Line Number="108">
<![CDATA[				axis.jog := 0;]]>
</Line>
<Line Number="109">
<![CDATA[				state := 50;]]>
</Line>
<Line Number="110">
<![CDATA[			1:]]>
</Line>
<Line Number="111">
<![CDATA[				;]]>
</Line>
<Line Number="112">
<![CDATA[			2:]]>
</Line>
<Line Number="113">
<![CDATA[				state := 110;	// jump to take new command]]>
</Line>
<Line Number="114">
<![CDATA[				TND();]]>
</Line>
<Line Number="115">
<![CDATA[		end_case;]]>
</Line>
<Line Number="116">
<![CDATA[		]]>
</Line>
<Line Number="117">
<![CDATA[		case currentCmd of]]>
</Line>
<Line Number="118">
<![CDATA[			1:	;]]>
</Line>
<Line Number="119">
<![CDATA[			2:	if partExitDetect then]]>
</Line>
<Line Number="120">
<![CDATA[					cmd := 0;]]>
</Line>
<Line Number="121">
<![CDATA[				end_if;]]>
</Line>
<Line Number="122">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="123">
<![CDATA[		]]>
</Line>
<Line Number="124">
<![CDATA[		]]>
</Line>
<Line Number="125">
<![CDATA[]]>
</Line>
<Line Number="126">
<![CDATA[end_case;]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[exitDetectLast := partExitDetect;]]>
</Line>
<Line Number="129">
<![CDATA[stateLast := state;]]>
</Line>
</STContent>
</Routine>
<Routine Name="messageSpeed" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[message := 'running ';]]>
</Line>
<Line Number="1">
<![CDATA[RTOS(pushSpeed, numString);]]>
</Line>
<Line Number="2">
<![CDATA[CONCAT(message, numString, message);]]>
</Line>
<Line Number="3">
<![CDATA[//\Event.message := message;]]>
</Line>
<Line Number="4">
<![CDATA[//Event(LogEvent);]]>
</Line>
</STContent>
</Routine>
