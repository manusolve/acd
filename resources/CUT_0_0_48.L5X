<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[/// this code sets the part present based on the status of ]]>
</Line>
<Line Number="3">
<![CDATA[// the gripper; however can't leave the gripper without a part]]>
</Line>
<Line Number="4">
<![CDATA[// in it and in the closedEmpty position as risk of]]>
</Line>
<Line Number="5">
<![CDATA[// collision. Added partPresent to gripper to give current status]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="9">
<![CDATA[	//COP(\IO.handoffs[counter].gripper, gripper, 1);]]>
</Line>
<Line Number="10">
<![CDATA[	COP(h[counter].gripper, gripper, 1);]]>
</Line>
<Line Number="11">
<![CDATA[	gripper.partPresent := ]]>
</Line>
<Line Number="12">
<![CDATA[		(gripper.isClosed and not gripper.isClosedEmpty);]]>
</Line>
<Line Number="13">
<![CDATA[		//or gripper.isClosed;]]>
</Line>
<Line Number="14">
<![CDATA[		]]>
</Line>
<Line Number="15">
<![CDATA[	\PartPresent.handOff[counter] := gripper.partPresent;]]>
</Line>
<Line Number="16">
<![CDATA[	//COP(gripper, \IO.handoffs[counter].gripper, 1);]]>
</Line>
<Line Number="17">
<![CDATA[	COP(gripper, h[counter].gripper, 1);]]>
</Line>
<Line Number="18">
<![CDATA[	]]>
</Line>
<Line Number="19">
<![CDATA[end_for;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[(*]]>
</Line>
<Line Number="22">
<![CDATA[if 0 then]]>
</Line>
<Line Number="23">
<![CDATA[	// the empty gripper at [3] make dummy signals]]>
</Line>
<Line Number="24">
<![CDATA[	for counter := 0 to 3 do]]>
</Line>
<Line Number="25">
<![CDATA[		]]>
</Line>
<Line Number="26">
<![CDATA[		case counter of]]>
</Line>
<Line Number="27">
<![CDATA[			0: edges[counter].InputBit := \IO.handoffs[3].gripper.open;]]>
</Line>
<Line Number="28">
<![CDATA[			1: edges[counter].InputBit := \IO.handoffs[3].gripper.close;]]>
</Line>
<Line Number="29">
<![CDATA[			2: edges[counter].InputBit := \IO.handoffs[3].indexA;]]>
</Line>
<Line Number="30">
<![CDATA[			3: edges[counter].InputBit := \IO.handoffs[3].indexB;]]>
</Line>
<Line Number="31">
<![CDATA[		end_case;]]>
</Line>
<Line Number="32">
<![CDATA[		]]>
</Line>
<Line Number="33">
<![CDATA[		OSRI(edges[counter]);]]>
</Line>
<Line Number="34">
<![CDATA[		]]>
</Line>
<Line Number="35">
<![CDATA[		// flip the bit]]>
</Line>
<Line Number="36">
<![CDATA[		if edges[counter].OutputBit then]]>
</Line>
<Line Number="37">
<![CDATA[			case counter of]]>
</Line>
<Line Number="38">
<![CDATA[				0: ]]>
</Line>
<Line Number="39">
<![CDATA[					\IO.handoffs[3].gripper.isOpen := 1;]]>
</Line>
<Line Number="40">
<![CDATA[					\IO.handoffs[3].gripper.isClosed := 0;]]>
</Line>
<Line Number="41">
<![CDATA[				1: ]]>
</Line>
<Line Number="42">
<![CDATA[					\IO.handoffs[3].gripper.isClosed := 1;]]>
</Line>
<Line Number="43">
<![CDATA[					//\IO.handoffs[3].gripper.isClosedEmpty := 1;]]>
</Line>
<Line Number="44">
<![CDATA[					\IO.handoffs[3].gripper.isOpen := 0;]]>
</Line>
<Line Number="45">
<![CDATA[				2: ]]>
</Line>
<Line Number="46">
<![CDATA[					\IO.handoffs[3].isIndexA := 1;]]>
</Line>
<Line Number="47">
<![CDATA[					\IO.handoffs[3].isIndexB := 0;]]>
</Line>
<Line Number="48">
<![CDATA[				3: ]]>
</Line>
<Line Number="49">
<![CDATA[					\IO.handoffs[3].isIndexB := 1;]]>
</Line>
<Line Number="50">
<![CDATA[					\IO.handoffs[3].isIndexA := 0;]]>
</Line>
<Line Number="51">
<![CDATA[			end_case;]]>
</Line>
<Line Number="52">
<![CDATA[		end_if;]]>
</Line>
<Line Number="53">
<![CDATA[	end_for;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[else]]>
</Line>
<Line Number="56">
<![CDATA[	// when the new handoff module is installed.]]>
</Line>
<Line Number="57">
<![CDATA[	]]>
</Line>
<Line Number="58">
<![CDATA[	;]]>
</Line>
<Line Number="59">
<![CDATA[end_if;]]>
</Line>
<Line Number="60">
<![CDATA[*)]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[(*]]>
</Line>
<Line Number="63">
<![CDATA[// these will not persist when the valve is off]]>
</Line>
<Line Number="64">
<![CDATA[\IO.handoffs[3].gripper.isOpen := \IO.handoffs[3].gripper.open;]]>
</Line>
<Line Number="65">
<![CDATA[// in this case the assumption is gripped; not empty]]>
</Line>
<Line Number="66">
<![CDATA[\IO.handoffs[3].gripper.isClosed := \IO.handoffs[3].gripper.close;]]>
</Line>
<Line Number="67">
<![CDATA[\IO.handoffs[3].isIndexA := \IO.handoffs[3].indexA;]]>
</Line>
<Line Number="68">
<![CDATA[\IO.handoffs[3].isIndexB := \IO.handoffs[3].indexB;]]>
</Line>
<Line Number="69">
<![CDATA[*)]]>
</Line>
<Line Number="70">
<![CDATA[]]>
</Line>
<Line Number="71">
<![CDATA[(*]]>
</Line>
<Line Number="72">
<![CDATA[// when an open/close signal is seen then reverse the other side of the valve]]>
</Line>
<Line Number="73">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="74">
<![CDATA[	openEdges[counter].InputBit := \IO.handoffs[counter].gripper.open;]]>
</Line>
<Line Number="75">
<![CDATA[	OSRI(openEdges[counter]);]]>
</Line>
<Line Number="76">
<![CDATA[	closeEdges[counter].InputBit := \IO.handoffs[counter].gripper.close;]]>
</Line>
<Line Number="77">
<![CDATA[	OSRI(closeEdges[counter]);]]>
</Line>
<Line Number="78">
<![CDATA[	]]>
</Line>
<Line Number="79">
<![CDATA[	if openEdges[counter].OutputBit then]]>
</Line>
<Line Number="80">
<![CDATA[		\IO.handoffs[counter].gripper.close := 0;]]>
</Line>
<Line Number="81">
<![CDATA[	elsif closeEdges[counter].OutputBit then]]>
</Line>
<Line Number="82">
<![CDATA[		\IO.handoffs[counter].gripper.open := 0;]]>
</Line>
<Line Number="83">
<![CDATA[	end_if;]]>
</Line>
<Line Number="84">
<![CDATA[end_for;]]>
</Line>
<Line Number="85">
<![CDATA[*)]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[]]>
</Line>
<Line Number="88">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="89">
<![CDATA[	]]>
</Line>
<Line Number="90">
<![CDATA[	COP(h[counter].gripper, gripper, 1);]]>
</Line>
<Line Number="91">
<![CDATA[	//COP(\IO.handoffs[counter].gripper, gripper, 1);]]>
</Line>
<Line Number="92">
<![CDATA[		]]>
</Line>
<Line Number="93">
<![CDATA[	TONR(gripper.timer);]]>
</Line>
<Line Number="94">
<![CDATA[	]]>
</Line>
<Line Number="95">
<![CDATA[	case gripper.state of]]>
</Line>
<Line Number="96">
<![CDATA[		0:]]>
</Line>
<Line Number="97">
<![CDATA[			if gripper.close or gripper.open then]]>
</Line>
<Line Number="98">
<![CDATA[				TimerStart(tS, gripper.timer, 2500);]]>
</Line>
<Line Number="99">
<![CDATA[				gripper.state := 10;]]>
</Line>
<Line Number="100">
<![CDATA[			end_if;]]>
</Line>
<Line Number="101">
<![CDATA[			]]>
</Line>
<Line Number="102">
<![CDATA[		10:]]>
</Line>
<Line Number="103">
<![CDATA[			if gripper.open then]]>
</Line>
<Line Number="104">
<![CDATA[				if gripper.isOpen then]]>
</Line>
<Line Number="105">
<![CDATA[					gripper.state := 30;]]>
</Line>
<Line Number="106">
<![CDATA[				end_If;]]>
</Line>
<Line Number="107">
<![CDATA[			elsif gripper.close then]]>
</Line>
<Line Number="108">
<![CDATA[				if gripper.isClosed or gripper.isClosedEmpty then]]>
</Line>
<Line Number="109">
<![CDATA[					gripper.state := 30;]]>
</Line>
<Line Number="110">
<![CDATA[				end_if;]]>
</Line>
<Line Number="111">
<![CDATA[			end_If;]]>
</Line>
<Line Number="112">
<![CDATA[			]]>
</Line>
<Line Number="113">
<![CDATA[			if gripper.timer.DN then]]>
</Line>
<Line Number="114">
<![CDATA[				gripper.timer.Reset := 1;]]>
</Line>
<Line Number="115">
<![CDATA[				gripper.state := 20;]]>
</Line>
<Line Number="116">
<![CDATA[			end_if;]]>
</Line>
<Line Number="117">
<![CDATA[		20:]]>
</Line>
<Line Number="118">
<![CDATA[			if gripper.open then]]>
</Line>
<Line Number="119">
<![CDATA[				message := 'gripper did not open';]]>
</Line>
<Line Number="120">
<![CDATA[			else]]>
</Line>
<Line Number="121">
<![CDATA[				message := 'gripper did not close';]]>
</Line>
<Line Number="122">
<![CDATA[			end_if;]]>
</Line>
<Line Number="123">
<![CDATA[			]]>
</Line>
<Line Number="124">
<![CDATA[			\Event.message := message;]]>
</Line>
<Line Number="125">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="126">
<![CDATA[			]]>
</Line>
<Line Number="127">
<![CDATA[			gripper.state := 30;]]>
</Line>
<Line Number="128">
<![CDATA[			]]>
</Line>
<Line Number="129">
<![CDATA[		30:]]>
</Line>
<Line Number="130">
<![CDATA[			gripper.close := 0;]]>
</Line>
<Line Number="131">
<![CDATA[			gripper.open := 0;]]>
</Line>
<Line Number="132">
<![CDATA[			gripper.timer.Reset := 1;]]>
</Line>
<Line Number="133">
<![CDATA[			gripper.state := 0;]]>
</Line>
<Line Number="134">
<![CDATA[			]]>
</Line>
<Line Number="135">
<![CDATA[	end_Case;]]>
</Line>
<Line Number="136">
<![CDATA[	]]>
</Line>
<Line Number="137">
<![CDATA[	//COP(gripper, \IO.handoffs[counter].gripper, 1);]]>
</Line>
<Line Number="138">
<![CDATA[	COP(gripper, h[counter].gripper, 1);]]>
</Line>
<Line Number="139">
<![CDATA[	]]>
</Line>
<Line Number="140">
<![CDATA[	// then process handoff]]>
</Line>
<Line Number="141">
<![CDATA[	//COP(\IO.handoffs[counter], handoff, 1);]]>
</Line>
<Line Number="142">
<![CDATA[	COP(h[counter], handoff, 1);]]>
</Line>
<Line Number="143">
<![CDATA[	]]>
</Line>
<Line Number="144">
<![CDATA[	TONR(handoff.timer);]]>
</Line>
<Line Number="145">
<![CDATA[	]]>
</Line>
<Line Number="146">
<![CDATA[	case handoff.state of]]>
</Line>
<Line Number="147">
<![CDATA[		0:]]>
</Line>
<Line Number="148">
<![CDATA[			if handoff.indexA or handoff.indexB then]]>
</Line>
<Line Number="149">
<![CDATA[				TimerStart(tS, handoff.timer, 2500);]]>
</Line>
<Line Number="150">
<![CDATA[				handoff.state := 10;]]>
</Line>
<Line Number="151">
<![CDATA[			end_if;]]>
</Line>
<Line Number="152">
<![CDATA[			]]>
</Line>
<Line Number="153">
<![CDATA[		10:]]>
</Line>
<Line Number="154">
<![CDATA[			if handoff.indexA then]]>
</Line>
<Line Number="155">
<![CDATA[				if handoff.isIndexA then]]>
</Line>
<Line Number="156">
<![CDATA[					handoff.state := 30;]]>
</Line>
<Line Number="157">
<![CDATA[				end_If;]]>
</Line>
<Line Number="158">
<![CDATA[			elsif handoff.indexB then]]>
</Line>
<Line Number="159">
<![CDATA[				if handoff.isIndexB then]]>
</Line>
<Line Number="160">
<![CDATA[					handoff.state := 30;]]>
</Line>
<Line Number="161">
<![CDATA[				end_If;]]>
</Line>
<Line Number="162">
<![CDATA[			end_If;]]>
</Line>
<Line Number="163">
<![CDATA[			]]>
</Line>
<Line Number="164">
<![CDATA[			if handoff.timer.DN then]]>
</Line>
<Line Number="165">
<![CDATA[				handoff.timer.Reset := 1;]]>
</Line>
<Line Number="166">
<![CDATA[				handoff.state := 20;]]>
</Line>
<Line Number="167">
<![CDATA[			end_if;]]>
</Line>
<Line Number="168">
<![CDATA[		20:]]>
</Line>
<Line Number="169">
<![CDATA[			if handoff.indexA then]]>
</Line>
<Line Number="170">
<![CDATA[				message := 'Not rotated to A';]]>
</Line>
<Line Number="171">
<![CDATA[			else]]>
</Line>
<Line Number="172">
<![CDATA[				message := 'Not rotated to B';]]>
</Line>
<Line Number="173">
<![CDATA[			end_if;]]>
</Line>
<Line Number="174">
<![CDATA[			]]>
</Line>
<Line Number="175">
<![CDATA[			\Event.message := message;]]>
</Line>
<Line Number="176">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="177">
<![CDATA[			]]>
</Line>
<Line Number="178">
<![CDATA[			handoff.state := 30;]]>
</Line>
<Line Number="179">
<![CDATA[			]]>
</Line>
<Line Number="180">
<![CDATA[		30:]]>
</Line>
<Line Number="181">
<![CDATA[			handoff.indexA := 0;]]>
</Line>
<Line Number="182">
<![CDATA[			handoff.indexB := 0;]]>
</Line>
<Line Number="183">
<![CDATA[			handoff.timer.Reset := 1;]]>
</Line>
<Line Number="184">
<![CDATA[			handoff.state := 0;]]>
</Line>
<Line Number="185">
<![CDATA[	end_case;]]>
</Line>
<Line Number="186">
<![CDATA[	]]>
</Line>
<Line Number="187">
<![CDATA[	//COP(handoff, \IO.handoffs[counter], 1);]]>
</Line>
<Line Number="188">
<![CDATA[	COP(handoff, h[counter], 1);]]>
</Line>
<Line Number="189">
<![CDATA[	]]>
</Line>
<Line Number="190">
<![CDATA[end_for;]]>
</Line>
<Line Number="191">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
