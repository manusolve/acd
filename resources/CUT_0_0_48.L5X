<Line Number="300">
<![CDATA[		end_if;]]>
</Line>
<Line Number="301">
<![CDATA[	]]>
</Line>
<Line Number="302">
<![CDATA[	// move to home]]>
</Line>
<Line Number="303">
<![CDATA[	200:	]]>
</Line>
<Line Number="304">
<![CDATA[		// move to home position]]>
</Line>
<Line Number="305">
<![CDATA[		message := 'wait axis ready';]]>
</Line>
<Line Number="306">
<![CDATA[		state := 205;]]>
</Line>
<Line Number="307">
<![CDATA[		]]>
</Line>
<Line Number="308">
<![CDATA[	205:]]>
</Line>
<Line Number="309">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="310">
<![CDATA[			axis.move := 1;]]>
