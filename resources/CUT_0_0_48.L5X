<DataValueMember Name="Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="1"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="1500"/>
<DataValueMember Name="EN" DataType="BOOL" Value="1"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="1"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="CalcCutPlan" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// take the incoming part length]]>
</Line>
<Line Number="1">
<![CDATA[cutPlan.inputLength := \Transfer.actualPartLen;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// add the deviation as well]]>
</Line>
<Line Number="4">
<![CDATA[cutPlan.outputLength := \Settings.cellProgram.outPart.length]]>
</Line>
<Line Number="5">
<![CDATA[						+ \Settings.cellProgram.outPart.deviation;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[GenCutPlan(gCP, cutPlan, \Settings.cellProgram.cutPlanParam);]]>
</Line>
</STContent>
</Routine>
<Routine Name="CutInFeedEvent" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[\Event.source := 70;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[case state of]]>
</Line>
<Line Number="4">
<![CDATA[	110:]]>
</Line>
<Line Number="5">
<![CDATA[		\Event.code := cmd;]]>
</Line>
<Line Number="6">
<![CDATA[		\Event.logLevel := \Event.EVENT_DEBUG_CMD;]]>
</Line>
<Line Number="7">
<![CDATA[	else]]>
</Line>
<Line Number="8">
<![CDATA[		\Event.message := message;		]]>
</Line>
<Line Number="9">
<![CDATA[end_case;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[Event(LogEvent);]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="2">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="3">
<![CDATA[end_if;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[// using the current pipe length]]>
</Line>
<Line Number="8">
<![CDATA[positionTransferUnload :=]]>
</Line>
<Line Number="9">
<![CDATA[			positionMid			]]>
</Line>
<Line Number="10">
<![CDATA[			- (cutPlan.inputLength / 2.0)]]>
</Line>
<Line Number="11">
<![CDATA[			- colletOffset]]>
</Line>
<Line Number="12">
<![CDATA[			- colletOffsetAdditonal;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[// look at the length of the incoming part]]>
</Line>
<Line Number="15">
<![CDATA[positionRetractForNextPipe :=]]>
</Line>
<Line Number="16">
<![CDATA[	positionMid]]>
</Line>
<Line Number="17">
<![CDATA[	- (\Transfer.actualPartLen / 2)]]>
</Line>
<Line Number="18">
<![CDATA[	- colletOffset]]>
</Line>
<Line Number="19">
<![CDATA[	- colletOffsetAdditonal]]>
</Line>
<Line Number="20">
<![CDATA[	- 30.0;						// safety distance; or positionOffset]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[isSafeForTransfer := ]]>
</Line>
<Line Number="23">
<![CDATA[	axis.currentPosition - 0.15 < positionRetractForNextPipe;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[isReadyToFeed :=]]>
</Line>
<Line Number="26">
<![CDATA[	isColletClamped and]]>
</Line>
<Line Number="27">
<![CDATA[	\Transfer.isOutputClear and]]>
</Line>
<Line Number="28">
<![CDATA[	\Cutter.isColletUnClamped;]]>
</Line>
<Line Number="29">
<![CDATA[	]]>
</Line>
<Line Number="30">
<![CDATA[if isAwaitingHeadHandoff then]]>
</Line>
<Line Number="31">
<![CDATA[    if 	\Heads.h[0].isColletClamped and ]]>
</Line>
<Line Number="32">
<![CDATA[		\ModeAuto.isHeadInitPosition[0] and ]]>
</Line>
<Line Number="33">
<![CDATA[		isColletUnClamped ]]>
</Line>
<Line Number="34">
<![CDATA[	then]]>
</Line>
<Line Number="35">
<![CDATA[        isAwaitingHeadHandoff := 0;]]>
</Line>
<Line Number="36">
<![CDATA[    end_if;]]>
</Line>
<Line Number="37">
<![CDATA[end_if;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[if axis.fault then]]>
</Line>
<Line Number="40">
<![CDATA[	if state <> opErrorState then]]>
</Line>
<Line Number="41">
<![CDATA[		errorState := state;]]>
</Line>
<Line Number="42">
<![CDATA[		state := opErrorState;]]>
</Line>
<Line Number="43">
<![CDATA[	end_if;]]>
</Line>
<Line Number="44">
<![CDATA[end_if;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[currentPosition := axis.currentPosition;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[case state of]]>
</Line>
<Line Number="49">
<![CDATA[	0:]]>
</Line>
<Line Number="50">
<![CDATA[		// param]]>
</Line>
<Line Number="51">
<![CDATA[		positionMid 		:= -925.83;		// absolute positions]]>
</Line>
<Line Number="52">
<![CDATA[		positionMid 		:= -927.47;		// 20251002]]>
</Line>
<Line Number="53">
<![CDATA[		positionFullBack 	:= -1685.0;		// abs]]>
</Line>
<Line Number="54">
<![CDATA[		positionOffset 		:= 100.0;		// relative]]>
</Line>
<Line Number="55">
<![CDATA[		positionBackOffal	:= -700.0;]]>
</Line>
<Line Number="56">
<![CDATA[		]]>
</Line>
<Line Number="57">
<![CDATA[		// setting]]>
</Line>
<Line Number="58">
<![CDATA[		colletOffset 			:= 94.6;	// standard value for default	]]>
</Line>
<Line Number="59">
<![CDATA[		colletOffsetAdditonal 	:= 3.0;		// nominal gap between shoulder and pipe; pipe length variation from measure]]>
</Line>
<Line Number="60">
<![CDATA[		]]>
</Line>
<Line Number="61">
<![CDATA[		]]>
</Line>
<Line Number="62">
<![CDATA[		// some defaults ]]>
</Line>
<Line Number="63">
<![CDATA[		speedRetract		:= 450.0;		// all retract speeds ]]>
</Line>
<Line Number="64">
<![CDATA[		speedToCollet		:= 450.0;		// speed to move to back side of collet w.r.t pipe len]]>
</Line>
<Line Number="65">
<![CDATA[		speedToCollect		:= 100.0;		// speed to move to collet position from retract]]>
</Line>
<Line Number="66">
<![CDATA[		speedToCollect		:= 450.0;		// speed to move to collet position from retract]]>
</Line>
<Line Number="67">
<![CDATA[		speedToCutter		:= 50.0;		// speed to move from backside of collet to blade ]]>
</Line>
<Line Number="68">
<![CDATA[		speedToCutter		:= 100.0;		// speed to move from backside of collet to blade ]]>
</Line>
<Line Number="69">
<![CDATA[											// in case of misaligned grip this is slow]]>
</Line>
<Line Number="70">
<![CDATA[		]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		axis.move 			:= 0;]]>
</Line>
<Line Number="73">
<![CDATA[		axis.accel 			:= 4000.0;//500.0;]]>
</Line>
<Line Number="74">
<![CDATA[		axis.decel 			:= axis.accel;]]>
</Line>
<Line Number="75">
<![CDATA[		axis.jerkPercentage := 100.0;//50.0;]]>
</Line>
<Line Number="76">
<![CDATA[		axis.speed 			:= 25.0;		// default but will be overwritten ]]>
</Line>
<Line Number="77">
<![CDATA[		]]>
</Line>
<Line Number="78">
<![CDATA[		currentCmd		 	:= -1;		]]>
</Line>
<Line Number="79">
<![CDATA[		cmd 				:= -1;]]>
</Line>
<Line Number="80">
<![CDATA[		]]>
</Line>
<Line Number="81">
<![CDATA[		errorState 			:= 0;]]>
</Line>
<Line Number="82">
<![CDATA[		opErrorState		:= 5000;]]>
</Line>
<Line Number="83">
<![CDATA[		]]>
</Line>
<Line Number="84">
<![CDATA[		//message := 'wait for axis ready';]]>
</Line>
<Line Number="85">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
<![CDATA[	10:]]>
</Line>
<Line Number="88">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="89">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="90">
<![CDATA[		else]]>
</Line>
<Line Number="91">
<![CDATA[			// the wait is not an error; ]]>
</Line>
<Line Number="92">
<![CDATA[			// after e-stop released there is indeed a delay]]>
</Line>
<Line Number="93">
<![CDATA[			//errorState := state;]]>
</Line>
<Line Number="94">
<![CDATA[		end_if;]]>
</Line>
<Line Number="95">
<![CDATA[	]]>
</Line>
<Line Number="96">
<![CDATA[	100:]]>
</Line>
<Line Number="97">
<![CDATA[		currentCmd := 0;]]>
</Line>
<Line Number="98">
<![CDATA[		cmd := -1;]]>
</Line>
<Line Number="99">
<![CDATA[		message := 'stopped';]]>
</Line>
<Line Number="100">
<![CDATA[		]]>
</Line>
<Line Number="101">
<![CDATA[		// reset the accel after dump]]>
</Line>
<Line Number="102">
<![CDATA[		axis.accel 			:= 2000.0;//500.0;]]>
</Line>
<Line Number="103">
<![CDATA[		axis.decel 			:= axis.accel;]]>
</Line>
<Line Number="104">
<![CDATA[		axis.jerkPercentage := 100.0;//50.0;]]>
</Line>
<Line Number="105">
<![CDATA[		]]>
</Line>
<Line Number="106">
<![CDATA[		state := 110;]]>
</Line>
<Line Number="107">
<![CDATA[		]]>
</Line>
<Line Number="108">
<![CDATA[	110:]]>
</Line>
<Line Number="109">
<![CDATA[		]]>
</Line>
<Line Number="110">
<![CDATA[		(*]]>
</Line>
<Line Number="111">
<![CDATA[		 cmd_string = {]]>
</Line>
<Line Number="112">
<![CDATA[			 0: "stop",]]>
</Line>
<Line Number="113">
<![CDATA[			 10: "toggle collet",]]>
</Line>
<Line Number="114">
<![CDATA[			 20: "Retract fully back",]]>
</Line>
<Line Number="115">
<![CDATA[			 21: "Retract to safe position",]]>
</Line>
<Line Number="116">
<![CDATA[			 22: "Retract to safe position by pipe length",]]>
</Line>
<Line Number="117">
<![CDATA[			 30: "Move to incoming pipe position",]]>
</Line>
<Line Number="118">
<![CDATA[			 31: "Grip and release transfer",]]>
</Line>
<Line Number="119">
<![CDATA[			 33: "Move incoming pipe, grip release transfer",]]>
</Line>
<Line Number="120">
<![CDATA[			 40: "Disable servo for cut",]]>
</Line>
<Line Number="121">
<![CDATA[			 50: "Advance to next cut",]]>
</Line>
<Line Number="122">
<![CDATA[			 60: "Retract to back offal and release"]]>
</Line>
<Line Number="123">
<![CDATA[    	}]]>
</Line>
<Line Number="124">
<![CDATA[		*)]]>
</Line>
<Line Number="125">
<![CDATA[		]]>
</Line>
<Line Number="126">
<![CDATA[		]]>
</Line>
<Line Number="127">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="128">
<![CDATA[			0: ;]]>
</Line>
<Line Number="129">
<![CDATA[			10:]]>
</Line>
<Line Number="130">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="131">
<![CDATA[			20:	]]>
</Line>
<Line Number="132">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="133">
<![CDATA[			21:]]>
</Line>
<Line Number="134">
<![CDATA[				state := 210; ]]>
</Line>
<Line Number="135">
<![CDATA[			22:]]>
</Line>
<Line Number="136">
<![CDATA[				state := 220;]]>
</Line>
<Line Number="137">
<![CDATA[			30:]]>
</Line>
<Line Number="138">
<![CDATA[				state := 300;]]>
</Line>
<Line Number="139">
<![CDATA[			31:]]>
</Line>
<Line Number="140">
<![CDATA[				state := 400;]]>
</Line>
<Line Number="141">
<![CDATA[			33:]]>
</Line>
<Line Number="142">
<![CDATA[				state := 300;				]]>
</Line>
<Line Number="143">
<![CDATA[			40:]]>
</Line>
<Line Number="144">
<![CDATA[				state := 550;]]>
</Line>
<Line Number="145">
<![CDATA[			50:]]>
</Line>
<Line Number="146">
<![CDATA[				state := 600;]]>
</Line>
<Line Number="147">
<![CDATA[			60:]]>
</Line>
<Line Number="148">
<![CDATA[				state := 700;]]>
</Line>
<Line Number="149">
<![CDATA[		end_case;]]>
</Line>
<Line Number="150">
<![CDATA[		]]>
</Line>
<Line Number="151">
<![CDATA[		case cmd of ]]>
</Line>
<Line Number="152">
<![CDATA[			-1, 0, 10, 31, 40:]]>
</Line>
<Line Number="153">
<![CDATA[				;]]>
</Line>
<Line Number="154">
<![CDATA[			else]]>
</Line>
<Line Number="155">
<![CDATA[				axis.disable := 0;]]>
</Line>
<Line Number="156">
<![CDATA[		end_case;]]>
</Line>
<Line Number="157">
<![CDATA[		]]>
</Line>
<Line Number="158">
<![CDATA[		// state changed ]]>
</Line>
<Line Number="159">
<![CDATA[		if stateLast <> state then]]>
</Line>
<Line Number="160">
<![CDATA[			JSR(CutInFeedEvent);]]>
</Line>
<Line Number="161">
<![CDATA[			currentCmd := cmd;]]>
</Line>
<Line Number="162">
<![CDATA[		end_if;]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[	150:]]>
</Line>
<Line Number="165">
<![CDATA[		case currentCmd of]]>
</Line>
<Line Number="166">
<![CDATA[			10:]]>
</Line>
<Line Number="167">
<![CDATA[				if isColletClamped then]]>
</Line>
<Line Number="168">
<![CDATA[					colletUnClamp := 1;]]>
</Line>
<Line Number="169">
<![CDATA[					colletClamp := 0;]]>
</Line>
<Line Number="170">
<![CDATA[					currentCmd := 11;]]>
</Line>
<Line Number="171">
<![CDATA[				elsif isColletUnClamped then]]>
</Line>
<Line Number="172">
<![CDATA[					colletClamp := 1;]]>
</Line>
<Line Number="173">
<![CDATA[					colletUnClamp := 0;]]>
</Line>
<Line Number="174">
<![CDATA[					currentCmd := 12;]]>
</Line>
<Line Number="175">
<![CDATA[				else]]>
</Line>
<Line Number="176">
<![CDATA[					colletUnClamp := 1;]]>
</Line>
<Line Number="177">
<![CDATA[					colletClamp := 0;]]>
</Line>
<Line Number="178">
<![CDATA[					currentCmd := 11;]]>
</Line>
<Line Number="179">
<![CDATA[				end_if;]]>
</Line>
<Line Number="180">
<![CDATA[				// This was 2000, but the same cylinders]]>
</Line>
<Line Number="181">
<![CDATA[				// on the heads are 1250]]>
</Line>
<Line Number="182">
<![CDATA[				TimerStart(tS, timer, 1500); ]]>
</Line>
<Line Number="183">
<![CDATA[				TONR(timer);]]>
</Line>
<Line Number="184">
<![CDATA[			11:]]>
</Line>
<Line Number="185">
<![CDATA[				if isColletUnClamped then]]>
</Line>
<Line Number="186">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="187">
<![CDATA[				end_if;]]>
</Line>
<Line Number="188">
<![CDATA[			12:]]>
</Line>
<Line Number="189">
<![CDATA[				if isColletClamped then]]>
</Line>
<Line Number="190">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="191">
<![CDATA[				end_if;]]>
</Line>
<Line Number="192">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="193">
<![CDATA[		]]>
</Line>
<Line Number="194">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="195">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="196">
<![CDATA[		end_if;]]>
</Line>
<Line Number="197">
<![CDATA[]]>
</Line>
<Line Number="198">
<![CDATA[]]>
</Line>
<Line Number="199">
<![CDATA[#region move back for loading	]]>
</Line>
<Line Number="200">
<![CDATA[	200:]]>
</Line>
<Line Number="201">
<![CDATA[		// full back position set]]>
</Line>
<Line Number="202">
<![CDATA[		positionNext := positionFullBack;]]>
</Line>
<Line Number="203">
<![CDATA[		message := 'move to full back position';]]>
</Line>
<Line Number="204">
<![CDATA[		state := 250; //300;]]>
</Line>
<Line Number="205">
<![CDATA[		]]>
</Line>
<Line Number="206">
<![CDATA[	210:]]>
</Line>
<Line Number="207">
<![CDATA[		message := 'move to safe back position';]]>
</Line>
<Line Number="208">
<![CDATA[		// calc]]>
</Line>
<Line Number="209">
<![CDATA[		// the mid position back half a length and 100mm clearance.]]>
</Line>
<Line Number="210">
<![CDATA[		positionNext := ]]>
</Line>
<Line Number="211">
<![CDATA[			positionMid -]]>
</Line>
<Line Number="212">
<![CDATA[			600 -				// half the longest part]]>
</Line>
<Line Number="213">
<![CDATA[			positionOffset;]]>
</Line>
<Line Number="214">
<![CDATA[		]]>
</Line>
<Line Number="215">
<![CDATA[		state := 250; //300;]]>
</Line>
<Line Number="216">
<![CDATA[	]]>
</Line>
<Line Number="217">
<![CDATA[	220:]]>
</Line>
<Line Number="218">
<![CDATA[		message := 'move to clear of incoming pipe position';]]>
</Line>
<Line Number="219">
<![CDATA[		]]>
</Line>
<Line Number="220">
<![CDATA[		// cut plan is generated here to be sure of the position]]>
</Line>
<Line Number="221">
<![CDATA[		// that we need to move to....]]>
</Line>
<Line Number="222">
<![CDATA[		// but it is not actually used; leaving it here.]]>
</Line>
<Line Number="223">
<![CDATA[		JSR(CalcCutPlan);]]>
</Line>
<Line Number="224">
<![CDATA[		]]>
</Line>
<Line Number="225">
<![CDATA[		// positionRetractForNextPipe next takes the transfer length]]>
</Line>
<Line Number="226">
<![CDATA[		positionNext := positionRetractForNextPipe;]]>
</Line>
<Line Number="227">
<![CDATA[		]]>
</Line>
<Line Number="228">
<![CDATA[		// crude check]]>
</Line>
<Line Number="229">
<![CDATA[		if positionNext < axis.limitMinus then]]>
</Line>
<Line Number="230">
<![CDATA[			positionNext := axis.limitMinus + 0.5;]]>
</Line>
<Line Number="231">
<![CDATA[		end_if;]]>
</Line>
<Line Number="232">
<![CDATA[		]]>
</Line>
<Line Number="233">
<![CDATA[		state := 250;]]>
</Line>
<Line Number="234">
<![CDATA[	]]>
</Line>
<Line Number="235">
<![CDATA[	250:]]>
</Line>
<Line Number="236">
<![CDATA[		// unclamp collet if not done]]>
</Line>
<Line Number="237">
<![CDATA[		colletUnClamp := not isColletUnClamped;]]>
</Line>
<Line Number="238">
<![CDATA[		]]>
</Line>
<Line Number="239">
<![CDATA[		axis.speed := speedRetract;]]>
</Line>
<Line Number="240">
<![CDATA[		]]>
</Line>
<Line Number="241">
<![CDATA[		state := 260;]]>
</Line>
<Line Number="242">
<![CDATA[	260:]]>
</Line>
<Line Number="243">
<![CDATA[		// move to abs		]]>
</Line>
<Line Number="244">
<![CDATA[		axis.move := 1;]]>
</Line>
<Line Number="245">
<![CDATA[		axis.position := positionNext;]]>
</Line>
<Line Number="246">
<![CDATA[		state := 270;]]>
</Line>
<Line Number="247">
<![CDATA[]]>
</Line>
<Line Number="248">
<![CDATA[	/// common wait state for all retract moves -- except dump back]]>
</Line>
<Line Number="249">
<![CDATA[	// offal]]>
</Line>
<Line Number="250">
<![CDATA[	270:]]>
</Line>
<Line Number="251">
<![CDATA[		]]>
</Line>
<Line Number="252">
<![CDATA[		if isColletUnClamped or not axis.move then]]>
</Line>
<Line Number="253">
<![CDATA[			cutCounter 				:= -1;]]>
</Line>
<Line Number="254">
<![CDATA[			isWaitForCut 			:= 0;]]>
</Line>
<Line Number="255">
<![CDATA[			isAwaitingHeadHandoff 	:= 0;]]>
</Line>
<Line Number="256">
<![CDATA[		end_if;]]>
</Line>
<Line Number="257">
<![CDATA[		]]>
</Line>
<Line Number="258">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="259">
<![CDATA[			// the move is finished -- the next steps are defined here.]]>
</Line>
<Line Number="260">
<![CDATA[			message := 'moved clear';]]>
</Line>
<Line Number="261">
<![CDATA[			]]>
</Line>
<Line Number="262">
<![CDATA[			// ]]>
</Line>
<Line Number="263">
<![CDATA[			isFrontOffal 			:= 1;		// should still be 1 as the first ]]>
</Line>
<Line Number="264">
<![CDATA[												// head will need to be clear]]>
</Line>
<Line Number="265">
<![CDATA[			]]>
</Line>
<Line Number="266">
<![CDATA[			// in theory we can check the cutPlanParam flag]]>
</Line>
<Line Number="267">
<![CDATA[			if \Settings.cellProgram.cutPlanParam.allowFront then]]>
</Line>
<Line Number="268">
<![CDATA[				;]]>
</Line>
<Line Number="269">
<![CDATA[			end_if;]]>
</Line>
<Line Number="270">
<![CDATA[			]]>
</Line>
<Line Number="271">
<![CDATA[			// or do this and]]>
</Line>
<Line Number="272">
<![CDATA[			if cutPlan.frontOffalLength = 0.0 then]]>
</Line>
<Line Number="273">
<![CDATA[				isFrontOffal := 0;]]>
</Line>
<Line Number="274">
<![CDATA[			end_if;]]>
</Line>
<Line Number="275">
<![CDATA[			]]>
</Line>
<Line Number="276">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="277">
<![CDATA[		end_if;]]>
</Line>
<Line Number="278">
<![CDATA[		]]>
</Line>
<Line Number="279">
<![CDATA[#endregion]]>
</Line>
<Line Number="280">
<![CDATA[]]>
</Line>
<Line Number="281">
<![CDATA[#region move to clamp]]>
</Line>
<Line Number="282">
<![CDATA[]]>
</Line>
<Line Number="283">
<![CDATA[	/// move to incoming pipe position]]>
</Line>
<Line Number="284">
<![CDATA[	300:]]>
</Line>
<Line Number="285">
<![CDATA[		message := 'Move to incmoming pipe position';]]>
</Line>
<Line Number="286">
<![CDATA[		cutCounter := -1;]]>
</Line>
<Line Number="287">
<![CDATA[		]]>
</Line>
<Line Number="288">
<![CDATA[		if not isColletUnClamped then]]>
</Line>
<Line Number="289">
<![CDATA[			colletUnClamp := 1;]]>
</Line>
<Line Number="290">
<![CDATA[		end_if;]]>
</Line>
<Line Number="291">
<![CDATA[		]]>
</Line>
<Line Number="292">
<![CDATA[		state := 305;]]>
</Line>
<Line Number="293">
<![CDATA[		]]>
</Line>
<Line Number="294">
<![CDATA[	305:]]>
</Line>
<Line Number="295">
<![CDATA[		if isColletUnClamped and \Transfer.isReadyForUnload then]]>
</Line>
<Line Number="296">
<![CDATA[			// The part is transferred, make the cutPlan]]>
</Line>
<Line Number="297">
<![CDATA[			JSR(CalcCutPlan);]]>
</Line>
<Line Number="298">
<![CDATA[			state := 310;]]>
</Line>
<Line Number="299">
<![CDATA[		end_if;]]>
</Line>
<Line Number="300">
<![CDATA[		]]>
</Line>
<Line Number="301">
<![CDATA[	310:]]>
</Line>
<Line Number="302">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="303">
<![CDATA[			/// length is updated from transferred part]]>
</Line>
<Line Number="304">
<![CDATA[			positionNext := positionTransferUnload;]]>
</Line>
<Line Number="305">
<![CDATA[			]]>
</Line>
<Line Number="306">
<![CDATA[			axis.speed 		:= speedToCollect;]]>
</Line>
<Line Number="307">
<![CDATA[			axis.position 	:= positionNext;]]>
</Line>
<Line Number="308">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="309">
<![CDATA[			]]>
</Line>
<Line Number="310">
<![CDATA[			state := 320;]]>
</Line>
<Line Number="311">
<![CDATA[		else]]>
</Line>
<Line Number="312">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="313">
<![CDATA[			message := 'Infeed axis not ready';]]>
</Line>
<Line Number="314">
<![CDATA[		end_if;]]>
</Line>
<Line Number="315">
<![CDATA[		]]>
</Line>
<Line Number="316">
<![CDATA[	320:]]>
</Line>
<Line Number="317">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="318">
<![CDATA[			message := 'move done';]]>
</Line>
<Line Number="319">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="320">
<![CDATA[			]]>
</Line>
<Line Number="321">
<![CDATA[			// continue to grip and release transfer]]>
</Line>
<Line Number="322">
<![CDATA[			if cmd = 33 then]]>
</Line>
<Line Number="323">
<![CDATA[				state := 400;]]>
</Line>
<Line Number="324">
<![CDATA[			end_if;]]>
</Line>
<Line Number="325">
<![CDATA[		end_if;]]>
</Line>
<Line Number="326">
<![CDATA[]]>
</Line>
<Line Number="327">
<![CDATA[	/// grip and release transfer]]>
</Line>
<Line Number="328">
<![CDATA[	400:]]>
</Line>
<Line Number="329">
<![CDATA[		if \Transfer.isReadyForUnload then 	// should be]]>
</Line>
<Line Number="330">
<![CDATA[			colletClampCount := 0;			]]>
</Line>
<Line Number="331">
<![CDATA[			state := 410;]]>
</Line>
<Line Number="332">
<![CDATA[		end_if;]]>
</Line>
<Line Number="333">
<![CDATA[	]]>
</Line>
<Line Number="334">
<![CDATA[	/// multi clamp cycle to remove dent]]>
</Line>
<Line Number="335">
<![CDATA[	// jump back and unclamp]]>
</Line>
<Line Number="336">
<![CDATA[	405:]]>
</Line>
<Line Number="337">
<![CDATA[		if isColletUnClamped then]]>
</Line>
<Line Number="338">
<![CDATA[			state := 410;]]>
</Line>
<Line Number="339">
<![CDATA[		else]]>
</Line>
<Line Number="340">
<![CDATA[			colletUnClamp := 1;]]>
</Line>
<Line Number="341">
<![CDATA[		end_if;]]>
</Line>
<Line Number="342">
<![CDATA[]]>
</Line>
<Line Number="343">
<![CDATA[	// clamp]]>
</Line>
<Line Number="344">
<![CDATA[	410:]]>
</Line>
<Line Number="345">
<![CDATA[		colletClamp := 1;		]]>
</Line>
<Line Number="346">
<![CDATA[		state := 415;]]>
</Line>
<Line Number="347">
<![CDATA[		]]>
</Line>
<Line Number="348">
<![CDATA[	415:]]>
</Line>
<Line Number="349">
<![CDATA[		if isColletClamped then]]>
</Line>
<Line Number="350">
<![CDATA[			colletClampCount := colletClampCount + 1;]]>
</Line>
<Line Number="351">
<![CDATA[			if colletClampCount >= 2 then				]]>
</Line>
<Line Number="352">
<![CDATA[				state := 420; ]]>
</Line>
<Line Number="353">
<![CDATA[			else]]>
</Line>
<Line Number="354">
<![CDATA[				state := 405;]]>
</Line>
<Line Number="355">
<![CDATA[			end_if;]]>
</Line>
<Line Number="356">
<![CDATA[		end_if;]]>
</Line>
<Line Number="357">
<![CDATA[		]]>
</Line>
<Line Number="358">
<![CDATA[	420:		]]>
</Line>
<Line Number="359">
<![CDATA[		if \Transfer.currentCmd = 0 then			]]>
</Line>
<Line Number="360">
<![CDATA[			// this starts the transfer move to home]]>
</Line>
<Line Number="361">
<![CDATA[			// should be the same in the Servo version]]>
</Line>
<Line Number="362">
<![CDATA[			\Transfer.cmd := 25;			// goto home]]>
</Line>
<Line Number="363">
<![CDATA[			]]>
</Line>
<Line Number="364">
<![CDATA[			\PartPresent.transfer := 0;]]>
</Line>
<Line Number="365">
<![CDATA[			\PartPresent.infeed := 1;]]>
</Line>
<Line Number="366">
<![CDATA[			]]>
</Line>
<Line Number="367">
<![CDATA[			state := 425;]]>
</Line>
<Line Number="368">
<![CDATA[		end_if;]]>
</Line>
<Line Number="369">
<![CDATA[		]]>
</Line>
<Line Number="370">
<![CDATA[	425:]]>
</Line>
<Line Number="371">
<![CDATA[		message := 'wait for transfer clear';]]>
</Line>
<Line Number="372">
<![CDATA[		state := 430;]]>
</Line>
<Line Number="373">
<![CDATA[	]]>
</Line>
<Line Number="374">
<![CDATA[	/// wait for transfer to be clear.]]>
</Line>
<Line Number="375">
<![CDATA[	430:]]>
</Line>
<Line Number="376">
<![CDATA[		// clear when xIn is beyond xWait position]]>
</Line>
<Line Number="377">
<![CDATA[		if \Transfer.isOutputClear then]]>
</Line>
<Line Number="378">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="379">
<![CDATA[		end_if;]]>
</Line>
<Line Number="380">
<![CDATA[]]>
</Line>
<Line Number="381">
<![CDATA[#endregion]]>
</Line>
<Line Number="382">
<![CDATA[]]>
</Line>
<Line Number="383">
<![CDATA[//// disable servo before cut	]]>
</Line>
<Line Number="384">
<![CDATA[	550:]]>
</Line>
<Line Number="385">
<![CDATA[		if axis.state = 200 or axis.disable then]]>
</Line>
<Line Number="386">
<![CDATA[			axis.disable := 1;]]>
</Line>
<Line Number="387">
<![CDATA[			positionBeforeCut := axis.currentPosition;]]>
</Line>
<Line Number="388">
<![CDATA[			state := 560;]]>
</Line>
<Line Number="389">
<![CDATA[		end_if;]]>
</Line>
<Line Number="390">
<![CDATA[		]]>
</Line>
<Line Number="391">
<![CDATA[	560:]]>
</Line>
<Line Number="392">
<![CDATA[		if axis.cipAxisState = 2 then]]>
</Line>
<Line Number="393">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="394">
<![CDATA[		end_if;]]>
</Line>
<Line Number="395">
<![CDATA[		]]>
</Line>
<Line Number="396">
<![CDATA[]]>
</Line>
<Line Number="397">
<![CDATA[#region cut loop		]]>
</Line>
<Line Number="398">
<![CDATA[///// Next Cut		]]>
</Line>
<Line Number="399">
<![CDATA[	600:]]>
</Line>
<Line Number="400">
<![CDATA[		message := 'wait/check for transfer to input side';]]>
</Line>
<Line Number="401">
<![CDATA[		state := 605;]]>
</Line>
<Line Number="402">
<![CDATA[		]]>
</Line>
<Line Number="403">
<![CDATA[	605:]]>
</Line>
<Line Number="404">
<![CDATA[		//if \Transfer.isLimitToInput then]]>
</Line>
<Line Number="405">
<![CDATA[		if \Transfer.isOutputClear then]]>
</Line>
<Line Number="406">
<![CDATA[			message := 'wait for transfer to input side';]]>
</Line>
<Line Number="407">
<![CDATA[			state := 610;]]>
</Line>
<Line Number="408">
<![CDATA[		end_if;]]>
</Line>
<Line Number="409">
<![CDATA[		]]>
</Line>
<Line Number="410">
<![CDATA[		// TODO:]]>
</Line>
<Line Number="411">
<![CDATA[		// similarly the transfer should be clear on it's x axis position]]>
</Line>
<Line Number="412">
<![CDATA[	]]>
</Line>
<Line Number="413">
<![CDATA[	610:]]>
</Line>
<Line Number="414">
<![CDATA[		]]>
</Line>
<Line Number="415">
<![CDATA[		// TODO: if allowFront is enabled then the first offal cut]]>
</Line>
<Line Number="416">
<![CDATA[		// is elminated and we go straight to main cutting]]>
</Line>
<Line Number="417">
<![CDATA[		// in CutPlan we don't store the result other than the frontOffalLength]]>
</Line>
<Line Number="418">
<![CDATA[		if cutPlan.frontOffalLength = 0.0 then]]>
</Line>
<Line Number="419">
<![CDATA[			// skip the front offal ]]>
</Line>
<Line Number="420">
<![CDATA[			// TODO: we could make an additional check that]]>
</Line>
<Line Number="421">
<![CDATA[			// front offal length is more than min.]]>
</Line>
<Line Number="422">
<![CDATA[			]]>
</Line>
<Line Number="423">
<![CDATA[			// in the case we don't want to remove front as offal]]>
</Line>
<Line Number="424">
<![CDATA[			if cutCounter = -1 then]]>
</Line>
<Line Number="425">
<![CDATA[				cutCounter := 0;]]>
</Line>
<Line Number="426">
<![CDATA[			end_if;]]>
</Line>
<Line Number="427">
<![CDATA[		end_if;]]>
</Line>
<Line Number="428">
<![CDATA[		]]>
</Line>
<Line Number="429">
<![CDATA[		// calculate this every entry]]>
</Line>
<Line Number="430">
<![CDATA[		positionFirst := ]]>
</Line>
<Line Number="431">
<![CDATA[			0.0]]>
</Line>
<Line Number="432">
<![CDATA[			- cutPlan.inputLength]]>
</Line>
<Line Number="433">
<![CDATA[			+ cutPlan.frontOffalLength  //frontOffalLength]]>
</Line>
<Line Number="434">
<![CDATA[			- colletOffset]]>
</Line>
<Line Number="435">
<![CDATA[			- colletOffsetAdditonal;]]>
</Line>
<Line Number="436">
<![CDATA[		]]>
</Line>
<Line Number="437">
<![CDATA[		// calc next cut position]]>
</Line>
<Line Number="438">
<![CDATA[		case cutCounter of]]>
</Line>
<Line Number="439">
<![CDATA[			-1:]]>
</Line>
<Line Number="440">
<![CDATA[				// must move to remove front offal]]>
</Line>
<Line Number="441">
<![CDATA[				positionNext := positionFirst;]]>
</Line>
<Line Number="442">
<![CDATA[				]]>
</Line>
<Line Number="443">
<![CDATA[			else]]>
</Line>
<Line Number="444">
<![CDATA[				/// next position calculated	]]>
</Line>
<Line Number="445">
<![CDATA[				positionNext :=]]>
</Line>
<Line Number="446">
<![CDATA[					positionFirst +]]>
</Line>
<Line Number="447">
<![CDATA[					(cutPlan.outputLength * (cutCounter + 1));	// this is to account for deviation]]>
</Line>
<Line Number="448">
<![CDATA[					//(\Settings.cellProgram.outPart.length * (cutCounter + 1));]]>
</Line>
<Line Number="449">
<![CDATA[					]]>
</Line>
<Line Number="450">
<![CDATA[		end_case;]]>
</Line>
<Line Number="451">
<![CDATA[		]]>
</Line>
<Line Number="452">
<![CDATA[		state := 615;]]>
</Line>
<Line Number="453">
<![CDATA[		]]>
</Line>
<Line Number="454">
<![CDATA[		if cutCounter >= cutPlan.numParts then]]>
</Line>
<Line Number="455">
<![CDATA[			message := 'cutinfeed - note tried to move beyond numParts';]]>
</Line>
<Line Number="456">
<![CDATA[			\Event.message := message;]]>
</Line>
<Line Number="457">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="458">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="459">
<![CDATA[		end_if;]]>
</Line>
<Line Number="460">
<![CDATA[	]]>
</Line>
<Line Number="461">
<![CDATA[	615:]]>
</Line>
<Line Number="462">
<![CDATA[		message := 'wait cutter ready for feed';]]>
</Line>
<Line Number="463">
<![CDATA[		state := 620;]]>
</Line>
<Line Number="464">
<![CDATA[		]]>
</Line>
<Line Number="465">
<![CDATA[	620:]]>
</Line>
<Line Number="466">
<![CDATA[		// Check cutter is open		]]>
</Line>
<Line Number="467">
<![CDATA[		// check cutter blades are retracted]]>
</Line>
<Line Number="468">
<![CDATA[		]]>
</Line>
<Line Number="469">
<![CDATA[		if \Cutter.isColletUnClamped and \Cutter.isBladeRetracted then]]>
</Line>
<Line Number="470">
<![CDATA[			state := 630;]]>
</Line>
<Line Number="471">
<![CDATA[		elsif \Cutter.errorState > 0 then]]>
</Line>
<Line Number="472">
<![CDATA[			// error in cutter]]>
</Line>
<Line Number="473">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="474">
<![CDATA[		end_if;]]>
</Line>
<Line Number="475">
<![CDATA[		]]>
</Line>
<Line Number="476">
<![CDATA[	630:]]>
</Line>
<Line Number="477">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="478">
<![CDATA[			axis.position := positionNext;]]>
</Line>
<Line Number="479">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="480">
<![CDATA[			axis.speed := speedToCutter;]]>
</Line>
<Line Number="481">
<![CDATA[			]]>
</Line>
<Line Number="482">
<![CDATA[			message := 'feeding to cut';]]>
</Line>
<Line Number="483">
<![CDATA[			state := 640;]]>
</Line>
<Line Number="484">
<![CDATA[		else]]>
</Line>
<Line Number="485">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="486">
<![CDATA[			message := 'axis not ready';]]>
</Line>
<Line Number="487">
<![CDATA[		end_if;]]>
</Line>
<Line Number="488">
<![CDATA[		]]>
</Line>
<Line Number="489">
<![CDATA[	640:]]>
</Line>
<Line Number="490">
<![CDATA[		// check the current position and request a speed]]>
</Line>
<Line Number="491">
<![CDATA[		// change from the axis. ]]>
</Line>
<Line Number="492">
<![CDATA[		// @450mm/s : 	50mm slow down dist.]]>
</Line>
<Line Number="493">
<![CDATA[		// 				80mm offset from blade to collet		]]>
</Line>
<Line Number="494">
<![CDATA[		]]>
</Line>
<Line Number="495">
<![CDATA[		if (positionFirst - currentPosition) > 130 then]]>
</Line>
<Line Number="496">
<![CDATA[			// fast move to the collet back]]>
</Line>
<Line Number="497">
<![CDATA[			axis.speed := speedToCollet;]]>
</Line>
<Line Number="498">
<![CDATA[		elsif (positionFirst - currentPosition) < 40 then	]]>
</Line>
<Line Number="499">
<![CDATA[			// fast move inside the collet]]>
</Line>
<Line Number="500">
<![CDATA[			axis.speed := speedToCollet;]]>
</Line>
<Line Number="501">
<![CDATA[		else]]>
</Line>
<Line Number="502">
<![CDATA[			axis.speed := 25.0;]]>
</Line>
<Line Number="503">
<![CDATA[		end_if;]]>
</Line>
<Line Number="504">
<![CDATA[		]]>
</Line>
<Line Number="505">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="506">
<![CDATA[			state := 650;]]>
</Line>
<Line Number="507">
<![CDATA[		end_if;]]>
</Line>
<Line Number="508">
<![CDATA[		]]>
</Line>
<Line Number="509">
<![CDATA[	650:]]>
</Line>
<Line Number="510">
<![CDATA[		// feed is complete]]>
</Line>
<Line Number="511">
<![CDATA[		]]>
</Line>
<Line Number="512">
<![CDATA[		// ready for the cutter]]>
</Line>
<Line Number="513">
<![CDATA[		isWaitForCut := 1;]]>
</Line>
<Line Number="514">
<![CDATA[		]]>
</Line>
<Line Number="515">
<![CDATA[		// we are not waiting for a cut if there is no backOffal]]>
</Line>
<Line Number="516">
<![CDATA[		if cutPlan.backOffalLength = 0.0 then]]>
</Line>
<Line Number="517">
<![CDATA[			if cutCounter >= cutPlan.numParts then]]>
</Line>
<Line Number="518">
<![CDATA[				isWaitForCut := 0; ]]>
</Line>
<Line Number="519">
<![CDATA[			end_if;]]>
</Line>
<Line Number="520">
<![CDATA[		end_if;]]>
</Line>
<Line Number="521">
<![CDATA[		]]>
</Line>
<Line Number="522">
<![CDATA[		isFrontOffal := (cutCounter = -1);]]>
</Line>
<Line Number="523">
<![CDATA[		isAwaitingHeadHandoff := not isFrontOffal;]]>
</Line>
<Line Number="524">
<![CDATA[		]]>
</Line>
<Line Number="525">
<![CDATA[		cutCounter := cutCounter + 1;]]>
</Line>
<Line Number="526">
<![CDATA[		]]>
</Line>
<Line Number="527">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="528">
<![CDATA[]]>
</Line>
<Line Number="529">
<![CDATA[#endregion]]>
</Line>
<Line Number="530">
<![CDATA[]]>
</Line>
<Line Number="531">
<![CDATA[#region drop back offal]]>
</Line>
<Line Number="532">
<![CDATA[]]>
</Line>
<Line Number="533">
<![CDATA[	/// reverse back from cutter and drop to output]]>
</Line>
<Line Number="534">
<![CDATA[	700:]]>
</Line>
<Line Number="535">
<![CDATA[		message := 'wait for unclamp collet on cutter';]]>
</Line>
<Line Number="536">
<![CDATA[		]]>
</Line>
<Line Number="537">
<![CDATA[		if \Cutter.currentCmd = 0 then]]>
</Line>
<Line Number="538">
<![CDATA[			\Cutter.cmd := 11; 	//unclamp collet]]>
</Line>
<Line Number="539">
<![CDATA[			state := 705;]]>
</Line>
<Line Number="540">
<![CDATA[		end_if;]]>
</Line>
<Line Number="541">
<![CDATA[	705:]]>
</Line>
<Line Number="542">
<![CDATA[		if \Cutter.currentCmd = 0 then			]]>
</Line>
<Line Number="543">
<![CDATA[			if \Cutter.isColletUnClamped then]]>
</Line>
<Line Number="544">
<![CDATA[				state := 710;]]>
</Line>
<Line Number="545">
<![CDATA[			end_if;]]>
</Line>
<Line Number="546">
<![CDATA[		end_if;]]>
</Line>
<Line Number="547">
<![CDATA[		]]>
</Line>
<Line Number="548">
<![CDATA[	710:]]>
</Line>
<Line Number="549">
<![CDATA[		positionNext := positionBackOffal;]]>
</Line>
<Line Number="550">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="551">
<![CDATA[			message := 'move to back dump position';]]>
</Line>
<Line Number="552">
<![CDATA[			axis.position := positionNext;]]>
</Line>
<Line Number="553">
<![CDATA[			axis.speed := speedRetract;]]>
</Line>
<Line Number="554">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="555">
<![CDATA[			state := 720;]]>
</Line>
<Line Number="556">
<![CDATA[		else]]>
</Line>
<Line Number="557">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="558">
<![CDATA[			message := 'axis not ready for move to dump';]]>
</Line>
<Line Number="559">
<![CDATA[		end_if;]]>
</Line>
<Line Number="560">
<![CDATA[		]]>
</Line>
<Line Number="561">
<![CDATA[	720:]]>
</Line>
<Line Number="562">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="563">
<![CDATA[			colletUnClamp := 1;]]>
</Line>
<Line Number="564">
<![CDATA[			state := 730;]]>
</Line>
<Line Number="565">
<![CDATA[		end_if;]]>
</Line>
<Line Number="566">
<![CDATA[		]]>
</Line>
<Line Number="567">
<![CDATA[	730:]]>
</Line>
<Line Number="568">
<![CDATA[		if isColletUnClamped then]]>
</Line>
<Line Number="569">
<![CDATA[			]]>
</Line>
<Line Number="570">
<![CDATA[			backDumpCount := 3;]]>
</Line>
<Line Number="571">
<![CDATA[			//backDumpCount := 1;]]>
</Line>
<Line Number="572">
<![CDATA[			]]>
</Line>
<Line Number="573">
<![CDATA[			if cutPlan.backOffalLength > 50 then]]>
</Line>
<Line Number="574">
<![CDATA[				state := 770;]]>
</Line>
<Line Number="575">
<![CDATA[			else]]>
</Line>
<Line Number="576">
<![CDATA[				state := 740;]]>
</Line>
<Line Number="577">
<![CDATA[			end_if;]]>
</Line>
<Line Number="578">
<![CDATA[		end_if;]]>
</Line>
<Line Number="579">
<![CDATA[		]]>
</Line>
<Line Number="580">
<![CDATA[		// start back dump]]>
</Line>
<Line Number="581">
<![CDATA[	740:]]>
</Line>
<Line Number="582">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="583">
<![CDATA[			positionNext := positionBackOffal - 25;]]>
</Line>
<Line Number="584">
<![CDATA[			axis.speed 	:= 900;]]>
</Line>
<Line Number="585">
<![CDATA[			axis.accel 	:= 8000.0;]]>
</Line>
<Line Number="586">
<![CDATA[			axis.decel 	:= axis.accel;]]>
</Line>
<Line Number="587">
<![CDATA[			axis.jerkPercentage := 100.0;]]>
</Line>
<Line Number="588">
<![CDATA[			axis.position := positionNext;]]>
</Line>
<Line Number="589">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="590">
<![CDATA[			state := 750;]]>
</Line>
<Line Number="591">
<![CDATA[		else]]>
</Line>
<Line Number="592">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="593">
<![CDATA[		end_if;]]>
</Line>
<Line Number="594">
<![CDATA[		]]>
</Line>
<Line Number="595">
<![CDATA[	750:]]>
</Line>
<Line Number="596">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="597">
<![CDATA[			]]>
</Line>
<Line Number="598">
<![CDATA[			positionNext := positionBackOffal;]]>
</Line>
<Line Number="599">
<![CDATA[			axis.position := positionNext;]]>
</Line>
<Line Number="600">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="601">
<![CDATA[			state := 760;]]>
</Line>
<Line Number="602">
<![CDATA[		end_if;]]>
</Line>
<Line Number="603">
<![CDATA[		]]>
</Line>
<Line Number="604">
<![CDATA[	760:]]>
</Line>
<Line Number="605">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="606">
<![CDATA[			backDumpCount := backDumpCount - 1;]]>
</Line>
<Line Number="607">
<![CDATA[			if backDumpCount = 0 then]]>
</Line>
<Line Number="608">
<![CDATA[				state := 770;]]>
</Line>
<Line Number="609">
<![CDATA[			else]]>
</Line>
<Line Number="610">
<![CDATA[				state := 740;]]>
</Line>
<Line Number="611">
<![CDATA[			end_if;]]>
</Line>
<Line Number="612">
<![CDATA[		end_if;]]>
</Line>
<Line Number="613">
<![CDATA[		]]>
</Line>
<Line Number="614">
<![CDATA[	770:]]>
</Line>
<Line Number="615">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="616">
<![CDATA[		]]>
</Line>
<Line Number="617">
<![CDATA[	5000:]]>
</Line>
<Line Number="618">
<![CDATA[		// full reset on clear]]>
</Line>
<Line Number="619">
<![CDATA[		if cmd = 0 then]]>
</Line>
<Line Number="620">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="621">
<![CDATA[		end_if;]]>
</Line>
<Line Number="622">
<![CDATA[		]]>
</Line>
<Line Number="623">
<![CDATA[#endregion]]>
</Line>
<Line Number="624">
<![CDATA[		]]>
</Line>
<Line Number="625">
<![CDATA[end_case;]]>
</Line>
<Line Number="626">
<![CDATA[]]>
</Line>
<Line Number="627">
<![CDATA[if errorState > 0 then]]>
</Line>
<Line Number="628">
<![CDATA[	state := opErrorState;]]>
</Line>
<Line Number="629">
<![CDATA[end_if;]]>
</Line>
<Line Number="630">
<![CDATA[]]>
</Line>
<Line Number="631">
<![CDATA[stateLast := state;]]>
</Line>
<Line Number="632">
<![CDATA[]]>
</Line>
<Line Number="633">
<![CDATA[(*]]>
</Line>
<Line Number="634">
<![CDATA[This code is duplicated in essence in several places and needs factoring]]>
</Line>
<Line Number="635">
<![CDATA[*)]]>
</Line>
<Line Number="636">
<![CDATA[]]>
</Line>
<Line Number="637">
<![CDATA[isColletUndecided := not (isColletClamped or isColletUnClamped);]]>
</Line>
<Line Number="638">
<![CDATA[TONR(cTimer);]]>
</Line>
<Line Number="639">
<![CDATA[]]>
</Line>
<Line Number="640">
<![CDATA[case cState of]]>
</Line>
<Line Number="641">
<![CDATA[	0:]]>
</Line>
<Line Number="642">
<![CDATA[		if isColletUndecided then]]>
</Line>
<Line Number="643">
<![CDATA[			colletUnClamp := 1;]]>
</Line>
<Line Number="644">
<![CDATA[		end_if;]]>
</Line>
<Line Number="645">
<![CDATA[		]]>
</Line>
<Line Number="646">
<![CDATA[		if colletClamp or colletUnClamp then]]>
</Line>
<Line Number="647">
<![CDATA[			isColletClamped 	:= 0;]]>
</Line>
<Line Number="648">
<![CDATA[			isColletUnClamped 	:= 0;]]>
</Line>
<Line Number="649">
<![CDATA[			TimerStart(tS, cTimer, 1250);]]>
</Line>
<Line Number="650">
<![CDATA[			]]>
</Line>
<Line Number="651">
<![CDATA[			cState := 10;]]>
</Line>
<Line Number="652">
<![CDATA[		end_if;]]>
</Line>
<Line Number="653">
<![CDATA[		]]>
</Line>
<Line Number="654">
<![CDATA[	10:]]>
</Line>
<Line Number="655">
<![CDATA[		if cTimer.DN then]]>
</Line>
<Line Number="656">
<![CDATA[			cTimer.Reset := 1;]]>
</Line>
<Line Number="657">
<![CDATA[			cState := 20;]]>
</Line>
<Line Number="658">
<![CDATA[		end_if;]]>
</Line>
<Line Number="659">
<![CDATA[		]]>
</Line>
<Line Number="660">
<![CDATA[	20:]]>
</Line>
<Line Number="661">
<![CDATA[		if colletClamp then]]>
</Line>
<Line Number="662">
<![CDATA[			isColletClamped := 1;]]>
</Line>
<Line Number="663">
<![CDATA[			isColletUnClamped := 0;]]>
</Line>
<Line Number="664">
<![CDATA[		elsif colletUnClamp then]]>
</Line>
<Line Number="665">
<![CDATA[			isColletUnClamped := 1;]]>
</Line>
<Line Number="666">
<![CDATA[			isColletClamped := 0;]]>
</Line>
<Line Number="667">
<![CDATA[		else]]>
</Line>
<Line Number="668">
<![CDATA[			; //wtf]]>
</Line>
<Line Number="669">
<![CDATA[		end_If;]]>
</Line>
<Line Number="670">
<![CDATA[		]]>
</Line>
<Line Number="671">
<![CDATA[		colletClamp := 0;]]>
</Line>
<Line Number="672">
<![CDATA[		colletUnClamp := 0;]]>
</Line>
<Line Number="673">
<![CDATA[		]]>
</Line>
<Line Number="674">
<![CDATA[		cState := 0;]]>
</Line>
<Line Number="675">
<![CDATA[		]]>
</Line>
<Line Number="676">
<![CDATA[end_Case;]]>
</Line>
<Line Number="677">
<![CDATA[]]>
</Line>
