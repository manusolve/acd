</Line>
<Line Number="226">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="227">
<![CDATA[				end_if;]]>
</Line>
<Line Number="228">
<![CDATA[			12:]]>
</Line>
<Line Number="229">
<![CDATA[				if gripper.isOpen then]]>
