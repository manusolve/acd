<Line Number="207">
<![CDATA[#region manual		]]>
</Line>
<Line Number="208">
<![CDATA[	150:]]>
</Line>
<Line Number="209">
<![CDATA[		// test operations]]>
</Line>
<Line Number="210">
<![CDATA[		case currentCmd of]]>
</Line>
<Line Number="211">
<![CDATA[			10:]]>
</Line>
<Line Number="212">
<![CDATA[				if gripper.isOpen then]]>
</Line>
<Line Number="213">
<![CDATA[					currentCmd := 11;]]>
</Line>
<Line Number="214">
<![CDATA[					gripper.close := 1;]]>
</Line>
<Line Number="215">
<![CDATA[					gripper.open := 0;]]>
</Line>
<Line Number="216">
<![CDATA[					message := 'await gripper close';]]>
</Line>
<Line Number="217">
<![CDATA[				elsif gripper.isClosed or gripper.isClosedEmpty then]]>
</Line>
<Line Number="218">
<![CDATA[					currentCmd := 12;]]>
