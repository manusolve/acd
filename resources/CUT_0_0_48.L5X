<Line Number="73">
<![CDATA[			]]>
</Line>
<Line Number="74">
<![CDATA[			hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="75">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="76">
<![CDATA[			]]>
</Line>
<Line Number="77">
<![CDATA[			]]>
</Line>
<Line Number="78">
<![CDATA[		else]]>
</Line>
<Line Number="79">
<![CDATA[			// but we will prefer to put the optimised move see below.]]>
</Line>
<Line Number="80">
<![CDATA[			pos := outputHandoff.position.z + offsetColletPartZ;]]>
</Line>
<Line Number="81">
<![CDATA[		end_if;]]>
</Line>
<Line Number="82">
<![CDATA[		]]>
</Line>
<Line Number="83">
<![CDATA[		// TODO remove this ]]>
</Line>
<Line Number="84">
<![CDATA[		if 0 then]]>
</Line>
<Line Number="85">
<![CDATA[			//// move back to the hand off position]]>
</Line>
<Line Number="86">
<![CDATA[			// this is not optimal but a safe position]]>
</Line>
<Line Number="87">
<![CDATA[			hSequence.ops[index].type := 19;			// retract from forming		]]>
</Line>
<Line Number="88">
<![CDATA[			//pos := outputHandoff.position.z + offsetColletPartZ;]]>
</Line>
<Line Number="89">
<![CDATA[			hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="90">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="91">
<![CDATA[			]]>
</Line>
<Line Number="92">
<![CDATA[			// lower head]]>
</Line>
<Line Number="93">
<![CDATA[			if hProgram.isLift then]]>
</Line>
<Line Number="94">
<![CDATA[				hSequence.ops[index].type := 26;]]>
</Line>
<Line Number="95">
<![CDATA[				index := index + 1;]]>
</Line>
<Line Number="96">
<![CDATA[			end_if;]]>
</Line>
<Line Number="97">
<![CDATA[		end_If;]]>
</Line>
<Line Number="98">
<![CDATA[	end_if;]]>
</Line>
<Line Number="99">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
