<Routines>
<Routine Name="CheckInitPositions" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[isInitPosition := 1;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="4">
<![CDATA[	]]>
</Line>
<Line Number="5">
<![CDATA[	if headEnabled[counter] then]]>
</Line>
<Line Number="6">
<![CDATA[		isHeadInitPosition[counter] := ]]>
</Line>
<Line Number="7">
<![CDATA[			ABS(\Axes.x[counter].currentPosition - \Settings.cycleSequences[counter].ops[0].xPos) < 0.1]]>
</Line>
<Line Number="8">
<![CDATA[			and]]>
</Line>
<Line Number="9">
<![CDATA[			//(\Axes.z[counter].currentPosition - \Settings.cycleSequences[counter].ops[0].zPos) < 0.6;]]>
</Line>
<Line Number="10">
<![CDATA[			ABS(\Axes.z[counter].currentPosition - \Settings.cycleSequences[counter].ops[0].zPos) < 1.5; //!]]>
</Line>
<Line Number="11">
<![CDATA[	else]]>
</Line>
<Line Number="12">
<![CDATA[		isHeadInitPosition[counter] := 1;]]>
</Line>
<Line Number="13">
<![CDATA[	end_if;]]>
</Line>
<Line Number="14">
<![CDATA[	isInitPosition := isInitPosition and isHeadInitPosition[counter];]]>
</Line>
<Line Number="15">
<![CDATA[	]]>
</Line>
<Line Number="16">
<![CDATA[end_for;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="CheckResumePositions" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[isAllHeadsLastPosition := 1;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="4">
<![CDATA[	]]>
</Line>
<Line Number="5">
<![CDATA[	if headEnabled[counter] then]]>
</Line>
<Line Number="6">
<![CDATA[		// lookup last position]]>
</Line>
<Line Number="7">
<![CDATA[		SequenceGetLastPosition(sglp, currentSeqs[counter], runHead[counter].index, resumeLastPosition[counter]);]]>
</Line>
<Line Number="8">
<![CDATA[		]]>
</Line>
<Line Number="9">
<![CDATA[		isHeadLastPosition[counter] := ]]>
</Line>
<Line Number="10">
<![CDATA[		 	ABS(\Axes.x[counter].currentPosition - resumeLastPosition[counter].x) < 0.5]]>
</Line>
<Line Number="11">
<![CDATA[			and]]>
</Line>
<Line Number="12">
<![CDATA[			ABS(\Axes.z[counter].currentPosition - resumeLastPosition[counter].z) < 0.5;]]>
</Line>
<Line Number="13">
<![CDATA[			]]>
</Line>
<Line Number="14">
<![CDATA[		isAllHeadsLastPosition := ]]>
</Line>
<Line Number="15">
<![CDATA[			isAllHeadsLastPosition ]]>
</Line>
<Line Number="16">
<![CDATA[			and ]]>
</Line>
<Line Number="17">
<![CDATA[			isHeadLastPosition[counter];]]>
</Line>
<Line Number="18">
<![CDATA[	end_if;]]>
</Line>
<Line Number="19">
<![CDATA[end_for;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="LogHeadError" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[\Event.source := 1000;]]>
</Line>
<Line Number="1">
<![CDATA[\Event.logLevel := 0;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[\Event.message := 'Error ';]]>
</Line>
<Line Number="4">
<![CDATA[DTOS(runHead[counter].errorState, \Event.tempString);]]>
</Line>
<Line Number="5">
<![CDATA[CONCAT(\Event.message, \Event.tempString, \Event.message);]]>
</Line>
<Line Number="6">
<![CDATA[\Event.tempString := ' in head ';]]>
</Line>
<Line Number="7">
<![CDATA[DTOS(counter, \Event.tempString);]]>
</Line>
<Line Number="8">
<![CDATA[CONCAT(\Event.message, \Event.tempString, \Event.message);]]>
</Line>
<Line Number="9">
<![CDATA[EVENT(LogEvent);]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[/// Run AUTO/PROG mode]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// check if in correct mode]]>
</Line>
<Line Number="4">
<![CDATA[case \MachineMain.modeCurrent of]]>
</Line>
<Line Number="5">
<![CDATA[	0: 		stepMode := 1;	// prog mode]]>
</Line>
<Line Number="6">
<![CDATA[	2:		stepMode := 0; 	// auto mode]]>
</Line>
<Line Number="7">
<![CDATA[	else	message := 'Not in AUTO/PROG mode';]]>
</Line>
<Line Number="8">
<![CDATA[			TND();]]>
</Line>
<Line Number="9">
<![CDATA[end_case;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="12">
<![CDATA[	// capture break in safety for reason of stop]]>
</Line>
<Line Number="13">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	active := 0;]]>
</Line>
<Line Number="15">
<![CDATA[end_if;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="18">
<![CDATA[JSR(CheckInitPositions);		// update init position status]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//// TEST CODE]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[// hard code out heads]]>
</Line>
<Line Number="23">
<![CDATA[headEnabled[0] := 1;]]>
</Line>
<Line Number="24">
<![CDATA[headEnabled[1] := 1;]]>
</Line>
<Line Number="25">
<![CDATA[headEnabled[2] := 1;]]>
</Line>
<Line Number="26">
<![CDATA[headEnabled[3] := 1;]]>
</Line>
<Line Number="27">
<![CDATA[//dryRun := 0;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[// in ModeAuto then prefer to stop at the point where]]>
</Line>
<Line Number="30">
<![CDATA[// all the handoffs have hold of the part; that is after all waiting]]>
</Line>
<Line Number="31">
<![CDATA[// ]]>
</Line>
<Line Number="32">
<![CDATA[(*]]>
</Line>
<Line Number="33">
<![CDATA[if 0 then]]>
</Line>
<Line Number="34">
<![CDATA[	if requestStop then]]>
</Line>
<Line Number="35">
<![CDATA[		stepMode := 1;]]>
</Line>
<Line Number="36">
<![CDATA[	end_if;]]>
</Line>
<Line Number="37">
<![CDATA[	;]]>
</Line>
<Line Number="38">
<![CDATA[end_if;]]>
</Line>
<Line Number="39">
<![CDATA[*)]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[case state of]]>
</Line>
<Line Number="43">
<![CDATA[	0:]]>
</Line>
<Line Number="44">
<![CDATA[		\HMI.clearButtons := 1;]]>
</Line>
<Line Number="45">
<![CDATA[		]]>
</Line>
<Line Number="46">
<![CDATA[		message := '';]]>
</Line>
<Line Number="47">
<![CDATA[		]]>
</Line>
<Line Number="48">
<![CDATA[		// auto/prog init mode]]>
</Line>
<Line Number="49">
<![CDATA[		opErrorState := 5000; 	//error state]]>
</Line>
<Line Number="50">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="51">
<![CDATA[		]]>
</Line>
<Line Number="52">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="53">
<![CDATA[			//]]>
</Line>
<Line Number="54">
<![CDATA[			if dryRun then]]>
</Line>
<Line Number="55">
<![CDATA[				runHead[counter].debugIgnorePartPresent := 1;]]>
</Line>
<Line Number="56">
<![CDATA[			else]]>
</Line>
<Line Number="57">
<![CDATA[				runHead[counter].debugIgnorePartPresent := 0;]]>
</Line>
<Line Number="58">
<![CDATA[			end_if;]]>
</Line>
<Line Number="59">
<![CDATA[			]]>
</Line>
<Line Number="60">
<![CDATA[			// for some reason z axis settles long ]]>
</Line>
<Line Number="61">
<![CDATA[			runHead[counter].positionThreshold := 0.5;]]>
</Line>
<Line Number="62">
<![CDATA[		end_for;]]>
</Line>
<Line Number="63">
<![CDATA[		]]>
</Line>
<Line Number="64">
<![CDATA[		// TODO: remove when we have handoff at final position]]>
</Line>
<Line Number="65">
<![CDATA[		runHead[3].bumpAccel := 60000.0;]]>
</Line>
<Line Number="66">
<![CDATA[		runHead[3].bumpSpeed := 1000.0;]]>
</Line>
<Line Number="67">
<![CDATA[		runHead[3].bumpDistance := 30;]]>
</Line>
<Line Number="68">
<![CDATA[		runHead[3].bumpCount := 4; 			// even to move + (away) first]]>
</Line>
<Line Number="69">
<![CDATA[		]]>
</Line>
<Line Number="70">
<![CDATA[		state := 5;]]>
</Line>
<Line Number="71">
<![CDATA[	5:]]>
</Line>
<Line Number="72">
<![CDATA[		// take a copy for debug purposes]]>
</Line>
<Line Number="73">
<![CDATA[		COP(runHead[0], runHeadPrev[0], 4);			]]>
</Line>
<Line Number="74">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="75">
<![CDATA[		]]>
</Line>
<Line Number="76">
<![CDATA[	10:]]>
</Line>
<Line Number="77">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="78">
<![CDATA[		// precheck]]>
</Line>
<Line Number="79">
<![CDATA[		message := 'Precheck current status';]]>
</Line>
<Line Number="80">
<![CDATA[		]]>
</Line>
<Line Number="81">
<![CDATA[		// check collet clamps -- decided means in known state]]>
</Line>
<Line Number="82">
<![CDATA[		if not \Heads.isClampsDecided then]]>
</Line>
<Line Number="83">
<![CDATA[			message := 'Head collet status mismatch - retract all in MAN mode';]]>
</Line>
<Line Number="84">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="85">
<![CDATA[			state := opErrorState;]]>
</Line>
<Line Number="86">
<![CDATA[		end_if;]]>
</Line>
<Line Number="87">
<![CDATA[		]]>
</Line>
<Line Number="88">
<![CDATA[		]]>
</Line>
<Line Number="89">
<![CDATA[		// check last done status -- that would indicate an E-Stop or sudden stop]]>
</Line>
<Line Number="90">
<![CDATA[		allDoneOnLastRun := 1;]]>
</Line>
<Line Number="91">
<![CDATA[		]]>
</Line>
<Line Number="92">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="93">
<![CDATA[			allDoneOnLastRun := allDoneOnLastRun and runHead[counter].DN;]]>
</Line>
<Line Number="94">
<![CDATA[		end_for;]]>
</Line>
<Line Number="95">
<![CDATA[		]]>
</Line>
<Line Number="96">
<![CDATA[		// set all to done to prevent exec]]>
</Line>
<Line Number="97">
<![CDATA[		// the last index will be kept]]>
</Line>
<Line Number="98">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="99">
<![CDATA[			runHead[counter].DN := 1;]]>
</Line>
<Line Number="100">
<![CDATA[			runHead[counter].stepWait := 0;]]>
</Line>
<Line Number="101">
<![CDATA[		end_for;]]>
</Line>
<Line Number="102">
<![CDATA[		]]>
</Line>
<Line Number="103">
<![CDATA[		headWithError 	:= -1;]]>
</Line>
<Line Number="104">
<![CDATA[		stateStartLast 	:= -1;]]>
</Line>
<Line Number="105">
<![CDATA[		modeSelectLast 	:= -1;]]>
</Line>
<Line Number="106">
<![CDATA[		]]>
</Line>
<Line Number="107">
<![CDATA[		state := 20;]]>
</Line>
<Line Number="108">
<![CDATA[		]]>
</Line>
<Line Number="109">
<![CDATA[	20:]]>
</Line>
<Line Number="110">
<![CDATA[		// program has changed; re-entry]]>
</Line>
<Line Number="111">
<![CDATA[		if \Build.buildSeqs then]]>
</Line>
<Line Number="112">
<![CDATA[			state := 10;]]>
</Line>
<Line Number="113">
<![CDATA[			TND();]]>
</Line>
<Line Number="114">
<![CDATA[		end_if;]]>
</Line>
<Line Number="115">
<![CDATA[		]]>
</Line>
<Line Number="116">
<![CDATA[		stateStart 		:= -1;		]]>
</Line>
<Line Number="117">
<![CDATA[		isPreCheckOK 	:= 1;]]>
</Line>
<Line Number="118">
<![CDATA[		]]>
</Line>
<Line Number="119">
<![CDATA[		if not allDoneOnLastRun then]]>
</Line>
<Line Number="120">
<![CDATA[			// moves remain uncompleted.]]>
</Line>
<Line Number="121">
<![CDATA[			// start init or reset process]]>
</Line>
<Line Number="122">
<![CDATA[			//state := 50;]]>
</Line>
<Line Number="123">
<![CDATA[			;]]>
</Line>
<Line Number="124">
<![CDATA[		end_if;]]>
</Line>
<Line Number="125">
<![CDATA[		]]>
</Line>
<Line Number="126">
<![CDATA[		if allDoneOnLastRun then]]>
</Line>
<Line Number="127">
<![CDATA[			;]]>
</Line>
<Line Number="128">
<![CDATA[		end_if;]]>
</Line>
<Line Number="129">
<![CDATA[	]]>
</Line>
<Line Number="130">
<![CDATA[		// any parts present]]>
</Line>
<Line Number="131">
<![CDATA[		partsPresent := 0;]]>
</Line>
<Line Number="132">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="133">
<![CDATA[			partsPresent := partsPresent or]]>
</Line>
<Line Number="134">
<![CDATA[							\PartPresent.handOff[counter] or ]]>
</Line>
<Line Number="135">
<![CDATA[							\PartPresent.head[counter];]]>
</Line>
<Line Number="136">
<![CDATA[		end_for;]]>
</Line>
<Line Number="137">
<![CDATA[		]]>
</Line>
<Line Number="138">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="139">
<![CDATA[			if \PartPresent.head[counter] and \Heads.h[counter].isColletReleased then]]>
</Line>
<Line Number="140">
<![CDATA[				isPreCheckOK := 0;]]>
</Line>
<Line Number="141">
<![CDATA[				message := 'Head Part Present and collet status mismatch';]]>
</Line>
<Line Number="142">
<![CDATA[			end_if;]]>
</Line>
<Line Number="143">
<![CDATA[		end_for;]]>
</Line>
<Line Number="144">
<![CDATA[		]]>
</Line>
<Line Number="145">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="146">
<![CDATA[			if \Settings.hPrograms[counter].isHead1]]>
</Line>
<Line Number="147">
<![CDATA[				or \Settings.hPrograms[counter].isHead2]]>
</Line>
<Line Number="148">
<![CDATA[			then]]>
</Line>
<Line Number="149">
<![CDATA[				if not \Machine.m[counter].isReady then]]>
</Line>
<Line Number="150">
<![CDATA[					isPreCheckOK := 0;]]>
</Line>
<Line Number="151">
<![CDATA[					message := 'Sizing machine not ready';]]>
</Line>
<Line Number="152">
<![CDATA[				end_if;]]>
</Line>
<Line Number="153">
<![CDATA[			end_if;]]>
</Line>
<Line Number="154">
<![CDATA[		end_for;]]>
</Line>
<Line Number="155">
<![CDATA[		]]>
</Line>
<Line Number="156">
<![CDATA[		if \OutputHandler.isBinsFull then]]>
</Line>
<Line Number="157">
<![CDATA[			isPreCheckOK := 0;]]>
