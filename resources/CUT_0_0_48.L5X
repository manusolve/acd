<DataValueMember Name="state" DataType="INT" Radix="Decimal" Value="0"/>
<StructureMember Name="timer" DataType="FBD_TIMER">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="TimerEnable" DataType="BOOL" Value="1"/>
