<Routines>
<Routine Name="BuildClear" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[index := 0;]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[// do unclamp at end]]>
</Line>
<Line Number="3">
<![CDATA[hSequence.ops[index].type := 21;  		// collet unclamp ]]>
</Line>
<Line Number="4">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[hSequence.ops[index].type := 16;  		// retract]]>
</Line>
<Line Number="7">
<![CDATA[hSequence.ops[index].zPos := 640;		// was 700 lift head 663.5 max]]>
</Line>
<Line Number="8">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[// move to x midposition]]>
</Line>
<Line Number="11">
<![CDATA[case headIndex of]]>
</Line>
<Line Number="12">
<![CDATA[	0:]]>
</Line>
<Line Number="13">
<![CDATA[		hSequence.ops[index].xPos := machine.positions[0].x;]]>
</Line>
<Line Number="14">
<![CDATA[	1..3:]]>
</Line>
<Line Number="15">
<![CDATA[		pos := (outputHandoff.position.x - inputHandoff.position.x) / 2;]]>
</Line>
<Line Number="16">
<![CDATA[		pos := inputHandoff.position.x + pos;]]>
</Line>
<Line Number="17">
<![CDATA[		hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="18">
<![CDATA[end_case;]]>
</Line>
<Line Number="19">
<![CDATA[hSequence.ops[index].type := 12;		// x move to 'input']]>
</Line>
<Line Number="20">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[if hProgram.isLift then]]>
</Line>
<Line Number="23">
<![CDATA[	hSequence.ops[index].type := 26;	// lower head]]>
</Line>
<Line Number="24">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="25">
<![CDATA[end_if;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[hSequence.ops[index].type := 41;  	// output handoff unclamp]]>
</Line>
<Line Number="28">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[hSequence.ops[index].type := 0;		// for safety make the next op null]]>
</Line>
</STContent>
</Routine>
<Routine Name="BuildInit" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[    Creates a sequence that safely moves the head to the initial position]]>
</Line>
<Line Number="3">
<![CDATA[    ready for clamping and starting operations.]]>
</Line>
<Line Number="4">
<![CDATA[	This is the load new program routine]]>
</Line>
<Line Number="5">
<![CDATA[	We assume that there are no parts present on the heads]]>
</Line>
<Line Number="6">
<![CDATA[	or the handoffs]]>
</Line>
<Line Number="7">
<![CDATA[*)]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[// Calculate the Z offset for the collet + part combination]]>
</Line>
<Line Number="10">
<![CDATA[//offsetColletPartZ := hProgram.colletOffset + (mProgram.outPart.length / 2);]]>
</Line>
<Line Number="11">
<![CDATA[offsetColletPartZ := hProgram.colletOffset + (outputPartLength / 2);]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[//// Build Initialization Sequence]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[index := 0;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[// do unclamp at end]]>
</Line>
<Line Number="18">
<![CDATA[hSequence.ops[index].type := 21;  		// collet unclamp ]]>
</Line>
<Line Number="19">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[hSequence.ops[index].type := 16;  		// retract]]>
</Line>
<Line Number="22">
<![CDATA[hSequence.ops[index].zPos := 640;		// was 700 lift head 663.5 max]]>
</Line>
<Line Number="23">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[if hProgram.isLift then]]>
</Line>
<Line Number="26">
<![CDATA[	hSequence.ops[index].type := 26;	// lower head]]>
</Line>
<Line Number="27">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="28">
<![CDATA[end_if;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[// we'll make rotate init take account of if there is a part ]]>
</Line>
<Line Number="31">
<![CDATA[// present and if the rotation needs to be done]]>
</Line>
<Line Number="32">
<![CDATA[hSequence.ops[index].type := 45;  		// output handoff init]]>
</Line>
<Line Number="33">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[///	Wait on all clear]]>
</Line>
<Line Number="36">
<![CDATA[hSequence.ops[index].type := 50;]]>
</Line>
<Line Number="37">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[JSR(GetInitPos);						// Gen positions]]>
</Line>
<Line Number="40">
<![CDATA[hSequence.ops[index].type := 12;  		// X move to input]]>
</Line>
<Line Number="41">
<![CDATA[hSequence.ops[index].zPos := 0.0;		// not needed]]>
</Line>
<Line Number="42">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[if headIndex = 3 then]]>
</Line>
<Line Number="45">
<![CDATA[	// on the last hand off open the grippers]]>
</Line>
<Line Number="46">
<![CDATA[	hSequence.ops[index].type := 41;  	// output handoff unclamp]]>
</Line>
<Line Number="47">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="48">
<![CDATA[end_if;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[JSR(GetInitPos);						// Gen positions]]>
</Line>
<Line Number="51">
<![CDATA[hSequence.ops[index].type := 17;  		// Z to handoff]]>
</Line>
<Line Number="52">
<![CDATA[hSequence.ops[index].xPos := 0.0;		// not needed]]>
</Line>
<Line Number="53">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="BuildSeq" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[(*]]>
</Line>
<Line Number="3">
<![CDATA[version: 1.0.0]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[build the sequence for the head into hSequence]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[sequence of moves from the pickup position and back.]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[requires:]]>
</Line>
<Line Number="10">
<![CDATA[	- HeadProgram]]>
</Line>
<Line Number="11">
<![CDATA[	- MachineProgram]]>
</Line>
<Line Number="12">
<![CDATA[	- Head]]>
</Line>
<Line Number="13">
<![CDATA[	]]>
</Line>
<Line Number="14">
<![CDATA[*)]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[//// Pre calcs]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[//offsetColletPartZ := hProgram.colletOffset + (mProgram.outPart.length / 2);]]>
</Line>
<Line Number="19">
<![CDATA[offsetColletPartZ := hProgram.colletOffset + (outputPartLength / 2);]]>
</Line>
<Line Number="20">
<![CDATA[ ]]>
</Line>
<Line Number="21">
<![CDATA[if outputHandoff.position.z > inputHandoff.position.z then]]>
</Line>
<Line Number="22">
<![CDATA[	positionRetract := outputHandoff.position.z + offsetColletPartZ + 80.0; ]]>
</Line>
<Line Number="23">
<![CDATA[else]]>
</Line>
<Line Number="24">
<![CDATA[	positionRetract := inputHandoff.position.z + offsetColletPartZ + 80.0; ]]>
</Line>
<Line Number="25">
<![CDATA[end_if;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[//// Build Seq.]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[index := 0;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[JSR(GenPreCheck);]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[//hSequence.ops[index].type := 20;			// collet clamp]]>
</Line>
<Line Number="34">
<![CDATA[//index := index + 1;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[case machine.type of]]>
</Line>
<Line Number="38">
<![CDATA[	0:]]>
</Line>
<Line Number="39">
<![CDATA[		// precheck - the collet is in position]]>
</Line>
<Line Number="40">
<![CDATA[		// should be unclamped]]>
</Line>
<Line Number="41">
<![CDATA[		// then wait for feed verified from inputside]]>
</Line>
<Line Number="42">
<![CDATA[		// ]]>
</Line>
<Line Number="43">
<![CDATA[		// wait for cutter to be done]]>
</Line>
<Line Number="44">
<![CDATA[		hSequence.ops[index].type := 7; 	// check/wait for feed]]>
</Line>
<Line Number="45">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="46">
<![CDATA[		hSequence.ops[index].type := 20;	// collet clamp]]>
</Line>
<Line Number="47">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="48">
<![CDATA[		hSequence.ops[index].type := 8; 	// wait for cut]]>
</Line>
<Line Number="49">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="50">
<![CDATA[		]]>
</Line>
<Line Number="51">
<![CDATA[		JSR(GenRetractFromInput);]]>
</Line>
<Line Number="52">
<![CDATA[	else]]>
</Line>
<Line Number="53">
<![CDATA[		hSequence.ops[index].type := 20;		// collet clamp]]>
</Line>
<Line Number="54">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="55">
<![CDATA[		hSequence.ops[index].type := 31;		// input handoff unclamp		]]>
</Line>
<Line Number="56">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[		//JSR(GenRetractFromInput);				// not sure if this was ever needed]]>
</Line>
<Line Number="59">
<![CDATA[		//JSR(GenMachineOps);		// original]]>
</Line>
<Line Number="60">
<![CDATA[		//JSR(GenMachineOpsV2);		// both in and out opt.]]>
</Line>
<Line Number="61">
<![CDATA[		JSR(GenMachineOpsV3);		// feed in only opt.]]>
</Line>
<Line Number="62">
<![CDATA[end_case;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[////]]>
</Line>
<Line Number="65">
<![CDATA[//// move to output hand off moves]]>
</Line>
<Line Number="66">
<![CDATA[////]]>
</Line>
<Line Number="67">
<![CDATA[if 1 then		// use the original version with V1 or V3]]>
</Line>
<Line Number="68">
<![CDATA[	// move to the hand off x position]]>
</Line>
<Line Number="69">
<![CDATA[	hSequence.ops[index].type := 11;				// x move to handoff]]>
</Line>
<Line Number="70">
<![CDATA[	pos := outputHandoff.position.x;]]>
</Line>
<Line Number="71">
<![CDATA[	hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="72">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="73">
<![CDATA[]]>
</Line>
<Line Number="74">
<![CDATA[	// ADDED: move to the hand off z position]]>
</Line>
<Line Number="75">
<![CDATA[	hSequence.ops[index].type := 17;				// z move to handoff]]>
</Line>
<Line Number="76">
<![CDATA[	pos := outputHandoff.position.z;]]>
</Line>
<Line Number="77">
<![CDATA[	pos := pos + offsetColletPartZ;]]>
</Line>
<Line Number="78">
<![CDATA[	pos := pos + hProgram.hoOutputOffset;]]>
</Line>
<Line Number="79">
<![CDATA[	hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="80">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="81">
<![CDATA[else]]>
</Line>
<Line Number="82">
<![CDATA[	// add in new move to output handoff]]>
</Line>
<Line Number="83">
<![CDATA[	hSequence.ops[index].type := 110;]]>
</Line>
<Line Number="84">
<![CDATA[	]]>
</Line>
<Line Number="85">
<![CDATA[	pos := outputHandoff.position.x;]]>
</Line>
<Line Number="86">
<![CDATA[	hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="87">
<![CDATA[	]]>
</Line>
<Line Number="88">
<![CDATA[	pos := outputHandoff.position.z;]]>
</Line>
<Line Number="89">
<![CDATA[	pos := pos + offsetColletPartZ;]]>
</Line>
<Line Number="90">
<![CDATA[	pos := pos + hProgram.hoOutputOffset;]]>
</Line>
<Line Number="91">
<![CDATA[	hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="92">
<![CDATA[	]]>
</Line>
<Line Number="93">
<![CDATA[	pos := machine.positions[0].z;		  // taking the z on the first head]]>
</Line>
<Line Number="94">
<![CDATA[	pos := pos + outputPartLength + 50.0; // as a starting point]]>
</Line>
<Line Number="95">
<![CDATA[	hSequence.ops[index].data := pos;]]>
</Line>
<Line Number="96">
<![CDATA[	]]>
</Line>
<Line Number="97">
<![CDATA[	]]>
</Line>
<Line Number="98">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[	;]]>
</Line>
<Line Number="101">
<![CDATA[end_if;]]>
</Line>
<Line Number="102">
<![CDATA[]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[// for empty gripper at the end]]>
</Line>
<Line Number="105">
<![CDATA[if outputHandoff.type = 0 then					]]>
</Line>
<Line Number="106">
<![CDATA[	hSequence.ops[index].type := 21;			// unclamp collet]]>
</Line>
<Line Number="107">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="108">
<![CDATA[	hSequence.ops[index].type := 42;			// bump remove]]>
</Line>
<Line Number="109">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="110">
<![CDATA[end_if;]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[///	Wait on all clear]]>
</Line>
<Line Number="113">
<![CDATA[// moved to before the clamps are released to avoid collision]]>
</Line>
<Line Number="114">
<![CDATA[hSequence.ops[index].type := 50;]]>
</Line>
<Line Number="115">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="116">
<![CDATA[]]>
</Line>
<Line Number="117">
<![CDATA[/// output handoff clamp]]>
</Line>
<Line Number="118">
<![CDATA[if outputHandoff.type <> 0 then					// drop output handoff]]>
</Line>
<Line Number="119">
<![CDATA[	hSequence.ops[index].type := 40;]]>
</Line>
<Line Number="120">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="121">
<![CDATA[	]]>
</Line>
<Line Number="122">
<![CDATA[	/// release collet]]>
</Line>
<Line Number="123">
<![CDATA[	hSequence.ops[index].type := 21;]]>
</Line>
<Line Number="124">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="125">
<![CDATA[end_if;]]>
</Line>
<Line Number="126">
<![CDATA[]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[]]>
</Line>
<Line Number="129">
<![CDATA[(*]]>
</Line>
<Line Number="130">
<![CDATA[/// move back clear of the handoff]]>
</Line>
<Line Number="131">
<![CDATA[hSequence.ops[index].type := 16;]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[// take the larger of the two positions input and output hand off so there are no z retract ]]>
</Line>
<Line Number="134">
<![CDATA[// problems -- compare outputHandoff.position.zPosition  and inputHandoff.position.zPosition ]]>
</Line>
<Line Number="135">
<![CDATA[// z plus is further back so choose the ]]>
</Line>
<Line Number="136">
<![CDATA[]]>
</Line>
<Line Number="137">
<![CDATA[//pos := head.outputHandoff.position.zPosition + colletPartZOffset + (mProgram.outPart.length / 2);]]>
</Line>
<Line Number="138">
<![CDATA[// 80 is to allow for rotation]]>
</Line>
<Line Number="139">
<![CDATA[if outputHandoff.position.zPosition > inputHandoff.position.zPosition then]]>
</Line>
<Line Number="140">
<![CDATA[	pos := outputHandoff.position.zPosition + offsetColletPartZ + 80.0; ]]>
</Line>
<Line Number="141">
<![CDATA[else]]>
</Line>
<Line Number="142">
<![CDATA[	pos := inputHandoff.position.zPosition + offsetColletPartZ + 80.0; ]]>
</Line>
<Line Number="143">
<![CDATA[end_if;]]>
</Line>
<Line Number="144">
<![CDATA[*)]]>
</Line>
<Line Number="145">
<![CDATA[]]>
</Line>
<Line Number="146">
<![CDATA[// if the output hand off is empty type 0 then need to add in a quick]]>
</Line>
<Line Number="147">
<![CDATA[// bump move z+ to get rid of the part.]]>
</Line>
<Line Number="148">
<![CDATA[(*]]>
</Line>
<Line Number="149">
<![CDATA[if outputHandoff.type = 0 then					// drop output handoff]]>
</Line>
<Line Number="150">
<![CDATA[	hSequence.ops[index].type := 42;]]>
</Line>
<Line Number="151">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="152">
<![CDATA[end_if;]]>
</Line>
<Line Number="153">
<![CDATA[*)]]>
</Line>
<Line Number="154">
<![CDATA[]]>
</Line>
<Line Number="155">
<![CDATA[hSequence.ops[index].type := 16;				// z retract from handoff]]>
</Line>
<Line Number="156">
<![CDATA[pos := positionRetract;]]>
</Line>
<Line Number="157">
<![CDATA[hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="158">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="159">
<![CDATA[]]>
</Line>
<Line Number="160">
<![CDATA[////]]>
</Line>
<Line Number="161">
<![CDATA[//// move back to input handoff]]>
</Line>
<Line Number="162">
<![CDATA[////]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[/// add in drop test]]>
</Line>
<Line Number="165">
<![CDATA[(*]]>
</Line>
<Line Number="166">
<![CDATA[if headIndex = 1 then]]>
</Line>
<Line Number="167">
<![CDATA[	hSequence.ops[index].type := 44;		// drop on return stroke]]>
</Line>
<Line Number="168">
<![CDATA[	// mid position]]>
</Line>
<Line Number="169">
<![CDATA[	pos := (outputHandoff.position.xPosition - inputHandoff.position.xPosition);]]>
</Line>
<Line Number="170">
<![CDATA[	pos := inputHandoff.position.xPosition + (pos / 2.0);]]>
</Line>
<Line Number="171">
<![CDATA[	hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="172">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="173">
<![CDATA[end_if;]]>
</Line>
<Line Number="174">
<![CDATA[*)]]>
</Line>
<Line Number="175">
<![CDATA[]]>
</Line>
<Line Number="176">
<![CDATA[// drop on last handoff]]>
</Line>
<Line Number="177">
<![CDATA[if headIndex = 3 and outputHandoff.type <> 0 then]]>
</Line>
<Line Number="178">
<![CDATA[	hSequence.ops[index].type := 44;		// drop on return stroke]]>
</Line>
<Line Number="179">
<![CDATA[	// mid position]]>
</Line>
<Line Number="180">
<![CDATA[	pos := (outputHandoff.position.x - inputHandoff.position.x);]]>
</Line>
<Line Number="181">
<![CDATA[	pos := inputHandoff.position.x + (pos / 2.0);]]>
</Line>
<Line Number="182">
<![CDATA[	hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="183">
<![CDATA[	index := index + 1;]]>
</Line>
<Line Number="184">
<![CDATA[end_if;]]>
</Line>
<Line Number="185">
<![CDATA[]]>
</Line>
<Line Number="186">
<![CDATA[]]>
</Line>
<Line Number="187">
<![CDATA[/// move to inputhand off x]]>
</Line>
<Line Number="188">
<![CDATA[hSequence.ops[index].type := 12;]]>
</Line>
<Line Number="189">
<![CDATA[case machine.type of]]>
</Line>
<Line Number="190">
<![CDATA[	0:		pos := machine.positions[0].x;]]>
</Line>
<Line Number="191">
<![CDATA[	else	pos := inputHandoff.position.x;]]>
</Line>
<Line Number="192">
<![CDATA[end_case;]]>
</Line>
<Line Number="193">
<![CDATA[]]>
</Line>
<Line Number="194">
<![CDATA[hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="195">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="196">
<![CDATA[]]>
</Line>
<Line Number="197">
<![CDATA[/// feed to handoff z for pickup]]>
</Line>
<Line Number="198">
<![CDATA[JSR(GetInitPos);		// load op with init position]]>
</Line>
<Line Number="199">
<![CDATA[hSequence.ops[index].type := 17;]]>
</Line>
<Line Number="200">
<![CDATA[hSequence.ops[index].xPos := 0.0;]]>
</Line>
<Line Number="201">
<![CDATA[index := index + 1;]]>
</Line>
<Line Number="202">
<![CDATA[]]>
</Line>
<Line Number="203">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="GenMachineOps" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// assuming that the position prior to cell machine moves is safe for x move.]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[headsTemp[0] := hProgram.isHead1;]]>
</Line>
<Line Number="3">
<![CDATA[headsTemp[1] := hProgram.isHead2;]]>
</Line>
<Line Number="4">
<![CDATA[headsTemp[2] := hProgram.isHead3;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[/// look at the program]]>
</Line>
<Line Number="8">
<![CDATA[for counter := 0 to 1 do]]>
</Line>
<Line Number="9">
<![CDATA[	]]>
</Line>
<Line Number="10">
<![CDATA[	// depending which head is selected generate moves.]]>
</Line>
<Line Number="11">
<![CDATA[	if headsTemp[counter] then]]>
</Line>
<Line Number="12">
<![CDATA[		]]>
</Line>
<Line Number="13">
<![CDATA[		hSequence.ops[index].type := 10;			// move to forming X]]>
</Line>
<Line Number="14">
<![CDATA[		pos := machine.positions[counter].x;]]>
</Line>
<Line Number="15">
<![CDATA[		hSequence.ops[index].xPos := pos;]]>
</Line>
<Line Number="16">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="17">
<![CDATA[		]]>
</Line>
<Line Number="18">
<![CDATA[		// can check ]]>
</Line>
<Line Number="19">
<![CDATA[		if machine.type = 3 then]]>
</Line>
<Line Number="20">
<![CDATA[			// if ram machine then lift should be set.]]>
</Line>
<Line Number="21">
<![CDATA[			;]]>
</Line>
<Line Number="22">
<![CDATA[		end_if;]]>
</Line>
<Line Number="23">
<![CDATA[		]]>
</Line>
<Line Number="24">
<![CDATA[		// lift head]]>
</Line>
<Line Number="25">
<![CDATA[		if hProgram.isLift then]]>
</Line>
<Line Number="26">
<![CDATA[			hSequence.ops[index].type := 25;]]>
</Line>
<Line Number="27">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="28">
<![CDATA[		end_if;]]>
</Line>
<Line Number="29">
<![CDATA[		]]>
</Line>
<Line Number="30">
<![CDATA[		//// move into head with machine zOffset set]]>
</Line>
<Line Number="31">
<![CDATA[		]]>
</Line>
<Line Number="32">
<![CDATA[		hSequence.ops[index].type := 18;			// feed into forming]]>
</Line>
<Line Number="33">
<![CDATA[		case counter of]]>
</Line>
<Line Number="34">
<![CDATA[			0:	]]>
</Line>
<Line Number="35">
<![CDATA[				pos := hProgram.head1FormingPos;]]>
</Line>
<Line Number="36">
<![CDATA[				pos := pos + hProgram.head1Deviation;]]>
</Line>
<Line Number="37">
<![CDATA[			1:	]]>
</Line>
<Line Number="38">
<![CDATA[				pos := hProgram.head2FormingPos;]]>
</Line>
<Line Number="39">
<![CDATA[				pos := pos + hProgram.head2Deviation;]]>
</Line>
<Line Number="40">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="41">
<![CDATA[		]]>
</Line>
<Line Number="42">
<![CDATA[		//pos := pos + hProgram.colletOffset + mProgram.outPart.length;]]>
</Line>
<Line Number="43">
<![CDATA[		pos := pos + hProgram.colletOffset + outputPartLength;		]]>
</Line>
<Line Number="44">
<![CDATA[		pos := pos + machine.positions[counter].z;]]>
</Line>
<Line Number="45">
<![CDATA[		]]>
</Line>
<Line Number="46">
<![CDATA[		hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="47">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="48">
<![CDATA[		]]>
</Line>
<Line Number="49">
<![CDATA[		// lower head]]>
</Line>
<Line Number="50">
<![CDATA[		if hProgram.isLift then]]>
</Line>
<Line Number="51">
<![CDATA[			hSequence.ops[index].type := 26;]]>
</Line>
<Line Number="52">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="53">
<![CDATA[		end_if;]]>
</Line>
<Line Number="54">
<![CDATA[		]]>
</Line>
<Line Number="55">
<![CDATA[		//// cycle head]]>
</Line>
<Line Number="56">
<![CDATA[		hSequence.ops[index].type := 60 + counter;]]>
</Line>
<Line Number="57">
<![CDATA[		index := index + 1;		]]>
</Line>
<Line Number="58">
<![CDATA[		]]>
</Line>
<Line Number="59">
<![CDATA[		// lift head]]>
</Line>
<Line Number="60">
<![CDATA[		if hProgram.isLift then]]>
</Line>
<Line Number="61">
<![CDATA[			hSequence.ops[index].type := 25;]]>
</Line>
<Line Number="62">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="63">
<![CDATA[		end_if;]]>
</Line>
<Line Number="64">
<![CDATA[		]]>
</Line>
<Line Number="65">
<![CDATA[		//// move back to the hand off position]]>
</Line>
<Line Number="66">
<![CDATA[		// this is not optimal but a safe position]]>
</Line>
<Line Number="67">
<![CDATA[		hSequence.ops[index].type := 19;			// retract from forming		]]>
</Line>
<Line Number="68">
<![CDATA[		pos := outputHandoff.position.z + offsetColletPartZ;]]>
</Line>
<Line Number="69">
<![CDATA[		hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="70">
<![CDATA[		index := index + 1;]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		// lower head]]>
</Line>
<Line Number="73">
<![CDATA[		if hProgram.isLift then]]>
</Line>
<Line Number="74">
<![CDATA[			hSequence.ops[index].type := 26;]]>
</Line>
<Line Number="75">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="76">
<![CDATA[		end_if;]]>
</Line>
<Line Number="77">
<![CDATA[	end_if;]]>
</Line>
<Line Number="78">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
