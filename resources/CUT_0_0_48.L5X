<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if index < 0 or index > 29 then]]>
</Line>
<Line Number="2">
<![CDATA[	TND();]]>
</Line>
<Line Number="3">
<![CDATA[end_if;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[gotX := 0;]]>
</Line>
<Line Number="6">
<![CDATA[gotZ := 0;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[for counter := index to 0 by -1 do]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	getX := 0;]]>
</Line>
<Line Number="12">
<![CDATA[	getZ := 0;]]>
</Line>
<Line Number="13">
<![CDATA[	]]>
</Line>
<Line Number="14">
<![CDATA[	case seq.ops[counter].type of]]>
</Line>
<Line Number="15">
<![CDATA[		5:]]>
</Line>
<Line Number="16">
<![CDATA[			getX := 1;]]>
</Line>
<Line Number="17">
<![CDATA[			getZ := 1;]]>
</Line>
<Line Number="18">
<![CDATA[			]]>
</Line>
<Line Number="19">
<![CDATA[		10..14: // xMoves]]>
</Line>
<Line Number="20">
<![CDATA[			getX := 1;]]>
</Line>
<Line Number="21">
<![CDATA[			]]>
</Line>
<Line Number="22">
<![CDATA[		15..19: // zMoves]]>
</Line>
<Line Number="23">
<![CDATA[			getZ := 1;]]>
</Line>
<Line Number="24">
<![CDATA[	end_case;]]>
</Line>
<Line Number="25">
<![CDATA[	]]>
</Line>
<Line Number="26">
<![CDATA[	if getX then]]>
</Line>
<Line Number="27">
<![CDATA[		if not gotX then]]>
</Line>
<Line Number="28">
<![CDATA[			gotX := 1;]]>
</Line>
<Line Number="29">
<![CDATA[			position.x := seq.ops[counter].xPos;]]>
</Line>
<Line Number="30">
<![CDATA[		end_If;]]>
</Line>
<Line Number="31">
<![CDATA[	end_if;]]>
</Line>
<Line Number="32">
<![CDATA[	]]>
</Line>
<Line Number="33">
<![CDATA[	if getZ then]]>
</Line>
<Line Number="34">
<![CDATA[		if not gotZ then]]>
</Line>
<Line Number="35">
<![CDATA[			position.z := seq.ops[counter].zPos;]]>
</Line>
<Line Number="36">
<![CDATA[			gotZ := 1;]]>
</Line>
<Line Number="37">
<![CDATA[		end_If;]]>
</Line>
<Line Number="38">
<![CDATA[	end_if;]]>
</Line>
<Line Number="39">
<![CDATA[	]]>
</Line>
<Line Number="40">
<![CDATA[	if gotX and gotZ then]]>
</Line>
<Line Number="41">
<![CDATA[		TND();]]>
</Line>
<Line Number="42">
<![CDATA[	end_if;]]>
</Line>
<Line Number="43">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
