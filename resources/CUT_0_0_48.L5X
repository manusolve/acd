<Line Number="380">
<![CDATA[		if requestPause then]]>
</Line>
<Line Number="381">
<![CDATA[			step := 0;]]>
</Line>
<Line Number="382">
<![CDATA[		end_If;]]>
</Line>
<Line Number="383">
<![CDATA[		 ]]>
</Line>
<Line Number="384">
<![CDATA[		// stop requested;]]>
</Line>
<Line Number="385">
<![CDATA[		// step is not need just set waitAtIndex]]>
</Line>
<Line Number="386">
<![CDATA[		if requestStop and not requestStopLast then		// rising]]>
</Line>
<Line Number="387">
<![CDATA[			]]>
</Line>
<Line Number="388">
<![CDATA[			// use stopAtIndex in RunHead]]>
</Line>
<Line Number="389">
<![CDATA[			// can be either before type 31 (unclamp) or after type 40 (clamp)]]>
</Line>
<Line Number="390">
<![CDATA[			// runHead.index is incremented after the operation has completed]]>
</Line>
<Line Number="391">
<![CDATA[			]]>
</Line>
<Line Number="392">
<![CDATA[			for counter := 0 to 3 do]]>
</Line>
<Line Number="393">
<![CDATA[				for opCounter := runHead[counter].index to 29 do]]>
</Line>
<Line Number="394">
<![CDATA[					case currentSeqs[counter].ops[opCounter].type of]]>
</Line>
<Line Number="395">
<![CDATA[						31: // unclamp]]>
</Line>
<Line Number="396">
<![CDATA[							runHead[counter].waitAtIndex := opCounter;]]>
</Line>
<Line Number="397">
<![CDATA[						40: //clamp]]>
</Line>
<Line Number="398">
<![CDATA[							runHead[counter].waitAtIndex := opCounter + 1;]]>
</Line>
<Line Number="399">
<![CDATA[					end_Case;]]>
</Line>
<Line Number="400">
<![CDATA[					]]>
</Line>
<Line Number="401">
