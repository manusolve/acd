<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[mAxis(sAxis, S, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="4">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="5">
<![CDATA[end_if;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[(*]]>
</Line>
<Line Number="8">
<![CDATA[Cutting head 1440 rpm - 50Hz]]>
</Line>
<Line Number="9">
<![CDATA[44/56]]>
</Line>
<Line Number="10">
<![CDATA[56/134]]>
</Line>
<Line Number="11">
<![CDATA[-> 44/134]]>
</Line>
<Line Number="12">
<![CDATA[*)]]>
</Line>
<Line Number="13">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="14">
<![CDATA[//isBladeRetracted :=]]>
</Line>
<Line Number="15">
<![CDATA[//	(positionBladeTouch - positionBladeRetract + 0.5) >= axis.currentPosition;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[isBladeRetracted :=]]>
