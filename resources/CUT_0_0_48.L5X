<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[mAxis(scrapAxis, ScrapConv, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="3">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[case state of ]]>
</Line>
<Line Number="8">
<![CDATA[	0:]]>
</Line>
<Line Number="9">
<![CDATA[		// init]]>
</Line>
<Line Number="10">
<![CDATA[		]]>
</Line>
<Line Number="11">
<![CDATA[		]]>
</Line>
<Line Number="12">
<![CDATA[		scrapAxis.speed				:= 25;]]>
</Line>
<Line Number="13">
<![CDATA[		scrapAxis.jerkPercentage 	:= 80;]]>
</Line>
<Line Number="14">
<![CDATA[		scrapAxis.jogDirection 		:= 0;]]>
</Line>
<Line Number="15">
<![CDATA[		scrapAxis.accel 			:= 40;]]>
</Line>
<Line Number="16">
<![CDATA[		scrapAxis.decel := scrapAxis.decel;]]>
</Line>
<Line Number="17">
<![CDATA[		]]>
</Line>
<Line Number="18">
<![CDATA[		scrapAxis.jog := 0;	]]>
</Line>
<Line Number="19">
<![CDATA[		]]>
</Line>
<Line Number="20">
<![CDATA[		]]>
</Line>
<Line Number="21">
<![CDATA[		state := 90;]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[	90:]]>
</Line>
<Line Number="24">
<![CDATA[		// entry]]>
</Line>
<Line Number="25">
<![CDATA[		//scrapAxis.jog := 1;]]>
</Line>
<Line Number="26">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="27">
<![CDATA[	]]>
