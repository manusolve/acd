<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="1">
<![CDATA[GSV(WallClockTime, ,CurrentValue, stamp[0]);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[if not safety then]]>
</Line>
<Line Number="4">
<![CDATA[	// if the safety is on should be in intial state]]>
</Line>
<Line Number="5">
<![CDATA[	if state > 0 then]]>
</Line>
<Line Number="6">
<![CDATA[		state := -1;]]>
</Line>
<Line Number="7">
<![CDATA[	end_if;]]>
</Line>
<Line Number="8">
<![CDATA[end_if;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//axis.AxisStatus]]>
</Line>
<Line Number="11">
<![CDATA[(*]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[The basic status conditions associated with the axis. These represent key status conditions used by the system in executing motion control instructions]]>
</Line>
<Line Number="14">
<![CDATA[Bitmap:]]>
</Line>
<Line Number="15">
<![CDATA[0 = ServoActionStatus]]>
</Line>
<Line Number="16">
<![CDATA[1 = DriveEnableStatus]]>
</Line>
<Line Number="17">
<![CDATA[2 = AxisShutdownStatus]]>
</Line>
<Line Number="18">
<![CDATA[3 = ConfigurationUpdateInProcess]]>
</Line>
<Line Number="19">
<![CDATA[4 = InhibitStatus]]>
</Line>
<Line Number="20">
<![CDATA[5 = DirectControlStatus]]>
</Line>
<Line Number="21">
<![CDATA[6 = AxisUpdateStatu]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[*)]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[(*]]>
</Line>
<Line Number="27">
<![CDATA[CIPAxisState]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[INT]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[Enumeration:]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[0 = Initializing]]>
</Line>
<Line Number="34">
<![CDATA[1 = Pre-Charge]]>
</Line>
<Line Number="35">
<![CDATA[2 = Stopped]]>
</Line>
<Line Number="36">
<![CDATA[3 = Starting]]>
</Line>
<Line Number="37">
<![CDATA[4 = Running]]>
</Line>
<Line Number="38">
<![CDATA[5 = Testing]]>
</Line>
<Line Number="39">
<![CDATA[6 = Stopping]]>
</Line>
<Line Number="40">
<![CDATA[7 = Aborting]]>
</Line>
<Line Number="41">
<![CDATA[8 = Faulted]]>
</Line>
<Line Number="42">
<![CDATA[9 = Start Inhibited]]>
</Line>
<Line Number="43">
<![CDATA[10 = Shutdown]]>
</Line>
<Line Number="44">
<![CDATA[11 = Axis Inhibited]]>
</Line>
<Line Number="45">
<![CDATA[12 = Not Grouped]]>
</Line>
<Line Number="46">
<![CDATA[*)]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[// update]]>
</Line>
<Line Number="49">
<![CDATA[currentPosition := axis.ActualPosition;]]>
</Line>
<Line Number="50">
<![CDATA[cipAxisState := axis.CIPAxisState;]]>
</Line>
<Line Number="51">
<![CDATA[fault := (cipAxisState = 8);]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[(*if fault then ]]>
</Line>
<Line Number="54">
<![CDATA[	state := -1;]]>
</Line>
<Line Number="55">
<![CDATA[end_if;*)]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[if clearFault then]]>
</Line>
<Line Number="58">
<![CDATA[	clearFault := 0;]]>
</Line>
<Line Number="59">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="60">
<![CDATA[	]]>
</Line>
<Line Number="61">
<![CDATA[	// these to stop movement on clear]]>
</Line>
<Line Number="62">
<![CDATA[	move := 0;]]>
</Line>
<Line Number="63">
<![CDATA[	jog := 0;]]>
</Line>
<Line Number="64">
<![CDATA[	setNewPosition := 0;]]>
</Line>
<Line Number="65">
<![CDATA[end_if;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[case state of]]>
</Line>
<Line Number="69">
<![CDATA[	-1:]]>
</Line>
<Line Number="70">
<![CDATA[		// clear values]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		jog := 0;]]>
</Line>
<Line Number="73">
<![CDATA[		move := 0;]]>
</Line>
<Line Number="74">
<![CDATA[		ready := 0;]]>
</Line>
<Line Number="75">
<![CDATA[		home := 0;			]]>
</Line>
<Line Number="76">
<![CDATA[		disable := 0;		// by default enabled]]>
</Line>
<Line Number="77">
<![CDATA[		]]>
</Line>
<Line Number="78">
<![CDATA[		// read the CIP limits for inline checking]]>
</Line>
<Line Number="79">
<![CDATA[		GSV(Axis, axis, SoftTravelLimitNegative, limitMinus);]]>
</Line>
<Line Number="80">
<![CDATA[		GSV(Axis, axis, SoftTravelLimitPositive, limitPlus);		]]>
</Line>
<Line Number="81">
<![CDATA[		]]>
</Line>
<Line Number="82">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="83">
<![CDATA[		]]>
</Line>
<Line Number="84">
<![CDATA[	0:]]>
</Line>
<Line Number="85">
<![CDATA[		// in the STO state]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
<![CDATA[		// safety is released]]>
</Line>
<Line Number="88">
<![CDATA[		// it will auto MSO]]>
</Line>
<Line Number="89">
<![CDATA[		if safety then]]>
</Line>
<Line Number="90">
<![CDATA[			]]>
</Line>
<Line Number="91">
<![CDATA[			// check is the axis is still inhibited]]>
</Line>
<Line Number="92">
<![CDATA[			if not axis.InhibitStatus then]]>
</Line>
<Line Number="93">
<![CDATA[				state := 50;]]>
</Line>
<Line Number="94">
<![CDATA[				//state := 100;]]>
</Line>
<Line Number="95">
<![CDATA[			end_if;]]>
</Line>
<Line Number="96">
<![CDATA[			]]>
</Line>
<Line Number="97">
<![CDATA[			// check for faulted, try to clear]]>
</Line>
<Line Number="98">
<![CDATA[			if cipAxisState = 8 then]]>
</Line>
<Line Number="99">
<![CDATA[				state := 20;]]>
</Line>
<Line Number="100">
<![CDATA[			end_if;]]>
</Line>
<Line Number="101">
<![CDATA[		end_if;]]>
</Line>
<Line Number="102">
<![CDATA[	]]>
</Line>
<Line Number="103">
<![CDATA[	20:]]>
</Line>
<Line Number="104">
<![CDATA[		// clear fault if any]]>
</Line>
<Line Number="105">
<![CDATA[		durationMAFR := stamp[0];]]>
</Line>
<Line Number="106">
<![CDATA[		MAFR(axis, mafr);]]>
</Line>
<Line Number="107">
<![CDATA[		state := 21;]]>
</Line>
<Line Number="108">
<![CDATA[	]]>
</Line>
<Line Number="109">
<![CDATA[	21:]]>
</Line>
<Line Number="110">
<![CDATA[		if mafr.DN then]]>
</Line>
<Line Number="111">
<![CDATA[			durationMAFR := stamp[0] - durationMAFR;]]>
</Line>
<Line Number="112">
<![CDATA[			state := 50;]]>
</Line>
<Line Number="113">
<![CDATA[		end_if;]]>
</Line>
<Line Number="114">
<![CDATA[		]]>
</Line>
<Line Number="115">
<![CDATA[	50:]]>
</Line>
<Line Number="116">
<![CDATA[		// switch off in case of previous active instr.]]>
</Line>
<Line Number="117">
<![CDATA[		durationMAS := stamp[0];]]>
</Line>
<Line Number="118">
<![CDATA[		state := 60;]]>
</Line>
<Line Number="119">
<![CDATA[		]]>
</Line>
<Line Number="120">
<![CDATA[	60:]]>
</Line>
<Line Number="121">
<![CDATA[		// stop]]>
</Line>
<Line Number="122">
<![CDATA[		MAS(axis, ]]>
</Line>
<Line Number="123">
<![CDATA[			mas, ]]>
</Line>
<Line Number="124">
<![CDATA[			All,			// stop type]]>
</Line>
<Line Number="125">
<![CDATA[			No,				// change decel]]>
</Line>
<Line Number="126">
<![CDATA[			10.0, 			// decel]]>
</Line>
<Line Number="127">
<![CDATA[			Unitspersec2,	// decel units]]>
</Line>
<Line Number="128">
<![CDATA[			No,				// change jerk]]>
</Line>
<Line Number="129">
<![CDATA[			10.0,			// decel jerk]]>
</Line>
<Line Number="130">
<![CDATA[			Unitspersec3 	// jerk units]]>
</Line>
<Line Number="131">
<![CDATA[			);]]>
</Line>
<Line Number="132">
<![CDATA[		]]>
</Line>
<Line Number="133">
<![CDATA[		if mas.DN then]]>
</Line>
<Line Number="134">
<![CDATA[			state := 70;]]>
</Line>
<Line Number="135">
<![CDATA[		end_if;]]>
</Line>
<Line Number="136">
<![CDATA[	]]>
</Line>
<Line Number="137">
<![CDATA[	70:	]]>
</Line>
<Line Number="138">
<![CDATA[		If mas.PC then]]>
</Line>
<Line Number="139">
<![CDATA[			durationMAS := stamp[0] - durationMAS;]]>
</Line>
<Line Number="140">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="141">
<![CDATA[		end_if;]]>
</Line>
<Line Number="142">
<![CDATA[		]]>
</Line>
<Line Number="143">
<![CDATA[	100:]]>
</Line>
<Line Number="144">
<![CDATA[		// switch on]]>
</Line>
<Line Number="145">
<![CDATA[		if not disable then]]>
</Line>
<Line Number="146">
<![CDATA[			durationMSO := stamp[0];		]]>
</Line>
<Line Number="147">
<![CDATA[			state := 110;]]>
</Line>
<Line Number="148">
<![CDATA[		end_if;]]>
</Line>
<Line Number="149">
<![CDATA[	110:]]>
</Line>
<Line Number="150">
<![CDATA[		MSO(axis, mso);]]>
</Line>
<Line Number="151">
<![CDATA[		if mso.DN then]]>
</Line>
<Line Number="152">
<![CDATA[			durationMSO := stamp[0] - durationMSO;]]>
</Line>
<Line Number="153">
<![CDATA[			state := 120;]]>
</Line>
<Line Number="154">
<![CDATA[		end_if;]]>
</Line>
<Line Number="155">
<![CDATA[]]>
</Line>
<Line Number="156">
<![CDATA[	120:]]>
</Line>
<Line Number="157">
<![CDATA[		// preset values for testing]]>
</Line>
<Line Number="158">
<![CDATA[		// define a minimum]]>
</Line>
<Line Number="159">
<![CDATA[		if speed <= 0.0 then]]>
</Line>
<Line Number="160">
<![CDATA[			speed := 5.0;]]>
</Line>
<Line Number="161">
<![CDATA[		end_if;]]>
</Line>
<Line Number="162">
<![CDATA[		]]>
</Line>
<Line Number="163">
<![CDATA[		// testing]]>
</Line>
<Line Number="164">
<![CDATA[		(*]]>
</Line>
<Line Number="165">
<![CDATA[		if position < 0 then]]>
</Line>
<Line Number="166">
<![CDATA[			position := 10;]]>
</Line>
<Line Number="167">
<![CDATA[		elsif position > 100 then]]>
</Line>
<Line Number="168">
<![CDATA[			position := 10;]]>
</Line>
<Line Number="169">
<![CDATA[		end_if;]]>
</Line>
<Line Number="170">
<![CDATA[		*)]]>
</Line>
<Line Number="171">
<![CDATA[		]]>
</Line>
<Line Number="172">
<![CDATA[		if jerkPercentage <= 0.0 then]]>
</Line>
<Line Number="173">
<![CDATA[			jerkPercentage := 25.0;]]>
</Line>
<Line Number="174">
<![CDATA[		elsif jerkPercentage > 100 then]]>
</Line>
<Line Number="175">
<![CDATA[			jerkPercentage := 50.0;]]>
</Line>
<Line Number="176">
<![CDATA[		end_if;]]>
</Line>
<Line Number="177">
<![CDATA[		]]>
</Line>
<Line Number="178">
<![CDATA[		if accel <= 0.0 then]]>
</Line>
<Line Number="179">
<![CDATA[			accel := 10.0;]]>
</Line>
<Line Number="180">
<![CDATA[		elsif accel > 10000 then]]>
</Line>
<Line Number="181">
<![CDATA[			accel := 400;]]>
</Line>
<Line Number="182">
<![CDATA[		end_if;]]>
</Line>
<Line Number="183">
<![CDATA[		]]>
</Line>
<Line Number="184">
<![CDATA[		if decel <= 0.0 then]]>
</Line>
<Line Number="185">
<![CDATA[			decel := accel;]]>
</Line>
<Line Number="186">
<![CDATA[		end_if;]]>
</Line>
<Line Number="187">
<![CDATA[		]]>
</Line>
<Line Number="188">
<![CDATA[		state := 190;]]>
</Line>
<Line Number="189">
<![CDATA[		]]>
</Line>
<Line Number="190">
<![CDATA[	190:]]>
</Line>
<Line Number="191">
<![CDATA[		// entry / re-entry]]>
</Line>
<Line Number="192">
<![CDATA[		]]>
</Line>
<Line Number="193">
<![CDATA[		// reset torque]]>
</Line>
<Line Number="194">
<![CDATA[		setTorque := 0.0;]]>
</Line>
<Line Number="195">
<![CDATA[		axis.TorqueLimitNegative := -200.0;]]>
</Line>
<Line Number="196">
<![CDATA[		axis.TorqueLimitPositive := 200.0;]]>
</Line>
<Line Number="197">
<![CDATA[		]]>
</Line>
<Line Number="198">
<![CDATA[		ready := 1;]]>
</Line>
<Line Number="199">
<![CDATA[		state := 200;]]>
</Line>
<Line Number="200">
<![CDATA[		]]>
</Line>
<Line Number="201">
<![CDATA[	200:]]>
</Line>
<Line Number="202">
<![CDATA[		// ready]]>
</Line>
<Line Number="203">
<![CDATA[		]]>
</Line>
<Line Number="204">
<![CDATA[		// check for jog, really we need const. vel in this mode]]>
</Line>
<Line Number="205">
<![CDATA[		if jog then			]]>
</Line>
<Line Number="206">
<![CDATA[			state := 400;]]>
</Line>
<Line Number="207">
<![CDATA[		end_if;]]>
</Line>
<Line Number="208">
<![CDATA[		]]>
</Line>
<Line Number="209">
<![CDATA[		if move then]]>
</Line>
<Line Number="210">
<![CDATA[			state := 300;]]>
</Line>
<Line Number="211">
<![CDATA[		end_if;]]>
</Line>
<Line Number="212">
<![CDATA[		]]>
</Line>
<Line Number="213">
<![CDATA[		if home then			]]>
</Line>
<Line Number="214">
<![CDATA[			state := 1100;]]>
</Line>
<Line Number="215">
<![CDATA[		end_if;]]>
</Line>
<Line Number="216">
<![CDATA[		]]>
</Line>
<Line Number="217">
<![CDATA[		if setNewPosition then]]>
</Line>
<Line Number="218">
<![CDATA[			state := 2000;]]>
</Line>
<Line Number="219">
<![CDATA[		end_if;]]>
</Line>
<Line Number="220">
<![CDATA[		]]>
</Line>
<Line Number="221">
<![CDATA[		if disable then]]>
</Line>
<Line Number="222">
<![CDATA[			state := 250;]]>
</Line>
<Line Number="223">
<![CDATA[		end_if;]]>
</Line>
<Line Number="224">
<![CDATA[		]]>
</Line>
<Line Number="225">
<![CDATA[		if state <> stateLast then]]>
</Line>
<Line Number="226">
<![CDATA[			// check if torque change is needed for command]]>
</Line>
<Line Number="227">
<![CDATA[			if setTorque > 0 then]]>
</Line>
<Line Number="228">
<![CDATA[				axis.TorqueLimitNegative := -setTorque;]]>
</Line>
<Line Number="229">
<![CDATA[				axis.TorqueLimitPositive := setTorque;]]>
</Line>
<Line Number="230">
<![CDATA[			end_if;]]>
</Line>
<Line Number="231">
<![CDATA[		end_if;]]>
</Line>
<Line Number="232">
<![CDATA[	]]>
</Line>
<Line Number="233">
<![CDATA[	250:]]>
</Line>
<Line Number="234">
<![CDATA[		// servo off when disable]]>
</Line>
<Line Number="235">
<![CDATA[		MSF(axis, msf);]]>
</Line>
<Line Number="236">
<![CDATA[		state := 255;]]>
</Line>
<Line Number="237">
<![CDATA[		]]>
</Line>
<Line Number="238">
<![CDATA[	255:]]>
</Line>
<Line Number="239">
<![CDATA[		if msf.DN then]]>
</Line>
<Line Number="240">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="241">
<![CDATA[		end_if;]]>
</Line>
<Line Number="242">
<![CDATA[		]]>
</Line>
<Line Number="243">
<![CDATA[	]]>
</Line>
<Line Number="244">
<![CDATA[#region position move ]]>
</Line>
<Line Number="245">
<![CDATA[	]]>
</Line>
<Line Number="246">
<![CDATA[	/// MAM absolute move start]]>
</Line>
<Line Number="247">
<![CDATA[	300:]]>
</Line>
<Line Number="248">
<![CDATA[		// position and other params should be set before here]]>
</Line>
<Line Number="249">
<![CDATA[		if position < limitMinus or position > limitPlus then]]>
</Line>
<Line Number="250">
<![CDATA[			// error]]>
</Line>
<Line Number="251">
<![CDATA[			;]]>
</Line>
<Line Number="252">
<![CDATA[		end_if;]]>
</Line>
<Line Number="253">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="254">
<![CDATA[		]]>
</Line>
<Line Number="255">
<![CDATA[	310:]]>
</Line>
<Line Number="256">
<![CDATA[		(*]]>
</Line>
<Line Number="257">
<![CDATA[		Instruction MAM(Axis, Motion Control, Move Type, Position, ]]>
</Line>
<Line Number="258">
<![CDATA[						Speed, Speed units, Accel Rate, Accel Units, Decel Rate, Decel Units, ]]>
</Line>
<Line Number="259">
<![CDATA[						Profile, Accel Jerk Decel Jerk, Jerk Units, ]]>
</Line>
<Line Number="260">
<![CDATA[						Merge, Merge Speed, Lock Position, Lock Direction, Event Distance, Calculated Data)]]>
</Line>
<Line Number="261">
<![CDATA[		*)]]>
</Line>
<Line Number="262">
<![CDATA[]]>
</Line>
<Line Number="263">
<![CDATA[		MAM(axis, mam, 0, position, ]]>
</Line>
<Line Number="264">
<![CDATA[			speed, Unitspersec, accel, Unitspersec2, decel, Unitspersec2, ]]>
</Line>
<Line Number="265">
<![CDATA[			SCurve, jerkPercentage, jerkPercentage, %ofMaximum, ]]>
</Line>
<Line Number="266">
<![CDATA[			Disabled, Programmed, 0, None, 0, 0);]]>
</Line>
<Line Number="267">
<![CDATA[		]]>
</Line>
<Line Number="268">
<![CDATA[		state := 380;]]>
</Line>
<Line Number="269">
<![CDATA[	]]>
</Line>
<Line Number="270">
<![CDATA[	// MAM with merge when existing command is present]]>
</Line>
<Line Number="271">
<![CDATA[	350:]]>
</Line>
<Line Number="272">
<![CDATA[		MAM(axis,]]>
</Line>
<Line Number="273">
<![CDATA[			mam, ]]>
</Line>
<Line Number="274">
<![CDATA[			0,				// move type 0=abs]]>
</Line>
<Line Number="275">
<![CDATA[			position, 		]]>
</Line>
<Line Number="276">
<![CDATA[			speed, ]]>
</Line>
<Line Number="277">
<![CDATA[			Unitspersec, ]]>
</Line>
<Line Number="278">
<![CDATA[			accel, ]]>
</Line>
<Line Number="279">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="280">
<![CDATA[			decel, ]]>
</Line>
<Line Number="281">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="282">
<![CDATA[			SCurve, ]]>
</Line>
<Line Number="283">
<![CDATA[			jerkPercentage, ]]>
</Line>
<Line Number="284">
<![CDATA[			jerkPercentage, ]]>
</Line>
<Line Number="285">
<![CDATA[			%ofMaximum, ]]>
</Line>
<Line Number="286">
<![CDATA[			Enabled, ]]>
</Line>
<Line Number="287">
<![CDATA[			Programmed, ]]>
</Line>
<Line Number="288">
<![CDATA[			0, ]]>
</Line>
<Line Number="289">
<![CDATA[			None, ]]>
</Line>
<Line Number="290">
<![CDATA[			0, ]]>
</Line>
<Line Number="291">
<![CDATA[			0);]]>
</Line>
<Line Number="292">
<![CDATA[		]]>
</Line>
<Line Number="293">
<![CDATA[		state := 380;]]>
</Line>
<Line Number="294">
<![CDATA[		]]>
</Line>
<Line Number="295">
<![CDATA[	380:]]>
</Line>
<Line Number="296">
<![CDATA[		if mam.DN then]]>
</Line>
<Line Number="297">
<![CDATA[			// copy to detect changes]]>
</Line>
<Line Number="298">
<![CDATA[			speedLast := speed;]]>
</Line>
<Line Number="299">
<![CDATA[			positionLast := position;]]>
</Line>
<Line Number="300">
<![CDATA[			state := 390;]]>
</Line>
<Line Number="301">
<![CDATA[		end_if;]]>
</Line>
<Line Number="302">
<![CDATA[	]]>
</Line>
<Line Number="303">
<![CDATA[	390:	]]>
</Line>
<Line Number="304">
<![CDATA[		// move was stopped before complete]]>
</Line>
<Line Number="305">
<![CDATA[		if not move then]]>
</Line>
<Line Number="306">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="307">
<![CDATA[		end_if;]]>
</Line>
<Line Number="308">
<![CDATA[		]]>
</Line>
<Line Number="309">
<![CDATA[		if position <> positionLast then]]>
</Line>
<Line Number="310">
<![CDATA[			// target position has changed, merge new command]]>
</Line>
<Line Number="311">
<![CDATA[			state := 350; ]]>
</Line>
<Line Number="312">
<![CDATA[		end_if;]]>
</Line>
<Line Number="313">
<![CDATA[		if speed <> speedLast then]]>
</Line>
<Line Number="314">
<![CDATA[			// target speed changed, merge new command]]>
</Line>
<Line Number="315">
<![CDATA[			state := 350;]]>
</Line>
<Line Number="316">
<![CDATA[		end_if;]]>
</Line>
<Line Number="317">
<![CDATA[		]]>
</Line>
<Line Number="318">
<![CDATA[		/// ... could do this for accel as well]]>
</Line>
<Line Number="319">
<![CDATA[		]]>
</Line>
<Line Number="320">
<![CDATA[		/// limit check]]>
</Line>
<Line Number="321">
<![CDATA[		stopOnLimit := 0;]]>
</Line>
<Line Number="322">
<![CDATA[]]>
</Line>
<Line Number="323">
<![CDATA[		if limitMinusSwitch and currentPosition > position then]]>
</Line>
<Line Number="324">
<![CDATA[			stopOnLimit := 1;]]>
</Line>
<Line Number="325">
<![CDATA[		end_if;]]>
</Line>
<Line Number="326">
<![CDATA[]]>
</Line>
<Line Number="327">
<![CDATA[		if limitPlusSwitch and currentPosition < position then]]>
</Line>
<Line Number="328">
<![CDATA[			stopOnLimit := 1;]]>
</Line>
<Line Number="329">
<![CDATA[		end_if;]]>
</Line>
<Line Number="330">
<![CDATA[		]]>
</Line>
<Line Number="331">
<![CDATA[		if stopOnLimit then]]>
</Line>
<Line Number="332">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="333">
<![CDATA[		end_if;]]>
</Line>
<Line Number="334">
<![CDATA[		]]>
</Line>
<Line Number="335">
<![CDATA[		if mam.PC and not mam.IP then]]>
</Line>
<Line Number="336">
<![CDATA[			move := 0; // reset to indicate done]]>
</Line>
<Line Number="337">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="338">
<![CDATA[		end_if;]]>
</Line>
<Line Number="339">
<![CDATA[#endregion		]]>
</Line>
<Line Number="340">
<![CDATA[		]]>
</Line>
<Line Number="341">
<![CDATA[#region const velocity jog]]>
</Line>
<Line Number="342">
<![CDATA[	400:]]>
</Line>
<Line Number="343">
<![CDATA[		(*]]>
</Line>
<Line Number="344">
<![CDATA[		Instruction MAJ(Axis Motion Control, Direction, Speed, Speed Units, Accel Rate, Accel Units, Decel Rate, Decel Units, ]]>
</Line>
<Line Number="345">
<![CDATA[						Profile, Accel Jerk, Decel Jerk Jerk Units, ]]>
</Line>
<Line Number="346">
<![CDATA[						Merge, Merge Speed, Lock Position, Lock Direction)]]>
</Line>
<Line Number="347">
<![CDATA[		*)]]>
</Line>
<Line Number="348">
<![CDATA[		MAJ(axis, ]]>
</Line>
<Line Number="349">
<![CDATA[			maj, ]]>
</Line>
<Line Number="350">
<![CDATA[			jogDirection, 				// direction]]>
</Line>
<Line Number="351">
<![CDATA[			speed, 						// speed]]>
</Line>
<Line Number="352">
<![CDATA[			Unitspersec, ]]>
</Line>
<Line Number="353">
<![CDATA[			accel, 						// accel]]>
</Line>
<Line Number="354">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="355">
<![CDATA[			decel, 						// decel]]>
</Line>
<Line Number="356">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="357">
<![CDATA[			SCurve, 					// profile]]>
</Line>
<Line Number="358">
<![CDATA[			jerkPercentage, 			// jerk accel]]>
</Line>
<Line Number="359">
<![CDATA[			jerkPercentage, 			// jerk decel]]>
</Line>
<Line Number="360">
<![CDATA[			%ofMaximum, 				// jerk units]]>
</Line>
<Line Number="361">
<![CDATA[			Enabled, 					// merge]]>
</Line>
<Line Number="362">
<![CDATA[			Programmed, 				// Programmed mean use the speed in this instruction]]>
</Line>
<Line Number="363">
<![CDATA[			0, ]]>
</Line>
<Line Number="364">
<![CDATA[			None);]]>
</Line>
<Line Number="365">
<![CDATA[		]]>
</Line>
<Line Number="366">
<![CDATA[		speedLast := speed;]]>
</Line>
<Line Number="367">
<![CDATA[		lastDirection := jogDirection;]]>
</Line>
<Line Number="368">
<![CDATA[		]]>
</Line>
<Line Number="369">
<![CDATA[		state := 410;]]>
</Line>
<Line Number="370">
<![CDATA[		]]>
</Line>
<Line Number="371">
<![CDATA[	410:]]>
</Line>
<Line Number="372">
<![CDATA[		// see if maj rec'd]]>
</Line>
<Line Number="373">
<![CDATA[		if maj.DN then]]>
</Line>
<Line Number="374">
<![CDATA[			state := 420;]]>
</Line>
<Line Number="375">
<![CDATA[		end_if;]]>
</Line>
<Line Number="376">
<![CDATA[		]]>
</Line>
<Line Number="377">
<![CDATA[	420:]]>
</Line>
<Line Number="378">
<![CDATA[		if not maj.IP or not jog then]]>
</Line>
<Line Number="379">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="380">
<![CDATA[		end_if;]]>
</Line>
<Line Number="381">
<![CDATA[		]]>
</Line>
<Line Number="382">
<![CDATA[		// see if a MAJ can be changed to a MAM]]>
</Line>
<Line Number="383">
<![CDATA[		]]>
</Line>
<Line Number="384">
<![CDATA[		if move then]]>
</Line>
<Line Number="385">
<![CDATA[			jog := 0;]]>
</Line>
<Line Number="386">
<![CDATA[			state := 350; // skips precheck]]>
</Line>
<Line Number="387">
<![CDATA[			TND(); // Return]]>
</Line>
<Line Number="388">
<![CDATA[		end_if;]]>
</Line>
<Line Number="389">
<![CDATA[		]]>
</Line>
<Line Number="390">
<![CDATA[		/// limit check]]>
</Line>
<Line Number="391">
<![CDATA[		stopOnLimit := 0;]]>
</Line>
<Line Number="392">
<![CDATA[]]>
</Line>
<Line Number="393">
<![CDATA[		if limitMinusSwitch and jogDirection = 1 then]]>
</Line>
<Line Number="394">
<![CDATA[			stopOnLimit := 1;]]>
</Line>
<Line Number="395">
<![CDATA[		end_if;]]>
</Line>
<Line Number="396">
<![CDATA[]]>
</Line>
<Line Number="397">
<![CDATA[		if limitPlusSwitch and jogDirection = 1 then]]>
</Line>
<Line Number="398">
<![CDATA[			stopOnLimit := 1;]]>
</Line>
<Line Number="399">
<![CDATA[		end_if;]]>
</Line>
<Line Number="400">
<![CDATA[		]]>
</Line>
<Line Number="401">
<![CDATA[		if stopOnLimit then]]>
</Line>
<Line Number="402">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="403">
<![CDATA[		end_if;]]>
</Line>
<Line Number="404">
<![CDATA[			]]>
</Line>
<Line Number="405">
<![CDATA[		]]>
</Line>
<Line Number="406">
<![CDATA[		]]>
</Line>
<Line Number="407">
<![CDATA[		// speed change reissues the MAJ]]>
</Line>
<Line Number="408">
<![CDATA[		if speed <> speedLast or jogDirection <> lastDirection then]]>
</Line>
<Line Number="409">
<![CDATA[			state := 400;]]>
</Line>
<Line Number="410">
<![CDATA[		end_if;]]>
</Line>
<Line Number="411">
<![CDATA[		speedLast := speed; ]]>
</Line>
<Line Number="412">
<![CDATA[		lastDirection := jogDirection;]]>
</Line>
<Line Number="413">
<![CDATA[#endregion]]>
</Line>
<Line Number="414">
<![CDATA[]]>
</Line>
<Line Number="415">
<![CDATA[#region stop motion all		]]>
</Line>
<Line Number="416">
<![CDATA[]]>
</Line>
<Line Number="417">
<![CDATA[	/// stop sequence for all motion types	]]>
</Line>
<Line Number="418">
<![CDATA[	800:]]>
</Line>
<Line Number="419">
<![CDATA[]]>
</Line>
<Line Number="420">
<![CDATA[		durationMAS := stamp[0];]]>
</Line>
<Line Number="421">
<![CDATA[		state := 810;]]>
</Line>
<Line Number="422">
<![CDATA[		]]>
</Line>
<Line Number="423">
<![CDATA[	810:]]>
</Line>
<Line Number="424">
<![CDATA[		// stop]]>
</Line>
<Line Number="425">
<![CDATA[		MAS(axis, ]]>
</Line>
<Line Number="426">
<![CDATA[			mas, ]]>
</Line>
<Line Number="427">
<![CDATA[			All,			// stop type]]>
</Line>
<Line Number="428">
<![CDATA[			No,				// change decel]]>
</Line>
<Line Number="429">
<![CDATA[			decel, 			// decel]]>
</Line>
<Line Number="430">
<![CDATA[			Unitspersec2,	// decel units]]>
</Line>
<Line Number="431">
<![CDATA[			No,				// change jerk]]>
</Line>
<Line Number="432">
<![CDATA[			jerkPercentage,	// decel jerk]]>
</Line>
<Line Number="433">
<![CDATA[			%ofMaximum 	// jerk units]]>
</Line>
<Line Number="434">
<![CDATA[			);]]>
</Line>
<Line Number="435">
<![CDATA[]]>
</Line>
<Line Number="436">
<![CDATA[		if mas.DN then]]>
</Line>
<Line Number="437">
<![CDATA[			state := 820;]]>
</Line>
<Line Number="438">
<![CDATA[		end_if;]]>
</Line>
<Line Number="439">
<![CDATA[]]>
</Line>
<Line Number="440">
<![CDATA[	820:]]>
</Line>
<Line Number="441">
<![CDATA[		If mas.PC then]]>
</Line>
<Line Number="442">
<![CDATA[			durationMAS := stamp[0] - durationMAS;			]]>
</Line>
<Line Number="443">
<![CDATA[			state := 190;//200; // go back to ready]]>
</Line>
<Line Number="444">
<![CDATA[		end_if;]]>
</Line>
<Line Number="445">
<![CDATA[#endregion]]>
</Line>
<Line Number="446">
<![CDATA[]]>
</Line>
<Line Number="447">
<![CDATA[#region axis homing WIP]]>
</Line>
<Line Number="448">
<![CDATA[	/// start homing the axis	]]>
</Line>
<Line Number="449">
<![CDATA[	1000:]]>
</Line>
<Line Number="450">
<![CDATA[		//]]>
</Line>
<Line Number="451">
<![CDATA[		]]>
</Line>
<Line Number="452">
<![CDATA[		homeMode := 1;		// 0 passive, 1 active]]>
</Line>
<Line Number="453">
<![CDATA[		(*]]>
</Line>
<Line Number="454">
<![CDATA[		Enumeration]]>
</Line>
<Line Number="455">
<![CDATA[			0 = Immediate (default)]]>
</Line>
<Line Number="456">
<![CDATA[			1 = Home to switch (O)]]>
</Line>
<Line Number="457">
<![CDATA[			2 = Home to marker (O)]]>
</Line>
<Line Number="458">
<![CDATA[			3 = Home to switch then marker (O)]]>
</Line>
<Line Number="459">
<![CDATA[			4 = Home to torque (O)]]>
</Line>
<Line Number="460">
<![CDATA[			5 = Home to torque then marker (O)]]>
</Line>
<Line Number="461">
<![CDATA[			6 = Immediate Absolute (O)]]>
</Line>
<Line Number="462">
<![CDATA[		*)]]>
</Line>
<Line Number="463">
<![CDATA[		homeSequence := 4; ]]>
</Line>
<Line Number="464">
<![CDATA[		homeSpeed := 10.0;]]>
</Line>
<Line Number="465">
<![CDATA[		homeAcceleration := 10.0;]]>
</Line>
<Line Number="466">
<![CDATA[		homeTorque := 25.0;]]>
</Line>
<Line Number="467">
<![CDATA[		]]>
</Line>
<Line Number="468">
<![CDATA[		]]>
</Line>
<Line Number="469">
<![CDATA[		SSV(Axis, axis, HomeMode, homeMode);]]>
</Line>
<Line Number="470">
<![CDATA[		SSV(Axis, axis, HomeSequence, homeSequence);]]>
</Line>
<Line Number="471">
<![CDATA[		SSV(Axis, axis, HomeSpeed, homeSpeed);]]>
</Line>
<Line Number="472">
<![CDATA[		//SSV(Axis, axis, ]]>
</Line>
<Line Number="473">
<![CDATA[		//SSV(Axis, axis, TorqueThreshold, homeTorque);]]>
</Line>
<Line Number="474">
<![CDATA[		//SSV(Axis, axis, HomeTorque, homeTorque);]]>
</Line>
<Line Number="475">
<![CDATA[		]]>
</Line>
<Line Number="476">
<![CDATA[		state := 1010;]]>
</Line>
<Line Number="477">
<![CDATA[		]]>
</Line>
<Line Number="478">
<![CDATA[	1010:]]>
</Line>
<Line Number="479">
<![CDATA[		MAH(axis, mah);]]>
</Line>
<Line Number="480">
<![CDATA[		]]>
</Line>
<Line Number="481">
<![CDATA[		state := 1020;]]>
</Line>
<Line Number="482">
<![CDATA[		]]>
</Line>
<Line Number="483">
<![CDATA[	1020:]]>
</Line>
<Line Number="484">
<![CDATA[		if mah.DN then]]>
</Line>
<Line Number="485">
<![CDATA[			state := 1030;]]>
</Line>
<Line Number="486">
<![CDATA[		end_If;]]>
</Line>
<Line Number="487">
<![CDATA[	]]>
</Line>
<Line Number="488">
<![CDATA[	1030:]]>
</Line>
<Line Number="489">
<![CDATA[		;]]>
</Line>
<Line Number="490">
<![CDATA[#endregion]]>
</Line>
<Line Number="491">
<![CDATA[		]]>
</Line>
<Line Number="492">
<![CDATA[#region home axis using torque limit		]]>
</Line>
<Line Number="493">
<![CDATA[	1100:]]>
</Line>
<Line Number="494">
<![CDATA[		//https://support.rockwellautomation.com/app/answers/answer_view/a_id/602870]]>
</Line>
<Line Number="495">
<![CDATA[		// torque limitation]]>
</Line>
<Line Number="496">
<![CDATA[		]]>
</Line>
<Line Number="497">
<![CDATA[		// ]]>
</Line>
<Line Number="498">
<![CDATA[		saveTorque := axis.TorqueLimitNegative;]]>
</Line>
<Line Number="499">
<![CDATA[		]]>
</Line>
<Line Number="500">
<![CDATA[		if homeTorque <= 0 then]]>
</Line>
<Line Number="501">
<![CDATA[			homeTorque := 10.0; 			// percentage]]>
</Line>
<Line Number="502">
<![CDATA[		end_if;]]>
</Line>
<Line Number="503">
<![CDATA[		]]>
</Line>
<Line Number="504">
<![CDATA[		//SSV(Axis, axis, TorqueLimitNegative, homeTorque);]]>
</Line>
<Line Number="505">
<![CDATA[		//SSV(Axis, axis, TorqueLimitPositive, homeTorque);]]>
</Line>
<Line Number="506">
<![CDATA[		axis.TorqueLimitNegative := homeTorque;]]>
</Line>
<Line Number="507">
<![CDATA[		axis.TorqueLimitPositive := homeTorque;]]>
</Line>
<Line Number="508">
<![CDATA[		]]>
</Line>
<Line Number="509">
<![CDATA[		]]>
</Line>
<Line Number="510">
<![CDATA[		]]>
</Line>
<Line Number="511">
<![CDATA[		state := 1102;]]>
</Line>
<Line Number="512">
<![CDATA[	]]>
</Line>
<Line Number="513">
<![CDATA[	1102:]]>
</Line>
<Line Number="514">
<![CDATA[		// custom home to stop]]>
</Line>
<Line Number="515">
<![CDATA[		;]]>
</Line>
<Line Number="516">
<![CDATA[		homeSpeed := speed;]]>
</Line>
<Line Number="517">
<![CDATA[		homeAcceleration := accel;]]>
</Line>
<Line Number="518">
<![CDATA[		//homeTorque := 25.0;]]>
</Line>
<Line Number="519">
<![CDATA[		]]>
</Line>
<Line Number="520">
<![CDATA[		MAJ(axis, ]]>
</Line>
<Line Number="521">
<![CDATA[			maj, ]]>
</Line>
<Line Number="522">
<![CDATA[			jogDirection, 				// direction]]>
</Line>
<Line Number="523">
<![CDATA[			homeSpeed, 					// speed]]>
</Line>
<Line Number="524">
<![CDATA[			Unitspersec, ]]>
</Line>
<Line Number="525">
<![CDATA[			homeAcceleration, 			// accel]]>
</Line>
<Line Number="526">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="527">
<![CDATA[			homeAcceleration, 			// decel]]>
</Line>
<Line Number="528">
<![CDATA[			Unitspersec2, ]]>
</Line>
<Line Number="529">
<![CDATA[			SCurve, 					// profile]]>
</Line>
<Line Number="530">
<![CDATA[			jerkPercentage, 			// jerk accel]]>
</Line>
<Line Number="531">
<![CDATA[			jerkPercentage, 			// jerk decel]]>
</Line>
<Line Number="532">
<![CDATA[			%ofMaximum, 				// jerk units]]>
</Line>
<Line Number="533">
<![CDATA[			Enabled, 					// merge]]>
</Line>
<Line Number="534">
<![CDATA[			Programmed, 				// Programmed mean use the speed in this instruction]]>
</Line>
<Line Number="535">
<![CDATA[			0, ]]>
</Line>
<Line Number="536">
<![CDATA[			None);]]>
</Line>
<Line Number="537">
<![CDATA[		state := 1110;]]>
</Line>
<Line Number="538">
<![CDATA[	]]>
</Line>
<Line Number="539">
<![CDATA[	1110:]]>
</Line>
<Line Number="540">
<![CDATA[		if axis.PositionError > 1.0 then]]>
</Line>
<Line Number="541">
<![CDATA[			state := 1120;]]>
</Line>
<Line Number="542">
<![CDATA[		end_if;]]>
</Line>
<Line Number="543">
<![CDATA[		]]>
</Line>
<Line Number="544">
<![CDATA[		if axis.TorqueLimitStatus then]]>
</Line>
<Line Number="545">
<![CDATA[			state := 1120;]]>
</Line>
<Line Number="546">
<![CDATA[		end_if;]]>
</Line>
<Line Number="547">
<![CDATA[		]]>
</Line>
<Line Number="548">
<![CDATA[	1120:]]>
</Line>
<Line Number="549">
<![CDATA[		MAS(axis, ]]>
</Line>
<Line Number="550">
<![CDATA[			mas, ]]>
</Line>
<Line Number="551">
<![CDATA[			All,			// stop type]]>
</Line>
<Line Number="552">
<![CDATA[			No,				// change decel]]>
</Line>
<Line Number="553">
<![CDATA[			10.0, 			// decel]]>
</Line>
<Line Number="554">
<![CDATA[			Unitspersec2,	// decel units]]>
</Line>
<Line Number="555">
<![CDATA[			No,				// change jerk]]>
</Line>
<Line Number="556">
<![CDATA[			10.0,			// decel jerk]]>
</Line>
<Line Number="557">
<![CDATA[			Unitspersec3 	// jerk units]]>
</Line>
<Line Number="558">
<![CDATA[			);]]>
</Line>
<Line Number="559">
<![CDATA[		if mas.DN then]]>
</Line>
<Line Number="560">
<![CDATA[			]]>
</Line>
<Line Number="561">
<![CDATA[			state := 1130;]]>
</Line>
<Line Number="562">
<![CDATA[		end_if;]]>
</Line>
<Line Number="563">
<![CDATA[	1130:]]>
</Line>
<Line Number="564">
<![CDATA[		]]>
</Line>
<Line Number="565">
<![CDATA[		if mas.PC then]]>
</Line>
<Line Number="566">
<![CDATA[			state := 1140;]]>
</Line>
<Line Number="567">
<![CDATA[		end_if;]]>
</Line>
<Line Number="568">
<![CDATA[		]]>
</Line>
<Line Number="569">
<![CDATA[	1140:]]>
</Line>
<Line Number="570">
<![CDATA[		MAH(axis, mah);		]]>
</Line>
<Line Number="571">
<![CDATA[		state := 1150;]]>
</Line>
<Line Number="572">
<![CDATA[		]]>
</Line>
<Line Number="573">
<![CDATA[	1150:]]>
</Line>
<Line Number="574">
<![CDATA[		if mah.DN then]]>
</Line>
<Line Number="575">
<![CDATA[			// restore torque limit set]]>
</Line>
<Line Number="576">
<![CDATA[			axis.TorqueLimitNegative := saveTorque;]]>
</Line>
<Line Number="577">
<![CDATA[			axis.TorqueLimitPositive := saveTorque;]]>
</Line>
<Line Number="578">
<![CDATA[			home := 0;]]>
</Line>
<Line Number="579">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="580">
<![CDATA[		end_If;]]>
</Line>
<Line Number="581">
<![CDATA[]]>
</Line>
<Line Number="582">
<![CDATA[#endregion 	]]>
</Line>
<Line Number="583">
<![CDATA[	]]>
</Line>
<Line Number="584">
<![CDATA[		;]]>
</Line>
<Line Number="585">
<![CDATA[#region set current axis positon		]]>
</Line>
<Line Number="586">
<![CDATA[	/// set the current position to specified value]]>
</Line>
<Line Number="587">
<![CDATA[	2000:]]>
</Line>
<Line Number="588">
<![CDATA[		MRP(axis, mrp, Absolute, Actual, newPosition);]]>
</Line>
<Line Number="589">
<![CDATA[		state := 2005;]]>
</Line>
<Line Number="590">
<![CDATA[		]]>
</Line>
<Line Number="591">
<![CDATA[	2005:]]>
</Line>
<Line Number="592">
<![CDATA[		if mrp.DN then]]>
</Line>
<Line Number="593">
<![CDATA[			state := 2010;]]>
</Line>
<Line Number="594">
<![CDATA[		end_if;]]>
</Line>
<Line Number="595">
<![CDATA[	]]>
</Line>
<Line Number="596">
<![CDATA[	2010:]]>
</Line>
<Line Number="597">
<![CDATA[		setNewPosition := 0;]]>
</Line>
<Line Number="598">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="599">
<![CDATA[]]>
</Line>
<Line Number="600">
<![CDATA[#endregion]]>
</Line>
<Line Number="601">
<![CDATA[]]>
</Line>
<Line Number="602">
<![CDATA[	5000:]]>
</Line>
<Line Number="603">
<![CDATA[]]>
</Line>
<Line Number="604">
<![CDATA[end_case;]]>
</Line>
<Line Number="605">
<![CDATA[]]>
</Line>
<Line Number="606">
<![CDATA[]]>
</Line>
<Line Number="607">
<![CDATA[stateLast := state;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
