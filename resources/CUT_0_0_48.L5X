<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Last updated: 2025-08-25 12:28:40]]>
</Line>
<Line Number="1">
<![CDATA[// Author: manusolve]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="4">
<![CDATA[isLogMessage := 0;			// cleared every scan]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[GSV(WallClockTime, ,CurrentValue, stamp[0]);]]>
</Line>
<Line Number="7">
<![CDATA[timeOpDuration := stamp[0] - timeOpStart;]]>
</Line>
<Line Number="8">
<![CDATA[timeOpDuration := (timeOpDuration * 0.001);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[case state of]]>
</Line>
<Line Number="11">
<![CDATA[	-1:]]>
</Line>
<Line Number="12">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="13">
<![CDATA[		]]>
</Line>
<Line Number="14">
<![CDATA[	0:]]>
</Line>
<Line Number="15">
<![CDATA[		// set params]]>
</Line>
<Line Number="16">
<![CDATA[		]]>
</Line>
<Line Number="17">
<![CDATA[		timeMachineCycleStart := 125; 		// ms delay for machine to rec'v cycle start]]>
</Line>
<Line Number="18">
<![CDATA[		timeHandOffGripperDelay := 250;		// delay after gripper operations]]>
</Line>
<Line Number="19">
<![CDATA[		timeTimeoutDefault := 10000;			// default time out for collet and gripper operations before error]]>
</Line>
<Line Number="20">
<![CDATA[		timeMachineCycleTimeout := 120000; 	// timeout for machine cycle (machine should show error before this)]]>
</Line>
<Line Number="21">
<![CDATA[		positionThreshold := 0.35;]]>
</Line>
<Line Number="22">
<![CDATA[		]]>
</Line>
<Line Number="23">
<![CDATA[		opEndState := 2000;]]>
</Line>
<Line Number="24">
<![CDATA[		opErrorState := 3000;]]>
</Line>
<Line Number="25">
<![CDATA[		]]>
</Line>
<Line Number="26">
<![CDATA[		]]>
</Line>
<Line Number="27">
<![CDATA[		// reset for new run]]>
</Line>
<Line Number="28">
<![CDATA[		index := 0;]]>
</Line>
<Line Number="29">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="30">
<![CDATA[		errorCode := 0;]]>
</Line>
<Line Number="31">
<![CDATA[		]]>
</Line>
<Line Number="32">
<![CDATA[		waitAtIndex := -1;]]>
</Line>
<Line Number="33">
<![CDATA[		waiting := 0;]]>
</Line>
<Line Number="34">
<![CDATA[		unclampOutputOnReturn := 0;]]>
</Line>
<Line Number="35">
<![CDATA[		]]>
</Line>
<Line Number="36">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="37">
<![CDATA[	10:]]>
</Line>
<Line Number="38">
<![CDATA[		// wait for not DN]]>
</Line>
<Line Number="39">
<![CDATA[		if not DN then]]>
</Line>
<Line Number="40">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="41">
<![CDATA[		end_if;]]>
</Line>
<Line Number="42">
<![CDATA[	]]>
</Line>
<Line Number="43">
<![CDATA[	100:]]>
</Line>
<Line Number="44">
<![CDATA[		// entry]]>
</Line>
<Line Number="45">
<![CDATA[		COP(seq.ops[index], currOp, 1);]]>
</Line>
<Line Number="46">
<![CDATA[		state := 150;]]>
</Line>
<Line Number="47">
<![CDATA[		]]>
</Line>
<Line Number="48">
<![CDATA[		if currOp.type = 0 then]]>
</Line>
<Line Number="49">
<![CDATA[			state := 4000;]]>
</Line>
<Line Number="50">
<![CDATA[		end_if;]]>
</Line>
<Line Number="51">
<![CDATA[		]]>
</Line>
<Line Number="52">
<![CDATA[		xAxis.disable := 0;]]>
</Line>
<Line Number="53">
<![CDATA[		zAxis.disable := 0;]]>
</Line>
<Line Number="54">
<![CDATA[		stepWait := 0;]]>
</Line>
<Line Number="55">
<![CDATA[		errorCode := 0;]]>
</Line>
<Line Number="56">
<![CDATA[		]]>
</Line>
<Line Number="57">
<![CDATA[	150:]]>
</Line>
<Line Number="58">
<![CDATA[		if waitAtIndex = index then]]>
</Line>
<Line Number="59">
<![CDATA[			stepWait := 1;]]>
</Line>
<Line Number="60">
<![CDATA[		elsif step then]]>
</Line>
<Line Number="61">
<![CDATA[			stepWait := 0;]]>
</Line>
<Line Number="62">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="63">
<![CDATA[		else]]>
</Line>
<Line Number="64">
<![CDATA[			stepWait := 1;]]>
</Line>
<Line Number="65">
<![CDATA[		end_if;]]>
</Line>
<Line Number="66">
<![CDATA[		]]>
</Line>
<Line Number="67">
<![CDATA[	200:]]>
</Line>
<Line Number="68">
<![CDATA[		// these are the defaults; we have the option to later]]>
</Line>
<Line Number="69">
<![CDATA[		// apply overrides on a per operation basis.]]>
</Line>
<Line Number="70">
<![CDATA[		AxisSetMotionParams(setMP, xAxis, head.param.xMotion);]]>
</Line>
<Line Number="71">
<![CDATA[		AxisSetMotionParams(setMP, zAxis, head.param.zMotion);]]>
</Line>
<Line Number="72">
<![CDATA[		]]>
</Line>
<Line Number="73">
<![CDATA[		case currOp.type of]]>
</Line>
<Line Number="74">
<![CDATA[			]]>
</Line>
<Line Number="75">
<![CDATA[			0:	// empty]]>
</Line>
<Line Number="76">
<![CDATA[				state := 4000;]]>
</Line>
<Line Number="77">
<![CDATA[			5:  // precheck]]>
</Line>
<Line Number="78">
<![CDATA[				state := 300;]]>
</Line>
<Line Number="79">
<![CDATA[			7:	// wait for feed]]>
</Line>
<Line Number="80">
<![CDATA[				state := 350;]]>
</Line>
<Line Number="81">
<![CDATA[			8:	// wait for cut]]>
</Line>
<Line Number="82">
<![CDATA[				state := 360;]]>
</Line>
<Line Number="83">
<![CDATA[				(*]]>
</Line>
<Line Number="84">
<![CDATA[				10: "X Move to Forming Position",]]>
</Line>
<Line Number="85">
<![CDATA[        		11: "X Move to Handoff Position",]]>
</Line>
<Line Number="86">
<![CDATA[        		12: "X Move to Input",]]>
</Line>
<Line Number="87">
<![CDATA[				*)]]>
</Line>
<Line Number="88">
<![CDATA[			10..14:	// xMoves]]>
</Line>
<Line Number="89">
<![CDATA[				state := 400;			]]>
</Line>
<Line Number="90">
<![CDATA[			15..19: // zMoves]]>
</Line>
<Line Number="91">
<![CDATA[				state := 450;]]>
</Line>
<Line Number="92">
<![CDATA[				]]>
</Line>
<Line Number="93">
<![CDATA[			100:	// move to forming]]>
</Line>
<Line Number="94">
<![CDATA[				state := 420;]]>
</Line>
<Line Number="95">
<![CDATA[			110:	// move to output handoff ]]>
</Line>
<Line Number="96">
<![CDATA[				state := 470;]]>
</Line>
<Line Number="97">
<![CDATA[				]]>
</Line>
<Line Number="98">
<![CDATA[			20: // collet clamp]]>
</Line>
<Line Number="99">
<![CDATA[				state := 500;			]]>
</Line>
<Line Number="100">
<![CDATA[			21: // collet unclamp]]>
</Line>
<Line Number="101">
<![CDATA[				state := 550;]]>
</Line>
<Line Number="102">
<![CDATA[			25: // raise collet]]>
</Line>
<Line Number="103">
<![CDATA[				state := 600;]]>
</Line>
<Line Number="104">
<![CDATA[			26: // lower collet (leaving the cylinder pressurised)]]>
</Line>
<Line Number="105">
<![CDATA[				state := 650;]]>
</Line>
<Line Number="106">
<![CDATA[			]]>
</Line>
<Line Number="107">
<![CDATA[			/// input hand off commands]]>
</Line>
<Line Number="108">
<![CDATA[			30: // request input hand off clamp (inputHandoff)]]>
</Line>
<Line Number="109">
<![CDATA[				state := 700;]]>
</Line>
<Line Number="110">
<![CDATA[			31: // request input hand off unclamp]]>
</Line>
<Line Number="111">
<![CDATA[				state := 750;]]>
</Line>
<Line Number="112">
<![CDATA[				]]>
</Line>
<Line Number="113">
<![CDATA[			/// output hand off commands]]>
</Line>
<Line Number="114">
<![CDATA[			40: // request output hand off clamp (outputHandoff)]]>
</Line>
<Line Number="115">
<![CDATA[				state := 800;]]>
</Line>
<Line Number="116">
<![CDATA[			41: // request output hand off unclamp]]>
</Line>
<Line Number="117">
<![CDATA[				state := 850;]]>
</Line>
<Line Number="118">
<![CDATA[			42: // bump move to displace pipe]]>
</Line>
<Line Number="119">
<![CDATA[				bumpCounter := bumpCount;]]>
</Line>
<Line Number="120">
<![CDATA[				state := 450;]]>
</Line>
<Line Number="121">
<![CDATA[			44:	// drop output hand off on return stroke]]>
</Line>
<Line Number="122">
<![CDATA[				if outputHandoff.gripper.partPresent then]]>
</Line>
<Line Number="123">
<![CDATA[					unclampOutputOnReturn := 1;]]>
</Line>
<Line Number="124">
<![CDATA[					unclampOuputPosition := currOp.xPos;]]>
</Line>
<Line Number="125">
<![CDATA[				end_if;]]>
</Line>
<Line Number="126">
<![CDATA[				state := opEndState;]]>
</Line>
<Line Number="127">
<![CDATA[			45: // output handoff init]]>
</Line>
<Line Number="128">
<![CDATA[				state := 870;]]>
</Line>
<Line Number="129">
<![CDATA[			]]>
</Line>
<Line Number="130">
<![CDATA[			/// coordination	]]>
</Line>
<Line Number="131">
<![CDATA[			50: // wait on all clear ]]>
</Line>
<Line Number="132">
<![CDATA[				state := 950;]]>
</Line>
<Line Number="133">
<![CDATA[				]]>
</Line>
<Line Number="134">
<![CDATA[			/// cycles]]>
</Line>
<Line Number="135">
<![CDATA[			60: // cycle head 1]]>
</Line>
<Line Number="136">
<![CDATA[				xAxis.disable := 1;]]>
</Line>
<Line Number="137">
<![CDATA[				state := 1000;]]>
</Line>
<Line Number="138">
<![CDATA[			61: // cycle head 2]]>
</Line>
<Line Number="139">
<![CDATA[				xAxis.disable := 1;]]>
</Line>
<Line Number="140">
<![CDATA[				state := 1050;]]>
</Line>
<Line Number="141">
<![CDATA[			else]]>
</Line>
<Line Number="142">
<![CDATA[				// Invalid operation type]]>
</Line>
<Line Number="143">
<![CDATA[				errorState := state;]]>
</Line>
<Line Number="144">
<![CDATA[				state := opErrorState;]]>
</Line>
<Line Number="145">
<![CDATA[		end_case;]]>
</Line>
<Line Number="146">
<![CDATA[		timeOpStart := stamp[0];]]>
</Line>
<Line Number="147">
<![CDATA[]]>
</Line>
<Line Number="148">
<![CDATA[#region precheck]]>
</Line>
<Line Number="149">
<![CDATA[	// precheck operation]]>
</Line>
<Line Number="150">
<![CDATA[	300:]]>
</Line>
<Line Number="151">
<![CDATA[		// check if machine is needed and ready]]>
</Line>
<Line Number="152">
<![CDATA[		isMachineNeeded := ]]>
</Line>
<Line Number="153">
<![CDATA[			hProgram.isHead1 or hProgram.isHead2;]]>
</Line>
<Line Number="154">
<![CDATA[			//or machineParam.type = 0;		// cutter]]>
</Line>
<Line Number="155">
<![CDATA[		]]>
</Line>
<Line Number="156">
<![CDATA[		xAxis.disable := 0;]]>
</Line>
<Line Number="157">
<![CDATA[		zAxis.disable := 0;]]>
</Line>
<Line Number="158">
<![CDATA[		]]>
</Line>
<Line Number="159">
<![CDATA[		if isMachineNeeded then]]>
</Line>
<Line Number="160">
<![CDATA[			if machine.isReady and not machine.isError then				]]>
</Line>
<Line Number="161">
<![CDATA[				state := 310;]]>
</Line>
<Line Number="162">
<![CDATA[			else]]>
</Line>
<Line Number="163">
<![CDATA[				errorState := state;]]>
</Line>
<Line Number="164">
<![CDATA[				state := opErrorState;]]>
</Line>
<Line Number="165">
<![CDATA[			end_if;]]>
</Line>
<Line Number="166">
<![CDATA[		else]]>
</Line>
<Line Number="167">
<![CDATA[			state := 310;]]>
</Line>
<Line Number="168">
<![CDATA[		end_if;]]>
</Line>
<Line Number="169">
<![CDATA[	]]>
</Line>
<Line Number="170">
<![CDATA[	310:]]>
</Line>
<Line Number="171">
<![CDATA[		// check position of the head matches the correct start position]]>
</Line>
<Line Number="172">
<![CDATA[		// x, z should be at the input handoff]]>
</Line>
<Line Number="173">
<![CDATA[		// collet should be unclamped]]>
</Line>
<Line Number="174">
<![CDATA[		if ABS(xAxis.currentPosition - currOp.xPos) > positionThreshold then]]>
</Line>
<Line Number="175">
<![CDATA[			logMessage := 'X axis not in init position';]]>
</Line>
<Line Number="176">
<![CDATA[			]]>
</Line>
<Line Number="177">
<![CDATA[			//state := opErrorState;]]>
</Line>
<Line Number="178">
<![CDATA[		elsif ABS(zAxis.currentPosition - currOp.zPos) > positionThreshold then		]]>
</Line>
<Line Number="179">
<![CDATA[			logMessage := 'Z axis not in init position';]]>
</Line>
<Line Number="180">
<![CDATA[			//state := opErrorState;]]>
</Line>
<Line Number="181">
<![CDATA[		else]]>
</Line>
<Line Number="182">
<![CDATA[			state := 320;]]>
</Line>
<Line Number="183">
<![CDATA[		end_if;]]>
</Line>
<Line Number="184">
<![CDATA[		]]>
</Line>
<Line Number="185">
<![CDATA[		// change state expected]]>
</Line>
<Line Number="186">
<![CDATA[		if state = stateLast then			]]>
</Line>
<Line Number="187">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="188">
<![CDATA[			isLogMessage := 1;]]>
</Line>
<Line Number="189">
<![CDATA[		end_if;]]>
</Line>
<Line Number="190">
<![CDATA[		]]>
</Line>
<Line Number="191">
<![CDATA[	320:]]>
</Line>
<Line Number="192">
<![CDATA[		// other checks]]>
</Line>
<Line Number="193">
<![CDATA[		]]>
</Line>
<Line Number="194">
<![CDATA[		// for the cutter must ]]>
</Line>
<Line Number="195">
<![CDATA[		if machineParam.type = 0 and machine.isWorking then]]>
</Line>
<Line Number="196">
<![CDATA[			]]>
</Line>
<Line Number="197">
<![CDATA[			;]]>
</Line>
<Line Number="198">
<![CDATA[			]]>
</Line>
<Line Number="199">
<![CDATA[		end_if;]]>
</Line>
<Line Number="200">
<![CDATA[		]]>
</Line>
<Line Number="201">
<![CDATA[		state := 340;]]>
</Line>
<Line Number="202">
<![CDATA[	340:]]>
</Line>
<Line Number="203">
<![CDATA[		state := opEndState;]]>
</Line>
<Line Number="204">
<![CDATA[		;]]>
</Line>
<Line Number="205">
<![CDATA[#endregion]]>
</Line>
<Line Number="206">
<![CDATA[]]>
</Line>
<Line Number="207">
<![CDATA[	// wait for feed]]>
</Line>
<Line Number="208">
<![CDATA[	350:]]>
</Line>
<Line Number="209">
<![CDATA[		if inputFeedReady or not incomingPart then]]>
</Line>
<Line Number="210">
<![CDATA[			state := opEndState;]]>
</Line>
<Line Number="211">
<![CDATA[		end_if;]]>
</Line>
<Line Number="212">
<![CDATA[		]]>
</Line>
<Line Number="213">
<![CDATA[	// wait for cut]]>
</Line>
<Line Number="214">
<![CDATA[	360:]]>
</Line>
<Line Number="215">
<![CDATA[		if incomingPart then]]>
</Line>
<Line Number="216">
<![CDATA[			zAxis.disable := 1;]]>
</Line>
<Line Number="217">
<![CDATA[			]]>
</Line>
<Line Number="218">
<![CDATA[			// we'll just take it that if the inputFeed is]]>
</Line>
<Line Number="219">
<![CDATA[			// now not ready then the cut is complete]]>
</Line>
<Line Number="220">
<![CDATA[			//if not inputFeedReady then]]>
</Line>
<Line Number="221">
<![CDATA[			if cutDone then]]>
</Line>
<Line Number="222">
<![CDATA[				zAxis.disable := 0;]]>
</Line>
<Line Number="223">
<![CDATA[				state := 370;]]>
</Line>
<Line Number="224">
<![CDATA[			end_if;]]>
</Line>
<Line Number="225">
<![CDATA[		else]]>
</Line>
<Line Number="226">
