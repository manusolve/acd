<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[mAxis(x[0], X1, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="2">
<![CDATA[mAxis(x[1], X2, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="3">
<![CDATA[mAxis(x[2], X3, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="4">
<![CDATA[mAxis(x[3], X4, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[mAxis(z[0], Z1, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="7">
<![CDATA[mAxis(z[1], Z2, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="8">
<![CDATA[mAxis(z[2], Z3, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="9">
<![CDATA[mAxis(z[3], Z4, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[mAxis(y, Y0, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="12">
<![CDATA[mAxis(zIn, Z0, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="13">
<![CDATA[mAxis(xIn, X0, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[// variable for home to stop test]]>
</Line>
<Line Number="17">
<![CDATA[(*]]>
</Line>
<Line Number="18">
<![CDATA[y.jogDirection := 1;]]>
</Line>
<Line Number="19">
<![CDATA[y.speed := 25.0;]]>
</Line>
<Line Number="20">
<![CDATA[y.accel := 10.0;]]>
</Line>
<Line Number="21">
<![CDATA[y.decel := 10.0;]]>
</Line>
<Line Number="22">
<![CDATA[y.jerkPercentage := 50.0;]]>
</Line>
<Line Number="23">
<![CDATA[*)]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[mAxis(bladeF, BladeFeed, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[//Y0.SoftTravelLimitNegative]]>
</Line>
<Line Number="28">
<![CDATA[//GSV(Axis, Y0, SoftTravelLimitNegative, someDint);]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[/// range limitations, for example how could zones cause a stop]]>
</Line>
<Line Number="31">
<![CDATA[// real time check; not read ahead]]>
</Line>
<Line Number="32">
<![CDATA[if z[3].currentPosition < 500 then]]>
</Line>
<Line Number="33">
<![CDATA[	if x[3].currentPosition > 3200 then]]>
</Line>
<Line Number="34">
<![CDATA[		;]]>
</Line>
<Line Number="35">
<![CDATA[	end_if;]]>
</Line>
<Line Number="36">
<![CDATA[end_if;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[// global timestamp]]>
</Line>
<Line Number="39">
<![CDATA[GSV(WallClockTime, ,CurrentValue, timeStamp[0]);]]>
</Line>
</STContent>
