<Line Number="447">
<![CDATA[		// the count has to be done here as flag is]]>
</Line>
<Line Number="448">
<![CDATA[		// reset by next cycle]]>
</Line>
<Line Number="449">
<![CDATA[		if runHead[3].unclampOutputOnReturn and runHead[3].state = 4000 then]]>
</Line>
<Line Number="450">
<![CDATA[			// if this was set a part made it to the last handoff]]>
</Line>
<Line Number="451">
<![CDATA[			// we can count it.]]>
</Line>
<Line Number="452">
<![CDATA[			partCount := partCount + 1;				// this is resetable for the operator]]>
</Line>
<Line Number="453">
<![CDATA[			partCountTotal := partCountTotal + 1;	// this is not resettable]]>
</Line>
<Line Number="454">
<![CDATA[		end_if;]]>
</Line>
<Line Number="455">
<![CDATA[	]]>
</Line>
<Line Number="456">
<![CDATA[		if allDone then]]>
</Line>
<Line Number="457">
<![CDATA[			state := 790;]]>
</Line>
<Line Number="458">
<![CDATA[		end_if;]]>
</Line>
<Line Number="459">
<![CDATA[	]]>
</Line>
<Line Number="460">
<![CDATA[	// end cycle exit]]>
</Line>
<Line Number="461">
<![CDATA[	790:]]>
</Line>
<Line Number="462">
<![CDATA[		case modeSelect of]]>
</Line>
<Line Number="463">
<![CDATA[			0:]]>
</Line>
<Line Number="464">
<![CDATA[				state := 800;]]>
</Line>
<Line Number="465">
<![CDATA[			1:]]>
</Line>
<Line Number="466">
<![CDATA[				// init cycle is completed]]>
</Line>
<Line Number="467">
<![CDATA[				// Auto set we want incoming parts.]]>
</Line>
<Line Number="468">
<![CDATA[				\PartPresent.inputProcessIncoming := 1;]]>
</Line>
<Line Number="469">
<![CDATA[				state := 10;]]>
</Line>
<Line Number="470">
<![CDATA[			2:]]>
</Line>
<Line Number="471">
<![CDATA[				// clear all complete]]>
</Line>
<Line Number="472">
<![CDATA[				clearAll := 0;]]>
</Line>
<Line Number="473">
<![CDATA[				state := 10;]]>
</Line>
<Line Number="474">
<![CDATA[		]]>
</Line>
<Line Number="475">
<![CDATA[		end_case;]]>
</Line>
<Line Number="476">
<![CDATA[		]]>
</Line>
<Line Number="477">
<![CDATA[	]]>
</Line>
<Line Number="478">
<![CDATA[	// cycle pass complete]]>
</Line>
<Line Number="479">
<![CDATA[	800:]]>
</Line>
<Line Number="480">
<![CDATA[		]]>
</Line>
<Line Number="481">
<![CDATA[		cyclePassCount := cyclePassCount + 1;]]>
</Line>
<Line Number="482">
<![CDATA[		 ]]>
</Line>
<Line Number="483">
<![CDATA[		cycleTime := (timeStamp[0] - timeStart) * 0.001 * 0.001;]]>
</Line>
<Line Number="484">
<![CDATA[		]]>
</Line>
<Line Number="485">
<![CDATA[		\Event.source := 1000; 			// Event end of the cycle]]>
</Line>
<Line Number="486">
<![CDATA[		\Event.message := 'Cycle pass complete in ';]]>
</Line>
<Line Number="487">
<![CDATA[		RTOS(cycleTime, \Event.tempString);]]>
</Line>
<Line Number="488">
<![CDATA[		CONCAT(\Event.message, \Event.tempString, \Event.message);]]>
</Line>
<Line Number="489">
<![CDATA[		\Event.tempString := ' seconds';]]>
</Line>
<Line Number="490">
<![CDATA[		CONCAT(\Event.message, \Event.tempString, \Event.message);]]>
</Line>
<Line Number="491">
<![CDATA[		EVENT(LogEvent);]]>
</Line>
<Line Number="492">
<![CDATA[		]]>
</Line>
<Line Number="493">
<![CDATA[		state := 680;					// go back to repeat cycle]]>
</Line>
<Line Number="494">
<![CDATA[		]]>
</Line>
<Line Number="495">
<![CDATA[		// test for stop on empty]]>
</Line>
<Line Number="496">
<![CDATA[		]]>
</Line>
<Line Number="497">
<![CDATA[		if 	not \PartPresent.anyHandoff and ]]>
</Line>
<Line Number="498">
<![CDATA[			not \PartPresent.anyHeads and]]>
</Line>
<Line Number="499">
<![CDATA[			not \PartPresent.inputProcessIncoming]]>
</Line>
<Line Number="500">
<![CDATA[		then]]>
</Line>
<Line Number="501">
<![CDATA[			state := 10;]]>
</Line>
<Line Number="502">
<![CDATA[		end_if;]]>
</Line>
<Line Number="503">
<![CDATA[		]]>
</Line>
<Line Number="504">
<![CDATA[		if \OutputHandler.isBinsFull then]]>
</Line>
<Line Number="505">
<![CDATA[			\Event.source := 1000; 			// Event end of the cycle]]>
</Line>
<Line Number="506">
<![CDATA[			\Event.message := 'Cycle stopped on bins full';]]>
</Line>
<Line Number="507">
<![CDATA[			\Event.logLevel := 2;			]]>
</Line>
<Line Number="508">
<![CDATA[			EVENT(LogEvent);]]>
</Line>
<Line Number="509">
<![CDATA[			state := 10;]]>
</Line>
<Line Number="510">
<![CDATA[		end_if;]]>
</Line>
<Line Number="511">
<![CDATA[		]]>
</Line>
<Line Number="512">
<![CDATA[	5000:]]>
</Line>
<Line Number="513">
<![CDATA[		// opErrorState]]>
</Line>
<Line Number="514">
<![CDATA[		// abnormal condition]]>
</Line>
<Line Number="515">
<![CDATA[		message := 'abnormal condition - B to reset';]]>
</Line>
<Line Number="516">
<![CDATA[		]]>
</Line>
<Line Number="517">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="518">
<![CDATA[		]]>
</Line>
<Line Number="519">
<![CDATA[		// stop any motion ]]>
</Line>
<Line Number="520">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="521">
<![CDATA[			\Axes.x[counter].move := 0;]]>
</Line>
<Line Number="522">
<![CDATA[			\Axes.z[counter].move := 0;]]>
</Line>
<Line Number="523">
<![CDATA[		end_for;]]>
</Line>
<Line Number="524">
<![CDATA[		]]>
</Line>
<Line Number="525">
<![CDATA[		if bButtonEdge.OutputBit then]]>
</Line>
<Line Number="526">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="527">
<![CDATA[		end_if;]]>
</Line>
<Line Number="528">
<![CDATA[		]]>
</Line>
<Line Number="529">
<![CDATA[	else]]>
</Line>
<Line Number="530">
<![CDATA[		errorState := state;]]>
</Line>
<Line Number="531">
<![CDATA[		state := opErrorState;]]>
</Line>
<Line Number="532">
<![CDATA[]]>
</Line>
<Line Number="533">
<![CDATA[end_case;]]>
</Line>
<Line Number="534">
<![CDATA[]]>
</Line>
<Line Number="535">
<![CDATA[]]>
</Line>
<Line Number="536">
<![CDATA[stateLast := state;]]>
</Line>
<Line Number="537">
<![CDATA[requestStopLast := requestStop;]]>
</Line>
<Line Number="538">
<![CDATA[]]>
</Line>
<Line Number="539">
<![CDATA[(*]]>
</Line>
<Line Number="540">
<![CDATA[	runHead is executed continous]]>
</Line>
<Line Number="541">
<![CDATA[*)]]>
</Line>
<Line Number="542">
<![CDATA[]]>
</Line>
<Line Number="543">
<![CDATA[// runHeads are not executed in start state]]>
</Line>
<Line Number="544">
<![CDATA[if state = 0 then]]>
</Line>
<Line Number="545">
<![CDATA[	TND();]]>
</Line>
<Line Number="546">
<![CDATA[end_if;]]>
</Line>
<Line Number="547">
<![CDATA[]]>
</Line>
<Line Number="548">
<![CDATA[]]>
</Line>
<Line Number="549">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="550">
<![CDATA[	if headEnabled[counter] then]]>
</Line>
<Line Number="551">
<![CDATA[		]]>
</Line>
<Line Number="552">
<![CDATA[		case counter of ]]>
</Line>
<Line Number="553">
<![CDATA[			0:		runHead[counter].incomingPart := \PartPresent.inputProcessIncoming;]]>
</Line>
<Line Number="554">
<![CDATA[			1..3:	runHead[counter].incomingPart := \PartPresent.handOff[counter-1];]]>
</Line>
<Line Number="555">
<![CDATA[		end_case;]]>
</Line>
<Line Number="556">
<![CDATA[		]]>
</Line>
<Line Number="557">
<![CDATA[		// need to index runHead explicity for datacontext in logix]]>
</Line>
<Line Number="558">
<![CDATA[		case counter of]]>
</Line>
<Line Number="559">
<![CDATA[			0:]]>
</Line>
<Line Number="560">
<![CDATA[				// head 1 has no input handoff]]>
</Line>
<Line Number="561">
<![CDATA[				RunHead(runHead[0],]]>
</Line>
<Line Number="562">
<![CDATA[						\Heads.h[counter],]]>
</Line>
<Line Number="563">
<![CDATA[						\Axes.x[counter],]]>
</Line>
<Line Number="564">
<![CDATA[						\Axes.z[counter],  				]]>
</Line>
<Line Number="565">
<![CDATA[						currentSeqs[counter],				// headSeq]]>
</Line>
<Line Number="566">
<![CDATA[						\Machine.m[counter],				// MachineIO]]>
</Line>
<Line Number="567">
<![CDATA[						emptyHandoff,						// input handoff						]]>
</Line>
<Line Number="568">
<![CDATA[						\Handoffs.h[counter],				// output handoff]]>
</Line>
<Line Number="569">
<![CDATA[						logMessage,]]>
</Line>
<Line Number="570">
<![CDATA[						\Settings.hPrograms[counter],]]>
</Line>
<Line Number="571">
<![CDATA[						\Settings.machineParams[counter],]]>
</Line>
<Line Number="572">
<![CDATA[						\PartPresent.head[counter]]]>
</Line>
<Line Number="573">
<![CDATA[						);]]>
</Line>
<Line Number="574">
<![CDATA[]]>
</Line>
<Line Number="575">
<![CDATA[			1:			]]>
</Line>
<Line Number="576">
<![CDATA[				RunHead(runHead[1],]]>
</Line>
<Line Number="577">
<![CDATA[						\Heads.h[counter],]]>
</Line>
<Line Number="578">
<![CDATA[						\Axes.x[counter],]]>
</Line>
<Line Number="579">
<![CDATA[						\Axes.z[counter], ]]>
</Line>
<Line Number="580">
<![CDATA[						currentSeqs[counter],				// MachineIO]]>
</Line>
<Line Number="581">
<![CDATA[						\Machine.m[counter],				]]>
</Line>
<Line Number="582">
<![CDATA[						\Handoffs.h[counter-1],				// input handoff]]>
</Line>
<Line Number="583">
<![CDATA[						\Handoffs.h[counter],				// output handoff]]>
</Line>
<Line Number="584">
<![CDATA[						logMessage,]]>
</Line>
<Line Number="585">
<![CDATA[						\Settings.hPrograms[counter],]]>
</Line>
<Line Number="586">
<![CDATA[						\Settings.machineParams[counter],]]>
</Line>
<Line Number="587">
<![CDATA[						\PartPresent.head[counter]]]>
</Line>
<Line Number="588">
<![CDATA[						);]]>
</Line>
<Line Number="589">
<![CDATA[				]]>
</Line>
<Line Number="590">
<![CDATA[			2:]]>
</Line>
<Line Number="591">
<![CDATA[				RunHead(runHead[2],]]>
</Line>
<Line Number="592">
<![CDATA[						\Heads.h[counter],]]>
</Line>
<Line Number="593">
<![CDATA[						\Axes.x[counter],]]>
</Line>
<Line Number="594">
<![CDATA[						\Axes.z[counter], ]]>
</Line>
<Line Number="595">
<![CDATA[						currentSeqs[counter],				// MachineIO]]>
</Line>
<Line Number="596">
<![CDATA[						\Machine.m[counter],					// shuttleHead						]]>
</Line>
<Line Number="597">
<![CDATA[						\Handoffs.h[counter-1],				// input handoff]]>
</Line>
<Line Number="598">
<![CDATA[						\Handoffs.h[counter],				// output handoff]]>
</Line>
<Line Number="599">
<![CDATA[						logMessage,]]>
</Line>
<Line Number="600">
<![CDATA[						\Settings.hPrograms[counter],]]>
</Line>
<Line Number="601">
<![CDATA[						\Settings.machineParams[counter],]]>
</Line>
<Line Number="602">
<![CDATA[						\PartPresent.head[counter]]]>
</Line>
<Line Number="603">
<![CDATA[						);]]>
</Line>
<Line Number="604">
<![CDATA[]]>
</Line>
<Line Number="605">
<![CDATA[				]]>
</Line>
<Line Number="606">
<![CDATA[			3:]]>
</Line>
<Line Number="607">
<![CDATA[				RunHead(runHead[3],]]>
</Line>
<Line Number="608">
<![CDATA[						\Heads.h[counter],]]>
</Line>
<Line Number="609">
<![CDATA[						\Axes.x[counter],]]>
</Line>
<Line Number="610">
<![CDATA[						\Axes.z[counter],  ]]>
</Line>
<Line Number="611">
<![CDATA[						currentSeqs[counter],				// MachineIO]]>
</Line>
<Line Number="612">
<![CDATA[						\Machine.m[counter],					// shuttleHead]]>
</Line>
<Line Number="613">
<![CDATA[						\Handoffs.h[counter-1],				// input handoff]]>
</Line>
<Line Number="614">
<![CDATA[						\Handoffs.h[counter],				// output handoff]]>
</Line>
<Line Number="615">
<![CDATA[						logMessage,]]>
</Line>
<Line Number="616">
<![CDATA[						\Settings.hPrograms[counter],]]>
</Line>
<Line Number="617">
<![CDATA[						\Settings.machineParams[counter],]]>
</Line>
<Line Number="618">
<![CDATA[						\PartPresent.head[counter]]]>
</Line>
<Line Number="619">
<![CDATA[						);]]>
</Line>
<Line Number="620">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="621">
<![CDATA[		]]>
</Line>
<Line Number="622">
<![CDATA[		if runHead[counter].isLogMessage then					]]>
</Line>
<Line Number="623">
<![CDATA[			runHeadMessage[counter] := logMessage;			// keep a local copy for hmi]]>
</Line>
<Line Number="624">
<![CDATA[			\Event.message := logMessage;]]>
</Line>
<Line Number="625">
<![CDATA[			\Event.source := (1000 * counter) + runHead[counter].errorCode;	// need a address space for these]]>
</Line>
<Line Number="626">
<![CDATA[			]]>
</Line>
<Line Number="627">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="628">
<![CDATA[			runHead[counter].isLogMessage := 0;]]>
</Line>
<Line Number="629">
<![CDATA[		end_if;]]>
</Line>
<Line Number="630">
<![CDATA[	end_if;]]>
</Line>
<Line Number="631">
<![CDATA[end_for;]]>
</Line>
<Line Number="632">
<![CDATA[]]>
