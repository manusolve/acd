</Line>
<Line Number="437">
<![CDATA[			end_if;]]>
</Line>
<Line Number="438">
<![CDATA[		end_for;]]>
</Line>
<Line Number="439">
<![CDATA[		]]>
</Line>
<Line Number="440">
<![CDATA[		allDone := 1;]]>
</Line>
<Line Number="441">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="442">
<![CDATA[			if headEnabled[counter] then]]>
