<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(*]]>
</Line>
<Line Number="2">
<![CDATA[	Apply some default settings]]>
</Line>
<Line Number="3">
<![CDATA[	or different settings]]>
</Line>
<Line Number="4">
<![CDATA[	]]>
</Line>
<Line Number="5">
<![CDATA[	using state numbers so alternative settings]]>
</Line>
<Line Number="6">
<![CDATA[	in the case of maintenance, testing and development can be]]>
</Line>
<Line Number="7">
<![CDATA[	done without HMI/PC program setting]]>
</Line>
<Line Number="8">
<![CDATA[*)]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[(*]]>
</Line>
<Line Number="11">
<![CDATA[Handoff params]]>
</Line>
<Line Number="12">
<![CDATA[0 - is the positon where the handoff at the cuthead is done]]>
</Line>
<Line Number="13">
<![CDATA[1,2,3 are the arm positions]]>
</Line>
<Line Number="14">
<![CDATA[4 is the empty positon at the end]]>
</Line>
<Line Number="15">
<![CDATA[*)]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[(*]]>
</Line>
<Line Number="18">
<![CDATA[if cellProgram.outBinQty < 100 then]]>
</Line>
<Line Number="19">
<![CDATA[	cellProgram.outBinQty := 100;]]>
</Line>
<Line Number="20">
<![CDATA[end_if;]]>
</Line>
<Line Number="21">
<![CDATA[*)]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// limit deviation to 2]]>
</Line>
<Line Number="24">
<![CDATA[if cellProgram.outPart.deviation < -devLimitTemp then]]>
</Line>
<Line Number="25">
<![CDATA[	cellProgram.outPart.deviation := -devLimitTemp;]]>
</Line>
<Line Number="26">
<![CDATA[elsif cellProgram.outPart.deviation > devLimitTemp then]]>
</Line>
<Line Number="27">
<![CDATA[	cellProgram.outPart.deviation := devLimitTemp;]]>
</Line>
<Line Number="28">
<![CDATA[end_if;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="31">
<![CDATA[	if hPrograms[counter].head1Deviation < -devLimitTemp then]]>
</Line>
<Line Number="32">
<![CDATA[		hPrograms[counter].head1Deviation := -devLimitTemp;]]>
</Line>
<Line Number="33">
<![CDATA[	elsif hPrograms[counter].head1Deviation > devLimitTemp then]]>
</Line>
<Line Number="34">
<![CDATA[		hPrograms[counter].head1Deviation := devLimitTemp;]]>
</Line>
<Line Number="35">
<![CDATA[	end_if;]]>
</Line>
<Line Number="36">
<![CDATA[	if hPrograms[counter].head2Deviation < -devLimitTemp then]]>
</Line>
<Line Number="37">
<![CDATA[		hPrograms[counter].head2Deviation := -devLimitTemp;]]>
</Line>
<Line Number="38">
<![CDATA[	elsif hPrograms[counter].head2Deviation > devLimitTemp then]]>
</Line>
<Line Number="39">
<![CDATA[		hPrograms[counter].head2Deviation := devLimitTemp;]]>
</Line>
<Line Number="40">
<![CDATA[	end_if;]]>
</Line>
<Line Number="41">
<![CDATA[end_for;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[case mState of]]>
</Line>
<Line Number="44">
<![CDATA[	0:]]>
</Line>
<Line Number="45">
<![CDATA[		;]]>
</Line>
<Line Number="46">
<![CDATA[		]]>
</Line>
<Line Number="47">
<![CDATA[	10:]]>
</Line>
<Line Number="48">
<![CDATA[		]]>
</Line>
<Line Number="49">
<![CDATA[		inputProcessParam.stepperSpeed := 5.0;]]>
</Line>
<Line Number="50">
<![CDATA[		inputProcessParam.inputPushSpeed := 125.0;		]]>
</Line>
<Line Number="51">
<![CDATA[		]]>
</Line>
<Line Number="52">
<![CDATA[		inputProcessParam.measureMeasureSpeed := 50.0;]]>
</Line>
<Line Number="53">
<![CDATA[		inputProcessParam.measurePullSpeed := 150.0;]]>
</Line>
<Line Number="54">
<![CDATA[		inputProcessParam.sensorToPickup := 753.0;]]>
</Line>
<Line Number="55">
<![CDATA[		]]>
</Line>
<Line Number="56">
<![CDATA[		inputProcessParam.transferDropOffY := 164.5;]]>
</Line>
<Line Number="57">
<![CDATA[		inputProcessParam.transferDropOffY := 166.2;		// after install +1.5]]>
</Line>
<Line Number="58">
<![CDATA[		inputProcessParam.transferDropOffY := 166.0;		// noted diffin stored value]]>
</Line>
<Line Number="59">
<![CDATA[		]]>
</Line>
<Line Number="60">
<![CDATA[		inputProcessParam.transferPickUpY := 196.5;//194.0;			]]>
</Line>
<Line Number="61">
<![CDATA[	]]>
</Line>
<Line Number="62">
<![CDATA[		inputProcessParam.transferPickUpX := 25.0;]]>
</Line>
<Line Number="63">
<![CDATA[		inputProcessParam.transferWaitX := 725.0;]]>
</Line>
<Line Number="64">
<![CDATA[		inputProcessParam.transferDropOffX := 1005.28; //965.0;]]>
</Line>
<Line Number="65">
<![CDATA[		]]>
</Line>
<Line Number="66">
<![CDATA[	]]>
</Line>
<Line Number="67">
<![CDATA[		mState := 0;]]>
</Line>
<Line Number="68">
<![CDATA[	20:]]>
</Line>
<Line Number="69">
<![CDATA[		]]>
</Line>
<Line Number="70">
<![CDATA[		(*]]>
</Line>
<Line Number="71">
<![CDATA[		Nominal positions are:]]>
</Line>
<Line Number="72">
<![CDATA[			Handoffs]]>
</Line>
<Line Number="73">
<![CDATA[			0 - -175 // dump it to the left]]>
</Line>
<Line Number="74">
<![CDATA[			1 - 375]]>
</Line>
<Line Number="75">
<![CDATA[			2 - 1375]]>
</Line>
<Line Number="76">
<![CDATA[			3 - 2375]]>
</Line>
<Line Number="77">
<![CDATA[			4 - 3375 // output position]]>
</Line>
<Line Number="78">
<![CDATA[			]]>
</Line>
<Line Number="79">
