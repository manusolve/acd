<Tag Name="axis" TagType="Base" DataType="mAxis" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[[3,0,1.66666672e-001,0.00000000e+000,1.00000000e+001,1.00000000e+001,1.00000000e+002,-1.05935919e+000
