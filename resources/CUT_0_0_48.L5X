<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// process mode]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[JSR(ProcessMode);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[GSV(WallClockTime, ,CurrentValue, stamp[0]);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// not enabled]]>
</Line>
<Line Number="7">
<![CDATA[If not \Safety.ENABLE_ALL then	]]>
</Line>
<Line Number="8">
<![CDATA[	TND(); ]]>
</Line>
<Line Number="9">
<![CDATA[end_if;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="ProcessMode" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if mode0 and not mode1 then]]>
</Line>
<Line Number="2">
<![CDATA[	modeSelect := 0; // prog]]>
</Line>
<Line Number="3">
<![CDATA[elsif not mode0 and mode1 then]]>
</Line>
<Line Number="4">
<![CDATA[	modeSelect := 1; // man]]>
</Line>
<Line Number="5">
<![CDATA[elsif mode0 and mode1 then]]>
</Line>
<Line Number="6">
<![CDATA[	modeSelect := -1; //error in buttons]]>
</Line>
<Line Number="7">
<![CDATA[else]]>
</Line>
<Line Number="8">
<![CDATA[	modeSelect := 2; // auto]]>
</Line>
<Line Number="9">
<![CDATA[end_if;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[(*]]>
</Line>
<Line Number="12">
<![CDATA[if not \Safety.ES then ]]>
</Line>
<Line Number="13">
<![CDATA[	modeSelect := -1;]]>
</Line>
<Line Number="14">
<![CDATA[end_if;]]>
</Line>
<Line Number="15">
<![CDATA[*)]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[TONR(modeTimer);]]>
</Line>
<Line Number="18">
<![CDATA[modeSwitched := modeSelect <> modeCurrent;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[case modeState of]]>
</Line>
<Line Number="21">
<![CDATA[	0:]]>
</Line>
<Line Number="22">
<![CDATA[		modeTimer.Reset := 1;]]>
</Line>
<Line Number="23">
<![CDATA[		modeState := 10;]]>
</Line>
<Line Number="24">
<![CDATA[		]]>
</Line>
<Line Number="25">
<![CDATA[	10:]]>
</Line>
<Line Number="26">
<![CDATA[		if modeSwitched then]]>
</Line>
<Line Number="27">
<![CDATA[			modeTimer.Reset := 1;]]>
</Line>
<Line Number="28">
<![CDATA[			modeState := 12;]]>
</Line>
<Line Number="29">
<![CDATA[		end_if;]]>
</Line>
<Line Number="30">
<![CDATA[		modeLast := modeSelect;]]>
</Line>
<Line Number="31">
<![CDATA[	12:]]>
</Line>
<Line Number="32">
<![CDATA[		// timer to filter mode changes]]>
</Line>
<Line Number="33">
<![CDATA[		TimerStart(tS, modeTimer, 100);]]>
</Line>
<Line Number="34">
<![CDATA[		modeState := 15;]]>
</Line>
<Line Number="35">
<![CDATA[	]]>
</Line>
<Line Number="36">
<![CDATA[	15:]]>
</Line>
<Line Number="37">
<![CDATA[		if modeSelect <> modeLast then]]>
</Line>
<Line Number="38">
<![CDATA[			modeState := 10;]]>
</Line>
<Line Number="39">
<![CDATA[		end_if;]]>
</Line>
<Line Number="40">
<![CDATA[		if modeTimer.DN then]]>
</Line>
<Line Number="41">
<![CDATA[			modeState := 20;]]>
</Line>
<Line Number="42">
<![CDATA[		end_if;]]>
</Line>
<Line Number="43">
<![CDATA[		]]>
</Line>
<Line Number="44">
<![CDATA[	20:]]>
</Line>
<Line Number="45">
<![CDATA[		// if the mode is active then wait]]>
</Line>
<Line Number="46">
<![CDATA[		case modeCurrent of]]>
</Line>
<Line Number="47">
<![CDATA[			-1:]]>
</Line>
<Line Number="48">
<![CDATA[				modeCurrent := modeSelect;]]>
</Line>
<Line Number="49">
<![CDATA[				;]]>
</Line>
<Line Number="50">
<![CDATA[			0, 2:	// auto or prog]]>
</Line>
<Line Number="51">
<![CDATA[				case modeSelect of]]>
</Line>
<Line Number="52">
<![CDATA[					0,2:]]>
</Line>
<Line Number="53">
<![CDATA[						// can switch ]]>
</Line>
<Line Number="54">
<![CDATA[						modeCurrent := modeSelect;]]>
</Line>
<Line Number="55">
<![CDATA[					1:]]>
</Line>
<Line Number="56">
<![CDATA[						if \ModeAuto.active or \ModeAutoInput.active then]]>
</Line>
<Line Number="57">
<![CDATA[							// can't switch to MAN]]>
</Line>
<Line Number="58">
<![CDATA[							;]]>
</Line>
<Line Number="59">
<![CDATA[						else]]>
</Line>
<Line Number="60">
<![CDATA[							modeCurrent := modeSelect;]]>
</Line>
<Line Number="61">
<![CDATA[						end_if;]]>
</Line>
<Line Number="62">
<![CDATA[				end_case;]]>
</Line>
<Line Number="63">
<![CDATA[				]]>
</Line>
<Line Number="64">
<![CDATA[			1:]]>
</Line>
<Line Number="65">
<![CDATA[				if not \ModeMan.active then]]>
</Line>
<Line Number="66">
<![CDATA[					modeCurrent := modeSelect;					]]>
</Line>
<Line Number="67">
<![CDATA[				end_if;]]>
</Line>
<Line Number="68">
<![CDATA[		end_case;]]>
</Line>
<Line Number="69">
<![CDATA[		]]>
</Line>
<Line Number="70">
<![CDATA[		// mode was changed in the mean time]]>
</Line>
<Line Number="71">
<![CDATA[		if modeSelect <> modeLast then]]>
</Line>
<Line Number="72">
<![CDATA[			modeState := 10;]]>
</Line>
<Line Number="73">
<![CDATA[		end_if;]]>
</Line>
<Line Number="74">
<![CDATA[		]]>
</Line>
<Line Number="75">
<![CDATA[		if modeCurrent = modeSelect then]]>
</Line>
<Line Number="76">
<![CDATA[			JSR(ResetAll);]]>
</Line>
<Line Number="77">
<![CDATA[			modeState := 10;]]>
</Line>
<Line Number="78">
<![CDATA[		end_if;]]>
</Line>
<Line Number="79">
<![CDATA[		]]>
</Line>
<Line Number="80">
<![CDATA[end_Case;]]>
</Line>
</STContent>
</Routine>
