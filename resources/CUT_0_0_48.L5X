<![CDATA[		if \Cutter.currentCmd = 0 then]]>
</Line>
<Line Number="544">
<![CDATA[			\Cutter.cmd := 11;				//unclamp collet]]>
</Line>
<Line Number="545">
<![CDATA[			state := 600;]]>
</Line>
<Line Number="546">
<![CDATA[		end_if;]]>
</Line>
<Line Number="547">
<![CDATA[	]]>
</Line>
<Line Number="548">
<![CDATA[	// end of cutting loop]]>
</Line>
<Line Number="549">
<![CDATA[	600:]]>
</Line>
<Line Number="550">
<![CDATA[		if \CutInFeed.cutCounter >= \CutInFeed.cutPlan.numParts then]]>
</Line>
<Line Number="551">
<![CDATA[			state := 700;		// done pipe]]>
</Line>
<Line Number="552">
<![CDATA[		else]]>
</Line>
<Line Number="553">
<![CDATA[			state := 450;		// cut next part]]>
</Line>
<Line Number="554">
<![CDATA[		end_if;]]>
</Line>
<Line Number="555">
<![CDATA[		]]>
</Line>
<Line Number="556">
<![CDATA[#endregion]]>
</Line>
<Line Number="557">
<![CDATA[]]>
</Line>
<Line Number="558">
<![CDATA[#region end cut of segment]]>
</Line>
<Line Number="559">
<![CDATA[]]>
</Line>
<Line Number="560">
<![CDATA[	// stopping cut head ready for next pipe]]>
</Line>
<Line Number="561">
<![CDATA[	700:]]>
</Line>
<Line Number="562">
<![CDATA[		if \Cutter.currentCmd = 0 then]]>
</Line>
<Line Number="563">
<![CDATA[			if stepMode then]]>
</Line>
<Line Number="564">
<![CDATA[				//message := ' wait for C button to stop cut head';]]>
</Line>
<Line Number="565">
<![CDATA[				message := 'step - retract for next input part';]]>
</Line>
<Line Number="566">
<![CDATA[				if step then]]>
</Line>
<Line Number="567">
<![CDATA[					//\Cutter.cmd := 21;]]>
</Line>
<Line Number="568">
<![CDATA[					state := 720;]]>
</Line>
<Line Number="569">
<![CDATA[				end_if;]]>
</Line>
<Line Number="570">
<![CDATA[			else]]>
</Line>
<Line Number="571">
<![CDATA[				state := 720;]]>
</Line>
<Line Number="572">
<![CDATA[			end_if;]]>
</Line>
<Line Number="573">
<![CDATA[			]]>
</Line>
<Line Number="574">
<![CDATA[		end_if;]]>
</Line>
<Line Number="575">
<![CDATA[	]]>
</Line>
<Line Number="576">
<![CDATA[	// move back cut infeed and release collet ]]>
</Line>
<Line Number="577">
<![CDATA[	720:]]>
</Line>
<Line Number="578">
<![CDATA[		if \Cutter.currentCmd = 0 then]]>
</Line>
<Line Number="579">
<![CDATA[			if \CutInFeed.currentCmd = 0 then]]>
</Line>
<Line Number="580">
<![CDATA[				\CutInFeed.cmd := 60;	// go to back dump position]]>
</Line>
<Line Number="581">
<![CDATA[				]]>
</Line>
<Line Number="582">
<![CDATA[				if \CutInFeed.cutPlan.backOffalLength = 0.0 then]]>
</Line>
<Line Number="583">
<![CDATA[					\CutInFeed.cmd := 22;	// no offal to dump]]>
</Line>
<Line Number="584">
<![CDATA[				end_if;]]>
</Line>
<Line Number="585">
<![CDATA[				]]>
</Line>
<Line Number="586">
<![CDATA[				state := 730;]]>
</Line>
<Line Number="587">
<![CDATA[			end_if;]]>
</Line>
<Line Number="588">
<![CDATA[		end_if;]]>
</Line>
<Line Number="589">
<![CDATA[		]]>
</Line>
<Line Number="590">
<![CDATA[	730:]]>
</Line>
<Line Number="591">
<![CDATA[		if \CutInFeed.currentCmd = 0 then]]>
</Line>
<Line Number="592">
<![CDATA[			state := 800;]]>
</Line>
<Line Number="593">
<![CDATA[		end_if;]]>
</Line>
<Line Number="594">
<![CDATA[		]]>
</Line>
<Line Number="595">
<![CDATA[]]>
</Line>
<Line Number="596">
<![CDATA[#endregion]]>
</Line>
<Line Number="597">
<![CDATA[]]>
</Line>
<Line Number="598">
<![CDATA[	]]>
</Line>
<Line Number="599">
<![CDATA[		]]>
</Line>
<Line Number="600">
<![CDATA[	// end cycle and restart	]]>
</Line>
<Line Number="601">
<![CDATA[	800:]]>
</Line>
<Line Number="602">
<![CDATA[		//state := 400;]]>
</Line>
<Line Number="603">
<![CDATA[		]]>
</Line>
<Line Number="604">
<![CDATA[		// Check for graceful stop after CutInFeed completes]]>
</Line>
<Line Number="605">
<![CDATA[		if stopAfterCutInfeed then]]>
</Line>
<Line Number="606">
<![CDATA[			message := 'Stopping after CutInFeed - stick complete';]]>
</Line>
<Line Number="607">
<![CDATA[			]]>
</Line>
<Line Number="608">
<![CDATA[			// TODO: Are we sure that the head has taken the]]>
</Line>
<Line Number="609">
<![CDATA[			// final part away.]]>
</Line>
<Line Number="610">
<![CDATA[			\PartPresent.inputProcessIncoming := 0;]]>
</Line>
<Line Number="611">
<![CDATA[			state := 900;       // go to graceful stop]]>
</Line>
<Line Number="612">
<![CDATA[		]]>
</Line>
<Line Number="613">
<![CDATA[		// consider later]]>
</Line>
<Line Number="614">
<![CDATA[		elsif stopAfterTransfer then]]>
</Line>
<Line Number="615">
<![CDATA[			]]>
</Line>
<Line Number="616">
<![CDATA[			// Stop measure from processing new parts]]>
</Line>
<Line Number="617">
<![CDATA[	        \Measure.cmd := 0;]]>
</Line>
<Line Number="618">
<![CDATA[	        ]]>
</Line>
<Line Number="619">
<![CDATA[	        if \PartPresent.transfer then]]>
</Line>
<Line Number="620">
<![CDATA[	            // Part on transfer - let it through]]>
</Line>
<Line Number="621">
<![CDATA[	            message := 'Transfer has part - processing final stick';]]>
</Line>
<Line Number="622">
<![CDATA[	            state := 400;]]>
</Line>
<Line Number="623">
<![CDATA[	        else]]>
</Line>
<Line Number="624">
<![CDATA[	            // No part on transfer - confirm measure stopped]]>
</Line>
<Line Number="625">
<![CDATA[	            state := 850;]]>
</Line>
<Line Number="626">
<![CDATA[	        end_if;]]>
</Line>
<Line Number="627">
<![CDATA[		]]>
</Line>
<Line Number="628">
<![CDATA[			;]]>
</Line>
<Line Number="629">
<![CDATA[		elsif stopAfterMeasure then]]>
</Line>
<Line Number="630">
<![CDATA[			\Stepper.cmd := 0;]]>
</Line>
<Line Number="631">
<![CDATA[			\InputConv.cmd := 0;]]>
</Line>
<Line Number="632">
<![CDATA[			]]>
</Line>
<Line Number="633">
<![CDATA[			// parts still on measure or transfer so continue]]>
</Line>
<Line Number="634">
<![CDATA[			if \PartPresent.anyMeasure or \PartPresent.transfer then]]>
</Line>
<Line Number="635">
<![CDATA[				state := 400;]]>
</Line>
<Line Number="636">
<![CDATA[			else]]>
</Line>
<Line Number="637">
<![CDATA[				state := 900;]]>
</Line>
<Line Number="638">
<![CDATA[			end_if;]]>
</Line>
<Line Number="639">
<![CDATA[			]]>
</Line>
<Line Number="640">
<![CDATA[		else]]>
</Line>
<Line Number="641">
<![CDATA[			state := 400;       // continue to next stick]]>
</Line>
<Line Number="642">
<![CDATA[		end_if;]]>
</Line>
<Line Number="643">
<![CDATA[	]]>
</Line>
<Line Number="644">
<![CDATA[	]]>
</Line>
<Line Number="645">
<![CDATA[		// proto code]]>
</Line>
<Line Number="646">
<![CDATA[	850:]]>
</Line>
<Line Number="647">
<![CDATA[	    // Confirm everything has stopped and no late arrivals]]>
</Line>
<Line Number="648">
<![CDATA[	    message := 'Confirming stop';]]>
</Line>
<Line Number="649">
<![CDATA[	    ]]>
</Line>
<Line Number="650">
<![CDATA[	    // Ensure upstream stopped]]>
</Line>
<Line Number="651">
<![CDATA[	    \Measure.cmd := 0;]]>
</Line>
<Line Number="652">
<![CDATA[	    \InputConv.cmd := 0;]]>
</Line>
<Line Number="653">
<![CDATA[	    \Stepper.cmd := 0;]]>
</Line>
<Line Number="654">
<![CDATA[	    ]]>
</Line>
<Line Number="655">
<![CDATA[	    state := 860;]]>
</Line>
<Line Number="656">
<![CDATA[]]>
</Line>
<Line Number="657">
<![CDATA[	860:]]>
</Line>
<Line Number="658">
<![CDATA[	    // Wait for measure to process stop]]>
</Line>
<Line Number="659">
<![CDATA[	    if \Measure.currentCmd = 0 then]]>
</Line>
<Line Number="660">
<![CDATA[			]]>
</Line>
<Line Number="661">
<![CDATA[	        // Recheck for late arrivals]]>
</Line>
<Line Number="662">
<![CDATA[	        if \PartPresent.anyMeasure or \PartPresent.transfer then]]>
</Line>
<Line Number="663">
<![CDATA[	            // Late arrival - go back and process]]>
</Line>
<Line Number="664">
<![CDATA[	            message := 'Late arrival - processing';]]>
</Line>
<Line Number="665">
<![CDATA[	            state := 400;]]>
</Line>
<Line Number="666">
<![CDATA[	        else]]>
</Line>
<Line Number="667">
<![CDATA[	            // Confirmed empty]]>
</Line>
<Line Number="668">
<![CDATA[	            \PartPresent.inputProcessIncoming := 0;]]>
</Line>
<Line Number="669">
<![CDATA[	            state := 900;]]>
</Line>
<Line Number="670">
<![CDATA[	        end_if;]]>
</Line>
<Line Number="671">
<![CDATA[	    end_if;]]>
</Line>
<Line Number="672">
<![CDATA[	]]>
</Line>
<Line Number="673">
<![CDATA[		]]>
</Line>
<Line Number="674">
<![CDATA[	// Graceful stop - wait for in-progress operations]]>
</Line>
<Line Number="675">
<![CDATA[	900:]]>
</Line>
<Line Number="676">
<![CDATA[		\Measure.cmd := 0;]]>
</Line>
<Line Number="677">
<![CDATA[	    \InputConv.cmd := 0;]]>
</Line>
<Line Number="678">
<![CDATA[	    \Stepper.cmd := 0;]]>
</Line>
<Line Number="679">
<![CDATA[		]]>
</Line>
<Line Number="680">
<![CDATA[		isStopping := 1;]]>
</Line>
<Line Number="681">
<![CDATA[		message := 'Graceful stop in progress';]]>
</Line>
<Line Number="682">
<![CDATA[		]]>
</Line>
<Line Number="683">
<![CDATA[		/// this is not correct as a part in cut will strand head 1]]>
</Line>
<Line Number="684">
<![CDATA[		// Ensure inputProcessIncoming is cleared]]>
</Line>
<Line Number="685">
<![CDATA[		//\PartPresent.inputProcessIncoming := 0;]]>
</Line>
<Line Number="686">
<![CDATA[		]]>
</Line>
<Line Number="687">
<![CDATA[		state := 910;]]>
</Line>
<Line Number="688">
<![CDATA[		]]>
</Line>
<Line Number="689">
<![CDATA[	910:]]>
</Line>
<Line Number="690">
<![CDATA[		]]>
</Line>
<Line Number="691">
<![CDATA[		/// Wait for any in-progress subsystem commands to complete]]>
</Line>
<Line Number="692">
<![CDATA[		]]>
</Line>
<Line Number="693">
<![CDATA[		// if error occured in CutInfeed and Cutter is currentCmd = 0?]]>
</Line>
<Line Number="694">
<![CDATA[		// same with Transfer]]>
</Line>
<Line Number="695">
<![CDATA[		if \CutInFeed.currentCmd = 0 ]]>
</Line>
<Line Number="696">
<![CDATA[		   and \Cutter.currentCmd = 0 ]]>
</Line>
<Line Number="697">
<![CDATA[		then]]>
</Line>
<Line Number="698">
<![CDATA[			// it gets stuck in the wait for infeed]]>
</Line>
<Line Number="699">
<![CDATA[			case \Transfer.currentCmd of]]>
</Line>
<Line Number="700">
<![CDATA[				0:]]>
</Line>
<Line Number="701">
<![CDATA[					state := 920;]]>
</Line>
<Line Number="702">
<![CDATA[				-1:]]>
</Line>
<Line Number="703">
<![CDATA[					// transfer is in error ]]>
</Line>
<Line Number="704">
<![CDATA[					\Transfer.cmd := 0;]]>
</Line>
<Line Number="705">
<![CDATA[					state := 920;]]>
</Line>
<Line Number="706">
<![CDATA[					]]>
</Line>
<Line Number="707">
<![CDATA[				else]]>
</Line>
<Line Number="708">
<![CDATA[					// request stop again or clear error]]>
</Line>
<Line Number="709">
<![CDATA[					\Transfer.cmd := 0;]]>
</Line>
<Line Number="710">
<![CDATA[					]]>
</Line>
<Line Number="711">
<![CDATA[			end_case;]]>
</Line>
<Line Number="712">
<![CDATA[			(*]]>
</Line>
<Line Number="713">
<![CDATA[			if \Transfer.currentCmd <> 0 then				]]>
</Line>
<Line Number="714">
<![CDATA[				\Transfer.cmd := 0;]]>
</Line>
<Line Number="715">
<![CDATA[			else]]>
</Line>
<Line Number="716">
<![CDATA[				state := 920;]]>
</Line>
<Line Number="717">
<![CDATA[			end_if;]]>
</Line>
<Line Number="718">
<![CDATA[			*)]]>
</Line>
<Line Number="719">
<![CDATA[		else]]>
</Line>
<Line Number="720">
<![CDATA[			message := 'Waiting for operations to complete';]]>
</Line>
<Line Number="721">
<![CDATA[		end_if;]]>
</Line>
<Line Number="722">
<![CDATA[		]]>
</Line>
<Line Number="723">
<![CDATA[	920:]]>
</Line>
<Line Number="724">
<![CDATA[		// Stop cutter rotation if running]]>
</Line>
<Line Number="725">
<![CDATA[		if \Cutter.isCutHeadRunning then]]>
</Line>
<Line Number="726">
<![CDATA[			\Cutter.cmd := 21;      // stop rotation]]>
</Line>
<Line Number="727">
<![CDATA[			state := 925;]]>
</Line>
<Line Number="728">
<![CDATA[		else]]>
</Line>
<Line Number="729">
<![CDATA[			state := 930;]]>
</Line>
<Line Number="730">
<![CDATA[		end_if;]]>
</Line>
<Line Number="731">
<![CDATA[		]]>
</Line>
<Line Number="732">
<![CDATA[	925:]]>
</Line>
<Line Number="733">
<![CDATA[		if \Cutter.currentCmd = 0 then]]>
</Line>
<Line Number="734">
<![CDATA[			state := 930;]]>
</Line>
<Line Number="735">
<![CDATA[		end_if;]]>
</Line>
<Line Number="736">
<![CDATA[		]]>
</Line>
<Line Number="737">
<![CDATA[	930:]]>
</Line>
<Line Number="738">
<![CDATA[		// Clear stop flags]]>
</Line>
<Line Number="739">
<![CDATA[		stopAfterCutInfeed := 0;]]>
</Line>
<Line Number="740">
<![CDATA[		stopAfterTransfer := 0;]]>
</Line>
<Line Number="741">
<![CDATA[		stopAfterMeasure := 0;]]>
</Line>
<Line Number="742">
<![CDATA[		requestStop := 0;]]>
</Line>
<Line Number="743">
<![CDATA[		]]>
</Line>
<Line Number="744">
<![CDATA[		isStopping := 0;]]>
</Line>
<Line Number="745">
<![CDATA[		]]>
</Line>
<Line Number="746">
<![CDATA[		// now clear ?]]>
</Line>
<Line Number="747">
<![CDATA[		\PartPresent.inputProcessIncoming := 0;]]>
</Line>
<Line Number="748">
<![CDATA[		]]>
</Line>
<Line Number="749">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="750">
<![CDATA[		message := 'Stopped - A to restart';]]>
</Line>
<Line Number="751">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="752">
<![CDATA[	]]>
</Line>
<Line Number="753">
<![CDATA[	1000:]]>
</Line>
<Line Number="754">
<![CDATA[		\Stepper.cmd := 0;]]>
</Line>
<Line Number="755">
<![CDATA[		\InputConv.cmd := 0;]]>
</Line>
<Line Number="756">
<![CDATA[		\Measure.cmd := 0;]]>
</Line>
<Line Number="757">
<![CDATA[		]]>
</Line>
<Line Number="758">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="759">
<![CDATA[		]]>
</Line>
<Line Number="760">
<![CDATA[	5000:]]>
</Line>
<Line Number="761">
<![CDATA[		/// error state]]>
</Line>
<Line Number="762">
<![CDATA[		// this is not normal condition and we have]]>
</Line>
<Line Number="763">
<![CDATA[		// absorbed sub system errors with the requestStop]]>
</Line>
<Line Number="764">
<![CDATA[		// but we'll leave this here in any case]]>
</Line>
<Line Number="765">
<![CDATA[		message := 'Abnormal condition';]]>
</Line>
<Line Number="766">
<![CDATA[		]]>
</Line>
<Line Number="767">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="768">
<![CDATA[		\Stepper.cmd := 0;]]>
</Line>
<Line Number="769">
<![CDATA[		\InputConv.cmd := 0;]]>
</Line>
<Line Number="770">
<![CDATA[		\Measure.cmd := 0;]]>
</Line>
<Line Number="771">
<![CDATA[		]]>
</Line>
<Line Number="772">
<![CDATA[end_case;]]>
</Line>
<Line Number="773">
<![CDATA[]]>
</Line>
<Line Number="774">
<![CDATA[stateLast := state;]]>
</Line>
<Line Number="775">
<![CDATA[		]]>
</Line>
<Line Number="776">
<![CDATA[]]>
</Line>
<Line Number="777">
<![CDATA[]]>
</Line>
<Line Number="778">
<![CDATA[]]>
</Line>
<Line Number="779">
<![CDATA[]]>
</Line>
