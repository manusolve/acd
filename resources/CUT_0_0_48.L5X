</Line>
<Line Number="435">
<![CDATA[]]>
</Line>
<Line Number="436">
<![CDATA[#region grip pipe on conveyor]]>
</Line>
<Line Number="437">
<![CDATA[	500:]]>
</Line>
<Line Number="438">
<![CDATA[		if gripper.isOpen then]]>
</Line>
<Line Number="439">
<![CDATA[			// as it should be]]>
</Line>
<Line Number="440">
<![CDATA[			state := 520;]]>
</Line>
<Line Number="441">
<![CDATA[		else]]>
</Line>
<Line Number="442">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="443">
<![CDATA[		end_if;]]>
</Line>
<Line Number="444">
<![CDATA[		]]>
</Line>
<Line Number="445">
<![CDATA[	520:]]>
</Line>
<Line Number="446">
<![CDATA[		gripper.close := 1;]]>
</Line>
<Line Number="447">
<![CDATA[		TimerStart(tS, timer, 150);]]>
</Line>
<Line Number="448">
<![CDATA[		state := 525;]]>
</Line>
<Line Number="449">
<![CDATA[		]]>
</Line>
<Line Number="450">
<![CDATA[	525:]]>
</Line>
<Line Number="451">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="452">
<![CDATA[			state := 530;]]>
</Line>
<Line Number="453">
<![CDATA[			TimerStart(tS, timer, 500);]]>
</Line>
<Line Number="454">
<![CDATA[		end_if;]]>
</Line>
<Line Number="455">
<![CDATA[		]]>
</Line>
<Line Number="456">
<![CDATA[	530:]]>
</Line>
<Line Number="457">
<![CDATA[		// the sensors have some overlap -- only isClosedEmpty alone is not gripped		]]>
</Line>
<Line Number="458">
<![CDATA[		if	(gripper.isClosed and gripper.isClosedEmpty) or]]>
</Line>
<Line Number="459">
<![CDATA[			gripper.isClosed]]>
</Line>
<Line Number="460">
<![CDATA[		then]]>
</Line>
<Line Number="461">
<![CDATA[			// the pipe is clamped]]>
</Line>
<Line Number="462">
<![CDATA[			\PartPresent.measuredToCollect := 0;]]>
</Line>
<Line Number="463">
<![CDATA[			\PartPresent.transfer := 1;			]]>
</Line>
<Line Number="464">
<![CDATA[			actualPartLen := \Measure.measuredLength;]]>
</Line>
<Line Number="465">
<![CDATA[			state := 540;]]>
</Line>
<Line Number="466">
<![CDATA[			]]>
</Line>
<Line Number="467">
<![CDATA[		elsif gripper.isClosedEmpty then]]>
</Line>
<Line Number="468">
<![CDATA[			// no pipe]]>
</Line>
<Line Number="469">
<![CDATA[			// is it an error]]>
</Line>
<Line Number="470">
<![CDATA[			// could wait with jaws open for another]]>
</Line>
<Line Number="471">
<![CDATA[			if timer.DN then]]>
</Line>
<Line Number="472">
<![CDATA[				gripper.close := 0;]]>
</Line>
<Line Number="473">
<![CDATA[				]]>
</Line>
<Line Number="474">
<![CDATA[				message := 'message no pipe gripped from measure to transfer';]]>
</Line>
<Line Number="475">
<![CDATA[				// TODO: Add in alarm with EventLog]]>
</Line>
<Line Number="476">
<![CDATA[				JSR(LogTransfer);]]>
</Line>
<Line Number="477">
<![CDATA[				]]>
</Line>
<Line Number="478">
<![CDATA[				\PartPresent.measuredToCollect := 0;	// no part was present so clear]]>
</Line>
<Line Number="479">
<![CDATA[				]]>
</Line>
<Line Number="480">
<![CDATA[				// this is messy if mode is MAN ]]>
</Line>
<Line Number="481">
<![CDATA[				//cmd := 20; 		// goto home]]>
</Line>
<Line Number="482">
<![CDATA[				cmd := 1; 		// return to normal auto]]>
</Line>
<Line Number="483">
<![CDATA[								// currentCmd will not return to 0]]>
</Line>
<Line Number="484">
<![CDATA[				state := 110;	// skip re-entry so cmd is not reset]]>
</Line>
<Line Number="485">
<![CDATA[			end_if;]]>
</Line>
<Line Number="486">
<![CDATA[		end_if;]]>
</Line>
<Line Number="487">
<![CDATA[		]]>
</Line>
<Line Number="488">
<![CDATA[	540:]]>
</Line>
<Line Number="489">
<![CDATA[		// could await an additional trigger]]>
</Line>
<Line Number="490">
<![CDATA[		state := 600;]]>
</Line>
<Line Number="491">
<![CDATA[]]>
</Line>
<Line Number="492">
<![CDATA[		JSR(CheckForStop);]]>
</Line>
<Line Number="493">
<![CDATA[		]]>
</Line>
<Line Number="494">
<![CDATA[#endregion]]>
</Line>
<Line Number="495">
<![CDATA[]]>
</Line>
<Line Number="496">
<![CDATA[	/// start lift and traverse]]>
</Line>
<Line Number="497">
<![CDATA[    // pipe is in the transfer gripper]]>
</Line>
<Line Number="498">
<![CDATA[]]>
</Line>
<Line Number="499">
<![CDATA[	600:]]>
</Line>
<Line Number="500">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="501">
<![CDATA[			axis.position := posUpY;]]>
</Line>
<Line Number="502">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="503">
<![CDATA[			state := 610;]]>
</Line>
<Line Number="504">
<![CDATA[		else]]>
</Line>
<Line Number="505">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="506">
<![CDATA[		end_if;]]>
</Line>
<Line Number="507">
<![CDATA[	610:]]>
</Line>
<Line Number="508">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="509">
<![CDATA[			case currentCmd of]]>
</Line>
<Line Number="510">
<![CDATA[				31:]]>
</Line>
<Line Number="511">
<![CDATA[					// move up only]]>
</Line>
<Line Number="512">
<![CDATA[					state := 100;	]]>
</Line>
<Line Number="513">
<![CDATA[				else]]>
</Line>
<Line Number="514">
<![CDATA[					state := 620;	]]>
</Line>
<Line Number="515">
<![CDATA[			end_case;]]>
</Line>
<Line Number="516">
<![CDATA[			]]>
</Line>
<Line Number="517">
<![CDATA[			// check for interruption]]>
</Line>
<Line Number="518">
<![CDATA[			if cmd <> -1 then]]>
</Line>
<Line Number="519">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="520">
<![CDATA[			end_if;]]>
</Line>
<Line Number="521">
<![CDATA[		end_if;]]>
</Line>
<Line Number="522">
<![CDATA[	]]>
</Line>
<Line Number="523">
<![CDATA[	620:]]>
</Line>
<Line Number="524">
<![CDATA[		// at this point we can move to the wait position]]>
</Line>
<Line Number="525">
<![CDATA[		// but if the cutInFeed is waiting we should just]]>
</Line>
<Line Number="526">
<![CDATA[		// skip straight to the infeed position]]>
</Line>
<Line Number="527">
<![CDATA[		if \CutInFeed.isSafeForTransfer then]]>
</Line>
<Line Number="528">
<![CDATA[			// goto the drop off position]]>
</Line>
<Line Number="529">
<![CDATA[			positionXNext := \Settings.inputProcessParam.transferDropOffX;]]>
</Line>
<Line Number="530">
<![CDATA[	    else]]>
</Line>
<Line Number="531">
<![CDATA[			// goto the wait position]]>
</Line>
<Line Number="532">
<![CDATA[			positionXNext := \Settings.inputProcessParam.transferWaitX;]]>
</Line>
<Line Number="533">
<![CDATA[		end_if;]]>
</Line>
<Line Number="534">
<![CDATA[		]]>
</Line>
<Line Number="535">
<![CDATA[		if \Axes.xIn.ready and axis.ready then]]>
</Line>
<Line Number="536">
<![CDATA[			\Axes.xIn.position := positionXNext;]]>
</Line>
<Line Number="537">
<![CDATA[			\Axes.xIn.move := 1;]]>
</Line>
<Line Number="538">
<![CDATA[			state := 630;]]>
</Line>
<Line Number="539">
<![CDATA[		else]]>
</Line>
<Line Number="540">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="541">
<![CDATA[		end_if;]]>
</Line>
<Line Number="542">
<![CDATA[		]]>
</Line>
<Line Number="543">
<![CDATA[	630:]]>
</Line>
<Line Number="544">
<![CDATA[		// once the transfer has moved a certain distance we ]]>
</Line>
<Line Number="545">
<![CDATA[		// can blend the Y move down]]>
</Line>
<Line Number="546">
<![CDATA[		if isInputClear then]]>
</Line>
<Line Number="547">
<![CDATA[			message := 'x position triggered y move';]]>
</Line>
<Line Number="548">
<![CDATA[			if axis.ready then]]>
</Line>
<Line Number="549">
<![CDATA[				axis.move := 1;]]>
</Line>
<Line Number="550">
<![CDATA[				axis.position := posDropOffY;]]>
</Line>
<Line Number="551">
<![CDATA[				state := 640;]]>
</Line>
<Line Number="552">
<![CDATA[			end_if;]]>
</Line>
<Line Number="553">
<![CDATA[		end_If;]]>
</Line>
<Line Number="554">
<![CDATA[		]]>
</Line>
<Line Number="555">
<![CDATA[	640:	]]>
</Line>
<Line Number="556">
<![CDATA[		]]>
</Line>
<Line Number="557">
<![CDATA[		if not \Axes.xIn.move and not axis.move then]]>
</Line>
<Line Number="558">
<![CDATA[			// both axes are in position]]>
</Line>
<Line Number="559">
<![CDATA[			// if we are still waiting for cutInfeed to be ready]]>
</Line>
<Line Number="560">
<![CDATA[			// need to move there]]>
</Line>
<Line Number="561">
<![CDATA[			if \CutInFeed.isSafeForTransfer then ]]>
</Line>
<Line Number="562">
<![CDATA[				// check if the position is correct]]>
</Line>
<Line Number="563">
<![CDATA[				if isAtOutput then]]>
</Line>
<Line Number="564">
<![CDATA[					// return, auto cycle will instruct next]]>
</Line>
<Line Number="565">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="566">
<![CDATA[				else]]>
</Line>
<Line Number="567">
<![CDATA[					state := 650;]]>
</Line>
<Line Number="568">
<![CDATA[				end_if;]]>
</Line>
<Line Number="569">
<![CDATA[			end_if;]]>
</Line>
<Line Number="570">
<![CDATA[		end_if;]]>
</Line>
<Line Number="571">
<![CDATA[		JSR(CheckForStop);]]>
</Line>
<Line Number="572">
<![CDATA[	]]>
</Line>
<Line Number="573">
<![CDATA[	650:]]>
</Line>
<Line Number="574">
<![CDATA[		// this is the case where we were waiting at the X wait]]>
</Line>
<Line Number="575">
<![CDATA[		// position]]>
</Line>
<Line Number="576">
<![CDATA[		if \CutInFeed.isSafeForTransfer then ]]>
</Line>
<Line Number="577">
<![CDATA[			if \Axes.xIn.ready and axis.ready then]]>
</Line>
<Line Number="578">
<![CDATA[				positionXNext := \Settings.inputProcessParam.transferDropOffX;]]>
</Line>
<Line Number="579">
<![CDATA[				\Axes.xIn.position := positionXNext;]]>
</Line>
<Line Number="580">
<![CDATA[				\Axes.xIn.move := 1;]]>
</Line>
<Line Number="581">
<![CDATA[				state := 660;]]>
</Line>
<Line Number="582">
<![CDATA[			end_if;]]>
</Line>
<Line Number="583">
<![CDATA[		end_if;]]>
</Line>
<Line Number="584">
<![CDATA[		JSR(CheckForStop);]]>
</Line>
<Line Number="585">
<![CDATA[	]]>
</Line>
<Line Number="586">
<![CDATA[	660:]]>
</Line>
<Line Number="587">
<![CDATA[		if not \Axes.xIn.move then]]>
</Line>
<Line Number="588">
<![CDATA[			//message := 'transferred to cut infeed length';]]>
</Line>
<Line Number="589">
<![CDATA[			//JSR(LogTransfer);]]>
</Line>
<Line Number="590">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="591">
<![CDATA[		end_if;]]>
</Line>
<Line Number="592">
<![CDATA[		]]>
</Line>
<Line Number="593">
<![CDATA[	1650:]]>
</Line>
<Line Number="594">
<![CDATA[		// this was the previous wait state.]]>
</Line>
<Line Number="595">
<![CDATA[		if \CutInFeed.isSafeForTransfer then]]>
</Line>
<Line Number="596">
<![CDATA[			state := 660;]]>
</Line>
<Line Number="597">
<![CDATA[		end_if;]]>
</Line>
<Line Number="598">
<![CDATA[		JSR(CheckForStop);]]>
</Line>
<Line Number="599">
<![CDATA[]]>
</Line>
<Line Number="600">
<![CDATA[	/// lower to output position]]>
</Line>
<Line Number="601">
<![CDATA[	700:]]>
</Line>
<Line Number="602">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="603">
<![CDATA[			axis.move := 1;]]>
</Line>
<Line Number="604">
<![CDATA[			axis.position := posDropOffY;]]>
</Line>
<Line Number="605">
<![CDATA[			state := 710;]]>
</Line>
<Line Number="606">
<![CDATA[		else]]>
</Line>
<Line Number="607">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="608">
<![CDATA[		end_if;]]>
</Line>
<Line Number="609">
<![CDATA[		]]>
</Line>
<Line Number="610">
<![CDATA[	710:]]>
</Line>
<Line Number="611">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="612">
<![CDATA[			// move done]]>
</Line>
<Line Number="613">
<![CDATA[			// the pipe length was carried with the pipe on the transfer]]>
</Line>
<Line Number="614">
<![CDATA[]]>
</Line>
<Line Number="615">
<![CDATA[			//message := 'transferred to cut infeed length';]]>
</Line>
<Line Number="616">
<![CDATA[			//JSR(LogTransfer);]]>
</Line>
<Line Number="617">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="618">
<![CDATA[		end_if;]]>
</Line>
<Line Number="619">
<![CDATA[]]>
</Line>
<Line Number="620">
<![CDATA[	5000:]]>
</Line>
<Line Number="621">
<![CDATA[		]]>
</Line>
<Line Number="622">
<![CDATA[		// stop both in case of 1 faulting when both should move.]]>
</Line>
<Line Number="623">
<![CDATA[		axis.move := 0;]]>
</Line>
<Line Number="624">
<![CDATA[		\Axes.xIn.move := 0;]]>
</Line>
<Line Number="625">
<![CDATA[		]]>
</Line>
<Line Number="626">
<![CDATA[		if cmd = 0 then]]>
</Line>
<Line Number="627">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="628">
<![CDATA[		end_if;]]>
</Line>
<Line Number="629">
<![CDATA[]]>
</Line>
<Line Number="630">
<![CDATA[end_case;]]>
</Line>
<Line Number="631">
<![CDATA[]]>
</Line>
<Line Number="632">
<![CDATA[if errorState > 0 then]]>
</Line>
<Line Number="633">
<![CDATA[	state := opErrorState;]]>
</Line>
<Line Number="634">
<![CDATA[end_if;]]>
</Line>
<Line Number="635">
<![CDATA[]]>
</Line>
<Line Number="636">
<![CDATA[stateLast := state;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="LogEvent" Type="EVENT" Rate="10" Priority="10" Watchdog="500" DisableUpdateOutputs="true" InhibitTask="false" Class="Standard">
<EventInfo EventTrigger="EVENT Instruction Only" EnableTimeout="false"/>
<ScheduledPrograms>
<ScheduledProgram Name="Event"/>
</ScheduledPrograms>
</Task>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
<ScheduledPrograms>
<ScheduledProgram Name="Axes"/>
<ScheduledProgram Name="IO"/>
<ScheduledProgram Name="MachineMain"/>
<ScheduledProgram Name="ModeAuto"/>
<ScheduledProgram Name="ModeAutoInput"/>
<ScheduledProgram Name="ModeMan"/>
<ScheduledProgram Name="Loading"/>
<ScheduledProgram Name="Stepper"/>
<ScheduledProgram Name="InputConv"/>
<ScheduledProgram Name="Measure"/>
<ScheduledProgram Name="Transfer"/>
<ScheduledProgram Name="CutInFeed"/>
<ScheduledProgram Name="Cutter"/>
<ScheduledProgram Name="Machine"/>
<ScheduledProgram Name="Heads"/>
<ScheduledProgram Name="Handoffs"/>
<ScheduledProgram Name="Diverter"/>
<ScheduledProgram Name="OutputHandler"/>
</ScheduledPrograms>
</Task>
<Task Name="Process10ms" Type="PERIODIC" Rate="5" Priority="6" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
<ScheduledPrograms>
<ScheduledProgram Name="HMI"/>
<ScheduledProgram Name="PartPresent"/>
<ScheduledProgram Name="Settings"/>
<ScheduledProgram Name="Doors"/>
<ScheduledProgram Name="Build"/>
<ScheduledProgram Name="ScrapConv"/>
</ScheduledPrograms>
</Task>
<Task Name="SafetyTask" Type="PERIODIC" Rate="20" Priority="10" Watchdog="20" DisableUpdateOutputs="false" InhibitTask="false" Class="Safety">
<ScheduledPrograms>
<ScheduledProgram Name="Safety"/>
</ScheduledPrograms>
</Task>
</Tasks>
<ParameterConnections>
<ParameterConnection EndPoint1="\CutInFeed.axis" EndPoint2="\Axes.zIn"/>
<ParameterConnection EndPoint1="\Cutter.axis" EndPoint2="\Axes.bladeF"/>
<ParameterConnection EndPoint1="\Measure.prog" EndPoint2="\Settings.cellProgram"/>
<ParameterConnection EndPoint1="\Transfer.axis" EndPoint2="\Axes.y"/>
</ParameterConnections>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<DataLogs/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="true"/>
<EthernetPorts>
<EthernetPort Port="1" Label="A1" PortEnabled="true"/>
<EthernetPort Port="2" Label="A2" PortEnabled="true"/>
</EthernetPorts>
<EthernetNetwork SupervisorModeEnabled="false" SupervisorPrecedence="0" BeaconInterval="400" BeaconTimeout="1960" VLANID="0"/>
</Controller>
