</Line>
<Line Number="239">
<![CDATA[			]]>
</Line>
<Line Number="240">
<![CDATA[		]]>
</Line>
<Line Number="241">
<![CDATA[		if modeSelect <> modeSelectLast then]]>
</Line>
<Line Number="242">
<![CDATA[			case modeSelect of]]>
</Line>
<Line Number="243">
<![CDATA[				0: 	COP(\Settings.cycleSequences[0], currentSeqs[0], 4);]]>
</Line>
<Line Number="244">
<![CDATA[				1:	COP(\Settings.initSequences[0], currentSeqs[0], 4);]]>
</Line>
<Line Number="245">
