<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// apply IO]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[// machine 0 is the cutting head]]>
</Line>
<Line Number="3">
<![CDATA[// but will interface the same as the external machines]]>
</Line>
<Line Number="4">
<![CDATA[m[0].isAttached 	:= 1; 		// always attached]]>
</Line>
<Line Number="5">
<![CDATA[m[0].isReady 		:= 1; 		// from state of cutter program]]>
</Line>
<Line Number="6">
<![CDATA[m[0].isEStop 		:= not \Safety.ENABLE_ALL;]]>
</Line>
<Line Number="7">
<![CDATA[m[0].isError 		:= 0;		// state of cutter Program]]>
</Line>
<Line Number="8">
<![CDATA[m[0].isWorking 		:= 0;		// state of cutter Program]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//m[0].headSelect;		// pass to the cutter program]]>
</Line>
<Line Number="11">
<![CDATA[//m[0].cycle;]]>
</Line>
<Line Number="12">
<![CDATA[//m[0].reset;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[for mCounter := 1 to 3 do]]>
</Line>
<Line Number="16">
<![CDATA[	case mCounter of]]>
</Line>
<Line Number="17">
<![CDATA[		1:]]>
</Line>
<Line Number="18">
<![CDATA[			inputByte := REM1:7:I;]]>
</Line>
<Line Number="19">
<![CDATA[		2:]]>
</Line>
<Line Number="20">
<![CDATA[			inputByte := REM1:8:I;]]>
</Line>
<Line Number="21">
<![CDATA[		3:]]>
</Line>
<Line Number="22">
<![CDATA[			inputByte := REM1:9:I;]]>
</Line>
<Line Number="23">
<![CDATA[	end_case;]]>
</Line>
<Line Number="24">
<![CDATA[	m[mCounter].isAttached 	:= inputByte.0;]]>
</Line>
<Line Number="25">
<![CDATA[	m[mCounter].isReady 	:= inputByte.1;]]>
</Line>
<Line Number="26">
<![CDATA[	m[mCounter].isEStop 	:= inputByte.2;]]>
</Line>
<Line Number="27">
<![CDATA[	m[mCounter].isError 	:= inputByte.3;]]>
</Line>
<Line Number="28">
<![CDATA[	m[mCounter].isWorking 	:= inputByte.4;]]>
</Line>
<Line Number="29">
<![CDATA[end_for;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[REM1:13:O.0 := m[1].headSelect;]]>
</Line>
<Line Number="32">
<![CDATA[REM1:13:O.1 := m[1].cycle;]]>
</Line>
<Line Number="33">
<![CDATA[REM1:13:O.2 := m[1].reset;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[REM1:13:O.4 := m[2].headSelect;]]>
</Line>
<Line Number="36">
<![CDATA[REM1:13:O.5 := m[2].cycle;]]>
</Line>
<Line Number="37">
<![CDATA[REM1:13:O.6 := m[2].reset;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[REM1:14:O.0 := m[3].headSelect;]]>
</Line>
<Line Number="40">
<![CDATA[REM1:14:O.1 := m[3].cycle;]]>
</Line>
<Line Number="41">
<![CDATA[REM1:14:O.2 := m[3].reset;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
