<Routines>
<Routine Name="BalluffIOLink" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if 1 then]]>
</Line>
<Line Number="2">
<![CDATA[	// this is the method to get the DINT values from the IO-Link devices]]>
</Line>
<Line Number="3">
<![CDATA[	// for postion as the bytes are swapped]]>
</Line>
<Line Number="4">
<![CDATA[	//bmp_io_link := REM2:2:I.Ch2Data[0];]]>
</Line>
<Line Number="5">
<![CDATA[	//COP(bmp_io_link, double, 1);]]>
</Line>
<Line Number="6">
<![CDATA[	]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[	COP(REM2:2:I.Ch2Data[0], double, 1);]]>
</Line>
<Line Number="9">
<![CDATA[	SWPB(double, REVERSE, double2);]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[	realval := double2;]]>
</Line>
<Line Number="12">
<![CDATA[	scaled := realval * 0.001;]]>
</Line>
<Line Number="13">
<![CDATA[	btlHeight := -scaled;]]>
</Line>
<Line Number="14">
<![CDATA[	]]>
</Line>
<Line Number="15">
<![CDATA[	btlHeight := btlHeight + 122.9 + 67.2;]]>
</Line>
<Line Number="16">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="ButtonEdges" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// TODO: add parameter or programmable switch]]>
</Line>
<Line Number="2">
<![CDATA[(*]]>
</Line>
<Line Number="3">
<![CDATA[if 0 then]]>
</Line>
<Line Number="4">
<![CDATA[	aButtonEdge.InputBit := aButton or a2Button;]]>
</Line>
<Line Number="5">
<![CDATA[	bButtonEdge.InputBit := bButton or b2Button;]]>
</Line>
<Line Number="6">
<![CDATA[	cButtonEdge.InputBit := cButton or c2Button;]]>
</Line>
<Line Number="7">
<![CDATA[	dButtonEdge.InputBit := dButton or d2Button;]]>
</Line>
<Line Number="8">
<![CDATA[else]]>
</Line>
<Line Number="9">
<![CDATA[	aButtonEdge.InputBit := aButton;]]>
</Line>
<Line Number="10">
<![CDATA[	bButtonEdge.InputBit := bButton;]]>
</Line>
<Line Number="11">
<![CDATA[	cButtonEdge.InputBit := cButton;]]>
</Line>
<Line Number="12">
<![CDATA[	dButtonEdge.InputBit := dButton;]]>
</Line>
<Line Number="13">
<![CDATA[end_if;]]>
</Line>
<Line Number="14">
<![CDATA[*)]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[// main panel buttons only]]>
</Line>
<Line Number="17">
<![CDATA[aButtonEdge.InputBit := aButton;]]>
</Line>
<Line Number="18">
<![CDATA[bButtonEdge.InputBit := bButton;]]>
</Line>
<Line Number="19">
<![CDATA[cButtonEdge.InputBit := cButton;]]>
</Line>
<Line Number="20">
<![CDATA[dButtonEdge.InputBit := dButton;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[OSRI(aButtonEdge);]]>
</Line>
<Line Number="23">
<![CDATA[OSRI(bButtonEdge);]]>
</Line>
<Line Number="24">
<![CDATA[OSRI(cButtonEdge);]]>
</Line>
<Line Number="25">
<![CDATA[OSRI(dButtonEdge);]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[	This program takes the inputs and outputs]]>
</Line>
<Line Number="2">
<![CDATA[	values are transferred to each program module]]>
</Line>
<Line Number="3">
<![CDATA[	from here]]>
</Line>
<Line Number="4">
<![CDATA[*)]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// output the reset Led]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[//REM1:3:O.Pt04Data := \Safety.isResetPossible;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[//// map the inputs from the IO-Link Blocks]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[/// Shuttle Heads]]>
</Line>
<Line Number="14">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="15">
<![CDATA[	// read data in incl outputs]]>
</Line>
<Line Number="16">
<![CDATA[	case counter of]]>
</Line>
<Line Number="17">
<![CDATA[		0:]]>
</Line>
<Line Number="18">
<![CDATA[			COP(REM1:4:I.Ch0Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="19">
<![CDATA[			COP(REM1:4:O.Ch0Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="20">
<![CDATA[		1:]]>
</Line>
<Line Number="21">
<![CDATA[			COP(REM1:4:I.Ch1Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="22">
<![CDATA[			COP(REM1:4:O.Ch1Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="23">
<![CDATA[		2:]]>
</Line>
<Line Number="24">
<![CDATA[			COP(REM1:4:I.Ch2Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="25">
<![CDATA[			COP(REM1:4:O.Ch2Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="26">
<![CDATA[		3:]]>
</Line>
<Line Number="27">
<![CDATA[			COP(REM1:4:I.Ch3Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="28">
<![CDATA[			COP(REM1:4:O.Ch3Data[0], bniOutput[0], 2);			]]>
</Line>
<Line Number="29">
<![CDATA[	end_case;]]>
</Line>
<Line Number="30">
<![CDATA[	]]>
</Line>
<Line Number="31">
<![CDATA[	// array index is pin 2 or 4 -- bit number is port]]>
</Line>
<Line Number="32">
<![CDATA[	\Heads.h[counter].isLiftUp			:= bniInput[0].4;]]>
</Line>
<Line Number="33">
<![CDATA[	\Heads.h[counter].isLiftDown 		:= bniInput[1].4;]]>
</Line>
<Line Number="34">
<![CDATA[	(*]]>
</Line>
<Line Number="35">
<![CDATA[	// array index is pin 2 or 4 -- bit number is port]]>
</Line>
<Line Number="36">
<![CDATA[	heads[counter].isLiftUp			:= bniInput[0].4;]]>
</Line>
<Line Number="37">
<![CDATA[	heads[counter].isLiftDown 		:= bniInput[1].4;]]>
</Line>
<Line Number="38">
<![CDATA[	*)]]>
</Line>
<Line Number="39">
<![CDATA[	]]>
</Line>
<Line Number="40">
<![CDATA[	// if there is 1 limit input (or there could be separate without case)]]>
</Line>
<Line Number="41">
<![CDATA[	case counter of]]>
</Line>
<Line Number="42">
<![CDATA[		0,1:	\Axes.x[counter].limitPlusSwitch 	:= bniInput[0].6;]]>
</Line>
<Line Number="43">
<![CDATA[		2,3:	\Axes.x[counter].limitMinusSwitch 	:= bniInput[0].6;]]>
</Line>
<Line Number="44">
<![CDATA[	end_case;]]>
</Line>
<Line Number="45">
<![CDATA[	]]>
</Line>
<Line Number="46">
<![CDATA[	bniOutput[0].0 := \Heads.h[counter].colletClamp;]]>
</Line>
<Line Number="47">
<![CDATA[    bniOutput[1].0 := \Heads.h[counter].colletRelease;]]>
</Line>
<Line Number="48">
<![CDATA[	bniOutput[0].1 := \Heads.h[counter].liftDown;]]>
</Line>
<Line Number="49">
<![CDATA[	bniOutput[1].1 := \Heads.h[counter].liftUp;]]>
</Line>
<Line Number="50">
<![CDATA[    	]]>
</Line>
<Line Number="51">
<![CDATA[	(*]]>
</Line>
<Line Number="52">
<![CDATA[	bniOutput[0].0 := heads[counter].colletClamp;]]>
</Line>
<Line Number="53">
<![CDATA[    bniOutput[1].0 := heads[counter].colletRelease;]]>
</Line>
<Line Number="54">
<![CDATA[	bniOutput[0].1 := heads[counter].liftDown;]]>
</Line>
<Line Number="55">
<![CDATA[	bniOutput[1].1 := heads[counter].liftUp;]]>
</Line>
<Line Number="56">
<![CDATA[	*)]]>
</Line>
<Line Number="57">
<![CDATA[    ]]>
</Line>
<Line Number="58">
<![CDATA[	]]>
</Line>
<Line Number="59">
<![CDATA[	// Write outputs]]>
</Line>
<Line Number="60">
<![CDATA[	case counter of]]>
</Line>
<Line Number="61">
<![CDATA[        0: COP(bniOutput[0], REM1:4:O.Ch0Data[0], 2);]]>
</Line>
<Line Number="62">
<![CDATA[        1: COP(bniOutput[0], REM1:4:O.Ch1Data[0], 2);]]>
</Line>
<Line Number="63">
<![CDATA[        2: COP(bniOutput[0], REM1:4:O.Ch2Data[0], 2);]]>
</Line>
<Line Number="64">
<![CDATA[		3: COP(bniOutput[0], REM1:4:O.Ch3Data[0], 2);]]>
</Line>
<Line Number="65">
<![CDATA[    end_case;]]>
</Line>
<Line Number="66">
<![CDATA[	]]>
</Line>
<Line Number="67">
<![CDATA[	]]>
</Line>
<Line Number="68">
<![CDATA[end_for;	]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[]]>
</Line>
<Line Number="71">
<![CDATA[/// Handoffs]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
<Line Number="73">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="74">
<![CDATA[    // read]]>
</Line>
<Line Number="75">
<![CDATA[    case counter of]]>
</Line>
<Line Number="76">
<![CDATA[        0: ]]>
</Line>
<Line Number="77">
<![CDATA[			COP(REM1:5:I.Ch0Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="78">
<![CDATA[			COP(REM1:5:O.Ch0Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="79">
<![CDATA[        1: ]]>
</Line>
<Line Number="80">
<![CDATA[			COP(REM1:5:I.Ch1Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="81">
<![CDATA[			COP(REM1:5:O.Ch1Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="82">
<![CDATA[        2: ]]>
</Line>
<Line Number="83">
<![CDATA[			COP(REM1:5:I.Ch2Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="84">
<![CDATA[			COP(REM1:5:O.Ch2Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="85">
<![CDATA[		3: ]]>
</Line>
<Line Number="86">
<![CDATA[			COP(REM1:5:I.Ch3Data[0], bniInput[0], 2);]]>
</Line>
<Line Number="87">
<![CDATA[			COP(REM1:5:O.Ch3Data[0], bniOutput[0], 2);]]>
</Line>
<Line Number="88">
<![CDATA[    end_case;]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[	//\Handoffs.h[counter].isIndexB]]>
</Line>
<Line Number="91">
<![CDATA[	]]>
</Line>
<Line Number="92">
<![CDATA[    \Handoffs.h[counter].isIndexB 				:= bniInput[0].4;]]>
</Line>
<Line Number="93">
<![CDATA[    \Handoffs.h[counter].isIndexA 				:= bniInput[1].4;	]]>
</Line>
<Line Number="94">
<![CDATA[	\Handoffs.h[counter].gripper.isOpen        	:= bniInput[0].5;]]>
</Line>
<Line Number="95">
<![CDATA[	\Handoffs.h[counter].gripper.isClosed      	:= bniInput[1].5;]]>
</Line>
<Line Number="96">
<![CDATA[    \Handoffs.h[counter].gripper.isClosedEmpty 	:= bniInput[0].6;]]>
</Line>
<Line Number="97">
<![CDATA[	]]>
</Line>
<Line Number="98">
<![CDATA[    bniOutput[0].0 := \Handoffs.h[counter].indexA;]]>
</Line>
<Line Number="99">
<![CDATA[    bniOutput[0].1 := \Handoffs.h[counter].indexB;]]>
</Line>
<Line Number="100">
<![CDATA[	bniOutput[0].2 := \Handoffs.h[counter].gripper.close;]]>
</Line>
<Line Number="101">
<![CDATA[    bniOutput[0].3 := \Handoffs.h[counter].gripper.open;]]>
</Line>
<Line Number="102">
<![CDATA[]]>
</Line>
<Line Number="103">
<![CDATA[    // Write outputs]]>
</Line>
<Line Number="104">
<![CDATA[    case counter of]]>
</Line>
<Line Number="105">
<![CDATA[        0: COP(bniOutput[0], REM1:5:O.Ch0Data[0], 2);]]>
</Line>
<Line Number="106">
<![CDATA[        1: COP(bniOutput[0], REM1:5:O.Ch1Data[0], 2);]]>
</Line>
<Line Number="107">
<![CDATA[        2: COP(bniOutput[0], REM1:5:O.Ch2Data[0], 2);]]>
</Line>
<Line Number="108">
<![CDATA[		3: COP(bniOutput[0], REM1:5:O.Ch3Data[0], 2);]]>
</Line>
<Line Number="109">
<![CDATA[    end_case;]]>
</Line>
<Line Number="110">
<![CDATA[end_for;]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[// output conveyor will share the 4th IO-Link block]]>
</Line>
<Line Number="113">
<![CDATA[// from the handoffs.]]>
</Line>
<Line Number="114">
<![CDATA[// the port 7 is free: we can have 2 IO in port 7 ]]>
</Line>
<Line Number="115">
<![CDATA[// or use an expansion to another module]]>
</Line>
<Line Number="116">
<![CDATA[]]>
</Line>
<Line Number="117">
<![CDATA[// select bin 1/bin2 ]]>
</Line>
<Line Number="118">
<![CDATA[// 2 outputs valve shift]]>
</Line>
<Line Number="119">
<![CDATA[//REM1:5:O.Ch3Data[0].6 := \OutputConv.divert1;]]>
</Line>
<Line Number="120">
<![CDATA[//REM1:5:O.Ch3Data[1].6 := \OutputConv.divert2;]]>
</Line>
<Line Number="121">
<![CDATA[REM1:5:O.Ch3Data[0].7 := \OutputHandler.divert1;]]>
</Line>
<Line Number="122">
<![CDATA[REM1:5:O.Ch3Data[1].7 := \OutputHandler.divert2;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[// scope is needed for the 4th position to be anohter type with]]>
</Line>
<Line Number="125">
<![CDATA[// air leak checker -- that will be a variant of handoff.]]>
</Line>
<Line Number="126">
<![CDATA[// in that case the port numbers on the BNI may need to have a dual]]>
</Line>
<Line Number="127">
<![CDATA[// purpose depending on type of handoff]]>
</Line>
<Line Number="128">
<![CDATA[]]>
</Line>
<Line Number="129">
<![CDATA[]]>
</Line>
<Line Number="130">
<![CDATA[#region panel2]]>
</Line>
<Line Number="131">
<![CDATA[/// Input side, panel 2]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[REM2:2:O.Ch0Data[0].0 := \Loading.loadValve; 		// load valve]]>
</Line>
<Line Number="134">
<![CDATA[REM2:2:O.Ch0Data[0].1 := \Loading.tipperUp; 		// tipper ]]>
</Line>
<Line Number="135">
<![CDATA[REM2:2:O.Ch0Data[1].1 := \Loading.tipperDown; 		// tipper ]]>
</Line>
<Line Number="136">
<![CDATA[REM2:2:O.Ch0Data[0].2 := \Loading.hopperUp; 		// hopper ]]>
</Line>
<Line Number="137">
<![CDATA[REM2:2:O.Ch0Data[1].2 := \Loading.hopperDown; 		// hopper ]]>
</Line>
<Line Number="138">
<![CDATA[]]>
</Line>
<Line Number="139">
<![CDATA[]]>
</Line>
<Line Number="140">
<![CDATA[\Loading.isTipperDown 	:= REM2:2:I.Ch0Data[0].4;		// tipper limit]]>
</Line>
<Line Number="141">
<![CDATA[// -> Not implemented 	\Loading.isTipperUp 	:= REM2:2:I.Ch0Data[1].4;		// tipper limit]]>
</Line>
<Line Number="142">
<![CDATA[\Loading.isBinPresent 	:= REM2:2:I.Ch0Data[1].4;]]>
</Line>
<Line Number="143">
<![CDATA[]]>
</Line>
<Line Number="144">
<![CDATA[\Loading.isHopperUp 	:= REM2:2:I.Ch0Data[0].5;		// hopper limit]]>
</Line>
<Line Number="145">
<![CDATA[\Loading.isHopperDown 	:= REM2:2:I.Ch0Data[1].5;		// hopper limit]]>
</Line>
<Line Number="146">
<![CDATA[]]>
</Line>
<Line Number="147">
<![CDATA[// tempBool := REM2:2:I.Ch0Data[0].5;		// tipper mid pos]]>
</Line>
<Line Number="148">
<![CDATA[// tempBool := REM2:2:I.Ch0Data[1].5;		// tipper bin present]]>
</Line>
<Line Number="149">
<![CDATA[]]>
</Line>
<Line Number="150">
<![CDATA[]]>
</Line>
<Line Number="151">
<![CDATA[/// hopper door closed/open feedback?]]>
</Line>
<Line Number="152">
<![CDATA[]]>
</Line>
<Line Number="153">
<![CDATA[/// Transfer IO ]]>
</Line>
<Line Number="154">
<![CDATA[]]>
</Line>
<Line Number="155">
<![CDATA[// gripper]]>
</Line>
<Line Number="156">
<![CDATA[\Transfer.gripper.isOpen        	:= REM2:2:I.Ch3Data[0].4;]]>
</Line>
<Line Number="157">
<![CDATA[\Transfer.gripper.isClosed      	:= REM2:2:I.Ch3Data[1].4;]]>
</Line>
<Line Number="158">
<![CDATA[]]>
</Line>
<Line Number="159">
<![CDATA[\Transfer.gripper.isClosedEmpty 	:= REM2:2:I.Ch3Data[0].5;]]>
</Line>
<Line Number="160">
<![CDATA[]]>
</Line>
<Line Number="161">
<![CDATA[REM2:2:O.Ch3Data[0].2 			:= \Transfer.gripper.close;]]>
</Line>
<Line Number="162">
<![CDATA[REM2:2:O.Ch3Data[0].3 			:= \Transfer.gripper.open;]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[// transfer axis]]>
</Line>
<Line Number="165">
<![CDATA[(*]]>
</Line>
<Line Number="166">
<![CDATA[\Transfer.isLimitToInput 		:= REM2:2:I.Ch3Data[0].6;]]>
</Line>
<Line Number="167">
<![CDATA[\Transfer.isLimitToOutput 		:= REM2:2:I.Ch3Data[1].6;]]>
</Line>
<Line Number="168">
<![CDATA[]]>
</Line>
<Line Number="169">
<![CDATA[REM2:2:O.Ch3Data[0].0 			:= \Transfer.travCylToInput;]]>
</Line>
<Line Number="170">
<![CDATA[REM2:2:O.Ch3Data[0].1 			:= \Transfer.travCylToOutput;]]>
</Line>
<Line Number="171">
<![CDATA[*)]]>
</Line>
<Line Number="172">
<![CDATA[]]>
</Line>
<Line Number="173">
<![CDATA[/// measure conveyor]]>
</Line>
<Line Number="174">
<![CDATA[REM2:2:O.Ch1Data[0].0 		:= \Measure.heightCylDown;]]>
</Line>
<Line Number="175">
<![CDATA[REM2:2:O.Ch1Data[1].0 		:= \Measure.heightCylUp;]]>
</Line>
<Line Number="176">
<![CDATA[]]>
</Line>
<Line Number="177">
<![CDATA[//\Measure.MeasureSensor1 	:= REM2:2:I.Ch1Data[0].1;]]>
</Line>
<Line Number="178">
<![CDATA[]]>
</Line>
<Line Number="179">
<![CDATA[\Measure.measureSensor1 	:= REM2:3:I.6;	// alternative connection for faster resp.]]>
</Line>
<Line Number="180">
<![CDATA[]]>
</Line>
<Line Number="181">
<![CDATA[\Measure.measureSensorA		:= REM2:2:I.Ch1Data[0].3;]]>
</Line>
<Line Number="182">
<![CDATA[\Measure.measureSensorB 	:= REM2:2:I.Ch1Data[0].2;]]>
</Line>
<Line Number="183">
<![CDATA[]]>
</Line>
<Line Number="184">
<![CDATA[\InputConv.partExitDetect	:= REM2:2:I.Ch1Data[0].7;]]>
</Line>
<Line Number="185">
<![CDATA[]]>
</Line>
<Line Number="186">
<![CDATA[/// Stepper]]>
</Line>
<Line Number="187">
<![CDATA[//\Stepper.partAtBottom := REM2:2:I.Ch1Data[0].4;		// moved off io-link]]>
</Line>
<Line Number="188">
<![CDATA[\Stepper.partAtBottom := REM2:3:I.7;					]]>
</Line>
<Line Number="189">
<![CDATA[// did not change anything to be resolved how to ]]>
</Line>
<Line Number="190">
<![CDATA[// usefully detect we are out of parts in the stepper/hopper]]>
</Line>
<Line Number="191">
<![CDATA[]]>
</Line>
<Line Number="192">
<![CDATA[/// ]]>
</Line>
<Line Number="193">
<![CDATA[REM2:2:O.Ch3Data[2].0 := \Cutter.colletClamp;]]>
</Line>
<Line Number="194">
<![CDATA[REM2:2:O.Ch3Data[2].1 := \Cutter.colletUnClamp;]]>
</Line>
<Line Number="195">
<![CDATA[]]>
</Line>
<Line Number="196">
<![CDATA[REM2:2:O.Ch3Data[2].2 := \CutInFeed.colletUnClamp;]]>
</Line>
<Line Number="197">
<![CDATA[REM2:2:O.Ch3Data[3].2 := \CutInFeed.colletClamp;]]>
</Line>
<Line Number="198">
<![CDATA[]]>
</Line>
<Line Number="199">
<![CDATA[// diverter under cut head]]>
</Line>
<Line Number="200">
<![CDATA[REM2:2:O.Ch3Data[2].4 := \Diverter.toInput;]]>
</Line>
<Line Number="201">
<![CDATA[REM2:2:O.Ch3Data[2].5 := \Diverter.toOutput;]]>
</Line>
<Line Number="202">
<![CDATA[\Diverter.isInput := REM2:2:I.Ch3Data[2].6; // Diverter lim]]>
</Line>
<Line Number="203">
<![CDATA[\Diverter.isOutput := REM2:2:I.Ch3Data[3].6; // Diverter lim]]>
</Line>
<Line Number="204">
<![CDATA[// := REM2:2:I.Ch3Data[2].7 // cutter cover closed]]>
</Line>
<Line Number="205">
<![CDATA[]]>
</Line>
<Line Number="206">
<![CDATA[]]>
</Line>
<Line Number="207">
<![CDATA[]]>
</Line>
<Line Number="208">
<![CDATA[// bin present 1/2]]>
</Line>
<Line Number="209">
<![CDATA[// part detect on conv.]]>
</Line>
<Line Number="210">
<![CDATA[]]>
</Line>
<Line Number="211">
<![CDATA[]]>
</Line>
<Line Number="212">
<![CDATA[]]>
</Line>
<Line Number="213">
<![CDATA[JSR(BalluffIOLink);]]>
</Line>
<Line Number="214">
<![CDATA[JSR(ButtonEdges);]]>
</Line>
<Line Number="215">
<![CDATA[]]>
</Line>
<Line Number="216">
<![CDATA[#endregion]]>
</Line>
<Line Number="217">
<![CDATA[]]>
</Line>
<Line Number="218">
<![CDATA[]]>
</Line>
<Line Number="219">
<![CDATA[]]>
</Line>
<Line Number="220">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
