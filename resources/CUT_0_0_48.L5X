<Routine Name="CheckClearForFeed" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[isOKToFeedNextPart := 0;]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[// check if a part is/should be present, and if so should have completed]]>
</Line>
<Line Number="3">
<![CDATA[// the retract from input]]>
</Line>
<Line Number="4">
<![CDATA[if \PartPresent.head[0] then]]>
</Line>
<Line Number="5">
<![CDATA[	for counter := 0 to 29 do]]>
</Line>
<Line Number="6">
<![CDATA[		if \ModeAuto.currentSeqs[0].ops[counter].type = 15 then]]>
</Line>
<Line Number="7">
<![CDATA[			retractIndex := counter;]]>
</Line>
<Line Number="8">
<![CDATA[		end_if;]]>
</Line>
<Line Number="9">
<![CDATA[	end_for;]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	if \ModeAuto.runHead[0].index > retractIndex then]]>
</Line>
<Line Number="12">
<![CDATA[		isOKToFeedNextPart := 1;]]>
</Line>
<Line Number="13">
<![CDATA[	end_if;]]>
</Line>
<Line Number="14">
<![CDATA[end_if;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[// it cannot be holding a part]]>
</Line>
<Line Number="17">
<![CDATA[if \Heads.h[0].isColletReleased then	]]>
</Line>
<Line Number="18">
<![CDATA[	isOKToFeedNextPart := 1;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[if \CutInFeed.isFrontOffal then]]>
</Line>
<Line Number="23">
<![CDATA[	]]>
</Line>
<Line Number="24">
<![CDATA[	isOKToFeedNextPart := 1;]]>
</Line>
<Line Number="25">
<![CDATA[	]]>
</Line>
<Line Number="26">
<![CDATA[	// this will still block the feed ]]>
</Line>
<Line Number="27">
<![CDATA[	if \PartPresent.head[0] and \ModeAuto.isHeadInitPosition[0] then]]>
</Line>
<Line Number="28">
<![CDATA[		// assume that there is a pipe being held that has not moved.]]>
</Line>
<Line Number="29">
<![CDATA[		// perhaps the Heads have stopped running]]>
</Line>
<Line Number="30">
<![CDATA[		;]]>
</Line>
<Line Number="31">
<![CDATA[	end_if;]]>
</Line>
<Line Number="32">
<![CDATA[	]]>
</Line>
<Line Number="33">
<![CDATA[	if \PartPresent.head[0] then]]>
</Line>
<Line Number="34">
<![CDATA[		// a part is present and the head is more than 25mm away]]>
</Line>
<Line Number="35">
<![CDATA[		if \Axes.z[0].currentPosition]]>
</Line>
<Line Number="36">
<![CDATA[			> ]]>
</Line>
<Line Number="37">
<![CDATA[			(\ModeAuto.currentSeqs[0].ops[0].zPos + 25)]]>
</Line>
<Line Number="38">
<![CDATA[		then]]>
</Line>
<Line Number="39">
<![CDATA[			isOKToFeedNextPart := 1;]]>
</Line>
<Line Number="40">
<![CDATA[		end_if;]]>
</Line>
<Line Number="41">
<![CDATA[	end_if;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[	]]>
</Line>
<Line Number="44">
<![CDATA[	]]>
</Line>
<Line Number="45">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(*]]>
</Line>
<Line Number="2">
<![CDATA[Handling of the coordination between the ]]>
</Line>
<Line Number="3">
<![CDATA[cutter and cutinfeed]]>
</Line>
<Line Number="4">
<![CDATA[The measure and transfer are semi-autonomous]]>
</Line>
<Line Number="5">
<![CDATA[*)]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[// check if in correct mode]]>
</Line>
<Line Number="8">
<![CDATA[case \MachineMain.modeCurrent of]]>
</Line>
<Line Number="9">
<![CDATA[	0: 		stepMode := 1;	// prog mode]]>
</Line>
<Line Number="10">
<![CDATA[	2:		stepMode := 0; 	// auto mode]]>
</Line>
<Line Number="11">
<![CDATA[	else	message := 'Not in AUTO/PROG mode';]]>
</Line>
<Line Number="12">
<![CDATA[			TND();]]>
</Line>
<Line Number="13">
<![CDATA[end_case;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="16">
<![CDATA[	// capture break in safety for reason of stop]]>
</Line>
<Line Number="17">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="18">
<![CDATA[	active := 0;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[step := cButtonEdge.OutputBit;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[if  \Cutter.errorState > 0 or]]>
</Line>
<Line Number="26">
<![CDATA[	\CutInFeed.errorState > 0 or]]>
</Line>
<Line Number="27">
<![CDATA[	\Transfer.errorState > 0]]>
</Line>
<Line Number="28">
<![CDATA[then]]>
</Line>
<Line Number="29">
<![CDATA[	// set request stop if active]]>
</Line>
<Line Number="30">
<![CDATA[	requestStop := active;]]>
</Line>
<Line Number="31">
<![CDATA[end_if;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[/// Process stop commands]]>
</Line>
<Line Number="34">
<![CDATA[if active then]]>
</Line>
<Line Number="35">
<![CDATA[	if requestStop then]]>
</Line>
<Line Number="36">
<![CDATA[		case state of]]>
</Line>
<Line Number="37">
<![CDATA[			400..899: state := 900;]]>
</Line>
<Line Number="38">
<![CDATA[		end_case;]]>
</Line>
<Line Number="39">
<![CDATA[	end_if;]]>
</Line>
<Line Number="40">
<![CDATA[	]]>
</Line>
<Line Number="41">
<![CDATA[    if stopAfterTransfer or stopAfterCutInfeed then]]>
</Line>
<Line Number="42">
<![CDATA[        // Stop measure immediately]]>
</Line>
<Line Number="43">
<![CDATA[		// if there are any parts on in measure then we need to eject it ]]>
</Line>
<Line Number="44">
<![CDATA[		// as though it is NOK]]>
</Line>
<Line Number="45">
<![CDATA[        if \Measure.currentCmd <> 0 and \Measure.cmd = -1 then]]>
</Line>
<Line Number="46">
<![CDATA[            \Measure.cmd := 0;]]>
</Line>
<Line Number="47">
<![CDATA[        end_if;]]>
</Line>
<Line Number="48">
<![CDATA[    end_if;]]>
</Line>
<Line Number="49">
<![CDATA[	]]>
</Line>
<Line Number="50">
<![CDATA[    if stopAfterMeasure or stopAfterTransfer or stopAfterCutInfeed then]]>
</Line>
<Line Number="51">
<![CDATA[        // Stop upstream feeding]]>
</Line>
<Line Number="52">
<![CDATA[        if \Stepper.cmd = -1 then]]>
</Line>
<Line Number="53">
<![CDATA[            \Stepper.cmd := 0;]]>
</Line>
<Line Number="54">
<![CDATA[        end_if;]]>
</Line>
<Line Number="55">
<![CDATA[        if \InputConv.cmd = -1 then]]>
</Line>
<Line Number="56">
<![CDATA[            \InputConv.cmd := 0;]]>
</Line>
<Line Number="57">
<![CDATA[        end_if;]]>
</Line>
<Line Number="58">
<![CDATA[    end_if;]]>
</Line>
<Line Number="59">
<![CDATA[end_if;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[case state of]]>
</Line>
<Line Number="63">
<![CDATA[	0:]]>
</Line>
<Line Number="64">
<![CDATA[		// auto/prog init mode]]>
</Line>
<Line Number="65">
<![CDATA[		\HMI.clearButtons := 1;]]>
</Line>
<Line Number="66">
<![CDATA[		opErrorState := 5000;	// state for error handle]]>
</Line>
<Line Number="67">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="68">
<![CDATA[		message := 'Init';]]>
</Line>
<Line Number="69">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="70">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[	10:]]>
</Line>
<Line Number="73">
<![CDATA[		// precheck]]>
</Line>
<Line Number="74">
<![CDATA[		message := 'Precheck all systems are reset';]]>
</Line>
<Line Number="75">
<![CDATA[		]]>
</Line>
<Line Number="76">
<![CDATA[		// stop all systems ready for startup]]>
</Line>
<Line Number="77">
<![CDATA[		\Stepper.cmd := 0;]]>
</Line>
<Line Number="78">
<![CDATA[		\InputConv.cmd := 0;]]>
</Line>
<Line Number="79">
<![CDATA[		\Measure.cmd := 0;]]>
</Line>
<Line Number="80">
<![CDATA[		// can't initiate motion when e-stop released.]]>
</Line>
<Line Number="81">
<![CDATA[		//\Transfer.cmd := 20; // move to home, could be conditional on status]]>
</Line>
<Line Number="82">
<![CDATA[		\Transfer.cmd := 0;]]>
</Line>
<Line Number="83">
<![CDATA[		\CutInFeed.cmd := 0;]]>
</Line>
<Line Number="84">
<![CDATA[		\Cutter.cmd := 0;]]>
</Line>
<Line Number="85">
<![CDATA[		]]>
</Line>
<Line Number="86">
<![CDATA[		// ]]>
</Line>
<Line Number="87">
<![CDATA[		preCheck := ]]>
</Line>
<Line Number="88">
<![CDATA[			\Stepper.currentCmd = 0 and]]>
</Line>
<Line Number="89">
<![CDATA[			\InputConv.currentCmd = 0 and]]>
</Line>
<Line Number="90">
<![CDATA[			\Measure.currentCmd = 0 and]]>
</Line>
<Line Number="91">
<![CDATA[			\Transfer.currentCmd = 0 and]]>
</Line>
<Line Number="92">
<![CDATA[			\CutInFeed.currentCmd = 0 and]]>
</Line>
<Line Number="93">
<![CDATA[			\Cutter.currentCmd = 0;]]>
</Line>
<Line Number="94">
<![CDATA[		]]>
</Line>
<Line Number="95">
<![CDATA[		if preCheck then]]>
</Line>
<Line Number="96">
<![CDATA[			//TimerStart(tS, timer, 200);]]>
</Line>
<Line Number="97">
<![CDATA[			message := 'Check startup conditions';]]>
</Line>
<Line Number="98">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="99">
<![CDATA[		end_if;]]>
</Line>
<Line Number="100">
<![CDATA[		]]>
</Line>
<Line Number="101">
<![CDATA[	100:]]>
</Line>
<Line Number="102">
<![CDATA[		// check the validity of the current state]]>
</Line>
<Line Number="103">
<![CDATA[		stateStart := -1;]]>
</Line>
<Line Number="104">
<![CDATA[		]]>
</Line>
<Line Number="105">
<![CDATA[		/// check infeed part status]]>
</Line>
<Line Number="106">
<![CDATA[		if \PartPresent.infeed then]]>
</Line>
<Line Number="107">
<![CDATA[			//check consistent]]>
</Line>
<Line Number="108">
<![CDATA[			if \CutInFeed.isColletUnClamped then]]>
</Line>
<Line Number="109">
<![CDATA[				\PartPresent.infeed := 0;]]>
</Line>
<Line Number="110">
<![CDATA[				// need to check manually if there is a part in the cutter still]]>
</Line>
<Line Number="111">
<![CDATA[				TND();]]>
</Line>
<Line Number="112">
<![CDATA[			end_if;]]>
</Line>
<Line Number="113">
<![CDATA[			]]>
</Line>
<Line Number="114">
<![CDATA[			// if waiting for cut or a handover (no cut)]]>
</Line>
<Line Number="115">
<![CDATA[			// -> the pipe is in the correct position (could be checked?)]]>
</Line>
<Line Number="116">
<![CDATA[			// -> a cutting cycle has not completed]]>
</Line>
<Line Number="117">
<![CDATA[]]>
</Line>
<Line Number="118">
<![CDATA[			if \Cutter.isCutDone then]]>
</Line>
<Line Number="119">
<![CDATA[				// go to feed, if the collet had been unclamped]]>
</Line>
<Line Number="120">
<![CDATA[				// this would have been cleared]]>
</Line>
<Line Number="121">
<![CDATA[				]]>
</Line>
<Line Number="122">
<![CDATA[				// not waiting for cut]]>
</Line>
<Line Number="123">
<![CDATA[				// -> a cutting cycle has completed]]>
</Line>
<Line Number="124">
<![CDATA[				// -> the pipe has not been advanced]]>
</Line>
<Line Number="125">
<![CDATA[				 ]]>
</Line>
<Line Number="126">
<![CDATA[				case \CutInFeed.cutCounter of]]>
</Line>
<Line Number="127">
<![CDATA[					-1:]]>
</Line>
<Line Number="128">
<![CDATA[						// have a part but has not been fed in yet]]>
</Line>
<Line Number="129">
<![CDATA[						stateStart := 450;				/// enter cutting loop]]>
</Line>
<Line Number="130">
<![CDATA[					else]]>
</Line>
<Line Number="131">
<![CDATA[						// need to consider the number of cuts?]]>
</Line>
<Line Number="132">
<![CDATA[						stateStart := 450;]]>
</Line>
<Line Number="133">
<![CDATA[				end_Case;]]>
</Line>
<Line Number="134">
<![CDATA[				]]>
</Line>
<Line Number="135">
<![CDATA[				stateStart := 450;]]>
</Line>
<Line Number="136">
<![CDATA[			]]>
</Line>
<Line Number="137">
<![CDATA[			else]]>
</Line>
<Line Number="138">
<![CDATA[				// have a part, cut not done collet clamped ]]>
</Line>
<Line Number="139">
<![CDATA[				if \Cutter.isColletClamped then]]>
</Line>
<Line Number="140">
<![CDATA[					// -> do the cut]]>
</Line>
<Line Number="141">
<![CDATA[					stateStart := 480;]]>
</Line>
<Line Number="142">
<![CDATA[				else]]>
</Line>
<Line Number="143">
<![CDATA[					// TODO: We can check the partCount and]]>
</Line>
<Line Number="144">
<![CDATA[					// infeed position / flags]]>
</Line>
<Line Number="145">
<![CDATA[					// looks like a empty start with part ]]>
</Line>
<Line Number="146">
<![CDATA[					// present]]>
</Line>
<Line Number="147">
<![CDATA[					stateStart := 450;]]>
</Line>
<Line Number="148">
<![CDATA[				end_if;]]>
</Line>
<Line Number="149">
<![CDATA[				]]>
</Line>
<Line Number="150">
<![CDATA[			end_if;]]>
</Line>
<Line Number="151">
<![CDATA[		else]]>
</Line>
<Line Number="152">
<![CDATA[			stateStart := 400;]]>
</Line>
<Line Number="153">
<![CDATA[		end_if;]]>
</Line>
<Line Number="154">
<![CDATA[		]]>
</Line>
<Line Number="155">
<![CDATA[		]]>
</Line>
<Line Number="156">
<![CDATA[		]]>
</Line>
<Line Number="157">
<![CDATA[		// if in run out situation need to know if there are still parts here?]]>
</Line>
<Line Number="158">
<![CDATA[		stepperStartCmd := 1;						// this is safe to assume run regardless]]>
</Line>
<Line Number="159">
<![CDATA[		]]>
</Line>
<Line Number="160">
<![CDATA[		// resuming from here is un-certain -- the status can not be verified.]]>
</Line>
<Line Number="161">
<![CDATA[		// alternative option is in case of any measure part element then]]>
</Line>
<Line Number="162">
<![CDATA[		// eject from end for safety.]]>
</Line>
<Line Number="163">
<![CDATA[		if \PartPresent.measure or \PartPresent.measured or \PartPresent.measuredToCollect then]]>
</Line>
<Line Number="164">
<![CDATA[			// throw out the end]]>
</Line>
<Line Number="165">
<![CDATA[		end_if;]]>
</Line>
<Line Number="166">
<![CDATA[		]]>
</Line>
<Line Number="167">
<![CDATA[		]]>
</Line>
<Line Number="168">
<![CDATA[		// default]]>
</Line>
<Line Number="169">
<![CDATA[		inputConvStartCmd := 1;]]>
</Line>
<Line Number="170">
<![CDATA[		measureStartCmd := 1;]]>
</Line>
<Line Number="171">
<![CDATA[		]]>
</Line>
<Line Number="172">
<![CDATA[		if \PartPresent.measuredToCollect then]]>
</Line>
<Line Number="173">
<![CDATA[			measureStartCmd := 10;					// if there is a pipe waiting then pick up.]]>
</Line>
<Line Number="174">
<![CDATA[													// assuming the pipe is not disturbed.]]>
</Line>
<Line Number="175">
<![CDATA[			inputConvStartCmd := 0;					// and will wait for measure]]>
</Line>
<Line Number="176">
<![CDATA[		end_if;]]>
</Line>
<Line Number="177">
<![CDATA[		]]>
</Line>
<Line Number="178">
<![CDATA[		if \PartPresent.transfer then]]>
</Line>
<Line Number="179">
<![CDATA[			transferStartCmd := 2;					// resume wait for cutinfeed]]>
</Line>
<Line Number="180">
<![CDATA[			measureStartCmd := 15; 					// wait for transfer to complete]]>
</Line>
<Line Number="181">
<![CDATA[			inputConvStartCmd := 2;					// wait for measure but advance pipe]]>
</Line>
<Line Number="182">
<![CDATA[		else]]>
</Line>
<Line Number="183">
<![CDATA[			transferStartCmd := 1;					// run auto]]>
</Line>
<Line Number="184">
<![CDATA[		end_if;	]]>
</Line>
<Line Number="185">
<![CDATA[		]]>
</Line>
<Line Number="186">
<![CDATA[		if stateStart <> -1 then]]>
</Line>
<Line Number="187">
<![CDATA[			message := 'A to start input process';]]>
</Line>
<Line Number="188">
<![CDATA[			]]>
</Line>
<Line Number="189">
<![CDATA[			if aButtonEdge.OutputBit then]]>
</Line>
<Line Number="190">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="191">
<![CDATA[			end_if;]]>
</Line>
<Line Number="192">
<![CDATA[		else]]>
</Line>
<Line Number="193">
<![CDATA[			// not able to start?]]>
</Line>
<Line Number="194">
<![CDATA[			message := 'Input state unknown - clear and reset with MAN';]]>
</Line>
<Line Number="195">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="196">
<![CDATA[		end_if;]]>
</Line>
<Line Number="197">
<![CDATA[]]>
</Line>
<Line Number="198">
<![CDATA[		]]>
</Line>
<Line Number="199">
<![CDATA[	/// start init	]]>
</Line>
<Line Number="200">
<![CDATA[	200:]]>
</Line>
<Line Number="201">
<![CDATA[		\Stepper.cmd := stepperStartCmd;]]>
</Line>
<Line Number="202">
<![CDATA[		\InputConv.cmd := inputConvStartCmd;]]>
</Line>
<Line Number="203">
<![CDATA[		\Measure.cmd := measureStartCmd;]]>
</Line>
<Line Number="204">
<![CDATA[		\Transfer.cmd := transferStartCmd;]]>
</Line>
<Line Number="205">
<![CDATA[		]]>
</Line>
<Line Number="206">
<![CDATA[		active := 1;]]>
</Line>
<Line Number="207">
<![CDATA[		]]>
</Line>
<Line Number="208">
<![CDATA[		state := stateStart;]]>
</Line>
<Line Number="209">
<![CDATA[		]]>
</Line>
<Line Number="210">
<![CDATA[	/// start of cycle]]>
</Line>
<Line Number="211">
<![CDATA[	400:]]>
</Line>
<Line Number="212">
<![CDATA[		]]>
</Line>
<Line Number="213">
<![CDATA[		// move the infeed back for the transfer]]>
</Line>
<Line Number="214">
<![CDATA[		]]>
</Line>
<Line Number="215">
<![CDATA[		if \CutInFeed.isColletUnClamped then]]>
</Line>
<Line Number="216">
<![CDATA[			if \Transfer.isOutputClear then]]>
</Line>
<Line Number="217">
<![CDATA[				message := 'started; infeed moving to init';				]]>
</Line>
<Line Number="218">
<![CDATA[				\CutInFeed.cmd := 22; 	// move back to position clear of next pipe]]>
</Line>
<Line Number="219">
<![CDATA[				state := 420;]]>
</Line>
<Line Number="220">
<![CDATA[			elsif \CutInFeed.isSafeForTransfer then]]>
</Line>
<Line Number="221">
<![CDATA[				state := 420;]]>
</Line>
<Line Number="222">
<![CDATA[			else]]>
</Line>
<Line Number="223">
<![CDATA[				message := 'CutInfeed is not safe for transfer';]]>
</Line>
<Line Number="224">
<![CDATA[			end_if;]]>
</Line>
<Line Number="225">
<![CDATA[		else]]>
</Line>
<Line Number="226">
<![CDATA[			/// should not be here]]>
</Line>
<Line Number="227">
<![CDATA[			// if collet is clamped then need to check current status of the]]>
</Line>
<Line Number="228">
<![CDATA[			message := 'infeed collet is clamped - check for part'; ]]>
</Line>
<Line Number="229">
<![CDATA[			]]>
</Line>
<Line Number="230">
<![CDATA[			if \PartPresent.infeed then]]>
</Line>
<Line Number="231">
<![CDATA[				// there is a part already in the infeed so should be]]>
</Line>
<Line Number="232">
<![CDATA[				// able to resume the cutting cycle.]]>
</Line>
<Line Number="233">
<![CDATA[				;]]>
</Line>
<Line Number="234">
<![CDATA[			end_if;]]>
</Line>
<Line Number="235">
<![CDATA[		end_if;]]>
</Line>
<Line Number="236">
<![CDATA[]]>
</Line>
<Line Number="237">
<![CDATA[]]>
</Line>
<Line Number="238">
<![CDATA[	420:]]>
</Line>
<Line Number="239">
<![CDATA[		// the transfer will detect by itself the the infeed is clear]]>
</Line>
<Line Number="240">
<![CDATA[		// and move across]]>
</Line>
<Line Number="241">
<![CDATA[		// double check and then tell the cutInfeed to collect the pipe]]>
</Line>
<Line Number="242">
<![CDATA[		if \CutInFeed.currentCmd = 0 then]]>
</Line>
<Line Number="243">
<![CDATA[			if \CutInFeed.isSafeForTransfer then]]>
</Line>
<Line Number="244">
<![CDATA[				if \Transfer.isReadyForUnload then]]>
</Line>
<Line Number="245">
<![CDATA[					\CutInFeed.cmd := 30; //move to incoming pipe position]]>
</Line>
<Line Number="246">
<![CDATA[					state := 430;]]>
