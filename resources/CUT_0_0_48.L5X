<Routines>
<Routine Name="CheckForStop" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[if cmd <> -1 then]]>
</Line>
<Line Number="1">
<![CDATA[	if cmd = 0 then]]>
</Line>
<Line Number="2">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="3">
<![CDATA[	end_if;]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="LogTransfer" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//message := message;]]>
</Line>
<Line Number="1">
<![CDATA[//RTOS(measuredLength, numString);]]>
</Line>
<Line Number="2">
<![CDATA[//CONCAT(message, numString, message);]]>
</Line>
<Line Number="3">
<![CDATA[\Event.message := message;]]>
</Line>
<Line Number="4">
<![CDATA[Event(LogEvent);]]>
</Line>
</STContent>
</Routine>
<Routine Name="MainServo" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="4">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="5">
<![CDATA[end_if;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[axisPosition := axis.currentPosition;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[isUp := Y0.ActualPosition < posUpY + 2.5; 			// allowance]]>
</Line>
<Line Number="10">
<![CDATA[isAtInput := ABS(\Axes.xIn.currentPosition - \Settings.inputProcessParam.transferPickUpX) < 0.25;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[// this could check Y position as well]]>
</Line>
<Line Number="13">
<![CDATA[isAtOutput := ABS(\Axes.xIn.currentPosition - \Settings.inputProcessParam.transferDropOffX ) < 0.25;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//isHome := isLimitToInput and isUp and gripper.isOpen;]]>
</Line>
<Line Number="16">
<![CDATA[isHome := isAtInput and isUp and gripper.isOpen;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[//isInputClear := isLimitToOutput;]]>
</Line>
<Line Number="19">
<![CDATA[isInputClear := \Axes.xIn.currentPosition > \Settings.inputProcessParam.transferPickUpX + 100.0;]]>
</Line>
<Line Number="20">
<![CDATA[isOutputClear := \Axes.xIn.currentPosition < (\Settings.inputProcessParam.transferWaitX + 1.0);]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[(*]]>
</Line>
<Line Number="23">
<![CDATA[// what about closedIsEmpty?]]>
</Line>
<Line Number="24">
<![CDATA[isReadyForUnload :=]]>
</Line>
<Line Number="25">
<![CDATA[	ABS(axis.currentPosition - posDropOffY) < 0.2 and]]>
</Line>
<Line Number="26">
<![CDATA[	not axis.move and]]>
</Line>
<Line Number="27">
<![CDATA[	isLimitToOutput;]]>
</Line>
<Line Number="28">
<![CDATA[// and gripper closed correctly]]>
</Line>
<Line Number="29">
<![CDATA[*)]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[// for servo]]>
</Line>
<Line Number="32">
<![CDATA[isReadyForUnload :=]]>
</Line>
<Line Number="33">
<![CDATA[	ABS(axis.currentPosition - posDropOffY) < 0.2 and not axis.move and]]>
</Line>
<Line Number="34">
<![CDATA[	ABS(\Axes.xIn.currentPosition - \Settings.inputProcessParam.transferDropOffX) < 0.2 and not \Axes.xIn.move;]]>
</Line>
<Line Number="35">
<![CDATA[// not putting in the that the gripper is closed and/or PartPresent could be used.]]>
</Line>
<Line Number="36">
<![CDATA[	]]>
</Line>
<Line Number="37">
<![CDATA[if axis.fault or \Axes.xIn.fault then]]>
</Line>
<Line Number="38">
<![CDATA[	if state <> opErrorState then]]>
</Line>
<Line Number="39">
<![CDATA[		errorState := state;]]>
</Line>
<Line Number="40">
<![CDATA[		state := opErrorState;]]>
</Line>
<Line Number="41">
<![CDATA[	end_if;]]>
</Line>
<Line Number="42">
<![CDATA[end_if;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[case state of]]>
</Line>
<Line Number="47">
<![CDATA[	]]>
</Line>
<Line Number="48">
<![CDATA[	/// init, after ES and PWR]]>
</Line>
<Line Number="49">
<![CDATA[	0: 	]]>
</Line>
<Line Number="50">
<![CDATA[		gripper.close 		:= 0;]]>
</Line>
<Line Number="51">
<![CDATA[		gripper.open 		:= 0;]]>
</Line>
<Line Number="52">
<![CDATA[		]]>
</Line>
<Line Number="53">
<![CDATA[		posUpY := 1.0;														// this is the top of the axis positon]]>
</Line>
<Line Number="54">
<![CDATA[		]]>
</Line>
<Line Number="55">
<![CDATA[		posPickupY := \Settings.inputProcessParam.transferPickUpY;			// this is the height on the measure conv. ]]>
</Line>
<Line Number="56">
<![CDATA[																			// but bottom of pipe is plane]]>
</Line>
<Line Number="57">
<![CDATA[		posDropOffY := \Settings.inputProcessParam.transferDropOffY;		// drop off position centre of pipe is reference.]]>
</Line>
<Line Number="58">
<![CDATA[		]]>
</Line>
<Line Number="59">
<![CDATA[		// set some defaults here.		]]>
</Line>
<Line Number="60">
<![CDATA[		axis.speed 			:= 250.0;]]>
</Line>
<Line Number="61">
<![CDATA[		axis.speed 			:= 300.0;]]>
</Line>
<Line Number="62">
<![CDATA[		]]>
</Line>
<Line Number="63">
<![CDATA[		axis.jerkPercentage := 75.0;]]>
</Line>
<Line Number="64">
<![CDATA[		axis.accel 			:= 1200.0;	//600.0;]]>
</Line>
<Line Number="65">
<![CDATA[		axis.decel 			:= axis.accel;]]>
</Line>
<Line Number="66">
<![CDATA[		]]>
</Line>
<Line Number="67">
<![CDATA[		// taken from x settings in ModeAuto]]>
</Line>
<Line Number="68">
<![CDATA[		\Axes.xIn.speed				:= 275.0;]]>
</Line>
<Line Number="69">
<![CDATA[		\Axes.xIn.accel				:= 1750.0;]]>
</Line>
<Line Number="70">
<![CDATA[		\Axes.xIn.decel				:= \Axes.xIn.accel;]]>
</Line>
<Line Number="71">
<![CDATA[		\Axes.xIn.jerkPercentage 	:= 50.0;]]>
</Line>
<Line Number="72">
<![CDATA[		]]>
</Line>
<Line Number="73">
<![CDATA[		// test speed]]>
</Line>
<Line Number="74">
<![CDATA[		\Axes.xIn.speed				:= 400.0;]]>
</Line>
<Line Number="75">
<![CDATA[		\Axes.xIn.speed				:= 550.0;]]>
</Line>
<Line Number="76">
<![CDATA[		\Axes.xIn.accel				:= 5000.0;//2750.0;]]>
</Line>
<Line Number="77">
<![CDATA[		\Axes.xIn.decel				:= \Axes.xIn.accel;]]>
</Line>
<Line Number="78">
<![CDATA[		\Axes.xIn.jerkPercentage 	:= 50.0;]]>
</Line>
<Line Number="79">
<![CDATA[		\Axes.xIn.jerkPercentage 	:= 75.0;]]>
</Line>
<Line Number="80">
<![CDATA[		]]>
</Line>
<Line Number="81">
<![CDATA[		currentCmd := -1;]]>
</Line>
<Line Number="82">
<![CDATA[		message := 'wait for axis ready';]]>
</Line>
<Line Number="83">
<![CDATA[		]]>
</Line>
<Line Number="84">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="85">
<![CDATA[		opErrorState := 5000;]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="88">
<![CDATA[	]]>
</Line>
<Line Number="89">
<![CDATA[	10:]]>
</Line>
<Line Number="90">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="91">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="92">
<![CDATA[		else]]>
</Line>
<Line Number="93">
<![CDATA[			// we are supposed to wait]]>
</Line>
<Line Number="94">
<![CDATA[		end_if;]]>
</Line>
<Line Number="95">
<![CDATA[	]]>
</Line>
<Line Number="96">
<![CDATA[	100:]]>
</Line>
<Line Number="97">
<![CDATA[		currentCmd 	:= 0;]]>
</Line>
<Line Number="98">
<![CDATA[		cmd 		:= -1;]]>
</Line>
<Line Number="99">
<![CDATA[		message 	:= 'stopped/ready';]]>
</Line>
<Line Number="100">
<![CDATA[		]]>
</Line>
<Line Number="101">
<![CDATA[		state := 110;		]]>
</Line>
<Line Number="102">
<![CDATA[	110:]]>
</Line>
<Line Number="103">
<![CDATA[		]]>
</Line>
<Line Number="104">
<![CDATA[		(*]]>
</Line>
<Line Number="105">
<![CDATA[			cmd]]>
</Line>
<Line Number="106">
<![CDATA[			 ]]>
</Line>
<Line Number="107">
<![CDATA[			 0 		- stop]]>
</Line>
<Line Number="108">
<![CDATA[			 1 		- run auto init -- go to home]]>
</Line>
<Line Number="109">
<![CDATA[			 2		- resume wait for cut infeed]]>
</Line>
<Line Number="110">
<![CDATA[			 15		- move to input]]>
</Line>
<Line Number="111">
<![CDATA[			 16		- move to output]]>
</Line>
<Line Number="112">
<![CDATA[			 20 	- go to home only]]>
</Line>
<Line Number="113">
<![CDATA[			 25		- go to home after unload]]>
</Line>
<Line Number="114">
<![CDATA[			 30 	- move down to pickup]]>
</Line>
<Line Number="115">
<![CDATA[			 31 	- move up]]>
</Line>
<Line Number="116">
<![CDATA[			 32 	- move down to output]]>
</Line>
<Line Number="117">
<![CDATA[			 40		- auto; pick up and run to infeed ]]>
</Line>
<Line Number="118">
<![CDATA[			 50 	- return part to measure conv. (wip)]]>
</Line>
<Line Number="119">
<![CDATA[			 100 	- manual ?]]>
</Line>
<Line Number="120">
<![CDATA[		*)]]>
</Line>
<Line Number="121">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="122">
<![CDATA[			0:]]>
</Line>
<Line Number="123">
<![CDATA[				//currentCmd := ]]>
</Line>
<Line Number="124">
<![CDATA[				;]]>
</Line>
<Line Number="125">
<![CDATA[			1:]]>
</Line>
<Line Number="126">
<![CDATA[				// start auto run]]>
</Line>
<Line Number="127">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="128">
<![CDATA[			]]>
</Line>
<Line Number="129">
<![CDATA[			2:	]]>
</Line>
<Line Number="130">
<![CDATA[				// resume wait for cutinfeed]]>
</Line>
<Line Number="131">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="132">
<![CDATA[			]]>
</Line>
<Line Number="133">
<![CDATA[			// manual commands	]]>
</Line>
<Line Number="134">
<![CDATA[			10:]]>
</Line>
<Line Number="135">
<![CDATA[				// toggle gripper]]>
</Line>
<Line Number="136">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="137">
<![CDATA[				]]>
</Line>
<Line Number="138">
<![CDATA[				(*]]>
</Line>
<Line Number="139">
<![CDATA[				//add?]]>
</Line>
<Line Number="140">
<![CDATA[			11: move up input]]>
</Line>
<Line Number="141">
<![CDATA[			12: move down input]]>
</Line>
<Line Number="142">
<![CDATA[			13: move down output]]>
</Line>
<Line Number="143">
<![CDATA[			]]>
</Line>
<Line Number="144">
<![CDATA[				*)]]>
</Line>
<Line Number="145">
<![CDATA[			15: // move to input]]>
</Line>
<Line Number="146">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="147">
<![CDATA[			16: // move to output]]>
</Line>
<Line Number="148">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="149">
<![CDATA[			17: // move to wait position]]>
</Line>
<Line Number="150">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="151">
<![CDATA[			20: // move to home]]>
</Line>
<Line Number="152">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="153">
<![CDATA[				]]>
</Line>
<Line Number="154">
<![CDATA[			// auto ]]>
</Line>
<Line Number="155">
<![CDATA[			25:	// open gripper, move to home after unload  ]]>
</Line>
<Line Number="156">
<![CDATA[				state := 160;]]>
</Line>
<Line Number="157">
<![CDATA[			40:	// move down and pickup -- next step auto]]>
</Line>
<Line Number="158">
<![CDATA[				state := 400;]]>
</Line>
<Line Number="159">
<![CDATA[				]]>
</Line>
<Line Number="160">
<![CDATA[			// need refactor	]]>
</Line>
<Line Number="161">
<![CDATA[			30:]]>
</Line>
<Line Number="162">
<![CDATA[				// move down to pickup only				]]>
</Line>
<Line Number="163">
<![CDATA[				state := 410;]]>
</Line>
<Line Number="164">
<![CDATA[			31:	// move up 		]]>
</Line>
<Line Number="165">
<![CDATA[				state := 600;]]>
