<Line Number="369">
<![CDATA[		runHead[0].cutDone := \Cutter.isCutDone;]]>
</Line>
<Line Number="370">
<![CDATA[		]]>
</Line>
<Line Number="371">
<![CDATA[		// step and waiting input]]>
</Line>
<Line Number="372">
<![CDATA[		allWaiting := 1;]]>
</Line>
<Line Number="373">
<![CDATA[		for counter := 0 to 3 do]]>
</Line>
<Line Number="374">
<![CDATA[			if headEnabled[counter] then]]>
</Line>
<Line Number="375">
<![CDATA[				allWaiting := allWaiting and runHead[counter].waiting;]]>
