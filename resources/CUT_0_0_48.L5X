<Line Number="244">
<![CDATA[		end_case;]]>
</Line>
<Line Number="245">
<![CDATA[	]]>
</Line>
<Line Number="246">
<![CDATA[	151:]]>
</Line>
<Line Number="247">
<![CDATA[		if isUp then]]>
</Line>
<Line Number="248">
<![CDATA[			if \Axes.xIn.ready then]]>
