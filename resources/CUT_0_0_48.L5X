<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// helper progrm for heads]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// process the head collet states]]>
</Line>
<Line Number="4">
<![CDATA[// the head collets don't have feedback so will be simulated]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[for counter := 0 to 3 do]]>
</Line>
<Line Number="7">
<![CDATA[	]]>
</Line>
<Line Number="8">
<![CDATA[	//COP(\IO.heads[counter], headIO, 1);]]>
</Line>
<Line Number="9">
<![CDATA[	COP(h[counter], headIO, 1);]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	TONR(headIO.cTimer);]]>
</Line>
<Line Number="12">
<![CDATA[	]]>
</Line>
<Line Number="13">
<![CDATA[	case headIO.cState of]]>
</Line>
<Line Number="14">
<![CDATA[		0:]]>
</Line>
<Line Number="15">
<![CDATA[			if headIO.colletClamp or headIO.colletRelease then]]>
</Line>
<Line Number="16">
<![CDATA[				headIO.isColletClamped 	:= 0;]]>
</Line>
<Line Number="17">
<![CDATA[				headIO.isColletReleased := 0;]]>
</Line>
<Line Number="18">
<![CDATA[				//TimerStart(tS, headIO.cTimer, 1250);]]>
</Line>
<Line Number="19">
<![CDATA[				TimerStart(tS, headIO.cTimer, 750);]]>
</Line>
<Line Number="20">
<![CDATA[				headIO.cState := 20;]]>
</Line>
<Line Number="21">
<![CDATA[			end_if;]]>
</Line>
<Line Number="22">
<![CDATA[			]]>
</Line>
<Line Number="23">
<![CDATA[		]]>
</Line>
<Line Number="24">
<![CDATA[		]]>
</Line>
<Line Number="25">
<![CDATA[		20:]]>
</Line>
<Line Number="26">
<![CDATA[			if headIO.cTimer.DN then]]>
</Line>
<Line Number="27">
<![CDATA[				headIO.cTimer.Reset := 1;]]>
</Line>
<Line Number="28">
<![CDATA[				headIO.cState := 30;]]>
</Line>
<Line Number="29">
<![CDATA[			end_if;]]>
</Line>
<Line Number="30">
<![CDATA[			]]>
</Line>
<Line Number="31">
<![CDATA[		30:]]>
</Line>
<Line Number="32">
<![CDATA[			if headIO.colletClamp then]]>
</Line>
<Line Number="33">
<![CDATA[				headIO.isColletClamped := 1;]]>
</Line>
<Line Number="34">
<![CDATA[				headIO.isColletReleased := 0;]]>
</Line>
<Line Number="35">
<![CDATA[			elsif headIO.colletRelease then]]>
</Line>
<Line Number="36">
<![CDATA[				headIO.isColletReleased := 1;]]>
</Line>
<Line Number="37">
<![CDATA[				headIO.isColletClamped := 0;]]>
</Line>
<Line Number="38">
<![CDATA[			else]]>
</Line>
<Line Number="39">
<![CDATA[				; //?]]>
</Line>
<Line Number="40">
<![CDATA[			end_If;]]>
</Line>
<Line Number="41">
<![CDATA[			]]>
</Line>
<Line Number="42">
<![CDATA[			headIO.colletClamp := 0;]]>
</Line>
<Line Number="43">
<![CDATA[			headIO.colletRelease := 0;]]>
</Line>
<Line Number="44">
<![CDATA[			]]>
</Line>
<Line Number="45">
<![CDATA[			headIO.cState := 0;]]>
</Line>
<Line Number="46">
<![CDATA[			]]>
</Line>
<Line Number="47">
<![CDATA[	end_Case;]]>
</Line>
<Line Number="48">
<![CDATA[	]]>
</Line>
<Line Number="49">
<![CDATA[	TONR(headIO.lTimer);]]>
</Line>
<Line Number="50">
<![CDATA[	]]>
</Line>
<Line Number="51">
<![CDATA[	case headIO.lState of ]]>
</Line>
<Line Number="52">
<![CDATA[		0:]]>
</Line>
<Line Number="53">
<![CDATA[			if headIO.liftUp or headIO.liftDown then]]>
</Line>
<Line Number="54">
<![CDATA[				TimerStart(tS, headIO.lTimer, 2500);]]>
</Line>
<Line Number="55">
<![CDATA[				headIO.lState := 10;]]>
</Line>
<Line Number="56">
<![CDATA[			end_if;]]>
</Line>
<Line Number="57">
<![CDATA[			]]>
</Line>
<Line Number="58">
<![CDATA[		10:]]>
</Line>
<Line Number="59">
<![CDATA[			if headIO.liftUp then]]>
</Line>
<Line Number="60">
<![CDATA[				if headIO.isLiftUp then]]>
</Line>
<Line Number="61">
<![CDATA[					headIO.lState := 30;]]>
</Line>
<Line Number="62">
<![CDATA[				end_if;]]>
</Line>
<Line Number="63">
<![CDATA[			elsif headIO.liftDown then]]>
</Line>
<Line Number="64">
<![CDATA[				if headIO.isLiftDown then]]>
</Line>
<Line Number="65">
<![CDATA[					headIO.lState := 30;]]>
</Line>
<Line Number="66">
<![CDATA[				end_if;]]>
</Line>
<Line Number="67">
<![CDATA[			end_if;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[			if headIO.lTimer.DN then]]>
</Line>
<Line Number="70">
<![CDATA[				headIO.lTimer.Reset := 1;]]>
</Line>
<Line Number="71">
<![CDATA[				headIO.lState := 20;]]>
</Line>
<Line Number="72">
<![CDATA[			end_if;]]>
</Line>
<Line Number="73">
<![CDATA[			]]>
</Line>
<Line Number="74">
<![CDATA[			]]>
</Line>
<Line Number="75">
<![CDATA[		20:]]>
</Line>
<Line Number="76">
<![CDATA[			if headIO.liftUp then]]>
</Line>
<Line Number="77">
<![CDATA[				message := 'lift up not done';]]>
</Line>
<Line Number="78">
<![CDATA[			else]]>
</Line>
<Line Number="79">
<![CDATA[				message := 'lift down not done';]]>
</Line>
<Line Number="80">
<![CDATA[			end_If;]]>
</Line>
<Line Number="81">
<![CDATA[			]]>
</Line>
<Line Number="82">
<![CDATA[			\Event.message := message;]]>
</Line>
<Line Number="83">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="84">
<![CDATA[			]]>
</Line>
<Line Number="85">
<![CDATA[			headIO.lState := 30;]]>
</Line>
<Line Number="86">
<![CDATA[		]]>
</Line>
<Line Number="87">
