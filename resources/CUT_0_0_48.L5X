<Line Number="25">
<![CDATA[	cuttingParam.isEndOnZ and]]>
</Line>
<Line Number="26">
<![CDATA[	not \CutInFeed.isFrontOffal and]]>
</Line>
<Line Number="27">
<![CDATA[	(\Axes.z[0].currentPosition - cutStartZ) > cuttingParam.zShiftThreshold;]]>
</Line>
<Line Number="28">
<![CDATA[	]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[if isColletUnClamped and isCutDone then]]>
</Line>
<Line Number="31">
<![CDATA[	isCutDone := 0;]]>
</Line>
<Line Number="32">
<![CDATA[end_if;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[if sAxis.fault or axis.fault then]]>
</Line>
<Line Number="35">
<![CDATA[	if state <> opErrorState then]]>
</Line>
<Line Number="36">
<![CDATA[		errorState := state;]]>
</Line>
<Line Number="37">
<![CDATA[		state := opErrorState;]]>
</Line>
<Line Number="38">
<![CDATA[	end_if;]]>
</Line>
<Line Number="39">
<![CDATA[end_if;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[case state of]]>
</Line>
<Line Number="42">
<![CDATA[	0:]]>
</Line>
<Line Number="43">
<![CDATA[		]]>
</Line>
<Line Number="44">
<![CDATA[		bladeRetractSpeed 	:= 18.0;]]>
</Line>
<Line Number="45">
<![CDATA[		inchTorque 			:= 110.0;]]>
</Line>
<Line Number="46">
<![CDATA[		]]>
</Line>
<Line Number="47">
<![CDATA[		// units are rev/s]]>
</Line>
<Line Number="48">
<![CDATA[		sAxis.jog := 0;]]>
</Line>
<Line Number="49">
<![CDATA[		sAxis.speed := 4.0;]]>
</Line>
<Line Number="50">
<![CDATA[		sAxis.accel := 3.0;]]>
</Line>
<Line Number="51">
<![CDATA[		sAxis.decel := 5.0;]]>
</Line>
<Line Number="52">
<![CDATA[		sAxis.jerkPercentage := 50.0;]]>
</Line>
<Line Number="53">
<![CDATA[		]]>
</Line>
<Line Number="54">
<![CDATA[		axis.speed := 3.0;]]>
</Line>
<Line Number="55">
<![CDATA[		axis.accel := 100.0;]]>
</Line>
<Line Number="56">
<![CDATA[		axis.decel := \Axes.bladeF.accel;]]>
</Line>
<Line Number="57">
<![CDATA[		axis.jerkPercentage := 50.0;]]>
</Line>
<Line Number="58">
<![CDATA[		 ]]>
</Line>
<Line Number="59">
<![CDATA[		opErrorState := 5000; ]]>
</Line>
<Line Number="60">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="61">
<![CDATA[		]]>
</Line>
<Line Number="62">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="63">
<![CDATA[		]]>
</Line>
<Line Number="64">
<![CDATA[	10:]]>
</Line>
<Line Number="65">
<![CDATA[		message := 'wait for cutter spindle axis';]]>
</Line>
<Line Number="66">
<![CDATA[		state := 20;]]>
</Line>
<Line Number="67">
<![CDATA[	20:]]>
</Line>
<Line Number="68">
<![CDATA[		if sAxis.ready then]]>
</Line>
<Line Number="69">
<![CDATA[			state := 21;]]>
</Line>
<Line Number="70">
<![CDATA[		end_if;]]>
</Line>
<Line Number="71">
<![CDATA[	21:]]>
</Line>
<Line Number="72">
<![CDATA[		message := 'wait for blade feed axis';]]>
</Line>
<Line Number="73">
<![CDATA[		state := 30;]]>
</Line>
<Line Number="74">
<![CDATA[	30:]]>
</Line>
<Line Number="75">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="76">
<![CDATA[			state := 50;]]>
</Line>
<Line Number="77">
<![CDATA[		end_if;]]>
</Line>
<Line Number="78">
<![CDATA[	50:]]>
</Line>
<Line Number="79">
<![CDATA[		//]]>
</Line>
<Line Number="80">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="81">
<![CDATA[		]]>
</Line>
<Line Number="82">
<![CDATA[	100:]]>
</Line>
<Line Number="83">
<![CDATA[	]]>
</Line>
<Line Number="84">
<![CDATA[		currentCmd := 0;]]>
</Line>
<Line Number="85">
<![CDATA[		cmd := -1;]]>
</Line>
<Line Number="86">
<![CDATA[		message := 'stopped';]]>
</Line>
<Line Number="87">
<![CDATA[		timer.Reset := 1;]]>
</Line>
<Line Number="88">
<![CDATA[		]]>
</Line>
<Line Number="89">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="90">
<![CDATA[		]]>
</Line>
<Line Number="91">
<![CDATA[		state := 110;]]>
</Line>
<Line Number="92">
<![CDATA[	110:]]>
</Line>
<Line Number="93">
<![CDATA[		(*]]>
</Line>
<Line Number="94">
<![CDATA[		    cmd_string = {]]>
</Line>
<Line Number="95">
<![CDATA[				 0: "stop",]]>
</Line>
<Line Number="96">
<![CDATA[				 10: "Toggle collet",]]>
</Line>
<Line Number="97">
<![CDATA[				 11: "Unclamp collet",]]>
</Line>
<Line Number="98">
<![CDATA[				 12: "Clamp collet",]]>
</Line>
<Line Number="99">
<![CDATA[				 20: "Start rotation",]]>
</Line>
<Line Number="100">
<![CDATA[				 21: "Stop rotation",]]>
</Line>
<Line Number="101">
<![CDATA[				 30: "Inch in",]]>
</Line>
<Line Number="102">
<![CDATA[				 31: "Inch out",]]>
</Line>
<Line Number="103">
<![CDATA[				 40: "Touch on",]]>
</Line>
<Line Number="104">
<![CDATA[				 50: "Blade feed for cutting",]]>
</Line>
<Line Number="105">
<![CDATA[				 51: "Blade to near cut position",]]>
</Line>
<Line Number="106">
<![CDATA[				 52: "Retract blade",]]>
</Line>
<Line Number="107">
<![CDATA[				 53: "Retract blade and Unclamp collet"]]>
</Line>
<Line Number="108">
<![CDATA[				 80: "Home axis blade feed"]]>
</Line>
<Line Number="109">
<![CDATA[		    }]]>
</Line>
<Line Number="110">
<![CDATA[		]]>
</Line>
<Line Number="111">
<![CDATA[		*)]]>
</Line>
<Line Number="112">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="113">
<![CDATA[			0:	;]]>
</Line>
<Line Number="114">
<![CDATA[			]]>
</Line>
<Line Number="115">
<![CDATA[			10..12:]]>
</Line>
<Line Number="116">
<![CDATA[				state := 150;]]>
</Line>
<Line Number="117">
<![CDATA[			20:	]]>
</Line>
<Line Number="118">
<![CDATA[				sAxis.speed := 4.0;]]>
</Line>
<Line Number="119">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="120">
<![CDATA[			21:]]>
</Line>
<Line Number="121">
<![CDATA[				state := 220;]]>
</Line>
<Line Number="122">
<![CDATA[				(*]]>
</Line>
<Line Number="123">
<![CDATA[				if sAxis.jog then]]>
</Line>
<Line Number="124">
<![CDATA[					sAxis.jog := 0;]]>
</Line>
<Line Number="125">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="126">
<![CDATA[				end_if;]]>
</Line>
<Line Number="127">
<![CDATA[				*)]]>
</Line>
<Line Number="128">
<![CDATA[			30, 31:]]>
</Line>
<Line Number="129">
<![CDATA[				state := 300;				]]>
</Line>
<Line Number="130">
<![CDATA[			40:]]>
</Line>
<Line Number="131">
<![CDATA[				positionBladeTouch := axis.currentPosition;]]>
</Line>
<Line Number="132">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="133">
<![CDATA[			50:]]>
</Line>
<Line Number="134">
<![CDATA[				state := 400;]]>
</Line>
<Line Number="135">
<![CDATA[			51:]]>
</Line>
<Line Number="136">
<![CDATA[				state := 420;]]>
</Line>
<Line Number="137">
<![CDATA[			52:]]>
</Line>
<Line Number="138">
<![CDATA[				state := 450;]]>
</Line>
<Line Number="139">
<![CDATA[			53:]]>
</Line>
<Line Number="140">
<![CDATA[				state := 440;]]>
</Line>
<Line Number="141">
<![CDATA[			80:]]>
</Line>
<Line Number="142">
<![CDATA[				state := 1000;				]]>
</Line>
<Line Number="143">
<![CDATA[		end_case;]]>
</Line>
<Line Number="144">
<![CDATA[		]]>
</Line>
<Line Number="145">
<![CDATA[		]]>
</Line>
<Line Number="146">
<![CDATA[		// state changed ]]>
</Line>
<Line Number="147">
<![CDATA[		if stateLast <> state then]]>
</Line>
<Line Number="148">
<![CDATA[			// as neat as it could be]]>
</Line>
<Line Number="149">
<![CDATA[			\Event.logLevel := \Event.EVENT_DEBUG_CMD;]]>
</Line>
<Line Number="150">
<![CDATA[			JSR(CutterEvent);]]>
</Line>
<Line Number="151">
<![CDATA[			]]>
</Line>
<Line Number="152">
<![CDATA[			currentCmd := cmd;]]>
</Line>
<Line Number="153">
<![CDATA[		end_if;]]>
</Line>
<Line Number="154">
<![CDATA[		]]>
</Line>
<Line Number="155">
<![CDATA[	150:]]>
</Line>
<Line Number="156">
<![CDATA[		case currentCmd of]]>
</Line>
<Line Number="157">
<![CDATA[			10:]]>
</Line>
<Line Number="158">
<![CDATA[				if isColletClamped then]]>
</Line>
<Line Number="159">
<![CDATA[					colletUnClamp := 1;]]>
</Line>
<Line Number="160">
<![CDATA[					currentCmd := 11;]]>
</Line>
<Line Number="161">
<![CDATA[				elsif isColletUnClamped then]]>
</Line>
<Line Number="162">
<![CDATA[					colletClamp := 1;]]>
</Line>
<Line Number="163">
<![CDATA[					currentCmd := 12;]]>
</Line>
<Line Number="164">
<![CDATA[				else]]>
</Line>
<Line Number="165">
<![CDATA[					colletUnClamp := 1;]]>
</Line>
<Line Number="166">
<![CDATA[					currentCmd := 11;]]>
</Line>
<Line Number="167">
<![CDATA[				end_if;]]>
</Line>
<Line Number="168">
<![CDATA[			11:]]>
</Line>
<Line Number="169">
<![CDATA[				if isColletUnClamped then]]>
</Line>
<Line Number="170">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="171">
<![CDATA[				else]]>
</Line>
<Line Number="172">
<![CDATA[					colletUnClamp := 1;]]>
</Line>
<Line Number="173">
<![CDATA[				end_if;]]>
</Line>
<Line Number="174">
<![CDATA[			12:]]>
</Line>
<Line Number="175">
<![CDATA[				if isColletClamped then]]>
</Line>
<Line Number="176">
<![CDATA[					state := 100;]]>
</Line>
<Line Number="177">
<![CDATA[				else]]>
</Line>
<Line Number="178">
<![CDATA[					colletClamp := 1;]]>
</Line>
<Line Number="179">
<![CDATA[				end_if;]]>
</Line>
<Line Number="180">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="181">
<![CDATA[		]]>
</Line>
<Line Number="182">
<![CDATA[	200:]]>
</Line>
<Line Number="183">
<![CDATA[		if isCutHeadRunning then ]]>
</Line>
<Line Number="184">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="185">
<![CDATA[		elsif sAxis.ready then]]>
</Line>
<Line Number="186">
<![CDATA[			sAxis.jog := 1;]]>
</Line>
<Line Number="187">
<![CDATA[			TimerStart(tS, timer, 500);]]>
</Line>
<Line Number="188">
<![CDATA[			state := 210;]]>
</Line>
<Line Number="189">
<![CDATA[		else]]>
</Line>
<Line Number="190">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="191">
<![CDATA[			state := opErrorState;]]>
</Line>
<Line Number="192">
<![CDATA[		end_if;]]>
</Line>
<Line Number="193">
<![CDATA[		]]>
</Line>
<Line Number="194">
<![CDATA[	210:]]>
</Line>
<Line Number="195">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="196">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="197">
<![CDATA[		end_if;]]>
</Line>
<Line Number="198">
<![CDATA[		]]>
</Line>
<Line Number="199">
<![CDATA[	220:]]>
</Line>
<Line Number="200">
<![CDATA[		sAxis.speed := 0.0;]]>
</Line>
<Line Number="201">
<![CDATA[		]]>
</Line>
<Line Number="202">
<![CDATA[		if ABS(S.ActualVelocity - sAxis.speed) < 0.1 then]]>
</Line>
<Line Number="203">
<![CDATA[			if sAxis.jog then]]>
</Line>
<Line Number="204">
<![CDATA[				sAxis.jog := 0;]]>
</Line>
<Line Number="205">
<![CDATA[				state := 230;]]>
</Line>
<Line Number="206">
<![CDATA[			else]]>
</Line>
<Line Number="207">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="208">
<![CDATA[			end_if;]]>
</Line>
<Line Number="209">
<![CDATA[		end_if;]]>
</Line>
<Line Number="210">
<![CDATA[		]]>
</Line>
<Line Number="211">
<![CDATA[	230:]]>
</Line>
<Line Number="212">
<![CDATA[		if sAxis.state = 200 then	// check for stop done]]>
</Line>
<Line Number="213">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="214">
<![CDATA[		end_if;]]>
</Line>
<Line Number="215">
<![CDATA[		]]>
</Line>
<Line Number="216">
<![CDATA[#region inch in/out and blade set	]]>
</Line>
<Line Number="217">
<![CDATA[	]]>
</Line>
<Line Number="218">
<![CDATA[	/// inch in/out]]>
</Line>
<Line Number="219">
<![CDATA[	300:]]>
</Line>
<Line Number="220">
<![CDATA[		axis.disable := 0;]]>
</Line>
<Line Number="221">
<![CDATA[		]]>
</Line>
<Line Number="222">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="223">
<![CDATA[			state := 310;]]>
</Line>
<Line Number="224">
<![CDATA[		else]]>
</Line>
<Line Number="225">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="226">
<![CDATA[			//state := opErrorState;]]>
</Line>
<Line Number="227">
<![CDATA[		end_if;]]>
</Line>
<Line Number="228">
<![CDATA[	310:]]>
</Line>
<Line Number="229">
<![CDATA[		]]>
</Line>
<Line Number="230">
<![CDATA[		case currentCmd of]]>
</Line>
<Line Number="231">
<![CDATA[			30:]]>
</Line>
<Line Number="232">
<![CDATA[				message := 'inch blade in ';]]>
</Line>
<Line Number="233">
<![CDATA[				RTOS(inchTorque, stringAdd);				]]>
</Line>
<Line Number="234">
<![CDATA[				CONCAT(message, stringAdd, message);]]>
</Line>
<Line Number="235">
<![CDATA[				stringAdd := '%';]]>
</Line>
<Line Number="236">
<![CDATA[				CONCAT(message, stringAdd, message);]]>
</Line>
<Line Number="237">
<![CDATA[				axis.position := axis.currentPosition + positionInchOffset;]]>
</Line>
<Line Number="238">
<![CDATA[				;]]>
</Line>
<Line Number="239">
<![CDATA[			31:]]>
</Line>
<Line Number="240">
<![CDATA[				axis.position := axis.currentPosition - positionInchOffset;]]>
</Line>
<Line Number="241">
<![CDATA[				message := 'inch blade out';]]>
</Line>
<Line Number="242">
<![CDATA[				]]>
</Line>
<Line Number="243">
<![CDATA[				if axis.position < 0.25 then]]>
</Line>
<Line Number="244">
<![CDATA[					message := 'inch blade out - near max';]]>
</Line>
<Line Number="245">
<![CDATA[					axis.position := 0.25;]]>
</Line>
<Line Number="246">
<![CDATA[				end_if;]]>
</Line>
<Line Number="247">
<![CDATA[				]]>
</Line>
<Line Number="248">
<![CDATA[				;]]>
</Line>
<Line Number="249">
<![CDATA[		end_case;]]>
</Line>
<Line Number="250">
<![CDATA[		axis.move := 1;]]>
</Line>
<Line Number="251">
<![CDATA[		axis.setTorque := inchTorque;]]>
</Line>
<Line Number="252">
<![CDATA[		state := 320;]]>
</Line>
<Line Number="253">
<![CDATA[		]]>
</Line>
<Line Number="254">
<![CDATA[	320:]]>
</Line>
<Line Number="255">
<![CDATA[		// access CIP direct]]>
</Line>
<Line Number="256">
<![CDATA[		if BladeFeed.TorqueLimitStatus then]]>
</Line>
<Line Number="257">
