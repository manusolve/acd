<Routines>
<Routine Name="Flash" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[case flashState of]]>
</Line>
<Line Number="3">
<![CDATA[	0:]]>
</Line>
<Line Number="4">
<![CDATA[		timeFlash := timeStamp[0];]]>
</Line>
<Line Number="5">
<![CDATA[		flashState := 10;]]>
</Line>
<Line Number="6">
<![CDATA[	10:]]>
</Line>
<Line Number="7">
<![CDATA[		if ((timeStamp[0] - timeFlash) * 0.001) > 500 then]]>
</Line>
<Line Number="8">
<![CDATA[			flashState := 20;]]>
</Line>
<Line Number="9">
<![CDATA[		end_if;]]>
</Line>
<Line Number="10">
<![CDATA[	20:]]>
</Line>
<Line Number="11">
<![CDATA[		]]>
</Line>
<Line Number="12">
<![CDATA[		flashOut := not flashOut;]]>
</Line>
<Line Number="13">
<![CDATA[		flashState := 0;]]>
</Line>
<Line Number="14">
<![CDATA[		]]>
</Line>
<Line Number="15">
<![CDATA[end_Case;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// standard I/O for the door controls]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//]]>
</Line>
<Line Number="3">
<![CDATA[// controller scope tags that are mapped to the safety process.]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[// door on main panel]]>
</Line>
<Line Number="6">
<![CDATA[doorStatIn[0] 		:= REM1:6:I.0;]]>
</Line>
<Line Number="7">
<![CDATA[doorStatIn[1] 		:= REM1:6:I.1;]]>
</Line>
<Line Number="8">
<![CDATA[exitResetButton[0] 	:= REM1:6:I.2;]]>
</Line>
<Line Number="9">
<![CDATA[exitResetButton[1] 	:= REM1:6:I.3;]]>
</Line>
<Line Number="10">
<![CDATA[unlockButton[0] 	:= REM1:6:I.4 or intUnlockButton[0];]]>
</Line>
<Line Number="11">
<![CDATA[unlockButton[1] 	:= REM1:6:I.5 or intUnlockButton[1];]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[// doors on second panel]]>
</Line>
<Line Number="14">
<![CDATA[doorStatIn[2] 		:= REM2:3:I.0;]]>
</Line>
<Line Number="15">
<![CDATA[doorStatIn[3] 		:= REM2:3:I.1;]]>
</Line>
<Line Number="16">
<![CDATA[exitResetButton[2] 	:= REM2:3:I.2;]]>
</Line>
<Line Number="17">
<![CDATA[exitResetButton[3] 	:= REM2:3:I.3;]]>
</Line>
<Line Number="18">
<![CDATA[unlockButton[2] 	:= REM2:3:I.4 or intUnlockButton[2];]]>
</Line>
<Line Number="19">
<![CDATA[unlockButton[3] 	:= REM2:3:I.5 or intUnlockButton[3];]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[//outputs for unlock illumination and resetled]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[JSR(Flash);		// generate a pulse ]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[for doorIndex := 0 to 3 do]]>
</Line>
<Line Number="26">
<![CDATA[	resetLed[doorIndex] := \Safety.DOORS[doorIndex].needReset and flashOut;]]>
</Line>
<Line Number="27">
<![CDATA[end_for;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[REM1:12:O.0 := unlockDoor[0]; 							// door unlock]]>
</Line>
<Line Number="30">
<![CDATA[REM1:12:O.1 := unlockDoor[1]; 							// door unlock]]>
</Line>
<Line Number="31">
<![CDATA[REM1:12:O.2 := resetLed[0]; 							// exit reset led]]>
</Line>
<Line Number="32">
<![CDATA[REM1:12:O.3 := resetLed[1]; 							// exit reset led]]>
</Line>
<Line Number="33">
<![CDATA[REM1:12:O.4 := unlockPossible; 							// unlock possible]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[REM2:4:O.0 := unlockDoor[2]; 							// door unlock]]>
</Line>
<Line Number="36">
<![CDATA[REM2:4:O.1 := unlockDoor[3]; 							// door unlock]]>
</Line>
<Line Number="37">
<![CDATA[REM2:4:O.2 := resetLed[2]; 								// exit reset led]]>
</Line>
<Line Number="38">
<![CDATA[REM2:4:O.3 := resetLed[3]; 								// exit reset led]]>
</Line>
<Line Number="39">
<![CDATA[REM2:4:O.4 := unlockPossible; 							// unlock possible]]>
</Line>
<Line Number="40">
<![CDATA[REM2:4:O.5 := loadDoorUnlockPossible; 					// unlock possible]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[// status output]]>
</Line>
<Line Number="43">
<![CDATA[REM2:4:O.6 := \Safety.ENABLE_ALL;]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[// check the unlock door requests]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[// check machine mode]]>
</Line>
<Line Number="48">
<![CDATA[// if button is pressed then unlock the door for a period]]>
</Line>
<Line Number="49">
<![CDATA[// if the door is open then keep keep the unlock signal]]>
</Line>
<Line Number="50">
<![CDATA[// if the timer is done and the door is closed the lock]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[// udpate timer and edge for door signals]]>
</Line>
<Line Number="53">
<![CDATA[for doorIndex := 0 to 3 do	]]>
</Line>
<Line Number="54">
<![CDATA[	TONR(doorTimer[doorIndex]);]]>
</Line>
<Line Number="55">
<![CDATA[	unlockButtonEdge[doorIndex].InputBit := unlockButton[doorIndex];		]]>
</Line>
<Line Number="56">
<![CDATA[	OSFI(unlockButtonEdge[doorIndex]);]]>
</Line>
<Line Number="57">
<![CDATA[end_for;]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[//unlockPossible 	:= (not \Safety.ENABLE_ALL) or (\MachineMain.modeCurrent = 1 and not \ModeMan.active);]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[case \MachineMain.modeCurrent of]]>
</Line>
<Line Number="65">
<![CDATA[	0,2:]]>
</Line>
<Line Number="66">
<![CDATA[		if \ModeAuto.active or \ModeAutoInput.active then]]>
</Line>
<Line Number="67">
<![CDATA[			unlockPossible 	:= 0;]]>
</Line>
<Line Number="68">
<![CDATA[		else]]>
</Line>
<Line Number="69">
<![CDATA[			unlockPossible 	:= 1;]]>
</Line>
<Line Number="70">
<![CDATA[		end_if;]]>
</Line>
<Line Number="71">
<![CDATA[	1:]]>
</Line>
<Line Number="72">
<![CDATA[		unlockPossible 	:= not \ModeMan.active;]]>
</Line>
<Line Number="73">
<![CDATA[end_case;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="76">
<![CDATA[	unlockPossible := 1;]]>
</Line>
<Line Number="77">
<![CDATA[end_if;]]>
</Line>
<Line Number="78">
<![CDATA[]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[autoOrProg 		:= (\MachineMain.modeCurrent = 0 or \MachineMain.modeCurrent = 2);]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
<Line Number="82">
<![CDATA[if unlockPossible then 			]]>
</Line>
<Line Number="83">
<![CDATA[	/// Doors can be unlocked -- ES or MAN mode active]]>
</Line>
<Line Number="84">
<![CDATA[		]]>
</Line>
<Line Number="85">
<![CDATA[	loadDoorUnlockPossible := 1;]]>
</Line>
<Line Number="86">
<![CDATA[	//	unlockButton]]>
</Line>
<Line Number="87">
<![CDATA[	for doorIndex := 0 to 3 do]]>
</Line>
<Line Number="88">
<![CDATA[		JSR(processDoorUnlock);]]>
</Line>
<Line Number="89">
<![CDATA[	end_for;]]>
</Line>
<Line Number="90">
<![CDATA[	]]>
</Line>
<Line Number="91">
<![CDATA[elsif autoOrProg then]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[	// case where light curtain or hopper is closed]]>
</Line>
<Line Number="94">
<![CDATA[	]]>
</Line>
<Line Number="95">
<![CDATA[	doorIndex := 3;]]>
</Line>
<Line Number="96">
<![CDATA[	]]>
</Line>
<Line Number="97">
<![CDATA[	// in the case of the auto program the door can be unlocked ]]>
</Line>
<Line Number="98">
<![CDATA[	// if the light curtain is OK]]>
</Line>
<Line Number="99">
<![CDATA[	(*]]>
</Line>
<Line Number="100">
<![CDATA[	if \Safety.LC.O1 then// or \Safety.DOORS[doorIndex].EnableOut then		]]>
</Line>
<Line Number="101">
<![CDATA[		JSR(processDoorUnlock);]]>
</Line>
<Line Number="102">
<![CDATA[		loadDoorUnlockPossible := 1;]]>
</Line>
<Line Number="103">
<![CDATA[	else]]>
</Line>
<Line Number="104">
<![CDATA[		loadDoorUnlockPossible := 0;]]>
</Line>
<Line Number="105">
<![CDATA[	end_if;]]>
</Line>
<Line Number="106">
<![CDATA[	*)]]>
</Line>
<Line Number="107">
<![CDATA[	// set the load door unlock all the time]]>
</Line>
<Line Number="108">
<![CDATA[	if \Loading.state < 200 then]]>
</Line>
<Line Number="109">
<![CDATA[		loadDoorUnlockPossible := 1;]]>
</Line>
<Line Number="110">
<![CDATA[		JSR(processDoorUnlock);]]>
</Line>
<Line Number="111">
<![CDATA[	else]]>
</Line>
<Line Number="112">
<![CDATA[		loadDoorUnlockPossible := 0;]]>
</Line>
<Line Number="113">
<![CDATA[	end_if;]]>
</Line>
<Line Number="114">
<![CDATA[	]]>
</Line>
<Line Number="115">
<![CDATA[	]]>
</Line>
<Line Number="116">
<![CDATA[else]]>
</Line>
<Line Number="117">
<![CDATA[	/// door controls are not accessible]]>
</Line>
<Line Number="118">
<![CDATA[		]]>
</Line>
<Line Number="119">
<![CDATA[	for doorIndex := 0 to 3 do]]>
</Line>
<Line Number="120">
<![CDATA[		unlockDoor[doorIndex] := 0;]]>
</Line>
<Line Number="121">
<![CDATA[		doorTimer[doorIndex].Reset := 1;]]>
</Line>
<Line Number="122">
<![CDATA[	end_for;]]>
</Line>
<Line Number="123">
<![CDATA[	loadDoorUnlockPossible := 0;]]>
</Line>
<Line Number="124">
<![CDATA[	]]>
</Line>
<Line Number="125">
<![CDATA[end_if;]]>
</Line>
<Line Number="126">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="processDoorUnlock" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[if unlockButtonEdge[doorIndex].OutputBit then]]>
</Line>
<Line Number="1">
<![CDATA[	unLockCount[doorIndex] := unLockCount[doorIndex] + 1;]]>
</Line>
<Line Number="2">
<![CDATA[	unlockDoor[doorIndex] := 1;]]>
</Line>
<Line Number="3">
<![CDATA[	TimerStart(tS, doorTimer[doorIndex], 10000);]]>
</Line>
<Line Number="4">
<![CDATA[	TONR(doorTimer[doorIndex]);]]>
</Line>
<Line Number="5">
<![CDATA[end_if;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// the door is open; lock is not needed]]>
</Line>
<Line Number="9">
<![CDATA[if not doorStatIn[doorIndex] then]]>
</Line>
<Line Number="10">
<![CDATA[	unlockDoor[doorIndex] := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[// time is out and the door is closed]]>
</Line>
<Line Number="14">
<![CDATA[if doorTimer[doorIndex].DN ]]>
</Line>
<Line Number="15">
<![CDATA[//and doorStatIn[doorIndex]]]>
</Line>
<Line Number="16">
<![CDATA[then]]>
</Line>
<Line Number="17">
<![CDATA[	unlockDoor[doorIndex] := 0;]]>
</Line>
<Line Number="18">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="Event" TestEdits="false" MainRoutineName="Main" Disabled="false" Class="Standard" UseAsFolder="false">
