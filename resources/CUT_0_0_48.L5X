<Data Format="L5K">
<![CDATA[[16,'Not rotated to Bopene$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		]]]>
</Data>
<Data Format="String" Length="16">
<![CDATA['Not rotated to B']]>
</Data>
</Tag>
