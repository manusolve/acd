<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="2">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="3">
<![CDATA[end_if;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[if toOutput and toInput then]]>
</Line>
<Line Number="6">
<![CDATA[	toOutput := 0;]]>
</Line>
<Line Number="7">
<![CDATA[end_if;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[timeCurr := (timeStamp[0] - timeStart) * 0.001;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[if \MachineMain.modeCurrent = 1 and state > 50 then]]>
</Line>
<Line Number="12">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="13">
<![CDATA[end_if;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[frontOffal := \CutInFeed.isFrontOffal;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[case state of ]]>
</Line>
<Line Number="18">
<![CDATA[	0:]]>
</Line>
<Line Number="19">
<![CDATA[		// init ]]>
</Line>
<Line Number="20">
<![CDATA[		toOutput := 0;]]>
</Line>
<Line Number="21">
<![CDATA[		toInput := 0;]]>
</Line>
<Line Number="22">
<![CDATA[		]]>
</Line>
<Line Number="23">
<![CDATA[		//state := 100;]]>
</Line>
<Line Number="24">
<![CDATA[		state := 50;]]>
</Line>
<Line Number="25">
<![CDATA[		]]>
</Line>
<Line Number="26">
<![CDATA[	50:]]>
</Line>
<Line Number="27">
<![CDATA[		// manual controls]]>
</Line>
<Line Number="28">
<![CDATA[		]]>
</Line>
<Line Number="29">
<![CDATA[		case \MachineMain.modeCurrent of]]>
</Line>
<Line Number="30">
<![CDATA[			0, 2:]]>
</Line>
<Line Number="31">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="32">
<![CDATA[			else]]>
</Line>
<Line Number="33">
<![CDATA[				;]]>
</Line>
<Line Number="34">
<![CDATA[		end_case;]]>
</Line>
<Line Number="35">
<![CDATA[	]]>
</Line>
<Line Number="36">
<![CDATA[	100:]]>
</Line>
<Line Number="37">
<![CDATA[		]]>
</Line>
<Line Number="38">
<![CDATA[		if \CutInFeed.isFrontOffal then]]>
</Line>
<Line Number="39">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="40">
<![CDATA[		else]]>
</Line>
<Line Number="41">
<![CDATA[			if \Cutter.isCutHeadRunning then]]>
</Line>
<Line Number="42">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="43">
<![CDATA[			end_if;]]>
</Line>
<Line Number="44">
<![CDATA[		end_if;]]>
</Line>
<Line Number="45">
<![CDATA[		]]>
</Line>
<Line Number="46">
<![CDATA[		// cutting cmd]]>
</Line>
<Line Number="47">
<![CDATA[		if \Cutter.currentCmd = 50 then]]>
</Line>
<Line Number="48">
<![CDATA[			// should be to input]]>
</Line>
<Line Number="49">
<![CDATA[			]]>
</Line>
<Line Number="50">
<![CDATA[			// once the cutterCmd transistions back to]]>
</Line>
<Line Number="51">
<![CDATA[			// 0 then the cut is done.]]>
</Line>
<Line Number="52">
<![CDATA[			// there should be a time delay then]]>
</Line>
<Line Number="53">
<![CDATA[			// shift to output]]>
</Line>
<Line Number="54">
<![CDATA[			]]>
</Line>
<Line Number="55">
<![CDATA[			//state := 200;]]>
</Line>
<Line Number="56">
<![CDATA[			;]]>
</Line>
<Line Number="57">
<![CDATA[		end_if;]]>
</Line>
<Line Number="58">
<![CDATA[	]]>
</Line>
<Line Number="59">
<![CDATA[	// default state is toInput	]]>
</Line>
<Line Number="60">
<![CDATA[	200:]]>
</Line>
<Line Number="61">
<![CDATA[		if not isInput then]]>
</Line>
<Line Number="62">
<![CDATA[			toInput := 1;]]>
</Line>
<Line Number="63">
<![CDATA[			toOutput := 0;]]>
</Line>
<Line Number="64">
<![CDATA[		else]]>
</Line>
<Line Number="65">
<![CDATA[			toInput := 0;]]>
</Line>
<Line Number="66">
<![CDATA[			toOutput := 0;]]>
</Line>
<Line Number="67">
<![CDATA[			//state := 100;]]>
</Line>
<Line Number="68">
<![CDATA[		end_if;]]>
</Line>
<Line Number="69">
<![CDATA[		]]>
</Line>
<Line Number="70">
<![CDATA[		if \CutInFeed.cutPlan.frontOffalLength > 0 then]]>
</Line>
<Line Number="71">
<![CDATA[			// front offal is cleared]]>
</Line>
<Line Number="72">
<![CDATA[			if not frontOffal and lastFrontOffal then]]>
</Line>
<Line Number="73">
<![CDATA[				// start clear cycle]]>
</Line>
<Line Number="74">
<![CDATA[				state := 300;]]>
</Line>
<Line Number="75">
<![CDATA[			end_if;]]>
</Line>
<Line Number="76">
<![CDATA[		end_if;]]>
</Line>
<Line Number="77">
<![CDATA[		]]>
</Line>
<Line Number="78">
<![CDATA[	// this starts a cycle of the clearing motion]]>
</Line>
<Line Number="79">
<![CDATA[	300:]]>
</Line>
<Line Number="80">
<![CDATA[		bumpCount := 0;]]>
</Line>
<Line Number="81">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="82">
<![CDATA[	310:]]>
</Line>
<Line Number="83">
<![CDATA[		timeStart := timeStamp[0];]]>
</Line>
<Line Number="84">
<![CDATA[		state := 320;]]>
</Line>
<Line Number="85">
<![CDATA[	]]>
</Line>
<Line Number="86">
<![CDATA[	320:]]>
</Line>
<Line Number="87">
<![CDATA[		if not isOutput then]]>
</Line>
<Line Number="88">
<![CDATA[			toOutput := 1;]]>
</Line>
<Line Number="89">
<![CDATA[			toInput := 0;]]>
</Line>
<Line Number="90">
<![CDATA[		else]]>
</Line>
<Line Number="91">
<![CDATA[			toOutput := 0;]]>
</Line>
<Line Number="92">
<![CDATA[			toInput := 1;]]>
</Line>
<Line Number="93">
<![CDATA[		end_if;]]>
</Line>
<Line Number="94">
<![CDATA[		]]>
</Line>
<Line Number="95">
<![CDATA[		state := 340;]]>
</Line>
<Line Number="96">
<![CDATA[	]]>
</Line>
<Line Number="97">
<![CDATA[	340:]]>
</Line>
<Line Number="98">
<![CDATA[		// TODO: Here we need to check if the cylinder has arrived or not]]>
</Line>
<Line Number="99">
<![CDATA[		if timeCurr > 500 then // for example]]>
</Line>
<Line Number="100">
<![CDATA[			// it should have moved from current input]]>
</Line>
<Line Number="101">
<![CDATA[			;]]>
</Line>
<Line Number="102">
<![CDATA[		end_if; ]]>
</Line>
<Line Number="103">
<![CDATA[		// the more important case]]>
</Line>
<Line Number="104">
<![CDATA[		if timeCurr > 1000 then // for example]]>
</Line>
<Line Number="105">
<![CDATA[			// it should have arrived]]>
</Line>
<Line Number="106">
<![CDATA[			;]]>
</Line>
<Line Number="107">
<![CDATA[		end_if;]]>
</Line>
<Line Number="108">
<![CDATA[		]]>
</Line>
<Line Number="109">
<![CDATA[		// Then if there is an error]]>
</Line>
<Line Number="110">
<![CDATA[		if 0 then]]>
</Line>
<Line Number="111">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="112">
<![CDATA[		end_if;]]>
</Line>
<Line Number="113">
<![CDATA[			]]>
</Line>
<Line Number="114">
<![CDATA[		if timeCurr > 5000 then]]>
</Line>
<Line Number="115">
<![CDATA[			// see if we need to count]]>
</Line>
<Line Number="116">
<![CDATA[			bumpCount := bumpCount + 1;]]>
</Line>
<Line Number="117">
<![CDATA[			if bumpCount > 3 then]]>
</Line>
<Line Number="118">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="119">
<![CDATA[			else]]>
</Line>
<Line Number="120">
<![CDATA[				state := 310;]]>
</Line>
<Line Number="121">
<![CDATA[			end_if;]]>
</Line>
<Line Number="122">
<![CDATA[		end_if;]]>
</Line>
<Line Number="123">
<![CDATA[		]]>
</Line>
<Line Number="124">
<![CDATA[		(*]]>
</Line>
<Line Number="125">
<![CDATA[		if \CutInFeed.isFrontOffal then]]>
</Line>
<Line Number="126">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="127">
<![CDATA[		end_if;]]>
</Line>
<Line Number="128">
<![CDATA[		*)]]>
</Line>
<Line Number="129">
<![CDATA[	]]>
</Line>
<Line Number="130">
<![CDATA[	2000:]]>
</Line>
<Line Number="131">
<![CDATA[		// test]]>
</Line>
<Line Number="132">
<![CDATA[		;]]>
</Line>
<Line Number="133">
<![CDATA[end_case;]]>
</Line>
<Line Number="134">
<![CDATA[]]>
</Line>
<Line Number="135">
<![CDATA[lastFrontOffal := \CutInFeed.isFrontOffal;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
