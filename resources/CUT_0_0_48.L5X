<Line Number="58">
<![CDATA[		if hProgram.isLift then]]>
</Line>
<Line Number="59">
<![CDATA[			hSequence.ops[index].type := 25;]]>
</Line>
<Line Number="60">
<![CDATA[			index := index + 1;]]>
</Line>
<Line Number="61">
<![CDATA[		end_if;]]>
</Line>
<Line Number="62">
<![CDATA[		]]>
</Line>
<Line Number="63">
<![CDATA[		]]>
</Line>
<Line Number="64">
<![CDATA[		/// ++]]>
</Line>
<Line Number="65">
<![CDATA[		// this is the retract from forming and will only be needed]]>
</Line>
<Line Number="66">
<![CDATA[		// if there is another cycle in the sequence]]>
</Line>
<Line Number="67">
<![CDATA[		// next head is needed]]>
</Line>
<Line Number="68">
<![CDATA[		if counter = 0 and headsTemp[1] then]]>
</Line>
<Line Number="69">
<![CDATA[			pos := machine.positions[counter].z;]]>
</Line>
<Line Number="70">
<![CDATA[			pos := pos + outputPartLength + 50.0; ]]>
</Line>
<Line Number="71">
<![CDATA[			]]>
</Line>
<Line Number="72">
<![CDATA[			hSequence.ops[index].type := 19;			// retract from forming		]]>
