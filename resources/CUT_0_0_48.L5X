</Line>
<Line Number="75">
<![CDATA[		end_if;]]>
</Line>
<Line Number="76">
<![CDATA[	end_if;]]>
</Line>
<Line Number="77">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="GenPreCheck" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/// index should be set]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[/// precheck for cycle -- depends on head params]]>
</Line>
<Line Number="3">
<![CDATA[hSequence.ops[index].type := 5;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[JSR(GetInitPos);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[index := index + 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="GenRetractFromInput" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// all program moves for the heads are done now move to the output ]]>
</Line>
<Line Number="2">
<![CDATA[// handoff position]]>
</Line>
<Line Number="3">
<![CDATA[hSequence.ops[index].type := 15;				// z move back]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[pos := positionRetract;]]>
</Line>
<Line Number="6">
<![CDATA[pos := pos + hProgram.hoOutputOffset;			// nominally 0 but will vary accroding to material consumption]]>
</Line>
<Line Number="7">
<![CDATA[												// of length in production and asymmetric rotation setup]]>
</Line>
<Line Number="8">
<![CDATA[hSequence.ops[index].zPos := pos;]]>
</Line>
<Line Number="9">
<![CDATA[index := index + 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="GetInitPos" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[case machine.type of]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[	0:]]>
</Line>
<Line Number="5">
<![CDATA[		// special case of cutting head the init position is the cutter]]>
</Line>
<Line Number="6">
<![CDATA[		hSequence.ops[index].xPos := machine.positions[0].x;]]>
</Line>
<Line Number="7">
<![CDATA[		]]>
</Line>
<Line Number="8">
<![CDATA[		// the default length assumes full length cut not front offal amount]]>
</Line>
<Line Number="9">
<![CDATA[		(*]]>
</Line>
<Line Number="10">
<![CDATA[		hSequence.ops[index].zPos := ]]>
</Line>
<Line Number="11">
<![CDATA[			machine.positions[0].zPosition +]]>
</Line>
<Line Number="12">
<![CDATA[			mProgram.outPart.length +]]>
</Line>
<Line Number="13">
<![CDATA[			hProgram.colletOffset;]]>
</Line>
<Line Number="14">
<![CDATA[		*)]]>
</Line>
<Line Number="15">
<![CDATA[		hSequence.ops[index].zPos := ]]>
</Line>
<Line Number="16">
<![CDATA[			machine.positions[0].z +]]>
</Line>
<Line Number="17">
<![CDATA[			outputPartLength +]]>
</Line>
<Line Number="18">
<![CDATA[			hProgram.colletOffset;]]>
</Line>
<Line Number="19">
<![CDATA[	else]]>
</Line>
<Line Number="20">
<![CDATA[		hSequence.ops[index].xPos := inputHandoff.position.x;]]>
</Line>
<Line Number="21">
<![CDATA[		(*]]>
</Line>
<Line Number="22">
<![CDATA[		hSequence.ops[index].zPos := ]]>
</Line>
<Line Number="23">
<![CDATA[			inputHandoff.position.zPosition +]]>
</Line>
<Line Number="24">
<![CDATA[			(mProgram.outPart.length / 2) +]]>
</Line>
<Line Number="25">
<![CDATA[			hProgram.colletOffset +]]>
</Line>
<Line Number="26">
<![CDATA[			hProgram.hoInputOffset;]]>
</Line>
<Line Number="27">
<![CDATA[			*)]]>
</Line>
<Line Number="28">
<![CDATA[		hSequence.ops[index].zPos := ]]>
</Line>
<Line Number="29">
<![CDATA[			inputHandoff.position.z +]]>
</Line>
<Line Number="30">
<![CDATA[			(outputPartLength / 2) +]]>
</Line>
<Line Number="31">
<![CDATA[			hProgram.colletOffset +]]>
</Line>
<Line Number="32">
<![CDATA[			hProgram.hoInputOffset;]]>
</Line>
<Line Number="33">
<![CDATA[end_case;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[if not buildSeqs then]]>
</Line>
<Line Number="3">
<![CDATA[	TND();]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[COP(\Settings.cellProgram, mProgram, 1);]]>
</Line>
<Line Number="7">
<![CDATA[outputPartLength := mProgram.outPart.length + mProgram.outPart.deviation;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[// the first input is empty, for compatability with the Build code]]>
</Line>
<Line Number="10">
<![CDATA[// we already have]]>
</Line>
<Line Number="11">
<![CDATA[COP(emptyHandoff, inputHandoff, 1);]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[for headIndex := 0 to 3 do]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[	// copy in empty]]>
</Line>
<Line Number="16">
<![CDATA[	COP(\Settings.emptySequence, hSequence, 1);]]>
</Line>
<Line Number="17">
<![CDATA[	]]>
</Line>
<Line Number="18">
<![CDATA[	// copy in references (will not be written]]>
</Line>
<Line Number="19">
<![CDATA[	COP(\Settings.hPrograms[headIndex], hProgram, 1);]]>
</Line>
<Line Number="20">
<![CDATA[	COP(\Settings.machineParams[headIndex], machine, 1);]]>
</Line>
<Line Number="21">
<![CDATA[	]]>
</Line>
<Line Number="22">
<![CDATA[	// in the case of head 0 the input hand off is ignored]]>
</Line>
<Line Number="23">
<![CDATA[	// but the params had 5 entries [1..4] were really 0..3]]>
</Line>
<Line Number="24">
<![CDATA[	//COP(\Settings.handoffParams[headIndex], inputHandoff, 1);]]>
</Line>
<Line Number="25">
<![CDATA[	//COP(\Settings.handoffParams[headIndex+1], outputHandoff, 1);]]>
</Line>
<Line Number="26">
<![CDATA[	// TODO: remap to Handoffs.h[headIndex].param]]>
</Line>
<Line Number="27">
<![CDATA[	]]>
</Line>
<Line Number="28">
<![CDATA[	if headIndex > 0 then]]>
</Line>
<Line Number="29">
<![CDATA[		COP(\Handoffs.h[headIndex-1].param, inputHandoff, 1);]]>
</Line>
<Line Number="30">
<![CDATA[	end_if;]]>
</Line>
<Line Number="31">
<![CDATA[	COP(\Handoffs.h[headIndex].param, outputHandoff, 1);]]>
</Line>
<Line Number="32">
<![CDATA[	]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	JSR(BuildSeq);]]>
</Line>
<Line Number="35">
<![CDATA[	]]>
</Line>
<Line Number="36">
<![CDATA[	// copy out new sequence]]>
</Line>
<Line Number="37">
<![CDATA[	COP(hSequence, \Settings.cycleSequences[headIndex], 1);]]>
</Line>
<Line Number="38">
<![CDATA[	]]>
</Line>
<Line Number="39">
<![CDATA[	COP(\Settings.emptySequence, hSequence, 1);				//clear]]>
</Line>
<Line Number="40">
<![CDATA[	JSR(BuildInit);]]>
</Line>
<Line Number="41">
<![CDATA[	COP(hSequence, \Settings.initSequences[headIndex], 1);]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[	COP(\Settings.emptySequence, hSequence, 1);]]>
</Line>
<Line Number="44">
<![CDATA[	JSR(BuildClear);]]>
</Line>
<Line Number="45">
<![CDATA[	COP(hSequence, \Settings.clearSequences[headIndex], 1);]]>
</Line>
<Line Number="46">
<![CDATA[	]]>
</Line>
<Line Number="47">
<![CDATA[end_for;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[buildCount := buildCount + 1;]]>
</Line>
<Line Number="50">
<![CDATA[buildSeqs := 0;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
