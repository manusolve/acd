</Line>
<Line Number="22">
<![CDATA[	//The number of microseconds elapsed since 0000 hours 1 January 1970.]]>
</Line>
<Line Number="23">
<![CDATA[	GSV(WallClockTime, ,CurrentValue, stamp[0]);]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[	// Increment global sequence number]]>
</Line>
<Line Number="26">
<![CDATA[	currentSequence := currentSequence + 1;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[	// Calculate next head index]]>
</Line>
<Line Number="29">
<![CDATA[	nextHeadIndex := (headIndex + 1) MOD bufferSize;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[	// Check if buffer is full and advance tail if needed]]>
</Line>
<Line Number="32">
<![CDATA[	// This can happen during reading - it's safe to advance the tail]]>
</Line>
<Line Number="33">
<![CDATA[	if logCount >= bufferSize then]]>
</Line>
<Line Number="34">
<![CDATA[		tailIndex := (tailIndex + 1) MOD bufferSize;]]>
</Line>
<Line Number="35">
<![CDATA[	ELSE]]>
</Line>
<Line Number="36">
<![CDATA[		// Increment count if not full]]>
</Line>
<Line Number="37">
<![CDATA[		logCount := logCount + 1;]]>
</Line>
<Line Number="38">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[	// Write log message at current head position]]>
</Line>
<Line Number="41">
<![CDATA[	COP(stamp[0], logBuffer[headIndex].timeStamp, 1);]]>
</Line>
<Line Number="42">
<![CDATA[	logBuffer[headIndex].message := message;]]>
</Line>
<Line Number="43">
<![CDATA[	logBuffer[headIndex].sequence := currentSequence;]]>
</Line>
<Line Number="44">
<![CDATA[	logBuffer[headIndex].logLevel := logLevel;]]>
</Line>
<Line Number="45">
<![CDATA[	logBuffer[headIndex].source := source;]]>
</Line>
<Line Number="46">
<![CDATA[	logBuffer[headIndex].code := code;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[	// Update head index]]>
</Line>
<Line Number="49">
<![CDATA[	headIndex := nextHeadIndex;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[end_if;]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[// clear the inputs]]>
</Line>
<Line Number="54">
<![CDATA[source := -1;]]>
</Line>
<Line Number="55">
<![CDATA[logLevel := -1;]]>
</Line>
<Line Number="56">
<![CDATA[code := -1;]]>
</Line>
<Line Number="57">
<![CDATA[message := '';]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[// clear the inputs]]>
</Line>
<Line Number="61">
<![CDATA[//message := '';]]>
</Line>
<Line Number="62">
<![CDATA[//logLevel := '';]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
