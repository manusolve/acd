<Line Number="371">
<![CDATA[			gripper.open := 0;]]>
</Line>
<Line Number="372">
<![CDATA[			]]>
</Line>
<Line Number="373">
<![CDATA[			state := 320;]]>
</Line>
<Line Number="374">
<![CDATA[		else]]>
</Line>
<Line Number="375">
<![CDATA[			// this gripper object is never processed]]>
</Line>
<Line Number="376">
<![CDATA[			// like the ones in handoff so there is no]]>
</Line>
<Line Number="377">
<![CDATA[			// backed in timeout]]>
</Line>
<Line Number="378">
<![CDATA[			// TODO: Process Gripper with AOI or such like.]]>
</Line>
<Line Number="379">
