<Structure DataType="RunHead">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="1"/>
<DataValueMember Name="DN" DataType="BOOL" Value="1"/>
<DataValueMember Name="timeMachineCycleStart" DataType="DINT" Radix="Decimal" Value="125"/>
<DataValueMember Name="timeHandOffGripperDelay" DataType="DINT" Radix="Decimal" Value="250"/>
<DataValueMember Name="timeTimeoutDefault" DataType="DINT" Radix="Decimal" Value="10000"/>
<DataValueMember Name="timeMachineCycleTimeout" DataType="DINT" Radix="Decimal" Value="120000"/>
<DataValueMember Name="index" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="step" DataType="BOOL" Value="1"/>
<DataValueMember Name="allClear" DataType="BOOL" Value="0"/>
<DataValueMember Name="waiting" DataType="BOOL" Value="0"/>
<DataValueMember Name="isLogMessage" DataType="BOOL" Value="0"/>
<DataValueMember Name="stepWait" DataType="BOOL" Value="0"/>
<DataValueMember Name="errorState" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="inputFeedReady" DataType="BOOL" Value="0"/>
<DataValueMember Name="state" DataType="INT" Radix="Decimal" Value="10"/>
<DataValueMember Name="opEndState" DataType="INT" Radix="Decimal" Value="2000"/>
<DataValueMember Name="opErrorState" DataType="INT" Radix="Decimal" Value="3000"/>
<DataValueMember Name="stateLast" DataType="DINT" Radix="Decimal" Value="10"/>
<DataValueMember Name="isMachineNeeded" DataType="BOOL" Value="0"/>
<DataValueMember Name="errorCode" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="errorIndex" DataType="DINT" Radix="Decimal" Value="-1"/>
<DataValueMember Name="unclampOutputOnReturn" DataType="BOOL" Value="0"/>
<DataValueMember Name="unclampOuputPosition" DataType="REAL" Radix="Float" Value="2874.0"/>
<DataValueMember Name="positionThreshold" DataType="REAL" Radix="Float" Value="0.5"/>
<DataValueMember Name="debugIgnorePartPresent" DataType="BOOL" Value="0"/>
<DataValueMember Name="incomingPart" DataType="BOOL" Value="0"/>
<DataValueMember Name="lastZCommand" DataType="REAL" Radix="Float" Value="424.69998"/>
<DataValueMember Name="lastXCommand" DataType="REAL" Radix="Float" Value="2373.0"/>
<DataValueMember Name="bumpSpeed" DataType="REAL" Radix="Float" Value="1000.0"/>
<DataValueMember Name="bumpAccel" DataType="REAL" Radix="Float" Value="60000.0"/>
<DataValueMember Name="waitAtIndex" DataType="DINT" Radix="Decimal" Value="-1"/>
<DataValueMember Name="timeOpDuration" DataType="DINT" Radix="Decimal" Value="505888"/>
<DataValueMember Name="bumpCounter" DataType="DINT" Radix="Decimal" Value="-1"/>
<DataValueMember Name="bumpDistance" DataType="REAL" Radix="Float" Value="30.0"/>
<DataValueMember Name="bumpCount" DataType="DINT" Radix="Decimal" Value="4"/>
