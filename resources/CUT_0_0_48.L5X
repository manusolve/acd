<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if \MachineMain.modeCurrent <> 1 then]]>
</Line>
<Line Number="2">
<![CDATA[	TND();]]>
</Line>
<Line Number="3">
<![CDATA[end_if;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[// not enabled]]>
</Line>
<Line Number="6">
<![CDATA[If not \Safety.ENABLE_ALL then	]]>
</Line>
<Line Number="7">
<![CDATA[	//TND(); // Return ]]>
</Line>
<Line Number="8">
<![CDATA[end_if;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[(*]]>
</Line>
<Line Number="11">
<![CDATA[Manual controls]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[- Hopper/Tipper]]>
</Line>
<Line Number="14">
<![CDATA[- Stepper ]]>
</Line>
<Line Number="15">
<![CDATA[- Input conv]]>
</Line>
<Line Number="16">
<![CDATA[- Transfer]]>
</Line>
<Line Number="17">
<![CDATA[- Cutter start/stop]]>
</Line>
<Line Number="18">
<![CDATA[- ]]>
</Line>
<Line Number="19">
<![CDATA[*)]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[/// check for new requested state from HMI]]>
</Line>
<Line Number="22">
<![CDATA[if reqState <> -1 and ]]>
</Line>
<Line Number="23">
<![CDATA[	reqState <> state and]]>
</Line>
<Line Number="24">
<![CDATA[	not active]]>
</Line>
<Line Number="25">
<![CDATA[then]]>
</Line>
<Line Number="26">
<![CDATA[	(*]]>
</Line>
<Line Number="27">
<![CDATA[	\Event.message := 'MAN mode change from HMI';]]>
</Line>
<Line Number="28">
<![CDATA[	Event(LogEvent);]]>
</Line>
<Line Number="29">
<![CDATA[	*)]]>
</Line>
<Line Number="30">
<![CDATA[	state := reqState;]]>
</Line>
<Line Number="31">
<![CDATA[	//\HMI.clearButtons := 1;]]>
</Line>
<Line Number="32">
<![CDATA[	entry := 1;]]>
</Line>
<Line Number="33">
<![CDATA[	TND();]]>
</Line>
<Line Number="34">
<![CDATA[end_if;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[case state of]]>
</Line>
<Line Number="37">
<![CDATA[	-1:]]>
</Line>
<Line Number="38">
<![CDATA[		active := 0;]]>
</Line>
<Line Number="39">
<![CDATA[		;]]>
</Line>
<Line Number="40">
<![CDATA[	0:]]>
</Line>
<Line Number="41">
<![CDATA[		/// none]]>
</Line>
<Line Number="42">
<![CDATA[		;]]>
</Line>
<Line Number="43">
<![CDATA[	10:]]>
</Line>
<Line Number="44">
<![CDATA[		/// tipper hopper]]>
</Line>
<Line Number="45">
<![CDATA[		if entry then]]>
</Line>
<Line Number="46">
<![CDATA[			\HMI.aButton := 'Tipper Up';]]>
</Line>
<Line Number="47">
<![CDATA[			\HMI.bButton := 'Tipper Down';]]>
</Line>
<Line Number="48">
<![CDATA[			\HMI.cButton := 'Hopper Up';]]>
</Line>
<Line Number="49">
<![CDATA[			\HMI.dButton := 'Hopper Down';]]>
</Line>
<Line Number="50">
<![CDATA[			entry := 0;]]>
</Line>
<Line Number="51">
<![CDATA[		end_if;]]>
</Line>
<Line Number="52">
<![CDATA[		]]>
