<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="state" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="plus" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="minus" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="isPlusFB" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="isMinusFB" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="tS" DataType="TimerStart" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TimerStart">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="time" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="timer" DataType="FBD_TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0,0,0,0,0,0,0,0,4,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="FBD_TIMER">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="TimerEnable" DataType="BOOL" Value="0"/>
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[	]]>
</Line>
<Line Number="1">
<![CDATA[	case state of]]>
</Line>
<Line Number="2">
<![CDATA[		0:]]>
</Line>
<Line Number="3">
<![CDATA[			//if gripper.close or gripper.open then]]>
</Line>
<Line Number="4">
<![CDATA[			if plus or minus then]]>
</Line>
<Line Number="5">
<![CDATA[				TimerStart(tS, timer, 2500);]]>
</Line>
<Line Number="6">
<![CDATA[				state := 10;]]>
</Line>
<Line Number="7">
<![CDATA[			end_if;]]>
</Line>
<Line Number="8">
<![CDATA[			]]>
</Line>
<Line Number="9">
<![CDATA[		10:]]>
</Line>
<Line Number="10">
<![CDATA[			if plus then]]>
</Line>
<Line Number="11">
<![CDATA[				if isPlusFB then]]>
</Line>
<Line Number="12">
<![CDATA[					state := 30;]]>
</Line>
<Line Number="13">
<![CDATA[				end_If;]]>
</Line>
<Line Number="14">
<![CDATA[			elsif minus then]]>
</Line>
<Line Number="15">
<![CDATA[				if isMinusFB then]]>
</Line>
<Line Number="16">
<![CDATA[					state := 30;]]>
</Line>
<Line Number="17">
<![CDATA[				end_if;]]>
</Line>
<Line Number="18">
<![CDATA[			end_If;]]>
</Line>
<Line Number="19">
<![CDATA[			]]>
</Line>
<Line Number="20">
<![CDATA[			if timer.DN then]]>
</Line>
<Line Number="21">
<![CDATA[				timer.Reset := 1;]]>
</Line>
<Line Number="22">
<![CDATA[				state := 20;]]>
</Line>
<Line Number="23">
<![CDATA[			end_if;]]>
</Line>
<Line Number="24">
<![CDATA[		20:]]>
</Line>
<Line Number="25">
<![CDATA[			if plus then]]>
</Line>
<Line Number="26">
<![CDATA[				//message := 'gripper did not open';]]>
</Line>
<Line Number="27">
<![CDATA[				; // plus not done]]>
</Line>
<Line Number="28">
<![CDATA[			else]]>
</Line>
<Line Number="29">
<![CDATA[				//message := 'gripper did not close';]]>
</Line>
<Line Number="30">
<![CDATA[				; //minus not done]]>
</Line>
<Line Number="31">
<![CDATA[			end_if;]]>
</Line>
<Line Number="32">
<![CDATA[			]]>
</Line>
<Line Number="33">
<![CDATA[			(*]]>
</Line>
<Line Number="34">
<![CDATA[			\Event.message := message;]]>
</Line>
<Line Number="35">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="36">
<![CDATA[			*)]]>
</Line>
<Line Number="37">
<![CDATA[			]]>
</Line>
<Line Number="38">
<![CDATA[			state := 30;]]>
</Line>
<Line Number="39">
<![CDATA[			]]>
</Line>
<Line Number="40">
<![CDATA[		30:]]>
</Line>
<Line Number="41">
<![CDATA[			plus := 0;]]>
</Line>
<Line Number="42">
<![CDATA[			minus := 0;]]>
</Line>
<Line Number="43">
<![CDATA[			]]>
</Line>
<Line Number="44">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="45">
<![CDATA[			]]>
</Line>
<Line Number="46">
<![CDATA[	end_Case;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="GenCutPlan" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2025-11-22T23:39:10.522Z" CreatedBy="EB14G9-1\will" EditedDate="2026-01-19T19:19:17.167Z" EditedBy="EB14G9-1\will" SoftwareRevision="v32.00"
>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="plan" TagType="Base" DataType="CutPlan" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="param" TagType="Base" DataType="CutPlanParam" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="tempOutLength" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="numPartsGross" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="maxNumParts" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="totalMinOffal" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="workingParam" DataType="CutPlanParam" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0.00000000e+000,0.00000000e+000,0.00000000e+000,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="CutPlanParam">
<DataValueMember Name="backOffalMin" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="frontOffalMin" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="frontOffalMax" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="allowFront" DataType="BOOL" Value="0"/>
<DataValueMember Name="allowBack" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[tempOutLength := plan.outputLength;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// this is the number of parts without consideration for the minimum cut lengths]]>
</Line>
<Line Number="4">
<![CDATA[maxNumParts := TRUNC(plan.inputLength / tempOutLength);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// this is the length of offal without minimum cut lengths]]>
</Line>
<Line Number="7">
<![CDATA[plan.basicOffalLength := plan.inputLength - (maxNumParts * plan.outputLength);]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[// this is the smallest amount we can remove front and back]]>
</Line>
<Line Number="10">
<![CDATA[totalMinOffal := param.backOffalMin + param.frontOffalMin;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[// the default case is to take the minimum from the front]]>
</Line>
<Line Number="13">
<![CDATA[plan.frontOffalLength := param.frontOffalMin;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[if plan.basicOffalLength > totalMinOffal then]]>
</Line>
<Line Number="16">
<![CDATA[	// we have sufficient offal to meet the minumum total front and back]]>
</Line>
<Line Number="17">
<![CDATA[	plan.numParts := maxNumParts;]]>
</Line>
<Line Number="18">
<![CDATA[else]]>
</Line>
<Line Number="19">
<![CDATA[	// insufficient offal to meet mininum]]>
</Line>
<Line Number="20">
<![CDATA[	plan.numParts := TRUNC((plan.inputLength - totalMinOffal) / plan.outputLength);]]>
</Line>
<Line Number="21">
<![CDATA[end_if;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// apply the rules we are using ]]>
</Line>
<Line Number="24">
<![CDATA[// allowBack means that we are allowing the back of the input part]]>
</Line>
<Line Number="25">
<![CDATA[// to be an edge in the last output part]]>
</Line>
<Line Number="26">
<![CDATA[if param.allowBack then]]>
</Line>
<Line Number="27">
<![CDATA[	]]>
</Line>
<Line Number="28">
<![CDATA[	if plan.basicOffalLength < param.frontOffalMax then]]>
</Line>
<Line Number="29">
<![CDATA[		// in this case we can remove the front offal and dump]]>
</Line>
<Line Number="30">
<![CDATA[		// -> remove the material from front only]]>
</Line>
<Line Number="31">
<![CDATA[		plan.frontOffalLength := plan.basicOffalLength;]]>
</Line>
<Line Number="32">
<![CDATA[		plan.backOffalLength := 0.0;]]>
</Line>
<Line Number="33">
<![CDATA[		plan.numParts := TRUNC((plan.inputLength - plan.basicOffalLength) / plan.outputLength);]]>
</Line>
<Line Number="34">
<![CDATA[		// numParts remains the same]]>
</Line>
<Line Number="35">
<![CDATA[		]]>
</Line>
<Line Number="36">
<![CDATA[	elsif plan.basicOffalLength < totalMinOffal then]]>
</Line>
<Line Number="37">
<![CDATA[		// in this case we cannot remove the minimum from the front]]>
</Line>
<Line Number="38">
<![CDATA[		// and back. The back offal will be longer than output part]]>
</Line>
<Line Number="39">
<![CDATA[		// -> the back offal length will be longer than 1 part]]>
</Line>
<Line Number="40">
<![CDATA[		plan.backOffalLength := (plan.basicOffalLength - plan.frontOffalLength)]]>
</Line>
<Line Number="41">
<![CDATA[								+ plan.outputLength;]]>
</Line>
<Line Number="42">
<![CDATA[		// numParts is 1 less due to insufficient amount of minimum offal]]>
</Line>
<Line Number="43">
<![CDATA[		//plan.numParts := plan.numParts - 1;]]>
</Line>
<Line Number="44">
<![CDATA[	else]]>
</Line>
<Line Number="45">
<![CDATA[		// in this case we can remove material from the front and]]>
</Line>
<Line Number="46">
<![CDATA[		// back]]>
</Line>
<Line Number="47">
<![CDATA[		// -> remove min from front (default)]]>
</Line>
<Line Number="48">
<![CDATA[		// -> remove calculated amount from the back]]>
</Line>
<Line Number="49">
<![CDATA[		plan.backOffalLength := (plan.basicOffalLength - plan.frontOffalLength);]]>
</Line>
<Line Number="50">
<![CDATA[		// numParts remains the same]]>
</Line>
<Line Number="51">
<![CDATA[		]]>
</Line>
<Line Number="52">
<![CDATA[	end_if;]]>
</Line>
<Line Number="53">
<![CDATA[end_if;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[// allowFront means we are allowing the front of the input part]]>
</Line>
<Line Number="56">
<![CDATA[// to be an edge in the first output part]]>
</Line>
<Line Number="57">
<![CDATA[if param.allowFront then]]>
</Line>
<Line Number="58">
<![CDATA[	]]>
</Line>
<Line Number="59">
<![CDATA[	plan.frontOffalLength := 0.0;]]>
</Line>
<Line Number="60">
<![CDATA[	]]>
</Line>
<Line Number="61">
<![CDATA[	// rules as applicable.....]]>
</Line>
<Line Number="62">
<![CDATA[	if plan.basicOffalLength < param.backOffalMin then]]>
</Line>
<Line Number="63">
<![CDATA[		// we cannot take the basic amount of the back ]]>
</Line>
<Line Number="64">
<![CDATA[		plan.numParts := TRUNC((plan.inputLength - param.backOffalMin) / plan.outputLength);]]>
</Line>
<Line Number="65">
<![CDATA[	else]]>
</Line>
<Line Number="66">
<![CDATA[		]]>
</Line>
<Line Number="67">
<![CDATA[		//plan.numParts := TRUNC((plan.inputLength - param.backOffalMin) / plan.outputLength);]]>
</Line>
<Line Number="68">
<![CDATA[		plan.numParts := maxNumParts;]]>
</Line>
<Line Number="69">
<![CDATA[	end_if;]]>
</Line>
<Line Number="70">
<![CDATA[	]]>
</Line>
<Line Number="71">
<![CDATA[	plan.backOffalLength := plan.inputLength - (plan.numParts * plan.outputLength);]]>
</Line>
<Line Number="72">
<![CDATA[	]]>
</Line>
<Line Number="73">
<![CDATA[end_if;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[// NOTE;]]>
</Line>
<Line Number="76">
<![CDATA[// if both allowFront and allowBack could/would be set then the parts ]]>
</Line>
<Line Number="77">
<![CDATA[// are passed through without offal however we are limited by the ]]>
</Line>
<Line Number="78">
<![CDATA[// actual part length variance and/or the variance in the measuring system]]>
</Line>
<Line Number="79">
<![CDATA[// in that case we must define a threshold window for the overall length]]>
</Line>
<Line Number="80">
<![CDATA[]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
<Line Number="82">
<![CDATA[if plan.numParts < 0 then]]>
</Line>
<Line Number="83">
<![CDATA[	plan.numParts := 0;]]>
</Line>
<Line Number="84">
<![CDATA[end_if;]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[if 0 then]]>
</Line>
<Line Number="88">
<![CDATA[	//// the previous method]]>
</Line>
<Line Number="89">
<![CDATA[	// work out number of parts possible for current input part]]>
</Line>
<Line Number="90">
<![CDATA[	plan.numParts := TRUNC((plan.inputLength - param.backOffalMin - plan.frontOffalLength) / tempOutLength);]]>
</Line>
<Line Number="91">
<![CDATA[]]>
</Line>
<Line Number="92">
<![CDATA[	// the back offal actual]]>
</Line>
<Line Number="93">
<![CDATA[	plan.backOffalLength := plan.inputLength - ((tempOutLength * plan.numParts) + plan.frontOffalLength);]]>
</Line>
<Line Number="94">
<![CDATA[end_if;]]>
</Line>
<Line Number="95">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SafetyDoor" Class="Safety" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2025-06-28T14:46:48.121Z" CreatedBy="ZB14-P-2\will" EditedDate="2025-11-26T20:48:18.974Z" EditedBy="EB14G9-1\will" SoftwareRevision="v32.00"
>
