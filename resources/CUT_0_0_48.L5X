<![CDATA[[0,0,2,[0,3.37500000e+003,3.02500000e+002]]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="HandoffParam">
<DataValueMember Name="id" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="index" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="type" DataType="DINT" Radix="Decimal" Value="2"/>
<StructureMember Name="position" DataType="Position">
<DataValueMember Name="id" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="x" DataType="REAL" Radix="Float" Value="3375.0"/>
<DataValueMember Name="z" DataType="REAL" Radix="Float" Value="302.5"/>
</StructureMember>
</Structure>
</Data>
</Tag>
<Tag Name="outputPartLength" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[8.58000031e+001]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="85.8"/>
</Data>
</Tag>
<Tag Name="pos" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="None">
<Data Format="L5K">
<![CDATA[2.87400000e+003]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="2874.0"/>
</Data>
</Tag>
<Tag Name="positionRetract" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[5.20900024e+002]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="520.9"/>
</Data>
