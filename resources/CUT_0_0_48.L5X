<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[// i.e rotating]]>
</Line>
<Line Number="21">
<![CDATA[isCutHeadRunning :=]]>
</Line>
<Line Number="22">
<![CDATA[	sAxis.state > 200 and sAxis.jog and not sAxis.fault;	// jog can be left high so check state]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[isEndOnZShift := ]]>
