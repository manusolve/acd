<Line Number="381">
<![CDATA[			if gripper.state = 0 then]]>
</Line>
<Line Number="382">
<![CDATA[				;]]>
</Line>
<Line Number="383">
<![CDATA[			end_if;]]>
</Line>
<Line Number="384">
<![CDATA[		end_if;]]>
</Line>
<Line Number="385">
<![CDATA[		]]>
