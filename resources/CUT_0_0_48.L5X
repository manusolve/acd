<Routines>
<Routine Name="LoadingControls" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if a2Last and not a2Button then]]>
</Line>
<Line Number="2">
<![CDATA[	reqTipperUp := 0;]]>
</Line>
<Line Number="3">
<![CDATA[end_if;]]>
</Line>
<Line Number="4">
<![CDATA[if not a2Last and a2Button then]]>
</Line>
<Line Number="5">
<![CDATA[	reqTipperUp := 1;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;		]]>
</Line>
<Line Number="7">
<![CDATA[a2Last := a2Button;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[if b2Last and not b2Button then]]>
</Line>
<Line Number="10">
<![CDATA[	reqTipperDown := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[if not b2Last and b2Button then]]>
</Line>
<Line Number="13">
<![CDATA[	reqTipperDown := 1;]]>
</Line>
<Line Number="14">
<![CDATA[end_if;		]]>
</Line>
<Line Number="15">
<![CDATA[b2Last := b2Button;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[if c2Last and not c2Button then]]>
</Line>
<Line Number="18">
<![CDATA[	reqHopperUp := 0;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[if not c2Last and c2Button then]]>
</Line>
<Line Number="21">
<![CDATA[	reqHopperUp := 1;]]>
</Line>
<Line Number="22">
<![CDATA[end_if;		]]>
</Line>
<Line Number="23">
<![CDATA[c2Last := c2Button;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[if d2Last and not d2Button then]]>
</Line>
<Line Number="26">
<![CDATA[	reqHopperDown := 0;]]>
</Line>
<Line Number="27">
<![CDATA[end_if;]]>
</Line>
<Line Number="28">
<![CDATA[if not d2Last and d2Button then]]>
</Line>
<Line Number="29">
<![CDATA[	reqHopperDown := 1;]]>
</Line>
<Line Number="30">
<![CDATA[end_if;		]]>
</Line>
<Line Number="31">
<![CDATA[d2Last := d2Button;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[mAxis(axis, HydAxis, U21_HYD:SO.SafeTorqueOff);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[//if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="4">
<![CDATA[if not U21_HYD:SO.SafeTorqueOff then	]]>
</Line>
<Line Number="5">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="6">
<![CDATA[	hydState := 0;]]>
</Line>
<Line Number="7">
<![CDATA[	reqHopperDown := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	reqHopperUp := 0;]]>
</Line>
<Line Number="9">
<![CDATA[	reqTipperDown := 0;]]>
</Line>
<Line Number="10">
<![CDATA[	reqTipperUp := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[JSR(LoadingControls);]]>
</Line>
<Line Number="15">
<![CDATA[(*]]>
</Line>
<Line Number="16">
<![CDATA[case \MachineMain.modeCurrent of]]>
</Line>
<Line Number="17">
<![CDATA[	1:		// manual mode]]>
</Line>
<Line Number="18">
<![CDATA[		if \ModeMan.state = 10 then]]>
</Line>
<Line Number="19">
<![CDATA[			JSR(LoadingControls);]]>
</Line>
<Line Number="20">
<![CDATA[		end_if;]]>
</Line>
<Line Number="21">
<![CDATA[	0,2:	// AUTO/PROG]]>
</Line>
<Line Number="22">
<![CDATA[		JSR(LoadingControls);]]>
</Line>
<Line Number="23">
<![CDATA[end_case;]]>
</Line>
<Line Number="24">
<![CDATA[*)]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[(*]]>
</Line>
<Line Number="27">
<![CDATA[Pump = 8.5cc/rev]]>
</Line>
<Line Number="28">
<![CDATA[= 0.0085 L/rev]]>
</Line>
<Line Number="29">
<![CDATA[is 117.657:1]]>
</Line>
<Line Number="30">
<![CDATA[since Axis scale must be whole numbers ~ 2:235 L:MotorRevs]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[Axis units are in L/s]]>
</Line>
<Line Number="33">
<![CDATA[*)]]>
</Line>
<Line Number="34">
<![CDATA[defaultPumpSpeed := 12.5; // L/Min]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[// change mode for loading interlocks]]>
</Line>
<Line Number="37">
<![CDATA[case 1 of ]]>
</Line>
<Line Number="38">
<![CDATA[	0:	]]>
</Line>
<Line Number="39">
<![CDATA[		// basic setup]]>
</Line>
<Line Number="40">
<![CDATA[		tipperDownPoss := \Safety.DOORS[3].doorClosed;]]>
</Line>
<Line Number="41">
<![CDATA[		tipperUpPoss := \Safety.DOORS[3].doorClosed;]]>
</Line>
<Line Number="42">
<![CDATA[		hopperUpPoss := \Safety.DOORS[3].doorClosed;]]>
</Line>
<Line Number="43">
<![CDATA[		hopperDownPoss := \Safety.DOORS[3].doorClosed;]]>
</Line>
<Line Number="44">
<![CDATA[		]]>
</Line>
<Line Number="45">
<![CDATA[	1:]]>
</Line>
<Line Number="46">
<![CDATA[		// when in final setup doors will be closed to enable]]>
</Line>
<Line Number="47">
<![CDATA[		// hyd.]]>
</Line>
<Line Number="48">
<![CDATA[		tipperDownPoss := 1;]]>
</Line>
<Line Number="49">
<![CDATA[		tipperUpPoss := isHopperDown;// and not isTipperUp;		]]>
</Line>
<Line Number="50">
<![CDATA[		hopperUpPoss := isTipperDown;// and not isHopperUp;]]>
</Line>
<Line Number="51">
<![CDATA[		hopperDownPoss := 1; // and isTipperDown?]]>
</Line>
<Line Number="52">
<![CDATA[	2:]]>
</Line>
<Line Number="53">
<![CDATA[		tipperDownPoss := 1;]]>
</Line>
<Line Number="54">
<![CDATA[		tipperUpPoss := 1;]]>
</Line>
<Line Number="55">
<![CDATA[		hopperUpPoss := 1;]]>
</Line>
<Line Number="56">
<![CDATA[		hopperDownPoss := 1;]]>
</Line>
<Line Number="57">
<![CDATA[		]]>
</Line>
<Line Number="58">
<![CDATA[end_Case;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[if reqHopperUp and reqHopperDown then]]>
</Line>
<Line Number="61">
<![CDATA[	reqHopperUp := 0;]]>
</Line>
<Line Number="62">
<![CDATA[end_if;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[if reqTipperUp and reqTipperDown then]]>
</Line>
<Line Number="65">
<![CDATA[	reqTipperUp := 0;]]>
</Line>
<Line Number="66">
<![CDATA[end_if;]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[TONR(valveTimer);]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[case state of]]>
</Line>
<Line Number="71">
<![CDATA[	0:]]>
</Line>
<Line Number="72">
<![CDATA[		hopperDown := 0;]]>
</Line>
<Line Number="73">
<![CDATA[		hopperUp := 0;]]>
</Line>
<Line Number="74">
<![CDATA[		tipperUp := 0;]]>
</Line>
<Line Number="75">
<![CDATA[		tipperDown := 0;]]>
</Line>
<Line Number="76">
<![CDATA[		loadValve := 0;]]>
</Line>
<Line Number="77">
<![CDATA[		]]>
</Line>
<Line Number="78">
<![CDATA[		state := 10;]]>
</Line>
<Line Number="79">
<![CDATA[		]]>
</Line>
<Line Number="80">
<![CDATA[	10:]]>
</Line>
<Line Number="81">
<![CDATA[		state:= 100;]]>
</Line>
<Line Number="82">
<![CDATA[		]]>
</Line>
<Line Number="83">
<![CDATA[	100, 101:]]>
</Line>
<Line Number="84">
<![CDATA[		// await command]]>
</Line>
<Line Number="85">
<![CDATA[		]]>
</Line>
<Line Number="86">
<![CDATA[		tipperDown := reqTipperDown and tipperDownPoss;		]]>
</Line>
<Line Number="87">
<![CDATA[		tipperUp := reqTipperUp and tipperUpPoss;]]>
</Line>
<Line Number="88">
<![CDATA[		hopperUp := reqHopperUp and hopperUpPoss;]]>
</Line>
<Line Number="89">
<![CDATA[		hopperDown := reqHopperDown and hopperDownPoss;]]>
</Line>
<Line Number="90">
<![CDATA[		]]>
</Line>
<Line Number="91">
<![CDATA[		activeCommand := tipperDown or tipperUp or hopperUp or hopperDown;]]>
</Line>
<Line Number="92">
<![CDATA[		]]>
</Line>
<Line Number="93">
<![CDATA[		if hydReady and not hydRunning and activeCommand then]]>
</Line>
<Line Number="94">
<![CDATA[			hydRun := 1;]]>
</Line>
<Line Number="95">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="96">
<![CDATA[		end_if;]]>
</Line>
<Line Number="97">
<![CDATA[		]]>
</Line>
<Line Number="98">
<![CDATA[		if not activeCommand and hydRunning then]]>
</Line>
<Line Number="99">
<![CDATA[			case state of]]>
</Line>
<Line Number="100">
<![CDATA[				100:]]>
</Line>
<Line Number="101">
<![CDATA[					// wait for turn off in case of other action]]>
</Line>
<Line Number="102">
<![CDATA[					TimerStart(tS, valveTimer, 500); // overrun]]>
</Line>
<Line Number="103">
<![CDATA[					state := 101;]]>
</Line>
<Line Number="104">
<![CDATA[				101:]]>
</Line>
<Line Number="105">
<![CDATA[					// turn off ]]>
</Line>
<Line Number="106">
<![CDATA[					if valveTimer.DN then]]>
</Line>
<Line Number="107">
<![CDATA[						valveTimer.Reset := 1;]]>
</Line>
<Line Number="108">
<![CDATA[						hydRun := 0;]]>
</Line>
<Line Number="109">
<![CDATA[						loadValve := 0;]]>
</Line>
<Line Number="110">
<![CDATA[						state := 300;]]>
</Line>
<Line Number="111">
<![CDATA[					end_if;]]>
</Line>
<Line Number="112">
<![CDATA[			end_case;]]>
</Line>
<Line Number="113">
<![CDATA[		elsif activeCommand and state = 101 then ]]>
</Line>
<Line Number="114">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="115">
<![CDATA[		end_if;]]>
</Line>
<Line Number="116">
<![CDATA[	]]>
</Line>
<Line Number="117">
<![CDATA[	//// turn on pump and load valve]]>
</Line>
<Line Number="118">
<![CDATA[	200:]]>
</Line>
<Line Number="119">
<![CDATA[		// valves off for pump and load on]]>
</Line>
<Line Number="120">
<![CDATA[		tipperDown := 0;]]>
</Line>
<Line Number="121">
<![CDATA[		tipperUp := 0;]]>
</Line>
<Line Number="122">
<![CDATA[		hopperUp := 0;]]>
</Line>
<Line Number="123">
<![CDATA[		hopperDown := 0;]]>
</Line>
<Line Number="124">
<![CDATA[		]]>
</Line>
<Line Number="125">
<![CDATA[		state := 220;]]>
</Line>
<Line Number="126">
<![CDATA[		]]>
</Line>
<Line Number="127">
<![CDATA[	220:]]>
</Line>
<Line Number="128">
<![CDATA[		if hydRunning then]]>
</Line>
<Line Number="129">
<![CDATA[			state := 240;]]>
</Line>
<Line Number="130">
<![CDATA[		end_if;]]>
</Line>
<Line Number="131">
<![CDATA[	240:]]>
</Line>
<Line Number="132">
<![CDATA[		loadValve := 1;]]>
</Line>
<Line Number="133">
<![CDATA[		TimerStart(tS, valveTimer, 200);]]>
</Line>
<Line Number="134">
<![CDATA[		state := 250;]]>
</Line>
<Line Number="135">
<![CDATA[	250:]]>
</Line>
<Line Number="136">
<![CDATA[		if valveTimer.DN then]]>
</Line>
<Line Number="137">
<![CDATA[			valveTimer.Reset := 1;]]>
</Line>
<Line Number="138">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="139">
<![CDATA[		end_if;]]>
</Line>
<Line Number="140">
<![CDATA[		]]>
</Line>
<Line Number="141">
<![CDATA[	////]]>
</Line>
<Line Number="142">
<![CDATA[	300:]]>
</Line>
<Line Number="143">
<![CDATA[		if not hydRunning then ]]>
</Line>
<Line Number="144">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="145">
<![CDATA[		end_if;]]>
</Line>
<Line Number="146">
<![CDATA[		]]>
</Line>
<Line Number="147">
<![CDATA[	400:]]>
</Line>
<Line Number="148">
<![CDATA[		]]>
</Line>
<Line Number="149">
<![CDATA[		;]]>
</Line>
<Line Number="150">
<![CDATA[		]]>
</Line>
<Line Number="151">
<![CDATA[		]]>
</Line>
<Line Number="152">
<![CDATA[end_case;]]>
</Line>
<Line Number="153">
<![CDATA[]]>
</Line>
<Line Number="154">
<![CDATA[TONR(hydTimer);]]>
</Line>
<Line Number="155">
<![CDATA[]]>
</Line>
<Line Number="156">
<![CDATA[case hydState of]]>
</Line>
<Line Number="157">
<![CDATA[	0:]]>
</Line>
<Line Number="158">
<![CDATA[		// init]]>
</Line>
<Line Number="159">
<![CDATA[		defaultPumpSpeed := 12.5; // L/Min]]>
</Line>
<Line Number="160">
<![CDATA[		defaultPumpSpeed := 10.0; // L/Min]]>
</Line>
<Line Number="161">
<![CDATA[		]]>
</Line>
<Line Number="162">
<![CDATA[		axis.speed := defaultPumpSpeed / 60.0;]]>
</Line>
<Line Number="163">
<![CDATA[		]]>
</Line>
<Line Number="164">
<![CDATA[		//axis.speed := 100.0; // need to work out pump speed]]>
</Line>
<Line Number="165">
<![CDATA[		axis.accel := 10.0;			// likely to be max]]>
</Line>
<Line Number="166">
<![CDATA[		axis.decel := 10.0;			// likely to be max]]>
</Line>
<Line Number="167">
<![CDATA[		axis.jogDirection := 1.0;]]>
</Line>
<Line Number="168">
<![CDATA[		axis.jerkPercentage := 100.0;]]>
</Line>
<Line Number="169">
<![CDATA[		]]>
</Line>
<Line Number="170">
<![CDATA[		hydState := 1;]]>
</Line>
<Line Number="171">
<![CDATA[		hydRunning := 0;]]>
</Line>
<Line Number="172">
<![CDATA[		hydRun := 0;]]>
</Line>
<Line Number="173">
<![CDATA[		hydReady := 0;]]>
</Line>
<Line Number="174">
<![CDATA[		]]>
</Line>
<Line Number="175">
<![CDATA[		;]]>
</Line>
<Line Number="176">
<![CDATA[	1:]]>
</Line>
<Line Number="177">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="178">
<![CDATA[			hydState := 100;]]>
</Line>
<Line Number="179">
<![CDATA[		end_if;]]>
</Line>
<Line Number="180">
<![CDATA[		]]>
</Line>
<Line Number="181">
<![CDATA[	100:]]>
</Line>
<Line Number="182">
<![CDATA[		// ready for command]]>
</Line>
<Line Number="183">
<![CDATA[		hydReady := 1;]]>
</Line>
<Line Number="184">
<![CDATA[		if hydRun then]]>
</Line>
<Line Number="185">
<![CDATA[			hydState := 110;]]>
</Line>
<Line Number="186">
<![CDATA[		end_if;]]>
</Line>
<Line Number="187">
<![CDATA[		]]>
</Line>
<Line Number="188">
<![CDATA[	110:]]>
</Line>
<Line Number="189">
<![CDATA[		axis.jog := 1;]]>
</Line>
<Line Number="190">
<![CDATA[		TimerStart(tS, hydTimer, 400); //200]]>
</Line>
<Line Number="191">
<![CDATA[		hydState := 120;]]>
</Line>
<Line Number="192">
<![CDATA[	120:]]>
</Line>
<Line Number="193">
<![CDATA[		if hydTimer.DN then ]]>
</Line>
<Line Number="194">
<![CDATA[			hydTimer.Reset := 1;]]>
</Line>
<Line Number="195">
<![CDATA[			hydRunning := 1;]]>
</Line>
<Line Number="196">
<![CDATA[			hydState := 200;]]>
</Line>
<Line Number="197">
<![CDATA[		end_if;]]>
</Line>
<Line Number="198">
<![CDATA[	]]>
</Line>
<Line Number="199">
<![CDATA[	200:]]>
</Line>
<Line Number="200">
<![CDATA[		if not hydRun then]]>
</Line>
<Line Number="201">
<![CDATA[			axis.jog := 0;]]>
</Line>
<Line Number="202">
<![CDATA[			TimerStart(tS, hydTimer, 25);]]>
</Line>
<Line Number="203">
<![CDATA[			hydState := 220;]]>
</Line>
<Line Number="204">
<![CDATA[		end_if;]]>
</Line>
<Line Number="205">
<![CDATA[	220:]]>
</Line>
<Line Number="206">
<![CDATA[		// stopping]]>
</Line>
<Line Number="207">
<![CDATA[		]]>
</Line>
<Line Number="208">
<![CDATA[		if hydTimer.DN then]]>
</Line>
<Line Number="209">
<![CDATA[			hydTimer.Reset := 1;]]>
</Line>
<Line Number="210">
<![CDATA[			hydState := 0;]]>
</Line>
<Line Number="211">
<![CDATA[		end_if;		]]>
</Line>
<Line Number="212">
<![CDATA[end_Case;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
