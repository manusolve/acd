<Routine Name="LogLength" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[message := 'Measured Length ';]]>
</Line>
<Line Number="1">
<![CDATA[RTOS(measuredLength, stringNum);]]>
</Line>
<Line Number="2">
<![CDATA[CONCAT(message, stringNum, message);]]>
</Line>
<Line Number="3">
<![CDATA[\Event.source := 8;]]>
</Line>
<Line Number="4">
<![CDATA[\Event.message := message;]]>
</Line>
<Line Number="5">
<![CDATA[Event(LogEvent);]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[// call the axis]]>
</Line>
<Line Number="3">
<![CDATA[mAxis(axis, MeasureConv, \Safety.ENABLE_ALL); ]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[axisPosition := MeasureConv.ActualPosition;]]>
</Line>
<Line Number="6">
<![CDATA[//diameterMeasure := \IO.btlHeight;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[measSens1REdge.InputBit := measureSensor1;]]>
</Line>
<Line Number="9">
<![CDATA[OSRI(measSens1REdge);]]>
</Line>
<Line Number="10">
<![CDATA[measSens1FEdge.InputBit := measureSensor1;]]>
</Line>
<Line Number="11">
<![CDATA[OSFI(measSens1FEdge);]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[TONR(timer);]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[(*]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[	]]>
</Line>
<Line Number="18">
<![CDATA[	reject mode]]>
</Line>
<Line Number="19">
<![CDATA[	0 - throw off end]]>
</Line>
<Line Number="20">
<![CDATA[	1 - move to end]]>
</Line>
<Line Number="21">
<![CDATA[	2 - stop in place]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[	run mode]]>
</Line>
<Line Number="24">
<![CDATA[	0 - normal]]>
</Line>
<Line Number="25">
<![CDATA[	10 - measure then eject]]>
</Line>
<Line Number="26">
<![CDATA[	20 - push all parts through]]>
</Line>
<Line Number="27">
<![CDATA[	]]>
</Line>
<Line Number="28">
<![CDATA[	gearbox i=32.593]]>
</Line>
<Line Number="29">
<![CDATA[	belt = 56T 8mm = 448mm circum]]>
</Line>
<Line Number="30">
<![CDATA[	]]>
</Line>
<Line Number="31">
<![CDATA[	448/32.593]]>
</Line>
<Line Number="32">
<![CDATA[	= 13.74528]]>
</Line>
<Line Number="33">
<![CDATA[	= 13.75mm / rev]]>
</Line>
<Line Number="34">
<![CDATA[	]]>
</Line>
<Line Number="35">
<![CDATA[	0.9826]]>
</Line>
<Line Number="36">
<![CDATA[*)]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="39">
<![CDATA[	// try to not leave pipe pinned]]>
</Line>
<Line Number="40">
<![CDATA[	heightCylUp := 1;]]>
</Line>
<Line Number="41">
<![CDATA[	heightCylDown := 0;]]>
</Line>
<Line Number="42">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="43">
<![CDATA[end_if;]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[if state > 110 then]]>
</Line>
<Line Number="46">
<![CDATA[	if cmd = 0 then]]>
</Line>
<Line Number="47">
<![CDATA[		state := 250;]]>
</Line>
<Line Number="48">
<![CDATA[	end_if;]]>
</Line>
<Line Number="49">
<![CDATA[end_if;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[// setting these here for online edits]]>
</Line>
<Line Number="52">
<![CDATA[cutPlan.frontOffalLength := \CutInFeed.cutPlan.frontOffalLength;]]>
</Line>
<Line Number="53">
<![CDATA[//cutPlan.backOffalMin := \CutInFeed.cutPlan.backOffalMin;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[if axis.fault then]]>
</Line>
<Line Number="56">
<![CDATA[	errorState := state;]]>
</Line>
<Line Number="57">
<![CDATA[	state := opErrorState;]]>
</Line>
<Line Number="58">
<![CDATA[end_if;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[case state of]]>
</Line>
<Line Number="61">
<![CDATA[	0:]]>
</Line>
<Line Number="62">
<![CDATA[		// init]]>
</Line>
<Line Number="63">
<![CDATA[		currentCmd := -1;		]]>
</Line>
<Line Number="64">
<![CDATA[		axis.jog := 0;]]>
</Line>
<Line Number="65">
<![CDATA[		axis.accel := 400.0;]]>
</Line>
<Line Number="66">
<![CDATA[		axis.decel := 1000.0;//400.0;]]>
</Line>
<Line Number="67">
<![CDATA[		axis.jerkPercentage := 80.0;]]>
</Line>
<Line Number="68">
<![CDATA[		]]>
</Line>
<Line Number="69">
<![CDATA[		//pullOffSpeed := 240.0; 	// this is the faster speed]]>
</Line>
<Line Number="70">
<![CDATA[		//measureSpeed := 50.0; 	// slow down]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		pullOffSpeed := \Settings.inputProcessParam.measurePullSpeed;//  240.0; 	// this is the faster speed]]>
</Line>
<Line Number="73">
<![CDATA[		measureSpeed := \Settings.inputProcessParam.measureMeasureSpeed; // 50.0; 	// slow down]]>
</Line>
<Line Number="74">
<![CDATA[		 ]]>
</Line>
<Line Number="75">
<![CDATA[		sensorToPickUp := 753.0 - 5.8;		//20251002]]>
</Line>
<Line Number="76">
<![CDATA[		sensorToPickUp := 753.0; // measured with tape from light beam to transf jaw centre]]>
</Line>
<Line Number="77">
<![CDATA[		sensorToPickUp := 753.0 - 1.55;		//20251012 -- from measurement]]>
</Line>
<Line Number="78">
<![CDATA[		sensorToPickUp := 745.25;			//20251108 -- after setup in plant]]>
</Line>
<Line Number="79">
<![CDATA[		sensorToPickUp := 746.25;			//20260123 -- after check without front cut]]>
</Line>
<Line Number="80">
<![CDATA[		// TODO: Use inputProcessParam]]>
</Line>
<Line Number="81">
<![CDATA[		heightCylDown := 0;]]>
</Line>
<Line Number="82">
<![CDATA[		heightCylUp := 0;]]>
</Line>
<Line Number="83">
<![CDATA[		]]>
</Line>
<Line Number="84">
<![CDATA[		diameterMeasure := 0.0;]]>
</Line>
<Line Number="85">
<![CDATA[		]]>
</Line>
<Line Number="86">
<![CDATA[		errorState := 0;]]>
</Line>
<Line Number="87">
<![CDATA[		opErrorState := 5000;]]>
</Line>
<Line Number="88">
<![CDATA[		]]>
</Line>
<Line Number="89">
<![CDATA[		message := 'wait for ready';]]>
</Line>
<Line Number="90">
<![CDATA[		]]>
</Line>
<Line Number="91">
<![CDATA[		state := 50;]]>
</Line>
<Line Number="92">
<![CDATA[	]]>
</Line>
<Line Number="93">
<![CDATA[	50:]]>
</Line>
<Line Number="94">
<![CDATA[		// wait for ready:]]>
</Line>
<Line Number="95">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="96">
<![CDATA[			state := 100;]]>
</Line>
<Line Number="97">
<![CDATA[		else]]>
</Line>
<Line Number="98">
<![CDATA[			// waiting after estop is not a error]]>
</Line>
<Line Number="99">
<![CDATA[		end_if;]]>
</Line>
<Line Number="100">
<![CDATA[		]]>
</Line>
<Line Number="101">
<![CDATA[	100:]]>
</Line>
<Line Number="102">
<![CDATA[		// enter stopped/wait]]>
</Line>
<Line Number="103">
<![CDATA[		message := 'stopped/ready';]]>
</Line>
<Line Number="104">
<![CDATA[		heightCylUp 	:= 1;]]>
</Line>
<Line Number="105">
<![CDATA[		heightCylDown 	:= 0;]]>
</Line>
<Line Number="106">
<![CDATA[		]]>
</Line>
<Line Number="107">
<![CDATA[		cmd 		:= -1;]]>
</Line>
<Line Number="108">
<![CDATA[		runMode 	:= 0;]]>
</Line>
<Line Number="109">
<![CDATA[		axis.move 	:= 0;]]>
</Line>
<Line Number="110">
<![CDATA[		axis.jog 	:= 0;]]>
</Line>
<Line Number="111">
<![CDATA[		]]>
</Line>
<Line Number="112">
<![CDATA[		state := 110;]]>
</Line>
<Line Number="113">
<![CDATA[	110:]]>
</Line>
<Line Number="114">
<![CDATA[		// stopped]]>
</Line>
<Line Number="115">
<![CDATA[		currentCmd := 0;]]>
</Line>
<Line Number="116">
<![CDATA[		]]>
</Line>
<Line Number="117">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="118">
<![CDATA[			0:]]>
</Line>
<Line Number="119">
<![CDATA[				;]]>
</Line>
<Line Number="120">
<![CDATA[			1:	]]>
</Line>
<Line Number="121">
<![CDATA[				// run mode]]>
</Line>
<Line Number="122">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[			10:]]>
</Line>
<Line Number="125">
<![CDATA[				// wait for transfer to collect]]>
</Line>
<Line Number="126">
<![CDATA[				state := 530;]]>
</Line>
<Line Number="127">
<![CDATA[			15:]]>
</Line>
<Line Number="128">
<![CDATA[				// wait for the transfer to complete]]>
</Line>
<Line Number="129">
<![CDATA[				state := 560;]]>
</Line>
<Line Number="130">
<![CDATA[				]]>
</Line>
<Line Number="131">
<![CDATA[			30:]]>
</Line>
<Line Number="132">
<![CDATA[				// run with eject mode on]]>
</Line>
<Line Number="133">
<![CDATA[				runMode := 10;]]>
</Line>
<Line Number="134">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="135">
<![CDATA[			40:]]>
</Line>
<Line Number="136">
<![CDATA[				// run out all parts]]>
</Line>
<Line Number="137">
<![CDATA[				runMode := 20;]]>
</Line>
<Line Number="138">
<![CDATA[				state := 200;]]>
</Line>
<Line Number="139">
<![CDATA[			else]]>
</Line>
<Line Number="140">
<![CDATA[				// command not applicable from here]]>
</Line>
<Line Number="141">
<![CDATA[				;]]>
</Line>
<Line Number="142">
<![CDATA[		end_Case;]]>
</Line>
<Line Number="143">
<![CDATA[		]]>
</Line>
<Line Number="144">
<![CDATA[		if stateLast <> state then]]>
</Line>
<Line Number="145">
<![CDATA[			currentCmd := cmd;]]>
</Line>
<Line Number="146">
<![CDATA[			cmd := -1;]]>
</Line>
<Line Number="147">
<![CDATA[		end_if;]]>
</Line>
<Line Number="148">
<![CDATA[		]]>
</Line>
<Line Number="149">
<![CDATA[	/// run mode start]]>
</Line>
<Line Number="150">
<![CDATA[	200:]]>
</Line>
<Line Number="151">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="152">
<![CDATA[			axis.jog 	:= 1;]]>
</Line>
<Line Number="153">
<![CDATA[			axis.speed 	:= pullOffSpeed;]]>
</Line>
<Line Number="154">
<![CDATA[			]]>
</Line>
<Line Number="155">
<![CDATA[			heightCylUp 	:= 1;]]>
</Line>
<Line Number="156">
<![CDATA[			heightCylDown 	:= 0;]]>
</Line>
<Line Number="157">
<![CDATA[			state := 300;]]>
</Line>
<Line Number="158">
<![CDATA[			]]>
</Line>
<Line Number="159">
<![CDATA[			if runMode = 20 then]]>
</Line>
<Line Number="160">
<![CDATA[				message := 'run out parts to hopper';]]>
</Line>
<Line Number="161">
<![CDATA[				state := 250;]]>
</Line>
<Line Number="162">
<![CDATA[			end_if;]]>
</Line>
<Line Number="163">
<![CDATA[		else]]>
</Line>
<Line Number="164">
<![CDATA[			errorState := state;]]>
</Line>
<Line Number="165">
<![CDATA[		end_if;]]>
</Line>
<Line Number="166">
<![CDATA[	]]>
</Line>
<Line Number="167">
<![CDATA[	]]>
</Line>
<Line Number="168">
<![CDATA[	/// runout mode]]>
</Line>
<Line Number="169">
<![CDATA[	250:]]>
</Line>
<Line Number="170">
<![CDATA[		// wait till stop 		]]>
</Line>
<Line Number="171">
<![CDATA[		case cmd of]]>
</Line>
<Line Number="172">
<![CDATA[			0:]]>
</Line>
<Line Number="173">
<![CDATA[				// stop motion]]>
</Line>
<Line Number="174">
<![CDATA[				axis.jog 	:= 0;	// clear the normal run]]>
</Line>
<Line Number="175">
<![CDATA[				axis.move 	:= 0;	// clear the move to pickup position]]>
</Line>
<Line Number="176">
<![CDATA[				]]>
</Line>
<Line Number="177">
<![CDATA[				// clear part present]]>
</Line>
<Line Number="178">
<![CDATA[				\PartPresent.measure 	:= 0;]]>
</Line>
<Line Number="179">
<![CDATA[				\PartPresent.measured 	:= 0;]]>
</Line>
<Line Number="180">
<![CDATA[				]]>
</Line>
<Line Number="181">
<![CDATA[				\InputConv.cmd := 0;]]>
</Line>
<Line Number="182">
<![CDATA[				state := 100;]]>
</Line>
<Line Number="183">
<![CDATA[		end_case;]]>
</Line>
<Line Number="184">
<![CDATA[		]]>
</Line>
<Line Number="185">
<![CDATA[	/// enter running ]]>
</Line>
<Line Number="186">
<![CDATA[	300:]]>
</Line>
<Line Number="187">
<![CDATA[		message := 'running';]]>
</Line>
<Line Number="188">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="189">
<![CDATA[	]]>
</Line>
<Line Number="190">
<![CDATA[	310:]]>
</Line>
<Line Number="191">
<![CDATA[		state := 340;]]>
</Line>
<Line Number="192">
<![CDATA[		]]>
</Line>
<Line Number="193">
<![CDATA[		// if at start there is a pipe here ]]>
</Line>
<Line Number="194">
<![CDATA[		// it should run it off the end -- ignore it.]]>
</Line>
<Line Number="195">
<![CDATA[		if measureSensor1 then]]>
</Line>
<Line Number="196">
<![CDATA[			message := 'ejecting part left on conveyor';]]>
</Line>
<Line Number="197">
<![CDATA[			]]>
</Line>
<Line Number="198">
<![CDATA[			// stop the input from pushing more parts on]]>
</Line>
<Line Number="199">
<![CDATA[			if \InputConv.currentCmd <> 0 ]]>
</Line>
<Line Number="200">
<![CDATA[			then]]>
</Line>
<Line Number="201">
<![CDATA[				\InputConv.cmd := 0;]]>
</Line>
<Line Number="202">
<![CDATA[			end_if;]]>
</Line>
<Line Number="203">
<![CDATA[			]]>
</Line>
<Line Number="204">
<![CDATA[			state := 315;]]>
</Line>
<Line Number="205">
<![CDATA[		end_if;]]>
</Line>
<Line Number="206">
<![CDATA[	]]>
</Line>
<Line Number="207">
<![CDATA[	315:]]>
</Line>
<Line Number="208">
<![CDATA[		// the pipe is now clear enter normal run]]>
</Line>
<Line Number="209">
<![CDATA[		if not measureSensor1 then]]>
</Line>
<Line Number="210">
<![CDATA[			state := 340; 						]]>
</Line>
<Line Number="211">
<![CDATA[		end_If;]]>
</Line>
<Line Number="212">
<![CDATA[	]]>
</Line>
<Line Number="213">
<![CDATA[	/// waiting for pipe front edge]]>
</Line>
<Line Number="214">
<![CDATA[	340:]]>
</Line>
<Line Number="215">
<![CDATA[		message := 'waiting for pipe front edge';]]>
</Line>
<Line Number="216">
<![CDATA[		]]>
</Line>
<Line Number="217">
<![CDATA[		currentCmd := 3;]]>
</Line>
<Line Number="218">
<![CDATA[		state := 350;]]>
</Line>
<Line Number="219">
<![CDATA[	]]>
</Line>
<Line Number="220">
<![CDATA[	/// waiting for coming part as long as required]]>
</Line>
<Line Number="221">
<![CDATA[	350:]]>
</Line>
<Line Number="222">
<![CDATA[		// if it was ejecting part then restart input]]>
</Line>
<Line Number="223">
<![CDATA[		if \InputConv.currentCmd = 0 then]]>
</Line>
<Line Number="224">
<![CDATA[			\InputConv.cmd := 1;]]>
</Line>
<Line Number="225">
<![CDATA[		end_if;]]>
</Line>
<Line Number="226">
<![CDATA[		]]>
</Line>
<Line Number="227">
<![CDATA[		// measureSensorB is neccessary -- but added in A as a check]]>
</Line>
<Line Number="228">
<![CDATA[		if measureSensorB and measureSensorA then ]]>
</Line>
<Line Number="229">
<![CDATA[			state := 360;]]>
</Line>
<Line Number="230">
<![CDATA[		end_if;]]>
</Line>
<Line Number="231">
<![CDATA[	]]>
</Line>
<Line Number="232">
<![CDATA[	// premeasure, apply top clamp]]>
</Line>
<Line Number="233">
<![CDATA[	360:]]>
</Line>
<Line Number="234">
<![CDATA[		heightCylUp := 0;]]>
</Line>
<Line Number="235">
<![CDATA[		heightCylDown := 1;]]>
</Line>
<Line Number="236">
<![CDATA[		axis.speed := measureSpeed;			// slow down for measure (if needed)]]>
</Line>
<Line Number="237">
<![CDATA[		\InputConv.cmd := 0;				// stop input]]>
</Line>
<Line Number="238">
<![CDATA[		\PartPresent.measure := 1;			// part is detected on the conv.]]>
</Line>
<Line Number="239">
<![CDATA[		message := 'partdetected entering pre-measure';]]>
</Line>
<Line Number="240">
<![CDATA[		currentCmd := 4;]]>
</Line>
<Line Number="241">
<![CDATA[		state := 380;]]>
</Line>
<Line Number="242">
<![CDATA[		]]>
</Line>
<Line Number="243">
<![CDATA[	380:]]>
</Line>
<Line Number="244">
<![CDATA[		// wait for part detect]]>
</Line>
<Line Number="245">
<![CDATA[		if measSens1REdge.OutputBit then]]>
</Line>
<Line Number="246">
<![CDATA[			state := 400;]]>
</Line>
<Line Number="247">
<![CDATA[		end_if;]]>
</Line>
<Line Number="248">
<![CDATA[		]]>
</Line>
<Line Number="249">
<![CDATA[		// we don't have a timeout here]]>
</Line>
<Line Number="250">
<![CDATA[	]]>
</Line>
<Line Number="251">
<![CDATA[	/// measure]]>
</Line>
<Line Number="252">
<![CDATA[	400:]]>
</Line>
<Line Number="253">
<![CDATA[		// record axis position on detection of part]]>
</Line>
<Line Number="254">
<![CDATA[		startMeasure := axisPosition;		]]>
</Line>
<Line Number="255">
<![CDATA[		heightCylUp := 0;]]>
</Line>
<Line Number="256">
<![CDATA[		heightCylDown := 1;]]>
</Line>
<Line Number="257">
<![CDATA[		]]>
</Line>
<Line Number="258">
<![CDATA[		// zero the axis to prevent overflow]]>
</Line>
<Line Number="259">
<![CDATA[		axis.newPosition := 0.0;]]>
</Line>
<Line Number="260">
<![CDATA[		axis.setNewPosition := 1;]]>
</Line>
<Line Number="261">
<![CDATA[		]]>
</Line>
<Line Number="262">
<![CDATA[		// log level info?]]>
</Line>
<Line Number="263">
<![CDATA[		message := 'part detected; waiting for pipe end';]]>
</Line>
<Line Number="264">
<![CDATA[		]]>
</Line>
<Line Number="265">
<![CDATA[		currentCmd := 5;]]>
</Line>
<Line Number="266">
<![CDATA[		state := 410;]]>
</Line>
<Line Number="267">
<![CDATA[		]]>
</Line>
<Line Number="268">
<![CDATA[	410:]]>
</Line>
<Line Number="269">
<![CDATA[		// continuously update the current measure]]>
</Line>
<Line Number="270">
<![CDATA[		currentMeasure := axisPosition - startMeasure;]]>
</Line>
<Line Number="271">
<![CDATA[		]]>
</Line>
<Line Number="272">
<![CDATA[		// this ensures sufficient time for the cylinder to come down]]>
</Line>
<Line Number="273">
<![CDATA[		if currentMeasure > 20 and currentMeasure < 22 then]]>
</Line>
<Line Number="274">
<![CDATA[			diameterMeasure := \IO.btlHeight;]]>
</Line>
<Line Number="275">
<![CDATA[		end_if;]]>
</Line>
<Line Number="276">
<![CDATA[		]]>
</Line>
<Line Number="277">
<![CDATA[		// back edge of the pipe is clear of the first]]>
</Line>
<Line Number="278">
<![CDATA[		// sensor, lif the cyl]]>
</Line>
<Line Number="279">
<![CDATA[		if not measureSensorA then]]>
</Line>
<Line Number="280">
<![CDATA[			heightCylDown := 0;]]>
</Line>
<Line Number="281">
<![CDATA[			heightCylUp := 1;]]>
</Line>
<Line Number="282">
<![CDATA[			]]>
</Line>
<Line Number="283">
<![CDATA[			// advance the input till there is a part]]>
</Line>
<Line Number="284">
<![CDATA[			// for the next feed]]>
</Line>
<Line Number="285">
<![CDATA[			if \InputConv.currentCmd = 0 then]]>
</Line>
<Line Number="286">
<![CDATA[				\InputConv.cmd := 2;]]>
</Line>
<Line Number="287">
<![CDATA[			end_if;]]>
</Line>
<Line Number="288">
<![CDATA[		end_if;]]>
</Line>
<Line Number="289">
<![CDATA[		]]>
</Line>
<Line Number="290">
<![CDATA[		// measure sensor has seen the back edge of the pipe,]]>
</Line>
<Line Number="291">
<![CDATA[		// take the measurement]]>
</Line>
<Line Number="292">
<![CDATA[		if measSens1FEdge.OutputBit then]]>
</Line>
<Line Number="293">
<![CDATA[			positionMeasureEnd := axisPosition;]]>
</Line>
<Line Number="294">
<![CDATA[			measuredLength := currentMeasure - 4.0; // minus the dot width]]>
</Line>
<Line Number="295">
<![CDATA[			]]>
</Line>
<Line Number="296">
<![CDATA[			\PartPresent.measured 	:= 1;]]>
</Line>
<Line Number="297">
<![CDATA[			\PartPresent.measure 	:= 0;]]>
</Line>
<Line Number="298">
<![CDATA[			]]>
</Line>
<Line Number="299">
<![CDATA[			state := 430;			]]>
</Line>
<Line Number="300">
<![CDATA[		end_if;]]>
</Line>
<Line Number="301">
<![CDATA[	]]>
</Line>
<Line Number="302">
<![CDATA[		// if measureSensor A or B are still true]]>
</Line>
<Line Number="303">
<![CDATA[		// and we have measured then that is not a normal]]>
</Line>
<Line Number="304">
<![CDATA[		// condition -- but that has not been observed]]>
</Line>
<Line Number="305">
<![CDATA[		// but it may inidcate a faultly sensor etc]]>
</Line>
<Line Number="306">
<![CDATA[		if (measureSensorA or measureSensorB) and not measureSensor1 then]]>
</Line>
<Line Number="307">
<![CDATA[			message := 'possible sensor fault';]]>
</Line>
<Line Number="308">
<![CDATA[			//LogEvent -- add to the log but don't throw an error]]>
</Line>
<Line Number="309">
<![CDATA[		end_if;]]>
</Line>
<Line Number="310">
<![CDATA[	]]>
</Line>
<Line Number="311">
<![CDATA[		// make sure the cyl is up]]>
</Line>
<Line Number="312">
<![CDATA[		if state <> stateLast then]]>
</Line>
<Line Number="313">
<![CDATA[			heightCylDown := 0;]]>
</Line>
<Line Number="314">
<![CDATA[			heightCylUp := 1;]]>
</Line>
<Line Number="315">
<![CDATA[		end_if;]]>
</Line>
<Line Number="316">
<![CDATA[	]]>
</Line>
<Line Number="317">
<![CDATA[	430:]]>
</Line>
<Line Number="318">
<![CDATA[		// evaluate part and log]]>
</Line>
<Line Number="319">
<![CDATA[		]]>
</Line>
<Line Number="320">
<![CDATA[		JSR(LogLength);]]>
</Line>
<Line Number="321">
<![CDATA[		]]>
</Line>
<Line Number="322">
<![CDATA[		cutPlan.inputLength := measuredLength;]]>
</Line>
<Line Number="323">
<![CDATA[		cutPlan.outputLength := \Settings.cellProgram.outPart.length;]]>
</Line>
<Line Number="324">
<![CDATA[		GenCutPlan(gCP, cutPlan, \Settings.cellProgram.cutPlanParam);]]>
</Line>
<Line Number="325">
<![CDATA[		if cutPlan.numParts < 1 then]]>
</Line>
<Line Number="326">
<![CDATA[			\Event.message := 'part too short - ejected';]]>
</Line>
<Line Number="327">
<![CDATA[			\Event.source := 8;]]>
</Line>
<Line Number="328">
<![CDATA[			Event(LogEvent);]]>
</Line>
<Line Number="329">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="330">
<![CDATA[		else]]>
</Line>
<Line Number="331">
<![CDATA[			state := 440;]]>
</Line>
<Line Number="332">
<![CDATA[		end_If;]]>
</Line>
<Line Number="333">
<![CDATA[		]]>
</Line>
<Line Number="334">
<![CDATA[	440:]]>
</Line>
<Line Number="335">
<![CDATA[		// evaluate diameter]]>
</Line>
<Line Number="336">
<![CDATA[		state := 500;]]>
</Line>
<Line Number="337">
<![CDATA[		]]>
</Line>
<Line Number="338">
<![CDATA[		if ABS(diameterMeasure - prog.inPart.dia) > 3 then // was 1 then 2]]>
</Line>
<Line Number="339">
<![CDATA[			// action incorrect diameter in machine]]>
</Line>
<Line Number="340">
<![CDATA[			message := 'Diameter rejected ';]]>
</Line>
<Line Number="341">
<![CDATA[			//Event(LogEvent);]]>
</Line>
<Line Number="342">
<![CDATA[			state := 200; 		// go back to run start]]>
</Line>
<Line Number="343">
<![CDATA[								// part will be ejected.]]>
</Line>
<Line Number="344">
<![CDATA[		else]]>
</Line>
<Line Number="345">
<![CDATA[			message := 'Diameter measured ';			]]>
</Line>
<Line Number="346">
<![CDATA[		end_if;]]>
</Line>
<Line Number="347">
<![CDATA[		JSR(LogDiameter);]]>
</Line>
<Line Number="348">
<![CDATA[	/// move to pickup]]>
</Line>
<Line Number="349">
<![CDATA[	500:]]>
</Line>
<Line Number="350">
<![CDATA[		]]>
</Line>
<Line Number="351">
<![CDATA[		pickUpMove := sensorToPickUp - (measuredLength / 2.0);]]>
</Line>
<Line Number="352">
<![CDATA[		pickUpMove := pickUpMove + axisPosition;]]>
</Line>
<Line Number="353">
<![CDATA[		axis.position := pickUpMove;]]>
</Line>
<Line Number="354">
<![CDATA[		axis.speed := pullOffSpeed;		]]>
</Line>
<Line Number="355">
<![CDATA[		axis.move := 1;]]>
</Line>
<Line Number="356">
<![CDATA[		]]>
</Line>
<Line Number="357">
<![CDATA[		message := 'move to transfer position';]]>
</Line>
<Line Number="358">
<![CDATA[		state := 510;]]>
</Line>
<Line Number="359">
<![CDATA[		]]>
</Line>
<Line Number="360">
<![CDATA[	510:]]>
</Line>
<Line Number="361">
<![CDATA[		if axis.position > positionMeasureEnd + 10 then]]>
</Line>
<Line Number="362">
<![CDATA[			heightCylUp := 0;]]>
</Line>
<Line Number="363">
<![CDATA[		end_if;]]>
</Line>
<Line Number="364">
<![CDATA[]]>
</Line>
<Line Number="365">
<![CDATA[		if not axis.move then]]>
</Line>
<Line Number="366">
<![CDATA[			axis.jog := 0; // clear flag]]>
</Line>
<Line Number="367">
<![CDATA[			debugStopDistance := axisPosition;]]>
</Line>
<Line Number="368">
<![CDATA[			state := 520;]]>
</Line>
<Line Number="369">
<![CDATA[		end_if;]]>
</Line>
<Line Number="370">
<![CDATA[	]]>
</Line>
<Line Number="371">
<![CDATA[	520:]]>
</Line>
<Line Number="372">
<![CDATA[		// be sure axis has stopped]]>
</Line>
<Line Number="373">
<![CDATA[		if axis.state = 200 then]]>
</Line>
<Line Number="374">
<![CDATA[			debugStopDistance := axisPosition - debugStopDistance;]]>
</Line>
<Line Number="375">
<![CDATA[			debugActualStopPosition := axisPosition;]]>
</Line>
<Line Number="376">
<![CDATA[			\PartPresent.measured 			:= 0;]]>
</Line>
<Line Number="377">
<![CDATA[			\PartPresent.measuredToCollect 	:= 1;]]>
</Line>
<Line Number="378">
<![CDATA[			]]>
</Line>
<Line Number="379">
<![CDATA[			state := 530;]]>
</Line>
<Line Number="380">
<![CDATA[		end_if;]]>
</Line>
<Line Number="381">
<![CDATA[]]>
</Line>
<Line Number="382">
<![CDATA[	/// wait for transfer collect]]>
</Line>
<Line Number="383">
<![CDATA[	530:]]>
</Line>
<Line Number="384">
<![CDATA[		currentCmd := 10;]]>
</Line>
<Line Number="385">
<![CDATA[		message := 'measure awaiting transfer';]]>
</Line>
<Line Number="386">
<![CDATA[		// reset the axis counter so no overflow]]>
</Line>
<Line Number="387">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="388">
<![CDATA[			axis.newPosition := 0.0;]]>
</Line>
<Line Number="389">
<![CDATA[			axis.setNewPosition := 1;]]>
</Line>
<Line Number="390">
<![CDATA[			]]>
</Line>
<Line Number="391">
<![CDATA[			state := 535;]]>
</Line>
<Line Number="392">
<![CDATA[		end_if;]]>
</Line>
<Line Number="393">
<![CDATA[		]]>
</Line>
<Line Number="394">
<![CDATA[	535:]]>
</Line>
<Line Number="395">
<![CDATA[		if not axis.setNewPosition then]]>
</Line>
<Line Number="396">
<![CDATA[			state := 540;]]>
</Line>
<Line Number="397">
<![CDATA[		else]]>
</Line>
<Line Number="398">
<![CDATA[			// wait for reset of position, errors not expected]]>
</Line>
<Line Number="399">
<![CDATA[		end_if;]]>
</Line>
<Line Number="400">
<![CDATA[		]]>
</Line>
<Line Number="401">
<![CDATA[	540:]]>
</Line>
<Line Number="402">
<![CDATA[		// now wait for transfer]]>
</Line>
<Line Number="403">
<![CDATA[		case runMode of]]>
</Line>
<Line Number="404">
<![CDATA[			0:]]>
</Line>
<Line Number="405">
<![CDATA[				if \Transfer.currentCmd = 0 ]]>
</Line>
<Line Number="406">
<![CDATA[					and \Transfer.isHome]]>
</Line>
<Line Number="407">
<![CDATA[					and \Transfer.cmd = -1]]>
</Line>
<Line Number="408">
<![CDATA[				then]]>
</Line>
<Line Number="409">
<![CDATA[					// the transfer is ready]]>
</Line>
<Line Number="410">
<![CDATA[					\Transfer.cmd := 40;]]>
</Line>
<Line Number="411">
<![CDATA[					message := 'measure requested transfer';]]>
</Line>
<Line Number="412">
<![CDATA[					state := 560;]]>
</Line>
<Line Number="413">
<![CDATA[				end_if;]]>
</Line>
<Line Number="414">
<![CDATA[			10:]]>
</Line>
<Line Number="415">
<![CDATA[				message := 'stop and eject from end';]]>
</Line>
<Line Number="416">
<![CDATA[				TimerStart(tS, timer, 300);]]>
</Line>
<Line Number="417">
<![CDATA[				state := 550;]]>
</Line>
<Line Number="418">
<![CDATA[		end_case;]]>
</Line>
<Line Number="419">
<![CDATA[	]]>
</Line>
<Line Number="420">
<![CDATA[	550:]]>
</Line>
<Line Number="421">
<![CDATA[		if timer.DN then]]>
</Line>
<Line Number="422">
<![CDATA[			state := 600;]]>
</Line>
<Line Number="423">
<![CDATA[		end_if;]]>
</Line>
<Line Number="424">
<![CDATA[	]]>
</Line>
<Line Number="425">
<![CDATA[	/// wait for the transfer to complete]]>
</Line>
<Line Number="426">
<![CDATA[	560:]]>
</Line>
<Line Number="427">
<![CDATA[		currentCmd := 15;]]>
</Line>
<Line Number="428">
<![CDATA[		// transfer has finished and not waiting for a new command]]>
</Line>
<Line Number="429">
<![CDATA[		// on start up condition ]]>
</Line>
<Line Number="430">
<![CDATA[		if \Transfer.currentCmd = 0 and \Transfer.cmd <> -1 then]]>
</Line>
<Line Number="431">
<![CDATA[			state := 570;]]>
</Line>
<Line Number="432">
<![CDATA[		end_if;]]>
</Line>
<Line Number="433">
<![CDATA[		]]>
</Line>
<Line Number="434">
<![CDATA[	570:]]>
</Line>
<Line Number="435">
<![CDATA[		message := 'Wait for transfer in clear position';]]>
</Line>
<Line Number="436">
<![CDATA[		state := 590;]]>
</Line>
<Line Number="437">
<![CDATA[		]]>
</Line>
<Line Number="438">
<![CDATA[	590:]]>
</Line>
<Line Number="439">
<![CDATA[		if \Transfer.isUp and \Settings.cellProgram.inPart.dia < 105 then]]>
</Line>
<Line Number="440">
<![CDATA[			state := 600;]]>
</Line>
<Line Number="441">
<![CDATA[		elsif \Transfer.isInputClear then]]>
</Line>
<Line Number="442">
<![CDATA[			state := 600;]]>
</Line>
<Line Number="443">
<![CDATA[		end_if;]]>
</Line>
<Line Number="444">
<![CDATA[		]]>
</Line>
<Line Number="445">
<![CDATA[	600:]]>
</Line>
<Line Number="446">
<![CDATA[		message := 'Transfer clear condition; Resume';]]>
</Line>
<Line Number="447">
<![CDATA[		// check for stopped in case it is advancing to detect]]>
</Line>
<Line Number="448">
<![CDATA[		if \InputConv.currentCmd = 0 then			]]>
</Line>
<Line Number="449">
<![CDATA[			\InputConv.cmd := 1;]]>
</Line>
<Line Number="450">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="451">
<![CDATA[		end_if;]]>
</Line>
<Line Number="452">
<![CDATA[]]>
</Line>
<Line Number="453">
<![CDATA[	5000:]]>
</Line>
<Line Number="454">
<![CDATA[		if cmd = 0 then]]>
</Line>
<Line Number="455">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="456">
<![CDATA[		end_if;]]>
</Line>
<Line Number="457">
<![CDATA[		;]]>
</Line>
<Line Number="458">
<![CDATA[		]]>
</Line>
<Line Number="459">
<![CDATA[end_case;]]>
</Line>
<Line Number="460">
<![CDATA[]]>
</Line>
<Line Number="461">
<![CDATA[stateLast := state;]]>
</Line>
<Line Number="462">
<![CDATA[]]>
</Line>
<Line Number="463">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
