<Routines>
<Routine Name="AirEnable" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(airEnable)OTE(AIR_ON_0)OTE(AIR_ON_1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ClearDoorResets" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(DEBUG_CLEAR_DOOR_RESETS)OTU(DOORS[0].needReset)OTU(DOORS[1].needReset)OTU(DOORS[2].needReset)OTU(DOORS[3].needReset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DriveEnable" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(U11:SO.SafeTorqueOff)OTE(U12:SO.SafeTorqueOff)OTE(U13:SO.SafeTorqueOff)OTE(U14:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(U15:SO.SafeTorqueOff)OTE(U16:SO.SafeTorqueOff)OTE(U17:SO.SafeTorqueOff)OTE(U18:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(U22_STEP:SO.SafeTorqueOff)OTE(U23_INCONV:SO.SafeTorqueOff)OTE(U24_MEAS:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(U25_BFEED:SO.SafeTorqueOff)OTE(U26_SCRAP:SO.SafeTorqueOff)OTE(U27:SO.SafeTorqueOff)OTE(U28_OUTCONV:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(U31:SO.SafeTorqueOff)OTE(U32:SO.SafeTorqueOff)OTE(U33:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Isolate STO on HydDrive]]>
</Comment>
<Text>
<![CDATA[XIC(driveEnable)[XIC(DOORS[3].O1) ,XIC(hydAlways) ]OTE(U21_HYD:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Check for resets on servo drives]]>
</Comment>
<Text>
<![CDATA[XIC(driveEnable)TON(servoClearResetTimer,?,?)SDriveReset(driveResets[0],U11:SO.Reset,U11:SI.ResetRequired)SDriveReset(driveResets[1],U12:SO.Reset,U12:SI.ResetRequired)SDriveReset(driveResets[2],U13:SO.Reset,U13:SI.ResetRequired)SDriveReset(driveResets[3],U14:SO.Reset,U14:SI.ResetRequired)SDriveReset(driveResets[4],U15:SO.Reset,U15:SI.ResetRequired)SDriveReset(driveResets[5],U16:SO.Reset,U16:SI.ResetRequired)SDriveReset(driveResets[6],U17:SO.Reset,U17:SI.ResetRequired)SDriveReset(driveResets[7],U18:SO.Reset,U18:SI.ResetRequired)SDriveReset(driveResets[8],U31:SO.Reset,U31:SI.ResetRequired)SDriveReset(driveResets[9],U32:SO.Reset,U32:SI.ResetRequired)SDriveReset(driveResets[10],U33:SO.Reset,U33:SI.ResetRequired);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(driveEnable)OTE(CELL_MC_0)OTE(CELL_MC_1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(ProcessIO,0)JSR(SafetyCheck,0)JSR(AirEnable,0)JSR(DriveEnable,0)JSR(ClearDoorResets,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(ES_BUTTONS) XIC(DEBUG_MODE) ,XIC(FINAL_SAFETY_OK) ]OTE(ALL_OK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(RESET_EDGE.Q)XIC(ALL_OK)XIO(AIR_ENABLE_SETUP_KEY)OTL(ENABLE_ALL);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(ALL_OK) ,XIC(AIR_ENABLE_SETUP_KEY) ]OTU(ENABLE_ALL);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(RESET_EDGE.Q)XIC(AIR_ENABLE_SETUP_KEY)XIO(DOORS[0].doorClosed)XIC(ES_BUTTONS)OTL(ENABLE_AIR_ONLY);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(AIR_ENABLE_SETUP_KEY) ,[XIC(DOORS[0].doorClosed) ,XIO(ES_BUTTONS) ] ]OTU(ENABLE_AIR_ONLY);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set comes from the fallng edge of the reset button
r]]>
</Comment>
<Text>
<![CDATA[XIC(ENABLE_ALL)XIO(AIR_ENABLE_SETUP_KEY)OTE(driveEnable);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(ENABLE_AIR_ONLY) ,XIC(ENABLE_ALL) ]OTE(airEnable);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ProcessIO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Generate Falling Edge from RESET Button]]>
</Comment>
<Text>
<![CDATA[[XIC(RESET_PB_MAIN) ,XIC(DEBUG_TEST_RESET) ][XIC(AIR.O1) ,XIC(DEBUG_ignoreAir) ]OSF(RESET_EDGE.MEM,RESET_EDGE.Q);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[The block is auto reset as the reset of the circuit
is handled by a falling edge elsewhere]]>
</Comment>
<Text>
<![CDATA[ESTOP(ES_BUTTON,AUTOMATIC,ES0,ES1,1,RESET_EDGE.Q);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ESTOP(ES_BUTTON_2,AUTOMATIC,ES2,ES3,1,RESET_EDGE.Q);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[RIN(LC,AUTOMATIC,LC0,LC1,1,RESET_EDGE.Q);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[RIN(AIR,AUTOMATIC,AIR_SAFE_0,AIR_SAFE_1,1,1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ALL_OK)XIO(ENABLE_ALL)OTE(RESET_LED);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[These will need to be OK when the cell is powered up; only once it is running should
they need reseting after the door is opened; therefore an init method is needed
to be sure that the doors are not all waiting for reset]]>
</Comment>
<Text>
<![CDATA[SafetyDoor(DOORS[0],DOOR_0_0,DOOR_0_1,exitResetButton_Map[0],doorStatIn_Map[0]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[SafetyDoor(DOORS[1],DOOR_1_0,DOOR_1_1,exitResetButton_Map[1],doorStatIn_Map[1]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[SafetyDoor(DOORS[2],DOOR_2_0,DOOR_2_1,exitResetButton_Map[2],doorStatIn_Map[2]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[SafetyDoor(DOORS[3],DOOR_3_0,DOOR_3_1,exitResetButton_Map[3],doorStatIn_Map[3]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SafetyCheck" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(DOORS[0].O1)XIC(DOORS[1].O1)XIC(DOORS[2].O1)OTE(DOORS_OK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(LC.O1) ,[XIC(DOORS[3].O1) ,XIC(DISABLE_LC) ] ]OTE(LOAD_AREA_OK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ES_BUTTON.O1)XIC(ES_BUTTON_2.O1)OTE(ES_BUTTONS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ES_BUTTONS)XIC(LOAD_AREA_OK)XIC(DOORS_OK)OTE(FINAL_SAFETY_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
