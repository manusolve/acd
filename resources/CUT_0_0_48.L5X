<Line Number="33">
<![CDATA[		]]>
</Line>
<Line Number="34">
<![CDATA[		// build the safe zPosition and store to data]]>
</Line>
<Line Number="35">
<![CDATA[		pos := machine.positions[counter].z;]]>
</Line>
<Line Number="36">
<![CDATA[		pos := pos + outputPartLength + 50.0; // as a starting point]]>
</Line>
<Line Number="37">
<![CDATA[		hSequence.ops[index].data := pos;]]>
</Line>
<Line Number="38">
<![CDATA[		]]>
</Line>
<Line Number="39">
<![CDATA[		index := index + 1;]]>
