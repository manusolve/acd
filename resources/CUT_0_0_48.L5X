<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// call the axis]]>
</Line>
<Line Number="2">
<![CDATA[mAxis(axis, StepperAxis, \Safety.ENABLE_ALL);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[if cmd = 10 then]]>
</Line>
<Line Number="6">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="7">
<![CDATA[end_if;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[if not \Safety.ENABLE_ALL then]]>
</Line>
<Line Number="10">
<![CDATA[	state := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[// check the edge of the part at bottom]]>
</Line>
<Line Number="14">
<![CDATA[partAtBottomEdge.InputBit := partAtBottom;]]>
</Line>
<Line Number="15">
<![CDATA[OSRI(partAtBottomEdge);]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[TONR(detectTimer);]]>
</Line>
<Line Number="18">
<![CDATA[TONR(hopperMoveTimer);]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[// using timeStamp]]>
</Line>
<Line Number="21">
<![CDATA[currTime := (timeStamp[0] - startTime) * 0.001;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[(*]]>
</Line>
<Line Number="25">
<![CDATA[	cmd]]>
</Line>
<Line Number="26">
<![CDATA[	---]]>
</Line>
<Line Number="27">
<![CDATA[	0 = stop]]>
</Line>
<Line Number="28">
<![CDATA[	1 = run const vel]]>
</Line>
<Line Number="29">
<![CDATA[*)]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[case state of]]>
</Line>
<Line Number="33">
<![CDATA[	0:]]>
</Line>
<Line Number="34">
<![CDATA[		// init]]>
</Line>
<Line Number="35">
<![CDATA[		currentCmd := -1;]]>
</Line>
<Line Number="36">
<![CDATA[		]]>
</Line>
<Line Number="37">
<![CDATA[		axis.jog := 0;]]>
</Line>
<Line Number="38">
<![CDATA[		axis.accel := 50;]]>
</Line>
<Line Number="39">
<![CDATA[		axis.accel := 5;]]>
</Line>
<Line Number="40">
<![CDATA[		]]>
</Line>
<Line Number="41">
<![CDATA[		axis.decel := axis.accel;]]>
</Line>
<Line Number="42">
<![CDATA[		axis.jerkPercentage := 80.0;]]>
</Line>
<Line Number="43">
<![CDATA[		]]>
</Line>
<Line Number="44">
<![CDATA[		message := 'wait for axis ready';]]>
</Line>
<Line Number="45">
<![CDATA[		isEmpty := 0;]]>
</Line>
<Line Number="46">
<![CDATA[		isTorqueLimitSeen := 0;]]>
</Line>
<Line Number="47">
<![CDATA[		]]>
</Line>
<Line Number="48">
<![CDATA[		state := 50;]]>
</Line>
<Line Number="49">
<![CDATA[	]]>
</Line>
<Line Number="50">
<![CDATA[	50:]]>
</Line>
<Line Number="51">
<![CDATA[		// wait for ready:]]>
</Line>
<Line Number="52">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="53">
<![CDATA[			state := 90;]]>
</Line>
<Line Number="54">
<![CDATA[		end_if;]]>
</Line>
<Line Number="55">
<![CDATA[		]]>
</Line>
<Line Number="56">
<![CDATA[	90:]]>
</Line>
<Line Number="57">
<![CDATA[		// enter stopped/wait]]>
</Line>
<Line Number="58">
<![CDATA[		message := 'stopped/ready';]]>
</Line>
<Line Number="59">
<![CDATA[		state := 100;]]>
</Line>
<Line Number="60">
<![CDATA[		]]>
</Line>
<Line Number="61">
<![CDATA[	100:]]>
</Line>
<Line Number="62">
<![CDATA[		// stopped]]>
</Line>
<Line Number="63">
<![CDATA[		currentCmd := 0;]]>
</Line>
<Line Number="64">
<![CDATA[		]]>
</Line>
<Line Number="65">
<![CDATA[		if cmd = 1 then]]>
</Line>
<Line Number="66">
<![CDATA[			cmd := -1;		// command has been consumed]]>
</Line>
<Line Number="67">
<![CDATA[			state := 200;]]>
</Line>
<Line Number="68">
<![CDATA[		end_if;]]>
</Line>
<Line Number="69">
<![CDATA[		]]>
</Line>
<Line Number="70">
<![CDATA[		(*]]>
</Line>
<Line Number="71">
<![CDATA[		if cmd = 2 then]]>
</Line>
<Line Number="72">
<![CDATA[			cmd := -1;]]>
</Line>
<Line Number="73">
<![CDATA[			state := 400;]]>
</Line>
<Line Number="74">
<![CDATA[		end_if;]]>
</Line>
<Line Number="75">
<![CDATA[		*)]]>
</Line>
<Line Number="76">
<![CDATA[		]]>
</Line>
<Line Number="77">
<![CDATA[		]]>
</Line>
<Line Number="78">
<![CDATA[	200:]]>
</Line>
<Line Number="79">
<![CDATA[		// starting]]>
</Line>
<Line Number="80">
<![CDATA[]]>
</Line>
<Line Number="81">
<![CDATA[		if axis.ready then]]>
</Line>
<Line Number="82">
<![CDATA[			axis.jog := 1;]]>
</Line>
<Line Number="83">
<![CDATA[			//axis.jogDirection := 1;]]>
</Line>
<Line Number="84">
<![CDATA[			axis.speed := \Settings.inputProcessParam.stepperSpeed;]]>
</Line>
<Line Number="85">
<![CDATA[			state := 210;]]>
</Line>
<Line Number="86">
<![CDATA[		end_if;]]>
</Line>
<Line Number="87">
<![CDATA[		]]>
</Line>
<Line Number="88">
<![CDATA[	210:]]>
</Line>
<Line Number="89">
<![CDATA[		// transitional to running]]>
</Line>
<Line Number="90">
<![CDATA[		state := 300;]]>
</Line>
<Line Number="91">
<![CDATA[	]]>
</Line>
<Line Number="92">
<![CDATA[	/// running]]>
</Line>
<Line Number="93">
<![CDATA[	300:]]>
</Line>
<Line Number="94">
<![CDATA[		// entry]]>
</Line>
<Line Number="95">
<![CDATA[		message := 'running';]]>
</Line>
<Line Number="96">
<![CDATA[		currentCmd := 1;]]>
</Line>
<Line Number="97">
<![CDATA[		state := 310;]]>
</Line>
<Line Number="98">
<![CDATA[	]]>
</Line>
<Line Number="99">
<![CDATA[	310:]]>
</Line>
<Line Number="100">
<![CDATA[		// restart part detect timer]]>
</Line>
<Line Number="101">
<![CDATA[		detectTimer.Reset := 1;]]>
</Line>
<Line Number="102">
<![CDATA[		TONR(detectTimer);]]>
</Line>
<Line Number="103">
<![CDATA[		TimerStart(tS, detectTimer, 15000);]]>
</Line>
<Line Number="104">
<![CDATA[		state := 320;]]>
</Line>
<Line Number="105">
<![CDATA[		]]>
</Line>
<Line Number="106">
<![CDATA[	320:]]>
</Line>
<Line Number="107">
<![CDATA[		// loop]]>
</Line>
<Line Number="108">
<![CDATA[		isEmpty := 0;]]>
</Line>
<Line Number="109">
<![CDATA[]]>
</Line>
<Line Number="110">
<![CDATA[		if \Loading.isTipperDown and \Loading.isHopperUp then]]>
</Line>
<Line Number="111">
<![CDATA[			// check for parts coming in]]>
</Line>
<Line Number="112">
<![CDATA[			//partAtBottomLast := partAtBottom;			]]>
</Line>
<Line Number="113">
<![CDATA[			]]>
</Line>
<Line Number="114">
<![CDATA[			if detectTimer.DN then				]]>
</Line>
<Line Number="115">
<![CDATA[				isEmpty := 1;]]>
</Line>
<Line Number="116">
<![CDATA[			end_if;]]>
</Line>
<Line Number="117">
<![CDATA[		end_if;]]>
</Line>
<Line Number="118">
<![CDATA[		]]>
</Line>
<Line Number="119">
<![CDATA[		if partAtBottomEdge.OutputBit or partAtBottom or check then]]>
</Line>
<Line Number="120">
<![CDATA[			check := 0;]]>
</Line>
<Line Number="121">
<![CDATA[			// start timer ]]>
</Line>
<Line Number="122">
<![CDATA[			newTIme := timeStamp[0];			]]>
</Line>
<Line Number="123">
<![CDATA[			lastSeenSec := (newTIme - lastSeen) * 0.000001;]]>
</Line>
<Line Number="124">
<![CDATA[			lastSeen := newTIme;]]>
</Line>
<Line Number="125">
<![CDATA[			state := 310;]]>
</Line>
<Line Number="126">
<![CDATA[		end_if;]]>
</Line>
<Line Number="127">
<![CDATA[		]]>
</Line>
<Line Number="128">
<![CDATA[		// monitor the torque on the stepper]]>
</Line>
<Line Number="129">
<![CDATA[		// in the case where we see an over load about to ]]>
</Line>
<Line Number="130">
<![CDATA[		// occur then check the hopper to see if it can be lowered.]]>
</Line>
<Line Number="131">
<![CDATA[		]]>
</Line>
<Line Number="132">
<![CDATA[		// SLVC gives a correct reading for THIS.]]>
</Line>
<Line Number="133">
<![CDATA[		velocityFeedback := StepperAxis.VelocityFeedback;]]>
</Line>
<Line Number="134">
<![CDATA[		]]>
</Line>
<Line Number="135">
<![CDATA[		if \Loading.hydReady then		// only if door is closed]]>
</Line>
<Line Number="136">
<![CDATA[			// then lower the hopper. or raise fault.]]>
</Line>
<Line Number="137">
<![CDATA[			if axis.fault or debugLowerHopper then]]>
</Line>
<Line Number="138">
<![CDATA[				(*]]>
</Line>
<Line Number="139">
<![CDATA[				if \Loading.isHopperUp then]]>
</Line>
<Line Number="140">
<![CDATA[					//\Loading.reqHopperDown := 1;]]>
</Line>
<Line Number="141">
<![CDATA[					//state := 400;]]>
</Line>
<Line Number="142">
<![CDATA[					;]]>
</Line>
<Line Number="143">
<![CDATA[				end_if;]]>
</Line>
<Line Number="144">
<![CDATA[				*)]]>
</Line>
<Line Number="145">
<![CDATA[				if \Loading.isHopperDown then]]>
</Line>
<Line Number="146">
<![CDATA[					// cannot lower]]>
</Line>
<Line Number="147">
<![CDATA[				elsif \Loading.isTipperDown then]]>
</Line>
<Line Number="148">
<![CDATA[					state := 400;]]>
</Line>
<Line Number="149">
<![CDATA[				end_if;]]>
</Line>
<Line Number="150">
<![CDATA[			end_if;]]>
</Line>
<Line Number="151">
<![CDATA[		end_if;]]>
</Line>
<Line Number="152">
<![CDATA[		]]>
</Line>
<Line Number="153">
<![CDATA[		]]>
</Line>
<Line Number="154">
<![CDATA[		]]>
</Line>
<Line Number="155">
<![CDATA[		if cmd = 0 then]]>
</Line>
<Line Number="156">
<![CDATA[			cmd := -1;		// command has been consumed]]>
</Line>
<Line Number="157">
<![CDATA[			state := 0;]]>
</Line>
<Line Number="158">
<![CDATA[		end_if;]]>
</Line>
<Line Number="159">
<![CDATA[	]]>
</Line>
<Line Number="160">
<![CDATA[	// recovery]]>
</Line>
<Line Number="161">
<![CDATA[	400:]]>
</Line>
<Line Number="162">
<![CDATA[		debugLowerHopper := 0;]]>
</Line>
<Line Number="163">
<![CDATA[		]]>
</Line>
<Line Number="164">
<![CDATA[		startTime := timeStamp[0];]]>
</Line>
<Line Number="165">
<![CDATA[		\Loading.reqHopperDown := 1;]]>
</Line>
<Line Number="166">
<![CDATA[		state := 410;]]>
</Line>
<Line Number="167">
<![CDATA[		]]>
</Line>
<Line Number="168">
<![CDATA[	410:]]>
</Line>
<Line Number="169">
<![CDATA[		if \Loading.isHopperDown then]]>
</Line>
<Line Number="170">
<![CDATA[			\Loading.reqHopperDown := 0;]]>
</Line>
<Line Number="171">
<![CDATA[			timeLower := currTime;]]>
</Line>
<Line Number="172">
<![CDATA[			startTime := timeStamp[0];]]>
</Line>
<Line Number="173">
<![CDATA[			state := 420;]]>
</Line>
<Line Number="174">
<![CDATA[		end_if;]]>
</Line>
<Line Number="175">
<![CDATA[		]]>
</Line>
<Line Number="176">
<![CDATA[	420:]]>
</Line>
<Line Number="177">
<![CDATA[		//wait on down]]>
</Line>
<Line Number="178">
<![CDATA[		// force reset of axis]]>
</Line>
<Line Number="179">
<![CDATA[		axis.state := 0;]]>
</Line>
<Line Number="180">
<![CDATA[		]]>
</Line>
<Line Number="181">
<![CDATA[		if currTime > 5000 then]]>
</Line>
<Line Number="182">
<![CDATA[			startTime := timeStamp[0];]]>
</Line>
<Line Number="183">
<![CDATA[			]]>
</Line>
<Line Number="184">
<![CDATA[			]]>
</Line>
<Line Number="185">
<![CDATA[			if timeLower < 2000 then]]>
</Line>
<Line Number="186">
<![CDATA[				timeLower := 2000;]]>
</Line>
<Line Number="187">
<![CDATA[			end_if;]]>
</Line>
<Line Number="188">
<![CDATA[			]]>
</Line>
<Line Number="189">
<![CDATA[			state := 450;]]>
</Line>
<Line Number="190">
<![CDATA[		end_if;]]>
</Line>
<Line Number="191">
<![CDATA[		]]>
</Line>
<Line Number="192">
<![CDATA[	]]>
</Line>
<Line Number="193">
<![CDATA[	// come back up]]>
</Line>
<Line Number="194">
<![CDATA[	450:]]>
</Line>
<Line Number="195">
<![CDATA[		\Loading.reqHopperUp := 1;]]>
</Line>
<Line Number="196">
<![CDATA[		]]>
</Line>
<Line Number="197">
<![CDATA[		if \Loading.isHopperUp ]]>
</Line>
<Line Number="198">
<![CDATA[			or currTime > (timeLower * 1.7)]]>
</Line>
<Line Number="199">
<![CDATA[		then]]>
</Line>
<Line Number="200">
<![CDATA[			\Loading.reqHopperUp := 0;]]>
</Line>
<Line Number="201">
<![CDATA[			state := 320;]]>
</Line>
<Line Number="202">
<![CDATA[		end_if;]]>
</Line>
<Line Number="203">
<![CDATA[		]]>
</Line>
<Line Number="204">
<![CDATA[	else]]>
</Line>
<Line Number="205">
<![CDATA[		state := 0;]]>
</Line>
<Line Number="206">
<![CDATA[]]>
</Line>
<Line Number="207">
<![CDATA[end_case;]]>
</Line>
<Line Number="208">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="Transfer" TestEdits="false" MainRoutineName="MainServo" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags>
<Tag Name="actualPartLen" TagType="Base" DataType="REAL" Radix="Float" Usage="Input" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[5.39623535e+002]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="539.62354"/>
</Data>
</Tag>
<Tag Name="axis" TagType="Base" DataType="mAxis" Usage="InOut" Constant="false" ExternalAccess="Read/Write"/>
